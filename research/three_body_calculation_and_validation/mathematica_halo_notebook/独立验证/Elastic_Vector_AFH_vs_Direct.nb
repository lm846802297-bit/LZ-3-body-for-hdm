Notebook[{
Cell["\:4e24\:4f53\:77e2\:91cf\:6563\:5c04\:ff1a\:76f4\:63a5\:632f\:5e45\:4e0e AFH \:5bf9\:7167", "Title"],
Cell["\:4ece\:4e0a\:5230\:4e0b\:4f9d\:6b21\:6309 Shift+Enter\:3002\:672c\:6587\:5efa\:7acb\:4e00\:4e2a\:5bf9\:89d2\:77e2\:91cf\:8026\:5408\:7684\:72ec\:7acb\:4e24\:4f53\:57fa\:51c6\:ff0c\:5e76\:4e0d\:628a\:5b83\:5f53\:4f5c\:539f\:6a21\:578b\:7684\:4e09\:4f53\:8fc7\:7a0b\:3002\:6240\:6709\:622a\:9762\:5355\:4f4d\:4e3a GeV^-3\:ff1b\:8fd0\:884c\:524d\:8bf7\:786e\:8ba4\:540c\:76ee\:5f55\:4e0a\:4e00\:7ea7\:5b58\:5728 dmformfactor-V6.m\:3002", "Text"],
Cell["\:4e00\:3001\:7269\:7406\:6a21\:578b\:4e0e\:6bd4\:8f83\:8303\:56f4", "Section"],
Cell["\:6a21\:578b\:ff1ag\:03c7 V\:03bc \:03c7\:0304 \:03b3\:03bc \:03c7 + gN V\:03bc N\:0304 \:03b3\:03bc N\:ff0c\:53d6\:8d28\:5b50\:548c\:4e2d\:5b50\:8026\:5408\:76f8\:7b49\:3002\:76f4\:63a5\:65b9\:6cd5\:7531\:9886\:5148\:9636\:77e2\:91cf\:7535\:8377\:632f\:5e45\:5f97\:5230 d\:03c3/dER = mA (g\:03c7 gN)^2 R(E_R) / [2\:03c0 v\:00b2 (mV\:00b2 + 2 mA ER)\:00b2]\:3002AFH \:65b9\:6cd5\:5219\:8bbe\:7f6e\:8d28\:5b50\:548c\:4e2d\:5b50\:7684 O1 \:7cfb\:6570\:ff0c\:518d\:8c03\:7528 DiffCrossSection\:3002\:4e24\:8fb9\:5171\:540c\:4f7f\:7528 AFH \:6838\:5bc6\:5ea6\:6570\:636e\:ff0c\:56e0\:6b64\:8fd9\:4e0d\:662f\:5bf9\:6838\:7ed3\:6784\:6570\:636e\:7684\:72ec\:7acb\:9a8c\:8bc1\:3002", "Text"],
Cell["\:4e8c\:3001\:8bbe\:7f6e\:53c2\:6570\:5e76\:52a0\:8f7d AFH", "Section"],
Cell["\:8bf7\:4fee\:6539\:4e0b\:9762\:7684 mChi\:3001mV\:3001gChi\:3001gN\:3001speedKms \:548c recoilValues\:3002\:6b64\:5bf9\:7167\:9009 Xe-131\:3002mA \:91c7\:7528 AFH \:5185\:90e8\:7684 A \:00d7 0.938272 GeV\:ff1b\:901f\:5ea6\:91c7\:7528 AFH \:81ea\:5e26\:7684 km/s \:6362\:7b97\:3002", "Text"],
Cell["(* Xe-131 elastic vector-vector benchmark. Run with wolframscript -file. *)\nbase = DirectoryName[NotebookDirectory[]];  (* \:6839\:636e\:7b14\:8bb0\:672c\:4f4d\:7f6e\:627e\:5230 AFH \:7a0b\:5e8f\:6240\:5728\:76ee\:5f55 *)\nGet[FileNameJoin[{base, \"dmformfactor-V6.m\"}]];  (* \:52a0\:8f7d AFH \:7a0b\:5e8f *)\n\n(* All energies are in GeV unless explicitly labelled otherwise. *)\na = 131; jA = 3/2; mN = 0.938272; mA = a mN;  (* \:8bbe\:7f6e\:540c\:4f4d\:7d20\:3001\:81ea\:65cb\:53ca AFH \:7ea6\:5b9a\:7684\:6838\:5b50\:548c\:6838\:8d28\:91cf *)\nmChi = 1000.; mV = 10.; gChi = 1.; gN = 10^-4;  (* \:8bbe\:7f6e\:6697\:7269\:8d28\:8d28\:91cf\:3001\:4ecb\:5b50\:8d28\:91cf\:53ca\:4e24\:4e2a\:8026\:5408\:5e38\:6570 *)\nspeedKms = 500.; beta = speedKms dmformfactor`KilometerPerSecond;  (* \:8bbe\:7f6e\:901f\:5ea6\:5e76\:8f6c\:6362\:6210\:81ea\:7136\:5355\:4f4d *)\nreferenceMass = 246.2; recoilValues = {1., 5., 20., 50., 100.};  (* \:8bbe\:7f6e AFH \:53c2\:8003\:5c3a\:5ea6\:548c\:53cd\:51b2\:80fd\:91cf\:5217\:8868 *)\ndmformfactor`ZeroCoeffs[];  (* \:6e05\:96f6 AFH \:7684\:76f8\:4e92\:4f5c\:7528\:7cfb\:6570 *)\ndmformfactor`SetJChi[1/2];  (* \:8bbe\:7f6e\:6697\:7269\:8d28\:81ea\:65cb *)\ndmformfactor`SetMChi[mChi dmformfactor`GeV];  (* \:8bbe\:7f6e\:6697\:7269\:8d28\:8d28\:91cf *)\ndmformfactor`SetIsotope[54, a, \"default\", \"default\"];  (* \:52a0\:8f7d Xe-131 \:7684\:9ed8\:8ba4\:6838\:5bc6\:5ea6 *)\ndmformfactor`SetHelm[False];  (* \:4f7f\:7528\:6838\:5bc6\:5ea6\:8ba1\:7b97\:7684\:54cd\:5e94\:ff0c\:800c\:4e0d\:4f7f\:7528 Helm \:8fd1\:4f3c *)\nresponse = dmformfactor`ResponseNuclear[Global`y, 1, 0, 0];  (* \:63d0\:53d6 AFH \:7684 M \:578b\:7b49\:6807\:91cf\:6838\:54cd\:5e94 *)\noscillator = 5.0677 Sqrt[41.467/(45. a^(-1/3)-25. a^(-2/3))];  (* \:8ba1\:7b97\:8c10\:632f\:5b50\:957f\:5ea6\:ff0c\:5355\:4f4d\:4e3a GeV \:7684\:5012\:6570 *)\nwzero = N[response /. Global`y -> 0];  (* \:8ba1\:7b97\:96f6\:52a8\:91cf\:8f6c\:79fb\:5904\:7684\:54cd\:5e94 *)\nrawRzero = N[4 (4 Pi/(2 jA + 1)) wzero];  (* \:8ba1\:7b97 AFH \:539f\:59cb\:54cd\:5e94\:5bf9\:5e94\:7684\:96f6\:52a8\:91cf\:76f8\:5e72\:56e0\:5b50 *)\n\n", "Input"],
Cell["\:4e09\:3001\:9010\:70b9\:6bd4\:8f83\:4e24\:79cd\:65b9\:6cd5", "Section"],
Cell["AFH \:5c06\:65e0\:91cf\:7eb2 c1 \:9664\:4ee5 (246.2 GeV)^2\:ff1b\:4e3a\:4fdd\:7559\:77e2\:91cf\:4f20\:64ad\:5b50\:7684\:52a8\:91cf\:4f9d\:8d56\:ff0c\:6bcf\:4e2a ER \:5355\:72ec\:8bbe\:7f6e c1 = g\:03c7 gN (246.2 GeV)^2/(mV\:00b2+q\:00b2)\:3002\:5148\:6bd4\:8f83 AFH \:7684\:539f\:59cb\:6838\:54cd\:5e94\:ff0c\:518d\:6bd4\:8f83\:539f\:4e09\:4f53\:7a0b\:5e8f\:91c7\:7528\:7684 R(0)=A\:00b2 \:5f52\:4e00\:5316\:3002", "Text"],
Cell["(* Equal p and n couplings: direct nuclear density is 2 times the AFH isoscalar density. *)\nevaluate[er_?NumericQ] := Module[{q2, yval, w, rRaw, rNormalized, c, afh, direct, normalized},  (* \:5b9a\:4e49\:5355\:4e2a\:53cd\:51b2\:80fd\:91cf\:7684\:4e24\:79cd\:622a\:9762\:8ba1\:7b97 *)\n q2 = 2 mA er 10^-6;  (* \:8ba1\:7b97\:52a8\:91cf\:8f6c\:79fb\:5e73\:65b9\:ff0c\:53cd\:51b2\:80fd\:91cf\:7531 keV \:6362\:6210 GeV *)\n yval = q2 oscillator^2/4;  (* \:8ba1\:7b97\:6838\:54cd\:5e94\:7684\:65e0\:91cf\:7eb2\:53d8\:91cf y *)\n w = N[response /. Global`y -> yval];  (* \:5728\:5f53\:524d\:53cd\:51b2\:80fd\:91cf\:5904\:8ba1\:7b97 AFH \:6838\:54cd\:5e94 *)\n rRaw = 4 (4 Pi/(2 jA + 1)) w;  (* \:8f6c\:6362 AFH \:54cd\:5e94\:7684\:7b49\:6807\:91cf\:53ca\:6838\:81ea\:65cb\:5f52\:4e00\:5316 *)\n rNormalized = a^2 w/wzero;  (* \:6309\:4e09\:4f53\:7a0b\:5e8f\:7684\:7ea6\:5b9a\:5c06\:96f6\:52a8\:91cf\:503c\:5f52\:4e00\:5316\:4e3a A \:5e73\:65b9 *)\n (* AFH divides its dimensionless input by the fixed scale 246.2 GeV squared. *)\n c = gChi gN referenceMass^2/(mV^2+q2);  (* \:5339\:914d AFH \:7684\:65e0\:91cf\:7eb2\:7cfb\:6570\:53ca\:4f20\:64ad\:5b50 *)\n dmformfactor`ZeroCoeffs[];  (* \:6e05\:96f6 AFH \:7684\:76f8\:4e92\:4f5c\:7528\:7cfb\:6570 *)\n dmformfactor`SetCoeffsNonrel[1, c, \"p\"];  (* \:8bbe\:7f6e\:5bf9\:5e94\:6838\:5b50\:7684 O1 \:76f8\:4e92\:4f5c\:7528\:7cfb\:6570 *)\n dmformfactor`SetCoeffsNonrel[1, c, \"n\"];  (* \:8bbe\:7f6e\:5bf9\:5e94\:6838\:5b50\:7684 O1 \:76f8\:4e92\:4f5c\:7528\:7cfb\:6570 *)\n afh = N[dmformfactor`DiffCrossSection[er, beta] dmformfactor`GeV^3 /. dmformfactor`GeV -> 1];  (* \:8c03\:7528 AFH \:8ba1\:7b97\:622a\:9762\:5e76\:5316\:6210 GeV \:7684\:8d1f\:4e09\:6b21\:65b9 *)\n direct = N[mA (gChi gN)^2 rRaw/(2 Pi beta^2 (mV^2+q2)^2)];  (* \:7531\:76f4\:63a5\:632f\:5e45\:7684\:9886\:5148\:9636\:516c\:5f0f\:8ba1\:7b97\:622a\:9762 *)\n normalized = N[mA (gChi gN)^2 rNormalized/(2 Pi beta^2 (mV^2+q2)^2)];  (* \:4f7f\:7528\:5f52\:4e00\:5316\:6838\:54cd\:5e94\:8ba1\:7b97\:540c\:4e00\:4e2a\:76f4\:63a5\:516c\:5f0f *)\n {er, afh, direct, direct/afh-1, normalized, normalized/afh-1}  (* \:4f9d\:6b21\:8fd4\:56de\:80fd\:91cf\:3001\:622a\:9762\:548c\:76f8\:5bf9\:5dee *)\n];  (* \:7ed3\:675f\:5f53\:524d\:5b9a\:4e49\:6216\:5224\:65ad *)\nrows = evaluate /@ recoilValues;  (* \:5bf9\:6240\:6709\:53cd\:51b2\:80fd\:91cf\:6267\:884c\:6bd4\:8f83 *)\nPrint[\"mass_GeV=\",mA,\"; beta=\",beta,\"; raw_R0=\",rawRzero,\"; A2=\",a^2];  (* \:663e\:793a\:53c2\:6570\:3001\:8868\:5934\:6216\:68c0\:9a8c\:7ed3\:679c *)\nPrint[\"{ER_keV, AFH_GeV^-3, direct_raw_GeV^-3, direct_raw_rel_diff, direct_normalized_GeV^-3, normalized_rel_diff}\"];  (* \:663e\:793a\:53c2\:6570\:3001\:8868\:5934\:6216\:68c0\:9a8c\:7ed3\:679c *)\nScan[Print[InputForm[#]] &, rows];  (* \:9010\:884c\:663e\:793a\:5bf9\:7167\:7ed3\:679c *)\nIf[!And @@ (NumericQ /@ Flatten[rows]) || Max[Abs[rows[[All, 4]]]] > 10^-8,  (* \:5224\:65ad\:6240\:6709\:6570\:503c\:548c\:76f8\:5bf9\:8bef\:5dee\:662f\:5426\:6ee1\:8db3\:8981\:6c42 *)\n Print[\"FAIL: direct raw response does not match AFH\"],  (* \:663e\:793a\:53c2\:6570\:3001\:8868\:5934\:6216\:68c0\:9a8c\:7ed3\:679c *)\n Print[\"PASS: raw response matches AFH at all tested points.\"]  (* \:663e\:793a\:53c2\:6570\:3001\:8868\:5934\:6216\:68c0\:9a8c\:7ed3\:679c *)\n];  (* \:7ed3\:675f\:5f53\:524d\:5b9a\:4e49\:6216\:5224\:65ad *)\n", "Input"],
Cell["\:56db\:3001\:8bfb\:7ed3\:679c", "Section"],
Cell["\:6bcf\:4e00\:884c\:4f9d\:6b21\:4e3a ER\:3001AFH \:622a\:9762\:3001\:76f4\:63a5\:516c\:5f0f\:622a\:9762\:3001\:76f4\:63a5\:516c\:5f0f\:76f8\:5bf9\:5dee\:3001A\:00b2 \:5f52\:4e00\:5316\:622a\:9762\:3001\:5f52\:4e00\:5316\:622a\:9762\:76f8\:5bf9\:5dee\:3002PASS \:8868\:793a\:539f\:59cb\:54cd\:5e94\:7684\:5404\:70b9\:76f8\:5bf9\:5dee\:4f4e\:4e8e 10^-8\:3002\:6570\:503c\:63a5\:8fd1\:54cd\:5e94\:96f6\:70b9\:65f6\:76f8\:5bf9\:5dee\:53ef\:80fd\:66f4\:654f\:611f\:3002\:6b64\:5bf9\:7167\:53ea\:9a8c\:8bc1\:8be5\:4e24\:4f53\:9886\:5148\:9636\:5339\:914d\:ff0c\:4e0d\:80fd\:8bc1\:660e\:4e09\:4f53\:632f\:5e45\:6216\:76f8\:7a7a\:95f4\:6b63\:786e\:3002", "Text"]
}, WindowTitle -> "Elastic Vector Comparison", StyleDefinitions -> "Default.nb"]
