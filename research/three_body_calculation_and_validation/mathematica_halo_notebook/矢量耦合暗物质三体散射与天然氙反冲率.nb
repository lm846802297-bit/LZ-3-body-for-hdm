          {Cell["Gauss \:6c42\:79ef\:5bf9\:7167\:51fd\:6570", "Subsection",
            ExpressionUUID -> "2b06a371-afdd-4b40-b70a-d12eb63709f0"],
           Cell[CellGroupData[{Cell["gaussI6[m_?NumericQ,ms_?NumericQ,dm_?Num\
ericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,order_List,width_?NumericQ]:=Modu\
le[\n \
{beta,lor,ee,pz,qq,wlo,whi,pin,quadrW,quadrZ,quadrP,sum=0.,w2,weight,cq,q,K,b\
K,ps,e3,ref,e1,e2,lam,W,kabs,Ek,Ep,z,phi,n,k,pp,ang,pa,m2},\n \
If[!NumericQ[width] || !TrueQ[width>=0],Throw[\"Invalid constant pole \
width\"]];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n \
If[er<=0 || v<=0,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n \
beta=v/cKm;  (* Gauss \
\:5bf9\:7167\:ff1a\:901f\:5ea6\:8f6c\:4e3a\:65e0\:91cf\:7eb2 \[Beta] \
*)\nlor=1/Sqrt[1-beta^2];  (* Gauss \
\:5bf9\:7167\:ff1a\:8ba1\:7b97\:6d1b\:4f26\:5179\:56e0\:5b50 *)\nee=m lor;  \
(* Gauss \
\:5bf9\:7167\:ff1a\:8ba1\:7b97\:5165\:5c04\:6697\:7269\:8d28\:80fd\:91cf \
*)\npz=m lor beta;  (* Gauss \
\:5bf9\:7167\:ff1a\:8ba1\:7b97\:5165\:5c04\:6697\:7269\:8d28\:6cbf z \
\:8f74\:7684\:52a8\:91cf *)\nqq=Sqrt[2 mA er+er^2];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)\n\n \
wlo=(m+ms)^2;  (* \
\:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0b\:9650 \
*)\nwhi=m^2+2 pz qq-2(ee+mA)er;  (* \
\:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0a\:9650 \
*)\n\n If[whi<=wlo,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n m2=m+dm;  \
(* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf *)\n\n \
If[whi>=m2^2,Throw[\"On-shell chi2 accessible: off-shell calculation \
aborted\"]];  (* \
\:68c0\:67e5\:6fc0\:53d1\:6001\:4f20\:64ad\:5b50\:7684\:9002\:7528\:6761\
\:4ef6 *)\n\n pin={ee,0.,0.,pz};  (* Gauss \
\:5bf9\:7167\:ff1a\:6784\:9020\:5165\:5c04\:6697\:7269\:8d28\:56db\:52a8\
\:91cf *)\nquadrW=gl[order[[1]]];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\nquadrZ=gl[order[[2]]];  (* \
\:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd \
*)\nquadrP=gl[order[[3]]];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\n\n Do[\n  \
w2=(whi+wlo)/2+(whi-wlo)node[[1]]/2;  (* \:5c06 Gauss \
\:8282\:70b9\:6620\:5c04\:5230 W\262 \:79ef\:5206\:533a\:95f4 \
*)\nweight=node[[2]](whi-wlo)/2;  (* \:8ba1\:7b97\:8be5 W\262 \
\:8282\:70b9\:7684\:6743\:91cd\:548c\:533a\:95f4 Jacobian *)\n\n  \
cq=Clip[(w2-m^2+2(ee+mA)er)/(2 pz qq),{-1.,1.}];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)\n\n  \
q={er,qq Sqrt[Max[0.,1-cq^2]],0.,qq cq};  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf \
*)\nK=pin-q;  (* \:7531\:56db\:52a8\:91cf\:5b88\:6052\:5f97\:5230 \[Chi]1+s \
\:7cfb\:7edf\:56db\:52a8\:91cf *)\nbK=K[[2;;4]]/K[[1]];  (* \:8ba1\:7b97 \
\[Chi]1+s \
\:8d28\:5fc3\:7cfb\:76f8\:5bf9\:5b9e\:9a8c\:5ba4\:7cfb\:7684\:901f\:5ea6 \
*)\n\n  ps=boost[pin,-bK];  (* \
\:5c06\:5165\:5c04\:52a8\:91cf\:53d8\:6362\:5230 \[Chi]1+s \:8d28\:5fc3\:7cfb \
*)\ne3=Normalize[ps[[2;;4]]];  (* \
\:4ee5\:8d28\:5fc3\:7cfb\:5165\:5c04\:65b9\:5411\:5b9a\:4e49\:6781\:8f74 \
*)\nref=If[Abs[e3[[1]]]>.9,{0.,1.,0.},{1.,0.,0.}];  (* \
\:9009\:62e9\:4e0d\:4e0e\:6781\:8f74\:8fd1\:4e4e\:5e73\:884c\:7684\:53c2\
\:8003\:65b9\:5411 *)\n\n  e1=Normalize[Cross[ref,e3]];  (* \
\:8ba1\:7b97\:5782\:76f4\:4e8e\:6781\:8f74\:7684\:7b2c\:4e00\:4e2a\:5355\
\:4f4d\:77e2\:91cf *)\ne2=Cross[e3,e1];  (* \
\:8ba1\:7b97\:7b2c\:4e8c\:4e2a\:6a2a\:5411\:5355\:4f4d\:77e2\:91cf *)\n\n  \
lam=Max[0.,(w2-(m+ms)^2)(w2-(m-ms)^2)];  (* \:8ba1\:7b97 \
K\[ADoubleDot]ll\[EAcute]n \
\:51fd\:6570\:ff0c\:5e76\:9650\:5236\:9608\:503c\:5904\:820d\:5165\:8bef\
\:5dee *)\n W=Sqrt[w2];  (* \
\:4ece\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:5f97\:5230\:8d28\:5fc3\:7cfb\
\:603b\:80fd\:91cf *)\n\n  kabs=Sqrt[lam]/(2 W);  (* \
\:8ba1\:7b97\:8d28\:5fc3\:7cfb\:4e2d\:7684\:672b\:6001\:52a8\:91cf\:5927\
\:5c0f *)\nEk=(w2-m^2+ms^2)/(2 W);  (* \
\:8ba1\:7b97\:6807\:91cf\:5728\:8d28\:5fc3\:7cfb\:7684\:80fd\:91cf \
*)\nEp=(w2+m^2-ms^2)/(2 W);  (* \:8ba1\:7b97\:672b\:6001 \[Chi]1 \
\:5728\:8d28\:5fc3\:7cfb\:7684\:80fd\:91cf *)\n\n  ang=0.;  (* \
\:521d\:59cb\:5316\:6781\:89d2\:79ef\:5206\:7684\:7d2f\:52a0\:503c \
*)\nDo[z=zn[[1]];  (* \:904d\:5386 Gauss \:6781\:89d2\:4f59\:5f26\:8282\:70b9 \
*)\npa=0.;  (* \
\:521d\:59cb\:5316\:8be5\:6781\:89d2\:4e0b\:65b9\:4f4d\:89d2\:5e73\:5747\
\:7684\:7d2f\:52a0\:503c *)\nDo[phi=Pi(pn[[1]]+1);  (* \
\:5c06\:65b9\:4f4d\:89d2\:8282\:70b9\:6620\:5c04\:5230 0 \:5230 2\[Pi] *)\n\n \
  n=z e3+Sqrt[Max[0.,1-z^2]](Cos[phi] e1+Sin[phi] e2);  (* \
\:7531\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:6784\:9020\:6807\:91cf\:7684\
\:5355\:4f4d\:65b9\:5411 *)\n\n   k=boost[Join[{Ek},kabs n],bK];  (* \
\:5c06\:6807\:91cf\:56db\:52a8\:91cf\:53d8\:6362\:5230\:5b9e\:9a8c\:5ba4\
\:7cfb *)\npp=boost[Join[{Ep},-kabs n],bK];  (* \:5c06\:672b\:6001 \[Chi]1 \
\:56db\:52a8\:91cf\:53d8\:6362\:5230\:5b9e\:9a8c\:5ba4\:7cfb *)\n\n   \
pa+=pn[[2]]/2 trace[pin,pp,k,m,m2,w2,width],{pn,quadrP}];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n   ang+=zn[[2]] \
pa,{zn,quadrZ}];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 \
*)\n\n  sum+=weight Sqrt[lam]/w2 ang,{node,quadrW}];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\nsum];  (* \
\:8fd4\:56de\:5404\:79ef\:5206\:8282\:70b9\:7684\:52a0\:6743\:548c \
*)\n\n\nPrint[\"Gauss \
