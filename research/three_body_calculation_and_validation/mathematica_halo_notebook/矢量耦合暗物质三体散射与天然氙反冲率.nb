             "2b17683e-2b52-5c49-9f1f-3dd527deeb15"], Cell["(* Independent \
kernel: patched FeynArts is kept inside this project. \
*)\nworkDir=DirectoryName[$InputFileName];projectDir=DirectoryName[workDir];\
\nFeynCalc`$FeynArtsDirectory=FileNameJoin[{workDir,\"FeynArtsPatched\"}];\ns\
ourceModel=FileNameJoin[{workDir,\"ThreeBodyVV.fr\"}];\nhashFile=FileNameJoin\
[{workDir,\"generated_model_source_sha256.txt\"}];\nIf[!FileExistsQ[sourceMod\
el]||!FileExistsQ[hashFile]||ToLowerCase[FileHash[sourceModel,\"SHA256\",\"He\
xString\"]]=!=StringTrim[Import[hashFile,\"Text\"]],\n Print[\"FeynRules \
source changed since FeynArts model generation; regenerate and patch the \
model \
first.\"];Exit[2]];\n$LoadAddOns={\"FeynArts\"};$FeynCalcStartupMessages=Fals\
e;Get[\"FeynCalc`\"];\n$PrePrint=.;$FAVerbose=0;\ntop=CreateTopologies[0,2->3\
,ExcludeTopologies->{Tadpoles,SelfEnergies}];\nins=InsertFields[top,{F[1],F[3\
]}->{F[1],F[3],S[1]},Model->\"ThreeBodyVV_FA\",GenericModel->\"ThreeBodyVV_FA\
\",InsertionLevel->{Classes}];\nPrint[\"graphs=\",Length[ins]];\nfaamp=Create\
FeynAmp[ins,PreFactor->1];\nfcamp=FCFAConvert[faamp,IncomingMomenta->{p,P},Ou\
tgoingMomenta->{r,R,k},ChangeDimension->4,List->False,DropSumOver->True];\nPr\
int[\"FCAMP=\",ToString[InputForm[fcamp],PageWidth->Infinity]];\n\n(* Static \
nucleus charge current: project nuclear line to 2 m_A delta^mu_0. \
*)\nprojected=fcamp /. \
HoldPattern[Dot[Spinor[Momentum[R],___],middle__,Spinor[Momentum[P],___]]] :> \
2 MNuc;\nIf[!FreeQ[projected,Spinor[Momentum[P|R],___]],Print[\"Nuclear \
projection failed.\"];Exit[3]];\nprojected=projected /. \
{HoldPattern[Pair[LorentzIndex[_],LorentzIndex[_]]]->1,HoldPattern[DiracGamma\
[LorentzIndex[_]]]:>FeynCalc`GA[0]};\n(* Add the pole width only to the \
p-prime + k internal line, as in the paper. *)\nprojected=projected /. \
HoldPattern[FeynAmpDenominator[PropagatorDenominator[Momentum[-k-r],MChiTwo]]\
] :>\n 1/(Pair[Momentum[k+r],Momentum[k+r]]-MChiTwo^2+I MChiTwo \
gammaWidth);\nPrint[\"Width inserted in radiating propagator: \
\",!FreeQ[projected,gammaWidth]];\nIf[FreeQ[projected,gammaWidth],Print[\"Wid\
th insertion failed.\"];Exit[3]];\nconj=ComplexConjugate[projected] /. \
Conjugate[gammaWidth]->gammaWidth;\nsquared=FermionSpinSum[projected \
conj]/2;\nexpr=FeynAmpDenominatorExplicit[Contract[DiracSimplify[squared,Dira\
cTraceEvaluate->True]]];\nPrint[\"static projected spin trace \
bytes=\",ByteCount[expr],\" remaining \
propagators=\",Length[Cases[expr,_FeynAmpDenominator,Infinity]]];\n(* \
INSERT_NOTEBOOK_ENGINE *)\n(* INSERT_NOTEBOOK_NINTEGRATE \
*)\nprec=50;args=Rest[$ScriptCommandLine];\nIf[!MemberQ[{0,12},Length[args]],\
Print[\"Expected no arguments or exactly 12: \
m,ms,dm,mA,ER,v,mV,g1,g2,gN,A,widthMode.\"];Exit[2]];\nIf[Length[args]==12,\n \
{m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[Rationalize[ToExpression[#],0],prec]& /@ \
Take[args,10];iso=ToExpression[args[[11]]];widthMode=Last[args],\n \
{m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[#,prec]& /@ \
{1000,3/10000,1/1000,131*93149410242/10^11,1/5000,776,10,1,1,1};iso=131;width\
Mode=\"pole\"\n];\nIf[!MemberQ[{128,129,130,131,132,134,136},iso]||!TrueQ[Abs\
[ma-iso*93149410242/10^11]<10^-8]||!MemberQ[{\"pole\"},widthMode]||!TrueQ[m>0\
&&ms>=0&&dm>=0&&ma>0&&er>0&&0<v<299792458/1000&&mv>0&&cX!=0&&cS!=0&&cN!=0],Pr\
int[\"Invalid physical \
inputs.\"];Exit[2]];\nwidthGeV=Chi2Width[m,ms,dm,cS];\nkin=niKinematics[m,ms,\
ma,er,v,N[2/5,prec],N[1/4,prec],N[6/5,prec]];\nIf[kin===$Failed,Print[\"Phase \
space \
closed.\"];Exit[2]];\nIf[!TrueQ[(m+ms)^2+kin[\"delta\"]<(m+dm)^2],Print[\"On-\
shell pole accessible; off-shell assumption \
invalid.\"];Exit[2]];\nmuDot[a_,b_]:=a[[1]]b[[1]]-a[[2;;4]].b[[2;;4]];\nClear\
[fcStaticME2,fcStaticWeight];\nfcStaticME2[u_?NumericQ,z_?NumericQ,phi_?Numer\
icQ]:=Module[{x,pIn,pOut,kOut,pT,rT,vs,momf},\n \
x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];\n \
pIn=x[\"pin\"];pOut=x[\"pout\"];kOut=x[\"k\"];pT={ma,0,0,0};rT=pT+Join[{er},x\
[\"qvec\"]];\n vs={p->pIn,r->pOut,k->kOut,P->pT,R->rT};momf[a_]:=a/.vs;\n \
expr/.{HoldPattern[Pair[Momentum[a_],Momentum[b_]]]:>muDot[momf[a],momf[b]],H\
oldPattern[TemporalPair[ExplicitLorentzIndex[0],TemporalMomentum[a_]]]:>momf[\
a][[1]],MChiOne->m,MChiTwo->m+dm,MNuc->ma,MMed->mv,gammaWidth->widthGeV,gc1->\
cS,gc2->cS,gc3->cX,gc4->cX,gc5->cN}\n];\nfcStaticWeight[u_?NumericQ,z_?Numeri\
cQ,phi_?NumericQ]:=Module[{x},\n \
x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];\n x[\"jac\"] \
x[\"phase\"] Re[fcStaticME2[u,z,phi]]/(2 \
Pi)\n];\npoint=fcStaticME2[N[2/5,prec],N[1/4,prec],N[6/5,prec]];\npointRefere\
nce=4ma^2*(cX*cS*cN)^2 \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],widthGeV]/(mv^\
2+2ma er)^2;\nPrint[\"Static projected amplitude \
squared=\",N[Re[point],15],\" reference=\",N[pointReference,15],\" \
relative=\",N[point/pointReference-1,8]];\nIf[!NumericQ[point]||Abs[N[Im[poin\
t]/pointReference]]>10^-8||Abs[N[point/pointReference-1]]>10^-8,Print[\"Point \
check \
failed.\"];Exit[4]];\nincomingMomentum=m*(v/(299792458/1000))/Sqrt[1-(v/(2997\
92458/1000))^2];\nPrint[\"Integrating FeynCalc static-current amplitude; \
width \
mode=\",widthMode];\nsigmaPoint=NIntegrate[fcStaticWeight[u,z,phi],{u,0,1},{z\
,-1,1},{phi,0,2Pi},WorkingPrecision->35,AccuracyGoal->5,PrecisionGoal->5,MaxR\
ecursion->7,Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0}]/(1024 \
Pi^3 ma \
incomingMomentum^2);\nLoadResponses[FileNameJoin[{projectDir,\"dmformfactor-V\
6.m\"}],{iso}];\n(* Use the same AFH isotope and A*u nuclear mass as the \
notebook. \
*)\nresponse=NuclearResponse[iso,N[er*10^6]];\nsigmaXe=sigmaPoint*response;\n\
Print[\"AFH isotope and response=\",iso,\" \",response];\nPrint[\"Three-body \
dsigma GeV^-3=\",N[sigmaXe,15]];\nPrint[\"Three-body dsigma \
cm2/keV=\",N[sigmaXe*3893793721/10^43,15]];\nPrint[\"Pointlike R=1 dsigma \
GeV^-3=\",N[sigmaPoint,15]];\nPrint[\"Width \
GeV=\",N[widthGeV,12]];\noriginalParams=<|\"mchi\"->N[m],\"mV\"->N[mv],\"g2\"\
->N[cS],\"couplingSq\"->N[(cX*cS*cN)^2],\"quad\"->{24,24,12},\"widthMode\"->w\
idthMode|>;\noriginalSigma=DifferentialCrossSection[iso,N[er*10^6],N[v],N[ms]\
,N[dm],originalParams];\nPrint[\"Original Gauss (24,24,12) dsigma \
GeV^-3=\",originalSigma];\nPrint[\"FeynCalc/original - \
1=\",N[sigmaXe/originalSigma-1,8]];\nIf[!NumericQ[sigmaXe]||!TrueQ[sigmaXe>0]\
,Exit[5]];\nExit[0];\n\n\n", "Program", CellTags -> "embeddedNuclear",
            ExpressionUUID -> "816153c9-672f-ad4c-a0b6-3f82a03b88a6"],
           Cell[CellGroupData[{Cell["(* \
\:5148\:8fd0\:884c\:7b2c\:4e00\:81f3\:7b2c\:4e09\:8282\:ff0c\:9009\:5b9a\
\:540c\:4f4d\:7d20\:3001\:8d28\:91cf\:3001\:901f\:5ea6\:3001\:8026\:5408\
\:53ca\:5bbd\:5ea6\:5904\:65b9\:3002 *)\nfcNuclearScript = \
writeEmbeddedScript[\"embeddedNuclear\", True]; (* \
\:4e09\:4f53\:6838\:622a\:9762\:811a\:672c *)\nfcNuclearExecutable = \
SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \"Windows\", \
\"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
