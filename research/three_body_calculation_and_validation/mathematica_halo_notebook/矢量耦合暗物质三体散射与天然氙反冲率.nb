\:663e\:793a\:603b\:622a\:9762 *)\n \
Print[\"\:56fa\:5b9a\:901f\:5ea6\:603b\:622a\:9762 cm^2: \
\",totalXe131*0.3893793721*10^-27]; (* \
\:663e\:793a\:5398\:7c73\:5355\:4f4d\:7ed3\:679c \
*)\n];\nIf[!TrueQ[runExtendedCrossSections], \
Print[\"\:901f\:5ea6\:5e73\:5747\:622a\:9762\:548c\:603b\:622a\:9762\:5c1a\
\:672a\:8ba1\:7b97\:ff1b\:5c06\:672c\:5355\:5143\:5f00\:5173\:8bbe\:4e3a True \
\:540e\:91cd\:65b0\:8fd0\:884c\:3002\"]];", "Input", CellLabel ->
