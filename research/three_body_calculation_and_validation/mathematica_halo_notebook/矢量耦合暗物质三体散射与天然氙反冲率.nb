            "Subsection", ExpressionUUID ->
             "cade2634-f706-194b-a66e-a571af425bc3"],
           Cell[CellGroupData[{Cell["Print[notebookSource[\"embeddedModel\"]]\
;  (* \
\:663e\:793a\:672c\:7b14\:8bb0\:672c\:5185\:7684\:6a21\:578b\:4ee3\:7801 *)",
               "Input", CellLabel -> "In[1246]:=", ExpressionUUID ->
                "9b8e6ee6-4e63-0644-b2a9-2549f5f931f3"]}, Open]]}, Open]],
        Cell[CellGroupData[
          {Cell["5A.2 \:8fd0\:884c FeynRules \:5e76\:68c0\:67e5\:9876\:89d2",
            "Subsection", ExpressionUUID ->
             "332564a8-65ed-6940-ae2d-80fc66281675"], Cell["\:9884\:671f\
\:6709\:4e24\:6761\:6807\:91cf\:9876\:89d2 i \
