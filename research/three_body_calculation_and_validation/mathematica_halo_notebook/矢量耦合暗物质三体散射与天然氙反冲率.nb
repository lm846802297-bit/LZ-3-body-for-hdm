             "8a5ce5b8-3f83-0646-9f44-e2fc31cdc92c"], Cell["(* Independent \
kernel: patched FeynArts is kept inside this project. \
*)\nworkDir=DirectoryName[$InputFileName];projectDir=DirectoryName[workDir];\
\nFeynCalc`$FeynArtsDirectory=FileNameJoin[{workDir,\"FeynArtsPatched\"}];\ns\
ourceModel=FileNameJoin[{workDir,\"ThreeBodyVV.fr\"}];\nhashFile=FileNameJoin\
[{workDir,\"generated_model_source_sha256.txt\"}];\nIf[!FileExistsQ[sourceMod\
el]||!FileExistsQ[hashFile]||ToLowerCase[FileHash[sourceModel,\"SHA256\",\"He\
xString\"]]=!=StringTrim[Import[hashFile,\"Text\"]],\n Print[\"FeynRules \
source changed since FeynArts model generation; regenerate and patch the \
model \
first.\"];Exit[2]];\n$LoadAddOns={\"FeynArts\"};$FeynCalcStartupMessages=Fals\
e;Get[\"FeynCalc`\"];\n$PrePrint=.;$FAVerbose=0;\ntop=CreateTopologies[0,2->3\
,ExcludeTopologies->{Tadpoles,SelfEnergies}];\nins=InsertFields[top,{F[1],F[3\
]}->{F[1],F[3],S[1]},Model->\"ThreeBodyVV_FA\",GenericModel->\"ThreeBodyVV_FA\
\",InsertionLevel->{Classes}];\nPrint[\"graphs=\",Length[ins]];\nfaamp=Create\
FeynAmp[ins,PreFactor->1];\nfcamp=FCFAConvert[faamp,IncomingMomenta->{p,P},Ou\
tgoingMomenta->{r,R,k},ChangeDimension->4,List->False,DropSumOver->True];\nPr\
int[\"FCAMP=\",ToString[InputForm[fcamp],PageWidth->Infinity]];\n(* Match the \
main calculation: the outgoing-emission chi2 line carries the pole width. \
*)\nfcamp=fcamp /. \
HoldPattern[FeynAmpDenominator[PropagatorDenominator[Momentum[-k-r],MChiTwo]]\
] :>\n 1/(Pair[Momentum[k+r],Momentum[k+r]]-MChiTwo^2+I MChiTwo \
gammaWidth);\nIf[FreeQ[fcamp,gammaWidth],Print[\"Pole-width insertion \
failed.\"];Exit[3]];\nPrint[\"FCAMP_WITH_POLE_WIDTH=\",ToString[InputForm[fca\
mp],PageWidth->Infinity]];\nPrint[\"Starting finite-width spin \
sum...\"];\nsq=FermionSpinSum[fcamp \
(ComplexConjugate[fcamp]/.Conjugate[gammaWidth]->gammaWidth)]/4;\nPrint[\"Spi\
n sum generated; \
bytecount=\",ByteCount[sq]];\nresult=Contract[DiracSimplify[sq,DiracTraceEval\
uate->True]];\nPrint[\"Dirac trace evaluated; \
bytecount=\",ByteCount[result]];\nPrint[\"Expanding \
denominators...\"];\nexpr=FeynAmpDenominatorExplicit[result];\nPrint[\"Denomi\
nators expanded bytes=\",ByteCount[expr],\" \
remaining=\",Length[Cases[expr,_FeynAmpDenominator,Infinity]]];\n(* \
INSERT_NOTEBOOK_ENGINE *)\n(* Exact speed conversion avoids loss of precision \
in TeV minus keV differences. *)\n(* INSERT_NOTEBOOK_NINTEGRATE \
*)\nprec=50;\nargs=Rest[$ScriptCommandLine];\nIf[Length[args]==10,\n \
{m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[Rationalize[ToExpression[#],0],prec]& /@ \
args,\n {m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[#,prec]& /@ \
{1000,3/10000,1/1000,131*93149410242/10^11,1/5000,776,10,1,1,1}\n];\nIf[!True\
Q[m>0&&ms>=0&&dm>=0&&ma>0&&er>0&&0<v<299792458/1000&&mv>0&&cX!=0&&cS!=0&&cN!=\
0],Print[\"Invalid input or zero coupling; comparison \
aborted.\"];Exit[2]];\nPrint[\"Inputs m,ms,dm,mA,ER,v,mV,g1,g2,gN: \
\",N[{m,ms,dm,ma,er,v,mv,cX,cS,cN},10]];\nwidthGeV=Chi2Width[m,ms,dm,cS];\nPr\
int[\"Pole width GeV=\",N[widthGeV,12],\"; pointlike Dirac target; no AFH \
response.\"];\nkin=niKinematics[m,ms,ma,er,v,N[2/5,prec],N[1/4,prec],N[6/5,pr\
ec]];\nIf[kin===$Failed,Print[\"Phase space \
closed.\"];Exit[2]];\nIf[!TrueQ[(m+ms)^2+kin[\"delta\"]<(m+dm)^2],Print[\"On-\
shell pole accessible: off-shell calculation is \
invalid.\"];Exit[2]];\npin=kin[\"pin\"];pout=kin[\"pout\"];kvec=kin[\"k\"];Pt\
ar={ma,0,0,0};Rtar=Ptar+Join[{er},kin[\"qvec\"]];\nvecs={p->pin,r->pout,k->kv\
ec,P->Ptar,R->Rtar};\nmuDot[a_,b_]:=a[[1]]b[[1]]-a[[2;;4]].b[[2;;4]];\nmoment\
umValue[a_]:=a/.vecs;\nnum=expr/.{HoldPattern[Pair[Momentum[a_],Momentum[b_]]\
]:>muDot[momentumValue[a],momentumValue[b]],MChiOne->m,MChiTwo->m+dm,MNuc->ma\
,MMed->mv,gammaWidth->widthGeV,gc1->cS,gc2->cS,gc3->cX,gc4->cX,gc5->cN};\nPri\
nt[\"Unresolved FeynCalc objects: \
\",Length[Cases[num,_Pair|_FeynAmpDenominator|_DiracTrace,Infinity]]];\nPrint\
[\"FeynCalc amplitude squared: \
\",N[num,18]];\nmat=id;gam={g0,g1,g2,g3};g0=First[gam];et={1,-1,-1,-1};sl=sla\
sh;\nd1=muDot[pin-kvec,pin-kvec]-(m+dm)^2;d2=kin[\"w2\"]-(m+dm)^2+I (m+dm) \
widthGeV;\nch=Table[gam[[i]].(sl[pin-kvec]+(m+dm)mat)/d1+(sl[pout+kvec]+(m+dm\
)mat).gam[[i]]/d2,{i,4}];\nL=Table[Tr[(sl[pout]+m mat).ch[[i]].(sl[pin]+m \
mat).g0.ConjugateTranspose[ch[[j]]].g0]/2,{i,4},{j,4}];\nH=Table[Tr[(sl[Rtar]\
+ma mat).gam[[i]].(sl[Ptar]+ma \
mat).gam[[j]]]/2,{i,4},{j,4}];\nman=Re[Sum[et[[i]]et[[j]] \
L[[i,j]]H[[i,j]],{i,4},{j,4}]]*(cX*cS*cN)^2/(mv^2+2ma \
er)^2;\nPrint[\"Independent gamma-matrix amplitude squared: \
\",N[man,18]];\nPrint[\"relative difference: \
\",N[num/man-1,8]];\nIf[!NumericQ[num]||Abs[N[num/man-1]]>10^-8,Exit[3]];Prin\
t[\"FULL POINT \
PASS\"];Clear[fcFullME2,fcFullWeight];\nfcFullME2[u_?NumericQ,z_?NumericQ,phi\
_?NumericQ]:=Module[{x,pIn,pOut,kOut,pT,rT,vs,momf},\n \
x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];\n \
pIn=x[\"pin\"];pOut=x[\"pout\"];kOut=x[\"k\"];pT={ma,0,0,0};rT=pT+Join[{er},x\
[\"qvec\"]];\n vs={p->pIn,r->pOut,k->kOut,P->pT,R->rT};momf[a_]:=a/.vs;\n \
expr/.{HoldPattern[Pair[Momentum[a_],Momentum[b_]]]:>muDot[momf[a],momf[b]],M\
ChiOne->m,MChiTwo->m+dm,MNuc->ma,MMed->mv,gammaWidth->widthGeV,gc1->cS,gc2->c\
S,gc3->cX,gc4->cX,gc5->cN}\n];\nfcFullWeight[u_?NumericQ,z_?NumericQ,phi_?Num\
ericQ]:=Module[{x},\n \
x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];\n x[\"jac\"] \
x[\"phase\"] fcFullME2[u,z,phi]/(2 \
Pi)\n];\nincomingMomentum=m*(v/(299792458/1000))/Sqrt[1-(v/(299792458/1000))^\
2];\nPrint[\"Integrating full FeynCalc point-fermion \
target...\"];\nfullSigma=NIntegrate[fcFullWeight[u,z,phi],{u,0,1},{z,-1,1},{p\
hi,0,2Pi},WorkingPrecision->35,AccuracyGoal->6,PrecisionGoal->6,MaxRecursion-\
>7,Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0}]/(1024 Pi^3 ma \
incomingMomentum^2);\nstaticI6=niI6[m,ms,dm,ma,er,v,widthGeV,AccuracyGoal->6,\
PrecisionGoal->6,MaxRecursion->8];\nstaticSigma=ma*staticI6*(cX*cS*cN)^2/(256 \
Pi^3 incomingMomentum^2*(mv^2+2ma er)^2);\nPrint[\"FULL FEYNCALC dsigma \
GeV^-3=\",N[fullSigma,15]];\nPrint[\"FULL FEYNCALC dsigma \
cm2/keV=\",N[fullSigma*3893793721/10^43,15]];\nPrint[\"STATIC NOTEBOOK R=1 \
dsigma GeV^-3=\",N[staticSigma,15]];\nPrint[\"full/static - \
1=\",N[fullSigma/staticSigma-1,10]];\nIf[!NumericQ[fullSigma]||!NumericQ[stat\
icSigma]||!TrueQ[fullSigma>0],Exit[5]];\nExit[0];\n\n\n\n", "Program",
