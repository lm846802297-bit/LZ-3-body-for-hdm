          "719f4e53-46dd-1149-9411-86ee31b98c5b"], Cell["\:27e8d\[Sigma]/dER\
\:27e9 = \[Sum]A \[Eta]A \[Integral]vmin,A^vmax F(v) [d\[Sigma]A(v)/dER] dv",
         "Text", ExpressionUUID -> "ac7701b0-c9d1-c54f-81ea-859c6ff1c24c"],
        Cell[CellGroupData[{Cell["Clear[SpeedAveragedCrossSection, \
NaturalAveragedCrossSection];\nSpeedAveragedCrossSection[a_Integer, \
er_?NumericQ, ms_?NumericQ, dm_?NumericQ, p_Association] := Module[\n  {vmin, \
vmax, opt, integrand}, (* \
\:8bbe\:7f6e\:901f\:5ea6\:4e0a\:4e0b\:9650\:548c\:79ef\:5206\:9009\:9879 *)\n \
 vmin = VMin[p[\"mchi\"], ms, Global`XeNuclearMassGeV[a], er*10^-6]; (* \
\:8be5\:540c\:4f4d\:7d20\:7684\:9608\:503c\:ff0ckm/s *)\n  vmax = \
p[\"vEarth\"] + p[\"vEsc\"]; (* \
\:5730\:7403\:7cfb\:6700\:5927\:901f\:5ea6\:ff0ckm/s *)\n  If[vmin >= vmax, \
Return[0.]]; (* \:65e0\:53ef\:7528\:901f\:5ea6\:65f6\:622a\:9762\:4e3a\:96f6 \
*)\n  opt = p[\"nv\"]; (* \
\:4f7f\:7528\:4e3b\:8ba1\:7b97\:4e2d\:7684\:901f\:5ea6\:79ef\:5206\:8bbe\
\:7f6e *)\n  integrand[v_?NumericQ] := \
SpeedPDF[v,p[\"v0\"],p[\"vEarth\"],p[\"vEsc\"]] \
DifferentialCrossSection[a,er,v,ms,dm,p]; (* \
\:6982\:7387\:5bc6\:5ea6\:4e58\:5fae\:5206\:622a\:9762 *)\n  \
NIntegrate[integrand[v],{v,vmin,vmax},Method->{\"GlobalAdaptive\",\"SymbolicP\
rocessing\"->0}, \
AccuracyGoal->opt[\"AccuracyGoal\"],PrecisionGoal->opt[\"PrecisionGoal\"],Max\
Recursion->opt[\"MaxRecursion\"]] (* \:666e\:901a\:901f\:5ea6\:5e73\:5747 \
*)\n];\nNaturalAveragedCrossSection[er_?NumericQ,ms_?NumericQ,dm_?NumericQ,p_\
Association] := Total[Table[p[\"abundance\"][a] \
SpeedAveragedCrossSection[a,er,ms,dm,p],{a,p[\"isotopes\"]}]]; (* \
\:5404\:540c\:4f4d\:7d20\:6570\:76ee\:4e30\:5ea6\:52a0\:6743 \
*)\nPrint[\"\:5df2\:5b9a\:4e49\:5355\:540c\:4f4d\:7d20\:53ca\:5929\:7136\
