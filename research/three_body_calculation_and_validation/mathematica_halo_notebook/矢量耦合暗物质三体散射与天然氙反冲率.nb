\:8f93\:51fa\:ff1b\:5177\:4f53\:5b9e\:73b0\:4f4d\:4e8e\:4e0b\:65b9 \
*)\n\nSpeedPDF::usage=\"SpeedPDF[v,v0,ve,vesc] is the normalized truncated \
lab speed PDF.\";  (* \
\:4f7f\:7528\:5b9e\:9a8c\:5ba4\:7cfb\:901f\:5ea6\:5206\:5e03 \
*)\n\nRate::usage=\"Rate[erKeV,ms,dm,parameters] returns events/(tonne year \
keV).\";  (* \
\:8bf4\:660e\:6b64\:51fd\:6570\:7684\:7528\:9014\:3001\:8f93\:5165\:548c\
\:8f93\:51fa\:ff1b\:5177\:4f53\:5b9e\:73b0\:4f4d\:4e8e\:4e0b\:65b9 \
*)\n\nMakeCurves::usage=\"MakeCurves[energies,benchmarks,parameters] \
evaluates every curve.\";  (* \
\:8bf4\:660e\:6b64\:51fd\:6570\:7684\:7528\:9014\:3001\:8f93\:5165\:548c\
\:8f93\:51fa\:ff1b\:5177\:4f53\:5b9e\:73b0\:4f4d\:4e8e\:4e0b\:65b9 *)\n\n",
               "Input", CellTags -> "inlineEngine", CellLabel -> "In[909]:=",
               ExpressionUUID -> "710b8f54-a1a9-d647-b6ca-a47180fac000"]},
             Open]], Cell[CellGroupData[
             {Cell["\:8f85\:52a9\:51fd\:6570\:51c6\:5907", "Subsubsection",
               ExpressionUUID -> "b1e3e1f9-ed1b-6648-bf93-d98200a8b814"],
              Cell["\:4e0b\:9762\:4f9d\:6b21\:5b9a\:4e49\:6a21\:578b\:4f7f\
\:7528\:7684\:8f85\:52a9\:51fd\:6570\:548c\:8ba1\:7b97\:51fd\:6570\:3002\
\:6309\:987a\:5e8f\:8fd0\:884c\:5355\:5143\:5373\:53ef\:3002", "Text",
               ExpressionUUID -> "30539d89-6390-674d-b7d7-4e1ec98774ca"],
              Cell["(* \
\:51fd\:6570\:76f4\:63a5\:5728\:7b14\:8bb0\:672c\:4e2d\:5b9a\:4e49\:3002 *)",
               "Input", CellTags -> "inlineEngine", CellLabel -> "In[928]:=",
               ExpressionUUID -> "7b12fa26-0d68-034c-8b95-9b46ac22b926"]},
             Open]], Cell[CellGroupData[{Cell["\:5e38\:6570\:3001\:79ef\:5206\
\:8282\:70b9\:4e0e\:56db\:52a8\:91cf\:5de5\:5177", "Subsubsection",
               ExpressionUUID -> "907f1256-37e9-e84b-ab91-5f1524c20aa6"],
              Cell["\:5efa\:7acb\:5355\:4f4d\:6362\:7b97\:3001\:5bf9\:7167\
\:7528 Gauss \:8282\:70b9\:3001\:56db\:77e2\:91cf\:548c Dirac \
\:77e9\:9635\:3002", "Text", ExpressionUUID ->
                "2ec0effc-13c3-f64d-bffd-7c693de538eb"], Cell["cKm=299792.458\
;  (* \:5149\:901f\:ff0c\:5355\:4f4d \
km/s\:ff0c\:7528\:4e8e\:901f\:5ea6\:8f6c\:6210 v/c *)\n cCm=2.99792458*10^10; \
 (* \:5149\:901f\:ff0c\:5355\:4f4d \
cm/s\:ff0c\:7528\:4e8e\:7c92\:5b50\:901a\:91cf\:6362\:7b97 *)\n \
GeV2cm2=0.3893793721*10^-27;  (* \:5c06\:81ea\:7136\:5355\:4f4d GeV^-2 \
\:6362\:7b97\:4e3a cm\262 *)\n\n(* GL weights from Jacobi matrix. The angular \
phi weights sum to one. \
*)\ngl[n_Integer?Positive]:=gl[n]=Module[{b,vals,vec,order},\n \
b=Table[k/Sqrt[4. k^2-1.],{k,1,n-1}];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\n\n \
{vals,vec}=Eigensystem[DiagonalMatrix[b,1]+DiagonalMatrix[b,-1]];  (* Jacobi \
\:77e9\:9635\:7684\:672c\:5f81\:503c\:662f Gauss \
\:8282\:70b9\:ff0c\:672c\:5f81\:5411\:91cf\:7528\:4e8e\:8ba1\:7b97\:6743\
\:91cd *)\n\n order=Ordering[vals];  (* \
\:6309\:8282\:70b9\:5927\:5c0f\:6392\:5e8f *)\n Transpose[{vals[[order]],2 \
(vec[[order,1]])^2}]];  (* \
\:8fd4\:56de\:6709\:5e8f\:7684\:8282\:70b9\:548c\:5bf9\:5e94\:6743\:91cd \
*)\n\nmdot[a_,b_]:=a[[1]] b[[1]]-a[[2;;4]].b[[2;;4]];  (* \
\:8ba1\:7b97\:56db\:77e2\:91cf\:70b9\:79ef\:ff0c\:5ea6\:89c4\:53d6 \
(+,\[Minus],\[Minus],\[Minus]) \
*)\n\nboost[a_,beta_]:=Module[{b2=beta.beta,g,p},\n If[b2<10^-30,Return[a]];  \
(* \
\:901f\:5ea6\:63a5\:8fd1\:96f6\:65f6\:76f4\:63a5\:8fd4\:56de\:539f\:56db\
\:77e2\:91cf *)\n If[b2>=1,Throw[\"Invalid boost\"]];  (* \
\:8d85\:5149\:901f\:4e0d\:662f\:6709\:6548\:7684\:6d1b\:4f26\:5179\:53d8\
\:6362\:ff0c\:505c\:6b62\:8ba1\:7b97 *)\n\n g=1/Sqrt[1-b2];  (* \
\:8ba1\:7b97\:6d1b\:4f26\:5179\:56e0\:5b50 \[Gamma] *)\n p=a[[2;;4]].beta;  \
(* \
\:8ba1\:7b97\:56db\:52a8\:91cf\:7a7a\:95f4\:90e8\:5206\:4e0e\:53d8\:6362\
\:901f\:5ea6\:7684\:70b9\:79ef *)\n\n \
Join[{g(a[[1]]+p)},a[[2;;4]]+(((g-1)p/b2)+g a[[1]]) beta]];  (* \
\:8f93\:51fa\:6d1b\:4f26\:5179\:53d8\:6362\:540e\:7684\:56db\:52a8\:91cf \
*)\n\ni2=IdentityMatrix[2];  (* \:5b9a\:4e49 2\[Times]2 \
\:5355\:4f4d\:77e9\:9635 *)\nz2=ConstantArray[0,{2,2}];  (* \:5b9a\:4e49 \
2\[Times]2 \:96f6\:77e9\:9635 *)\n\ns1={{0,1},{1,0}};  (* \
\:5b9a\:4e49\:7b2c\:4e00\:6ce1\:5229\:77e9\:9635 \[Sigma]1 \
*)\ns2={{0,-I},{I,0}};  (* \:5b9a\:4e49\:7b2c\:4e8c\:6ce1\:5229\:77e9\:9635 \
\[Sigma]2 *)\ns3={{1,0},{0,-1}};  (* \
\:5b9a\:4e49\:7b2c\:4e09\:6ce1\:5229\:77e9\:9635 \[Sigma]3 \
*)\n\ng0=ArrayFlatten[{{i2,z2},{z2,-i2}}];  (* \
\:7531\:6ce1\:5229\:77e9\:9635\:6784\:9020 \[Gamma]0 \
*)\n\ng1=ArrayFlatten[{{z2,s1},{-s1,z2}}];  (* \
\:7531\:6ce1\:5229\:77e9\:9635\:6784\:9020 \
\[Gamma]1\:ff1b\:4e0d\:662f\:8026\:5408 g1val \
*)\n\ng2=ArrayFlatten[{{z2,s2},{-s2,z2}}];  (* \
\:7531\:6ce1\:5229\:77e9\:9635\:6784\:9020 \
\[Gamma]2\:ff1b\:4e0d\:662f\:8026\:5408 g2val \
*)\n\ng3=ArrayFlatten[{{z2,s3},{-s3,z2}}];  (* \
\:7531\:6ce1\:5229\:77e9\:9635\:6784\:9020 \[Gamma]3 *)\n \
id=IdentityMatrix[4];  (* \:5b9a\:4e49 4\[Times]4 \:5355\:4f4d\:77e9\:9635 \
*)\n\nslash[p_]:=g0 p[[1]]-g1 p[[2]]-g2 p[[3]]-g3 p[[4]];  (* \
\:6309\:6b63\:8d1f\:8d1f\:8d1f\:5ea6\:89c4\:5b9a\:4e49 Dirac \:659c\:6760 \
p\:0338 *)\n\n", "Input", CellTags -> "inlineEngine", CellLabel ->
                "In[929]:=", ExpressionUUID ->
                "4022b111-45f2-984f-8eb1-7d2948a73a40"]}, Open]],
           Cell[CellGroupData[{Cell["\:4e24\:5f20\:8f90\:5c04\:56fe\:7684\
\:632f\:5e45\:4e0e\:81ea\:65cb\:8ff9", "Subsubsection", ExpressionUUID ->
                "4a77e30d-5bc7-1a4a-a06c-5b529feb5e3a"], Cell["\:8ba1\:7b97\
\:6807\:91cf\:5728\:76f8\:4e92\:4f5c\:7528\:524d\:540e\:8f90\:5c04\:7684\
\:4e24\:9879\:53ca\:5176\:5e72\:6d89\:ff1b\:53ea\:4fdd\:7559\:6838\:6d41\
\:65f6\:95f4\:5206\:91cf\:3002", "Text", ExpressionUUID ->
                "a4c88a0a-9e5f-0146-8425-617ce7d70f4c"], Cell["trace[pin_,pp_\
,k_,m_,m2_,w2_,width_]:=Module[{d1,d2,gb,ga,g,bar},\n (* As in the \
manuscript: only the after-emission denominator has i m2 Gamma. *)\n \
d1=mdot[pin-k,pin-k]-m2^2;  (* \
\:8ba1\:7b97\:81ea\:65cb\:5e73\:5747\:7684\:4e24\:56fe\:632f\:5e45\:5e73\
\:65b9 *)\nd2=w2-m2^2+I m2 width;  (* \:8f90\:5c04\:540e \[Chi]2 \
\:4f20\:64ad\:5b50\:5206\:6bcd\:ff0c\:542b i m\[Chi]2 \[CapitalGamma]\[Chi]2 \
*)\n\n If[Abs[d1]<10^-12 || Abs[d2]<10^-12,Throw[\"Propagator pole or invalid \
kinematics\"]];  (* \
\:82e5\:5206\:6bcd\:8fc7\:5c0f\:5219\:505c\:6b62\:ff0c\:907f\:514d\:6570\
\:503c\:5947\:5f02 *)\n\n gb=g0.(slash[pin-k]+m2 id)/d1;  (* \
\:6784\:9020\:8f90\:5c04\:524d\:7684\:6697\:7269\:8d28\:77e9\:9635\:94fe\
\:53ca\:4f20\:64ad\:5b50 *)\n\n ga=(slash[pp+k]+m2 id).g0/d2;  (* \
\:6784\:9020\:8f90\:5c04\:540e\:7684\:6697\:7269\:8d28\:77e9\:9635\:94fe\
\:53ca\:4f20\:64ad\:5b50 *)\n\n g=gb+ga;  (* \
\:76f8\:52a0\:4e24\:5f20\:8d39\:66fc\:56fe\:7684\:77e9\:9635\:94fe\:ff0c\
\:5e72\:6d89\:9879\:968f\:540e\:4ea7\:751f \
*)\nbar=g0.ConjugateTranspose[g].g0;  (* \
\:6784\:9020\:4e24\:56fe\:603b\:77e9\:9635\:94fe\:7684 Dirac \:5171\:8f6d \
*)\n\n Re[Tr[(slash[pp]+m id).g.(slash[pin]+m id).bar]]/2];  (* \
\:6c42\:4e24\:56fe\:76f8\:5e72\:632f\:5e45\:7684\:81ea\:65cb\:8ff9\:ff0c\
\:5e76\:5bf9\:521d\:6001\:81ea\:65cb\:5e73\:5747 *)\n\n", "Input",
               CellTags -> "inlineEngine", CellLabel -> "In[959]:=",
               ExpressionUUID -> "1717197e-f293-5b40-ad79-6196b2198ef5"]},
             Open]], Cell[CellGroupData[{Cell["Gauss \
\:5bf9\:7167\:4ee3\:7801\:79fb\:81f3\:6700\:540e\:7684\:9a8c\:8bc1\:90e8\
\:5206", "Subsubsection", ExpressionUUID ->
                "516bb9de-b283-3c41-97a3-88b7d3228d61"], Cell["Gauss \
\:6c42\:79ef\:5b9e\:73b0\:53ea\:4f5c\:4e3a\:540e\:9762\:7684\:9a8c\:8bc1\
\:5bf9\:7167\:ff1b\:4e3b\:8ba1\:7b97\:76f4\:63a5\:5728 NIntegrate \
\:90e8\:5206\:5b9a\:4e49 \
I6\:3002\:4e3a\:517c\:5bb9\:72ec\:7acb\:5b50\:5185\:6838\:ff0c\:65e7\:6e90\
\:7801\:53e6\:4ee5\:9690\:85cf\:7a0b\:5e8f\:5355\:5143\:4fdd\:7559\:3002",
               "Text", ExpressionUUID ->
                "3938ecb0-3399-3e4f-8273-73279941e776"], Cell["I6[m_?NumericQ\
,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,order_List,w\
idth_?NumericQ]:=Module[\n \
{beta,lor,ee,pz,qq,wlo,whi,pin,quadrW,quadrZ,quadrP,sum=0.,w2,weight,cq,q,K,b\
K,ps,e3,ref,e1,e2,lam,W,kabs,Ek,Ep,z,phi,n,k,pp,ang,pa,m2},\n \
If[!NumericQ[width] || !TrueQ[width>=0],Throw[\"Invalid constant pole \
width\"]];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n \
If[er<=0 || v<=0,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n \
beta=v/cKm;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nlor=1/Sqrt[1-beta^2];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nee=m lor;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\npz=m lor beta;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nqq=Sqrt[2 mA er+er^2];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)\n\n \
wlo=(m+ms)^2;  (* \
\:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0b\:9650 \
*)\nwhi=m^2+2 pz qq-2(ee+mA)er;  (* \
\:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0a\:9650 \
*)\n\n If[whi<=wlo,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n m2=m+dm;  \
(* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf *)\n\n \
If[whi>=m2^2,Throw[\"On-shell chi2 accessible: off-shell calculation \
aborted\"]];  (* \
\:68c0\:67e5\:6fc0\:53d1\:6001\:4f20\:64ad\:5b50\:7684\:9002\:7528\:6761\
\:4ef6 *)\n\n pin={ee,0.,0.,pz};  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nquadrW=gl[order[[1]]];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\nquadrZ=gl[order[[2]]];  (* \
\:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd \
*)\nquadrP=gl[order[[3]]];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\n\n Do[\n  \
w2=(whi+wlo)/2+(whi-wlo)node[[1]]/2;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nweight=node[[2]](whi-wlo)/2;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  cq=Clip[(w2-m^2+2(ee+mA)er)/(2 pz qq),{-1.,1.}];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)\n\n  \
q={er,qq Sqrt[Max[0.,1-cq^2]],0.,qq cq};  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf \
*)\nK=pin-q;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nbK=K[[2;;4]]/K[[1]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  ps=boost[pin,-bK];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\ne3=Normalize[ps[[2;;4]]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nref=If[Abs[e3[[1]]]>.9,{0.,1.,0.},{1.,0.,0.}];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  e1=Normalize[Cross[ref,e3]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\ne2=Cross[e3,e1];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  lam=Max[0.,(w2-(m+ms)^2)(w2-(m-ms)^2)];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n W=Sqrt[w2];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  kabs=Sqrt[lam]/(2 W);  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nEk=(w2-m^2+ms^2)/(2 W);  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nEp=(w2+m^2-ms^2)/(2 W);  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n  ang=0.;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nDo[z=zn[[1]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\npa=0.;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nDo[phi=Pi(pn[[1]]+1);  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n   n=z e3+Sqrt[Max[0.,1-z^2]](Cos[phi] e1+Sin[phi] e2);  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n   k=boost[Join[{Ek},kabs n],bK];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\npp=boost[Join[{Ep},-kabs n],bK];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n   pa+=pn[[2]]/2 trace[pin,pp,k,m,m2,w2,width],{pn,quadrP}];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n   ang+=zn[[2]] \
pa,{zn,quadrZ}];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 \
*)\n\n  sum+=weight Sqrt[lam]/w2 ang,{node,quadrW}];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\nsum];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n", "Program", CellOpen -> False, CellTags -> "inlineEngine",
               ExpressionUUID -> "6468a938-d801-4b49-8999-ca09fbed0fe7"]},
             Open]], Cell[CellGroupData[
             {Cell["\:6fc0\:53d1\:6001\:8870\:53d8\:5bbd\:5ea6 Chi2Width",
               "Subsubsection", ExpressionUUID ->
                "ef0f40ed-c8f4-864e-a72b-f318aa2b30e1"], Cell["\:8ba1\:7b97 \
chi2 \[RightArrow] chi1+s \
\:7684\:7eaf\:6807\:91cf\:90e8\:5206\:5bbd\:5ea6\:ff1b\:8d28\:91cf\:7edf\
\:4e00\:4e3a \
GeV\:3002\:95ed\:5408\:6216\:6070\:5904\:9608\:503c\:65f6\:8fd4\:56de\:96f6\
\:3002\:56e0\:5f0f\:5206\:89e3\:907f\:514d\:5927\:8d28\:91cf\:76f8\:51cf\
\:635f\:5931\:7cbe\:5ea6\:3002", "Text", ExpressionUUID ->
                "1ddfe37d-d5f1-a846-b4f1-e1f3b3aedf3e"], Cell["(* Factorized \
Kallen function avoids loss of precision for TeV masses and keV splittings.\n \
  Assumptions: Dirac fermions, pure scalar Yukawa g2 s chibar2 chi1,\n   one \
open decay channel. The returned partial width is used as the total width. \
*)\nChi2Width[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,g_?NumericQ]:=Module[{m2,\
phase,heavy},\n If[!TrueQ[m>0 && ms>=0 && dm>=0],Throw[\"Invalid masses in \
Chi2Width\"]];  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:90e8\:5206\:5bbd\:5ea6 \
*)\n\n If[dm<=ms,Return[0.]];  (* \
\:8870\:53d8\:9608\:503c\:672a\:6253\:5f00\:65f6\:5bbd\:5ea6\:4e3a\:96f6 \
*)\n\n m2=m+dm;  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf \
*)\nphase=dm^2-ms^2;  (* \
\:8ba1\:7b97\:8d28\:91cf\:5288\:88c2\:5bf9\:5e94\:7684\:9608\:503c\:56e0\
\:5b50 *)\nheavy=(2 m+dm)^2-ms^2;  (* \
\:8ba1\:7b97\:8d28\:91cf\:548c\:5bf9\:5e94\:7684\:8fd0\:52a8\:5b66\:56e0\
\:5b50 *)\n\n Abs[g]^2 Sqrt[phase] heavy^(3/2)/(16 Pi m2^3)];  (* \
\:8ba1\:7b97 \[Chi]2\[RightArrow]\[Chi]1 s \
\:7684\:6781\:70b9\:90e8\:5206\:8870\:53d8\:5bbd\:5ea6 *)\n\n", "Input",
               CellTags -> "inlineEngine", CellLabel -> "In[962]:=",
               ExpressionUUID -> "98aa30df-804b-0843-b2bd-51c4eadb5b9e"]},
             Open]], Cell[CellGroupData[
             {Cell["\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\:5206\:5e03",
               "Subsubsection", ExpressionUUID ->
                "c4d627ff-2a78-be40-b557-c4f1469b08a5"], Cell["\:8ba1\:7b97\
\:6700\:5c0f\:5165\:5c04\:901f\:5ea6\:548c\:622a\:65ad\:901f\:5ea6\:5206\
\:5e03\:3002", "Text", ExpressionUUID ->
                "e7177ced-81d6-0540-b95e-de3b21b9c677"], Cell["VMin[m_,ms_,mA\
_,er_]:=Module[{q,a},If[er<=0,Return[Infinity]];  (* \
\:5b9a\:4e49\:4ea7\:751f\:6307\:5b9a\:53cd\:51b2\:80fd\:91cf\:6240\:9700\
\:7684\:6700\:5c0f\:5165\:5c04\:901f\:7387 *)\n\n q=Sqrt[2 mA er+er^2];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf \
*)\na=ms+(mA er+ms^2/2)/m;  (* \
\:5b9a\:4e49\:6c42\:89e3\:6700\:4f4e\:901f\:7387\:65f6\:4f7f\:7528\:7684\
\:8fd0\:52a8\:5b66\:7ec4\:5408 *)\n\n cKm (q er+a \
Sqrt[q^2-er^2+a^2])/(q^2+a^2)];  (* \:5c06\:6700\:4f4e\:901f\:7387 \[Beta]min \
\:6362\:6210 km/s *)\n\nSpeedPDF[v_,v0_,ve_,vesc_]:=Module[{z,n,b},\n If[v<0 \
|| v>=vesc+ve,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n \
z=vesc/v0;  (* \
\:8ba1\:7b97\:9003\:9038\:901f\:5ea6\:4e0e\:901f\:5ea6\:5c3a\:5ea6\:4e4b\
\:6bd4 *)\nn=Erf[z]-2 z Exp[-z^2]/Sqrt[Pi];  (* \:8ba1\:7b97\:622a\:65ad \
Maxwell \:901f\:7387\:5206\:5e03\:7684\:5f52\:4e00\:5316\:56e0\:5b50 *)\n\n \
b=If[v<vesc-ve,Exp[-((v-ve)/v0)^2]-Exp[-((v+ve)/v0)^2],Exp[-((v-ve)/v0)^2]-Ex\
p[-z^2]];  (* \
\:6309\:901f\:5ea6\:533a\:95f4\:8ba1\:7b97\:5730\:7403\:7cfb\:622a\:65ad\
\:901f\:7387\:5206\:5e03 *)\n\n v b/(Sqrt[Pi] v0 ve n)];  (* \
\:8fd4\:56de\:6bcf km/s \
\:7684\:5f52\:4e00\:5316\:901f\:7387\:6982\:7387\:5bc6\:5ea6 *)\n\n",
               "Input", CellTags -> "inlineEngine", CellLabel -> "In[966]:=",
               ExpressionUUID -> "114a4236-b96b-3043-98e3-3282e4295a73"]},
             Open]], Cell[CellGroupData[{Cell["AFH \:6838\:54cd\:5e94",
               "Subsubsection", ExpressionUUID ->
                "0a87e86d-6143-a84b-bff6-888af99c798e"], Cell["\:672c\:8282\
\:5bf9\:6bcf\:4e2a\:6c19\:540c\:4f4d\:7d20\:8bfb\:53d6 AFH \
\:9ed8\:8ba4\:5bc6\:5ea6\:77e9\:9635\:4e0b\:7684 M \
\:578b\:7b49\:6807\:91cf\:54cd\:5e94 W_M^00(y)\:3002\:4ee3\:7801\:4f7f\:7528 \
RA=A\262 W(y)/W(0)\:ff0c\:5f3a\:5236 \
RA(0)=A\262\:ff1b\:8fd9\:662f\:7b49\:8d28\:5b50\:3001\:4e2d\:5b50\:77e2\:91cf\
\:8026\:5408\:4e0b\:7684\:5f52\:4e00\:5316\:7ea6\:5b9a\:3002RA \
\:5df2\:5305\:542b\:76f8\:5e72\:589e\:5f3a\:4e0e\:6838 form \
factor\:ff0c\:4e0d\:5e94\:518d\:6b21\:4e58\:540c\:4e00\:4e2a\:6838 form \
factor\:3002\:5355\:6838\:5b50\:8026\:5408 gVN \
\:53d6\:5e38\:6570\:ff0c\:672a\:5355\:72ec\:8ba1\:5165\:6838\:5b50\:6709\
\:9650\:5c3a\:5bf8\:7684\:52a8\:91cf\:4f9d\:8d56\:3002", "Text",
               ExpressionUUID -> "550d8d40-7b0c-e842-88ae-dd50ad1900ee"],
              Cell["\:52a0\:8f7d\:5916\:90e8 AFH \
\:7a0b\:5e8f\:ff0c\:63d0\:53d6\:5e76\:7f13\:5b58\:5404\:6c19\:540c\:4f4d\
\:7d20\:7684 M \:578b\:7b49\:6807\:91cf\:54cd\:5e94\:3002", "Text",
               ExpressionUUID -> "e3826cf5-b3b2-4b4a-9410-4c0789974f01"],
              Cell["(* Normalization R(0)=A^2 removes finite-precision \
density table offset. \
*)\nLoadResponses[path_String,isotopes_List]:=Module[{expr,aa,b},\n \
If[!FileExistsQ[path],Throw[\"AFH package missing\"]];  (* \
\:51c6\:5907\:5404\:540c\:4f4d\:7d20\:6838\:54cd\:5e94 *)\nGet[path];  (* \
\:52a0\:8f7d AFH \:539f\:7a0b\:5e8f *)\n\n Do[aa=iso;  (* \
\:9010\:4e2a\:9009\:62e9\:5929\:7136\:6c19\:540c\:4f4d\:7d20 \
*)\ndmformfactor`SetIsotope[54,aa,\"default\",\"default\"];  (* \
\:9009\:62e9\:6838\:7d20\:53ca\:5176\:6838\:5bc6\:5ea6 *)\n\n \
expr=dmformfactor`ResponseNuclear[Global`y,1,0,0];  (* \:63d0\:53d6 M \
\:578b\:6838\:54cd\:5e94 *)\n\n \
If[!NumericQ[N[expr/.Global`y->0]],Throw[\"AFH response failed\"]];  (* \
\:68c0\:67e5 AFH \
\:54cd\:5e94\:5728\:96f6\:52a8\:91cf\:5904\:80fd\:5426\:5f97\:5230\:6570\
\:503c *)\n\n b=5.0677 Sqrt[41.467/(45. aa^(-1./3.)-25. aa^(-2./3.))];  (* \
\:6309 AFH \:9ed8\:8ba4\:632f\:5b50\:53c2\:6570\:516c\:5f0f\:8ba1\:7b97 \
b\:ff0c\:5e76\:8f6c\:6210 GeV^-1 *)\n\n responseExpr[aa]=expr;  (* \
\:4fdd\:5b58\:8be5\:540c\:4f4d\:7d20\:7684\:5b8c\:6574 AFH \
\:54cd\:5e94\:8868\:8fbe\:5f0f *)\nresponseZero[aa]=N[expr/.Global`y->0];  (* \
\:4fdd\:5b58\:96f6\:52a8\:91cf\:54cd\:5e94\:ff0c\:7528\:4e8e\:5f52\:4e00\
\:5316 *)\nbInv[aa]=b,\n {iso,isotopes}];  (* \
\:7ed3\:675f\:5bf9\:540c\:4f4d\:7d20\:5217\:8868\:7684\:5faa\:73af \
*)\nisotopes];  (* \
\:8fd4\:56de\:5df2\:52a0\:8f7d\:7684\:540c\:4f4d\:7d20\:5217\:8868 \
*)\n\nresponse[a_,er_,mA_]:=a^2 N[responseExpr[a]/.Global`y->((Sqrt[2 mA \
er+er^2] bInv[a]/2)^2)]/responseZero[a];  (* \:8ba1\:7b97 A\262 \
W(y)/W(0)\:ff0c\:5305\:542b\:76f8\:5e72\:589e\:5f3a\:4e0e\:6838 form factor \
*)\n\n(* The recoil energy accepted by this public function is in keV. \
*)\nNuclearResponse[a_Integer, recoilKeV_?NumericQ] := \
Module[{nuclearMass},\n If[!TrueQ[recoilKeV >= 0], Throw[\"Recoil energy must \
be nonnegative\"]];  (* \
\:8ba1\:7b97\:8be5\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\
\:5e94 *)\n\n If[!ValueQ[responseZero[a]], Throw[\"Load the requested isotope \
before evaluating its response\"]];  (* \
\:5c1a\:672a\:52a0\:8f7d\:8be5\:540c\:4f4d\:7d20\:65f6\:505c\:6b62\:ff0c\
\:907f\:514d\:4f7f\:7528\:9519\:8bef\:7684\:6838\:54cd\:5e94 *)\n\n \
nuclearMass = Global`XeNuclearMassGeV[a];  (* \
\:7528\:8d28\:91cf\:6570\:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\
\:4f3c\:6838\:8d28\:91cf\:ff0c\:5355\:4f4d GeV *)\n\n response[a, \
recoilKeV*10^-6, nuclearMass]\n];  (* \
\:7ed3\:675f\:5f53\:524d\:6838\:54cd\:5e94\:51fd\:6570\:5b9a\:4e49 *)\n\n\n",
               "Input", CellTags -> "inlineEngine", CellLabel -> "In[971]:=",
               ExpressionUUID -> "7078d049-ab9f-d14f-9804-5c5877272c17"]},
             Open]], Cell[CellGroupData[
             {Cell["\:8ba1\:7b97\:6a21\:578b\:7684\:6781\:70b9\:5bbd\:5ea6",
               "Subsubsection", ExpressionUUID ->
                "5b567c16-9125-9749-ac54-313b6e9dc6ac"], Cell["\:6839\:636e\
\:8d28\:91cf\:548c g\:2082 \
\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6\:ff1b\:6b64\:5bbd\:5ea6\:53ea\:5305\
\:542b\:5df2\:5efa\:6a21\:7684\:8870\:53d8\:9053\:3002", "Text",
               ExpressionUUID -> "3b738c66-563d-8d48-a2ab-409e24943f19"],
              Cell["(* \
\:622a\:9762\:548c\:4e8b\:4ef6\:7387\:5171\:7528\:540c\:4e00\:6781\:70b9\
\:5bbd\:5ea6\:ff1b\:4e0d\:63d0\:4f9b\:96f6\:5bbd\:5ea6\:8ba1\:7b97\:5904\
\:65b9\:3002 *)\nwidthForParameters[mass_, scalarMass_, splitting_, \
params_Association] := Module[{mode},\n mode = Lookup[params, \"widthMode\", \
\"pole\"];  (* \:9ed8\:8ba4\:4e3a\:6781\:70b9\:5bbd\:5ea6 *)\n If[mode =!= \
\"pole\" || !KeyExistsQ[params, \"g2\"],\n  Throw[\"Only pole width is \
supported; g2 is required\"]];\n Chi2Width[mass, scalarMass, splitting, \
params[\"g2\"]]  (* \:6309\:8d28\:91cf\:548c g2 \:8ba1\:7b97\:5bbd\:5ea6 \
*)\n];", "Input", CellTags -> "inlineEngine", CellLabel -> "In[981]:=",
               ExpressionUUID -> "7d7f24eb-2e97-1048-bbc9-259ec607e9ab"]},
             Open]], Cell[CellGroupData[
             {Cell[
               "\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\:5206\:622a\:9762"\
, "Subsubsection", ExpressionUUID -> "24622ca2-2ee9-c04b-97e5-b48815867453"],
              Cell["\:5c06\:81ea\:65cb\:8ff9\:3001\:76f8\:7a7a\:95f4\:79ef\
\:5206\:3001\:4f20\:64ad\:5b50\:548c AFH \
\:6838\:54cd\:5e94\:5408\:6210\:4e3a\:56fa\:5b9a\:901f\:5ea6\:622a\:9762\
\:3002", "Text", ExpressionUUID -> "088af27f-1d33-ba41-a074-abadfb77b1f5"],
              Cell["(* Eq. (radiative-recoil): I6 includes dW^2, dz and the \
phi average.\n   Inputs are GeV except speedKms. The result is in GeV^-3. \
*)\nfixedSpeedCrossSection[nuclearMass_, recoilGeV_, speedKms_, mass_, \
scalarMass_,\n   splitting_, mediatorMass_, couplingSquared_, orders_, \
width_, nuclearResponse_] :=\n Module[{beta, incomingMomentum, \
mediatorDenominator, integral},\n  If[!TrueQ[0 < speedKms < cKm], \
Throw[\"Fixed-speed cross section requires 0 < v < c\"]];  (* \
\:68c0\:67e5\:8f93\:5165\:901f\:5ea6\:5728 0 \:4e0e\:5149\:901f\:4e4b\:95f4 \
*)\n\n  beta = speedKms/cKm;  (* \:5c06\:8f93\:5165\:901f\:5ea6 km/s \
\:8f6c\:6362\:4e3a\:65e0\:91cf\:7eb2 v/c *)\n\n  incomingMomentum = \
mass*beta/Sqrt[1-beta^2];  (* \
\:8ba1\:7b97\:5165\:5c04\:6697\:7269\:8d28\:7684\:76f8\:5bf9\:8bba\:4e09\
\:52a8\:91cf\:5927\:5c0f *)\n\n  mediatorDenominator = \
(mediatorMass^2+2*nuclearMass*recoilGeV)^2;  (* \
\:8ba1\:7b97\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd (mV\262+2 mA ER)\262 \
*)\n\n  If[!TrueQ[mediatorDenominator > 0], Throw[\"Vector mediator \
denominator is zero\"]];  (* \
\:9632\:6b62\:4f20\:64ad\:5b50\:5206\:6bcd\:4e3a\:96f6 *)\n\n  integral = \
I6[mass, scalarMass, splitting, nuclearMass, recoilGeV, speedKms, orders, \
width];  (* \:8fdb\:884c\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 *)\n\n  \
nuclearMass*couplingSquared*nuclearResponse*integral/\n   \
(256*Pi^3*incomingMomentum^2*mediatorDenominator)\n ];  (* \
\:7ed3\:675f\:5f53\:524d\:622a\:9762\:51fd\:6570\:5b9a\:4e49 \
*)\n\n\nDifferentialCrossSection[a_Integer, recoilKeV_?NumericQ, \
