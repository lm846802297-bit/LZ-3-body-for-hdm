\:672c\:ff0c\:4e0d\:8bfb\:53d6\:6211\:4eec\:539f\:6709\:7684\:5916\:90e8\
\:8ba1\:7b97\:811a\:672c\:3002 *)\nwriteEmbeddedScript[tag_String, \
inRulesFolder_:False] := Module[\n {src, base, root, engineSource, niSource, \
modelSource, modelTemp, modelDir, hashTemp, temp},\n base = \
NotebookDirectory[];\n root = If[inRulesFolder, FileNameJoin[{base, \
\"FeynRules_check\"}], base];\n src = notebookSource[tag];\n engineSource = \
notebookSource[\"inlineEngine\"];\n niSource = \
notebookSource[\"embeddedNI\"];\n modelSource = \
notebookSource[\"embeddedModel\"];\n modelTemp = CreateTemporary[] <> \
\".fr\";\n Export[modelTemp, modelSource, \"Text\"];\n (* \
\:81ea\:52a8\:5bfc\:51fa\:7684 FeynArts \
\:6a21\:578b\:4e5f\:4ece\:672c\:7b14\:8bb0\:672c\:590d\:5236\:5230\:4e34\
\:65f6\:76ee\:5f55\:3002 *)\n modelDir = CreateDirectory[CreateTemporary[] <> \
\"_models\"];\n Export[FileNameJoin[{modelDir, \"ThreeBodyVV_FA.gen\"}], \
notebookSource[\"embeddedFAgen\"], \"Text\"];\n \
Export[FileNameJoin[{modelDir, \"ThreeBodyVV_FA.mod\"}], \
notebookSource[\"embeddedFAmod\"], \"Text\"];\n \
Export[FileNameJoin[{modelDir, \"ChiRadiation.mod\"}], \
notebookSource[\"embeddedChiFA\"], \"Text\"];\n hashTemp = CreateTemporary[] \
<> \".txt\";\n Export[hashTemp, \
\"ca06a6866fc7eb34bdb8ab985f6dc2b35553dbe031e929355c84586b62b5afd6\", \
\"Text\"];\n src = StringReplace[src, {\n   \"DirectoryName[$InputFileName]\" \
-> ToString[InputForm[root]],\n   \
\"FileNameJoin[{workDir,\\\"ThreeBodyVV.fr\\\"}]\" -> \
ToString[InputForm[modelTemp]],\n   \
\"FileNameJoin[{root,\\\"ThreeBodyVV.fr\\\"}]\" -> \
ToString[InputForm[modelTemp]],\n   \
\"FileNameJoin[{workDir,\\\"generated_model_source_sha256.txt\\\"}]\" -> \
ToString[InputForm[hashTemp]],\n   \"\\\"ThreeBodyVV_FA\\\"\" -> \
ToString[InputForm[FileNameJoin[{modelDir, \"ThreeBodyVV_FA\"}]]],\n   \
\"\\\"ChiRadiation\\\"\" -> ToString[InputForm[FileNameJoin[{modelDir, \
\"ChiRadiation\"}]]],\n   \"(* INSERT_NOTEBOOK_ENGINE *)\" -> engineSource,\n \
  \"(* INSERT_NOTEBOOK_NINTEGRATE *)\" -> StringReplace[niSource, \
\"299792.458\" -> \"(299792458/1000)\"]\n }];\n (* \
\:4e0d\:540c\:7cfb\:7edf\:7684\:6362\:884c\:7b26\:4e0d\:5f71\:54cd\:6a21\
\:578b\:7684\:7269\:7406\:5185\:5bb9\:ff1b\:4ee5\:89c4\:8303\:5316\:6a21\
