SHA256 \:8bb0\:5f55\:68c0\:67e5\:3002 *)\n src = StringReplace[src,\n  \
\"ToLowerCase[FileHash[sourceModel,\\\"SHA256\\\",\\\"HexString\\\"]]=!=Strin\
gTrim[Import[hashFile,\\\"Text\\\"]]\" ->\n   \
\"(Hash[StringTrim[StringReplace[Import[sourceModel,\\\"Text\\\"],FromCharact\
erCode[{13,10}]->FromCharacterCode[10]]],\\\"SHA256\\\"] =!= \" <>\n   \
ToString[expectedModelCanonicalHash, InputForm] <> \" || \
StringTrim[Import[hashFile,\\\"Text\\\"]] =!= \
\\\"ca06a6866fc7eb34bdb8ab985f6dc2b35553dbe031e929355c84586b62b5afd6\\\")\"\n \
];\n temp = CreateTemporary[] <> \".wls\";\n Export[temp, src, \"Text\"];\n \
temp\n];", "Input", CellLabel -> "In[1241]:=", ExpressionUUID ->
