(* 构造末态四动量；相空间映射不调用原程序的 boost 或 Gauss 求积函数。 *)
ClearAll[niDot,niKinematics,niIntegrand,niI6];  (* 清除符号的旧定义及属性 *)
niDot[a_,b_]:=a[[1]] b[[1]]-a[[2;;4]].b[[2;;4]];  (* 定义闵可夫斯基四向量点积 *)
niKinematics[m_?NumericQ,ms_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[  (* 独立定义相空间点和末态四动量的构造 *)
 {beta,e,p,q,wmin,wmax,w2,angle,qvec,pin,Q,W,Qvec,Qmag,ez,ex,ey,rad,est,kstar,ks,ks4,pp,threshold,delta},  (* 组织当前列表、函数参数或计算块 *)
 beta=v/(299792458/1000);e=m/Sqrt[1-beta^2];p=e beta;q=Sqrt[er (2 mA+er)];  (* 计算入射粒子的无量纲速度 *)
 wmin=(m+ms)^2;wmax=m^2+2 p q-2(e+mA)er;delta=wmax-wmin;  (* 计算不变质量平方的上下限及区间宽度 *)
 If[delta<=0,Return[$Failed]];  (* 若不变质量上下限倒置，返回失败 *)
 w2=wmin+delta u^2;  (* 用 u 的平方映射到不变质量积分区间 *)
 angle=(w2-m^2+2(e+mA)er)/(2 p q);  (* 由能量动量守恒计算核反冲方向余弦 *)
 If[Abs[angle]>1+10^-8,Return[$Failed]];  (* 检查反冲角余弦是否超出允许范围 *)
 qvec=q {Sqrt[Max[0,1-angle^2]],0,angle};  (* 构造实验室系核反冲三动量 *)
 pin={e,0,0,p};Q=Join[{e-er},{0,0,p}-qvec];  (* 构造入射暗物质四动量 *)
 W=Sqrt[w2];Qvec=Q[[2;;4]];Qmag=Norm[Qvec];  (* 计算末态不变质量与总三动量的大小 *)
 ez=If[Qmag>0,Qvec/Qmag,{0,0,1}];  (* 以末态总动量方向定义极轴 *)
 ex=Normalize[Cross[If[Abs[ez[[3]]]<0.9,{0,0,1},{0,1,0}],ez]];ey=Cross[ez,ex];  (* 建立与末态总动量垂直的两个正交基方向 *)
 rad=Sqrt[Max[0,(w2-(m+ms)^2)(w2-(m-ms)^2)]];  (* 计算有量纲 Källén 函数的平方根 *)
 est=(w2-m^2+ms^2)/(2 W);kstar=rad/(2 W);  (* 计算标量在末态质心系的能量 *)
 ks=kstar (z ez+Sqrt[Max[0,1-z^2]](Cos[phi] ex+Sin[phi] ey));  (* 按质心系极角和方位角构造标量三动量 *)
 ks4=Join[{(Q[[1]] est+Qvec.ks)/W},ks+Qvec (est/W+(Qvec.ks)/(W (Q[[1]]+W)))];  (* 将标量四动量从质心系变换至实验室系 *)
 pp=Q-ks4;  (* 由四动量守恒得到末态暗物质四动量 *)
 <|"pin"->pin,"pout"->pp,"k"->ks4,"Q"->Q,"w2"->w2,"qvec"->qvec,  (* 指定该函数的参数、替换规则或显示选项 *)
   "jac"->2 delta u,"phase"->rad/w2,"delta"->delta|>  (* 指定该函数的参数、替换规则或显示选项 *)
];  (* 结束当前参数列表、计算块或表达式 *)
Print["已定义相空间运动学：u→W²，z=cosθ*，phi 为方位角。具体四动量将在下面的固定点检查显示。"];
niIntegrand[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,width_?NumericQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[{kin},  (* 定义含 Jacobian、相空间权重和自旋迹的被积函数 *)
 kin=niKinematics[m,ms,mA,er,v,u,z,phi];  (* 在当前积分点构造运动学四动量 *)
 If[kin===$Failed,Return[0.]];  (* 运动学点无效时令该积分点贡献为零 *)
 kin["jac"] kin["phase"] Fig2`Private`trace[kin["pin"],kin["pout"],kin["k"],m,m+dm,kin["w2"],width]/(2 Pi)  (* 相空间 Jacobian 乘相空间因子、自旋迹及方位平均系数 *)
];  (* 结束当前参数列表、计算块或表达式 *)
Options[niI6]={AccuracyGoal->3,PrecisionGoal->3,MaxRecursion->6,WorkingPrecision->30};  (* 指定数值积分的精度目标或最大递归次数 *)
niI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,width_?NumericQ,OptionsPattern[]]:=Module[{b,e,p,q,wmax},  (* 定义局部变量和局部计算 *)
 If[!TrueQ[m>0&&ms>=0&&dm>=0&&mA>0&&er>0&&0<v<(299792458/1000)&&width>=0],Print["Invalid inputs"];Return[$Failed]];  (* 检查质量、反冲能量、速度和宽度是否位于允许范围 *)
 b=v/(299792458/1000);e=m/Sqrt[1-b^2];p=e b;q=Sqrt[er(2mA+er)];wmax=m^2+2p q-2(e+mA)er;  (* 计算入射速度、能量、动量与不变质量上限 *)
 If[wmax<=(m+ms)^2,Return[0.]];  (* 若末态相空间关闭，返回零 *)
 If[wmax>=(m+dm)^2,Print["On-shell chi2 accessible; off-shell calculation aborted."];Return[$Failed]];  (* 若中间态可在壳，停止当前离壳近似计算 *)
 NIntegrate[niIntegrand[m,ms,dm,mA,er,v,width,u,z,phi],{u,0,1},{z,-1,1},{phi,0,2Pi},  (* 进行数值积分 *)
   WorkingPrecision->OptionValue[WorkingPrecision], Method->{"GlobalAdaptive","SymbolicProcessing"->0},AccuracyGoal->OptionValue[AccuracyGoal],  (* 指定数值积分的精度目标或最大递归次数 *)
   PrecisionGoal->OptionValue[PrecisionGoal],MaxRecursion->OptionValue[MaxRecursion]]  (* 指定数值积分的精度目标或最大递归次数 *)
];  (* 结束当前参数列表、计算块或表达式 *)
Print["已定义 NIntegrate 被积函数与三维相空间积分；计算结果在固定点及 benchmark 表显示。"];