Cell["\:8fd9\:662f\:57fa\:4e8e\:539f\:7a3f\:516c\:5f0f\:548c\:660e\:786e\:5047\:8bbe\:7684\:5b8c\:6574\:8ba1\:7b97\:6d41\:7a0b\:ff0c\:4e0d\:58f0\:79f0\:5df2\:7ecf\:6062\:590d\:539f\:4f5c\:8005\:5b9e\:9645\:7ed8\:56fe\:8f93\:5165\:3002\:539f\:56fe\:7684\:56fe\:6ce8\:91cd\:590d\:5199\:6210\:4e86\:8d39\:66fc\:56fe\:ff0c\:4f46\:539f\:56fe\:5b9e\:9645\:4e3a\:4e8b\:4ef6\:7387\:66f2\:7ebf\:ff1b\:672c\:6587\:4ef6\:8ba1\:7b97\:66f2\:7ebf\:3002\:7ed3\:679c\:4e3a\:7406\:8bba\:6838\:53cd\:51b2\:7387\:ff0c\:672a\:52a0\:5165\:63a2\:6d4b\:6548\:7387\:3001\:80fd\:91cf\:5206\:8fa8\:6216\:80cc\:666f\:3002", "Text"],
Cell["\:4e00\:3001\:8bfb\:53d6\:8ba1\:7b97\:7a0b\:5e8f\:548c\:6838\:54cd\:5e94", "Section"],
Cell["\:6e90\:7a0b\:5e8f\:4f7f\:7528 AFH v6 \:5b98\:65b9\:5185\:7f6e\:5bc6\:5ea6\:77e9\:9635\:3002\:4e03\:79cd\:5df2\:63d0\:4f9b\:7684\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:5206\:522b\:8ba1\:7b97\:ff0c\:4e30\:5ea6\:4e4b\:548c\:7ea6 99.8158%\:ff1bXe-124 \:548c Xe-126 \:672a\:88ab AFH \:9ed8\:8ba4\:96c6\:5408\:63d0\:4f9b\:ff0c\:56e0\:6b64\:8fd9\:91cc\:4e0d\:5c06\:4e03\:79cd\:4e30\:5ea6\:91cd\:65b0\:5f52\:4e00\:5316\:ff0c\:4e5f\:4e0d\:58f0\:79f0\:8986\:76d6 100%\:3002", "Text"],
Cell["ClearAll[\"Global`*\"];\nbaseDir = NotebookDirectory[];\nenginePath = FileNameJoin[{baseDir, \"three_body_rate_engine.wl\"}];\nafhPath = FileNameJoin[{baseDir, \"dmformfactor-V6.m\"}];\nIf[!FileExistsQ[enginePath] || !FileExistsQ[afhPath], Print[\"ERROR: Missing .wl or AFH package in notebook folder.\"]; Abort[]];\nexpectedHash = \"dc0742f1c50b0a478adab62f2ddef6c82978ee034c1f177e0ed917deab5dd372\";\nIf[ToLowerCase[FileHash[afhPath, \"SHA256\", \"HexString\"]] =!= expectedHash, Print[\"ERROR: AFH file SHA-256 mismatch.\"]; Abort[]];\nGet[enginePath];\nisotopes = {128,129,130,131,132,134,136};\nFig2`LoadResponses[afhPath,isotopes];\nPrint[\"Mathematica: \",$Version]; Print[\"AFH SHA-256 verified.\"]", "Input"],
Cell["\:4e8c\:3001\:660e\:786e\:7269\:7406\:53c2\:6570\:548c\:53ef\:4fee\:6539\:5047\:8bbe", "Section"],
Cell["\:539f\:7a3f\:7ed9\:51fa m\:03c7=1 TeV \:548c\:8026\:5408\:4e58\:79ef\:5e73\:65b9 10^-8\:ff1b\:5355\:72ec\:7684\:5a92\:4ecb\:8d28\:91cf\:548c\:5bbd\:5ea6\:6ca1\:6709\:4ece\:539f\:59cb\:7ed8\:56fe\:8f93\:5165\:4e2d\:786e\:5b9a\:3002\:6b64\:5904 mV=10 GeV \:4e3a\:53ef\:4fee\:6539\:7684\:6f14\:793a\:5047\:8bbe\:ff0c\:4f20\:64ad\:5b50\:91c7\:7528\:96f6\:5bbd\:5ea6\:5e76\:8981\:6c42 Wmax<m\:03c72\:3002\:7c92\:5b50\:632f\:5e45\:91c7\:7528 Dirac \:57fa\:51c6\:3002\:5c40\:57df\:6697\:7269\:8d28\:5bc6\:5ea6\:548c\:6807\:51c6\:622a\:65ad Maxwell \:6655\:53c2\:6570\:4e5f\:5e94\:89c6\:4e3a\:53ef\:4fee\:6539\:8f93\:5165\:3002", "Text"],
Cell["\:539f\:56fe\:56fe\:4f8b\:7b2c\:4e09\:3001\:56db\:6761\:5206\:522b\:6807\:6709 360 MeV\:3001300 MeV\:ff0c\:4f46\:8bba\:6587\:6a21\:578b\:5199\:7684\:662f sub-MeV\:3002\:8fd9\:91cc\:660e\:786e\:7528 360 keV\:3001300 keV \:4f5c\:4e3a\:53ef\:68c0\:9a8c\:7684\:5047\:8bbe\:ff0c\:800c\:975e\:9759\:9ed8\:66f4\:6539\:539f\:56fe\:7ed3\:8bba\:3002\:539f\:59cb\:56fe\:4e2d\:7070\:8272\:5b9e\:9a8c\:533a\:57df\:7684\:6765\:6e90\:672a\:660e\:786e\:ff0c\:56e0\:6b64\:4e0d\:6dfb\:52a0\:3002", "Text"],
Cell["(* Masses: GeV in parameters; benchmark pairs below are {ms in keV, delta m in MeV}. *)\nabundances = <|128->0.019102,129->0.264006,130->0.040710,131->0.212324,\n 132->0.269086,134->0.104357,136->0.088573|>;\nparameters = <|\"mchi\"->1000., \"mV\"->10., \"couplingSq\"->1.*10^-8,\n \"rho\"->0.3, \"v0\"->220., \"vEarth\"->232., \"vEsc\"->544.,\n \"molarMass\"->131.293, \"isotopes\"->isotopes, \"abundance\"->abundances,\n \"quad\"->{6,6,4}, \"nv\"->6|>;\nbenchmarks = {{200.,1.},{300.,1.},{360.,1.},{300.,10.}};\nPrint[\"Isotope fraction included: \", Total[Lookup[abundances,isotopes]]];\nPrint[\"Parameters: \",parameters]; Print[\"Benchmarks {ms keV, Delta m MeV}: \",benchmarks]", "Input"],
Cell["\:4e09\:3001\:5148\:68c0\:67e5\:6570\:5b66\:548c\:7269\:7406\:91cf", "Section"],
Cell["\:5148\:505a\:5feb\:901f\:72ec\:7acb\:68c0\:67e5\:ff1a\:901f\:5ea6\:5206\:5e03\:5f52\:4e00\:5316\:3001\:5df2\:77e5\:4e09\:4f53\:79ef\:5206\:6d4b\:8bd5\:70b9\:3001Xe-131 \:8fd0\:52a8\:5b66\:9608\:503c\:3002I6 \:91c7\:7528\:4e24\:5f20\:56fe\:7684\:76f8\:5e72\:632f\:5e45\:548c\:5b8c\:6574\:81ea\:65cb\:8ff9\:ff1b\:8bf7\:5bf9\:7167\:8f93\:51fa\:4e0e\:53c2\:8003\:503c\:3002", "Text"],
Cell["haloNorm = NIntegrate[Fig2`SpeedPDF[v,220.,232.,544.],{v,0,312,776}];\ni6test = Fig2`I6[1000.,0.0003,0.001,122.,0.0002,776.,{16,16,8}];\nvminTest = Fig2`VMin[1000.,0.0003,122.,0.0002];\nGrid[{{\"check\",\"computed\",\"reference\"},\n {\"halo integral\",haloNorm,1.},\n {\"I6 (GeV^2)\",i6test,878098.5567396},\n {\"vmin (km/s)\",vminTest,711.66003436}},Frame->All]", "Input"],
Cell["If[Abs[haloNorm-1.]>10^-6 || Abs[i6test/878098.5567396-1]>10^-6 || Abs[vminTest-711.66003436]>0.001,\n Print[\"ERROR: diagnostic check failed; stop before plotting.\"]; Abort[],Print[\"PASS: diagnostic checks.\"]]", "Input"],
Cell["\:56db\:3001\:8ba1\:7b97\:56db\:6761\:66f2\:7ebf", "Section"],
Cell["\:672c\:9ed8\:8ba4\:8bbe\:7f6e\:662f\:53ef\:8fd0\:884c\:7684\:7c97\:7f51\:683c\:63a2\:7d22\:ff1a\:56db\:6761\:66f2\:7ebf\:3001\:4e03\:79cd\:540c\:4f4d\:7d20\:3001\:622a\:65ad\:6655\:901f\:5ea6\:79ef\:5206\:3001\:4e09\:4f53\:79ef\:5206\:3002\:6bcf\:79cd\:540c\:4f4d\:7d20\:72ec\:7acb\:8ba1\:7b97\:5176\:8d28\:91cf\:3001\:54cd\:5e94\:548c\:4e09\:4f53\:79ef\:5206\:ff0c\:7136\:540e\:6309\:5929\:7136\:4e30\:5ea6\:52a0\:6743\:3002\:8ba1\:7b97\:91cf\:8f83\:5927\:ff0c\:5185\:6838\:8fd0\:884c\:65f6\:8bf7\:7b49\:5f85\:3002\:66f2\:7ebf\:6570\:503c\:53ca\:8c37\:5e95\:5bf9\:79ef\:5206\:9636\:6570\:3001\:80fd\:91cf\:7f51\:683c\:53ef\:80fd\:654f\:611f\:ff0c\:5e94\:6267\:884c\:4e0b\:4e00\:8282\:7684\:6536\:655b\:68c0\:67e5\:3002", "Text"],
Cell["\:60f3\:63d0\:9ad8\:7ed8\:56fe\:5206\:8fa8\:7387\:ff0c\:53ef\:5c06\:80fd\:91cf\:6b65\:957f 10 \:6539\:4e3a 5 keV\:ff0c\:5e76\:63d0\:9ad8 quad \:4e0e nv\:ff1b\:8ba1\:7b97\:65f6\:95f4\:4f1a\:663e\:8457\:589e\:52a0\:3002101\:3001267\:3001542 keV \:662f\:989d\:5916\:52a0\:5165\:7684\:5bf9\:7167\:70b9\:3002", "Text"],
Cell["energies = Sort[DeleteDuplicates[Join[N[Range[10,800,10]],{101.,267.,542.}]]];\ntiming = AbsoluteTiming[curves = Fig2`MakeCurves[energies,benchmarks,parameters];];\nPrint[\"Elapsed seconds: \",timing[[1]],\"; energy points: \",Length[energies]];\nPrint[\"First benchmark first five {ER keV, rate}: \",Take[curves[[1]],5]]", "Input"],
Cell["\:4e94\:3001\:7ed8\:56fe\:4e0e\:5bfc\:51fa", "Section"],
Cell["\:7eb5\:8f74\:662f\:7406\:8bba\:4e8b\:4ef6\:7387 events/(tonne year keV)\:ff0c\:5e76\:975e\:67d0\:4e2a\:7ed9\:5b9a\:66dd\:5149\:91cf\:5185\:7684\:603b\:8ba1\:6570\:3002\:79ef\:5206\:6307\:5b9a\:80fd\:91cf\:533a\:95f4\:5e76\:4e58\:4ee5\:5b9e\:9645\:66dd\:5149\:ff08tonne year\:ff09\:540e\:624d\:5f97\:5230\:76f8\:5e94\:7684\:7406\:8bba\:4e8b\:4ef6\:6570\:3002", "Text"],
Cell["styles = {Red,RGBColor[0,.5,0],Black,Blue};\nlabels = {\"ms=200 keV, dm=1 MeV\", \"ms=300 keV, dm=1 MeV\",\n \"ms=360 keV, dm=1 MeV (assumed)\", \"ms=300 keV, dm=10 MeV (assumed)\"};\npositiveCurves = (Select[#, Last[#] > 0 &] &) /@ curves;\nfig2plot = ListLogPlot[positiveCurves, Joined->True, PlotStyle->styles, PlotRange->All,\n Frame->True, FrameLabel->{\"Recoil energy E_R (keV)\",\"Rate [events/(tonne year keV)]\"},\n PlotLegends->Placed[labels,Above], ImageSize->Large,\n PlotLabel->\"AFH default, seven xenon isotopes, assumed parameters\"];\nfig2plot", "Input"],
Cell["outDir=FileNameJoin[{baseDir,\"rate_curve_outputs\"}];\nIf[!DirectoryQ[outDir],CreateDirectory[outDir]];\nDo[Export[FileNameJoin[{outDir,\"benchmark_\"<>ToString[i]<>\".csv\"}],\n Prepend[curves[[i]],{\"ER_keV\",\"rate_events_per_tonne_year_keV\"}],\"CSV\"],{i,Length[curves]}];\nExport[FileNameJoin[{outDir,\"figure2_exploratory.png\"}],fig2plot,\"PNG\",ImageResolution->200];\nPrint[\"Exported to \",outDir]", "Input"],
Cell["\:516d\:3001\:6570\:503c\:6536\:655b\:68c0\:67e5\:ff08\:5efa\:8bae\:81f3\:5c11\:8fd0\:884c\:4e00\:6b21\:ff09", "Section"],
Cell["\:540c\:4e00\:53c2\:6570\:4e0b\:ff0c\:5728 E_R=200 keV \:6bd4\:8f83\:66f4\:9ad8\:7684\:79ef\:5206\:9636\:6570\:3002\:4e0b\:9762\:53ea\:68c0\:67e5\:5355\:4e2a\:80fd\:91cf\:3001\:4e00\:4e2a benchmark\:ff1b\:8981\:7528\:4e8e\:8bba\:6587\:ff0c\:5e94\:5bf9\:6240\:6709\:66f2\:7ebf\:3001\:591a\:4e2a\:80fd\:91cf\:70b9\:5c24\:5176\:662f\:8c37\:5e95\:53ca\:8fd0\:52a8\:5b66\:8fb9\:754c\:91cd\:590d\:68c0\:67e5\:ff0c\:5e76\:63d0\:9ad8\:80fd\:91cf\:5206\:8fa8\:7387\:3002", "Text"],
Cell["pFine = Join[parameters,<|\"quad\"->{10,10,6},\"nv\"->10|>];\ncoarseValue = Fig2`Rate[200.,0.0003,0.001,parameters];\nfineValue = Fig2`Rate[200.,0.0003,0.001,pFine];\nGrid[{{\"ER=200 keV, ms=300 keV\", \"rate\", \"relative to fine\"},\n {\"coarse\",coarseValue,If[fineValue==0,Indeterminate,coarseValue/fineValue-1]},\n {\"fine\",fineValue,0.}},Frame->All]", "Input"],
Cell["\:4e03\:3001\:7ed3\:679c\:8fb9\:754c", "Section"],
Cell["\:7ed3\:679c\:662f\:7ed9\:5b9a\:5047\:8bbe\:4e0b\:7684\:7406\:8bba\:4e8b\:4ef6\:7387\:8ba1\:7b97\:ff0c\:53ef\:72ec\:7acb\:4fee\:6539\:53c2\:6570\:548c\:6c42\:79ef\:9636\:6570\:3002\:5176\:5e76\:975e\:5df2\:5b8c\:6210\:7684\:539f\:56fe\:6570\:503c\:590d\:73b0\:ff1a\:539f\:59cb\:6570\:636e\:3001mV\:3001\:5bbd\:5ea6\:3001\:539f\:56fe\:56fe\:4f8b\:5355\:4f4d\:53ca\:63a2\:6d4b\:5668\:5904\:7406\:5c1a\:672a\:786e\:5b9a\:3002Xe-124/126 \:672a\:8ba1\:5165\:ff1b\:6a21\:578b\:7684 Dirac/Majorana \:9009\:62e9\:548c\:8bba\:6587\:622a\:9762\:603b\:5f52\:4e00\:5316\:4e5f\:4ecd\:9700\:7269\:7406\:5ba1\:8ba1\:3002", "Text"]
