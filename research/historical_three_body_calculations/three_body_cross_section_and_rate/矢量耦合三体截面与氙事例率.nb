Cell["\<\
baseDir = NotebookDirectory[];
enginePath = FileNameJoin[{baseDir,\"three_body_rate_engine.wl\"}];
afhPath = FileNameJoin[{baseDir,\"dmformfactor-V6.m\"}];
If[!FileExistsQ[enginePath] || !FileExistsQ[afhPath],Print[\"ERROR: engine or \
AFH package missing.\"];Abort[]];
expectedHash=\"\
dc0742f1c50b0a478adab62f2ddef6c82978ee034c1f177e0ed917deab5dd372\";
If[ToLowerCase[FileHash[afhPath,\"SHA256\",\"HexString\"]]=!=expectedHash,\
Print[\"ERROR: unexpected AFH source hash.\"];Abort[]];
Get[enginePath];
Fig2`LoadResponses[afhPath,isotopes];
Print[\"Version: \",$Version,\"; AFH source SHA-256 verified.\"]\
\>", "Input",ExpressionUUID->"6fc4c8c7-f8d9-f845-b1bb-47e8e4d540c6"],

