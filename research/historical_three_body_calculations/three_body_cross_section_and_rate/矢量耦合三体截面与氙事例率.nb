Cell["\:4f7f\:7528\:7b2c\:4e8c\:8282\:8bbe\:7f6e\:7684\:8f83\:9ad8\:79ef\:5206\
\:9636\:6570\:ff0c\:5bf9\:5f53\:524d\:56fa\:5b9a\:901f\:5ea6\:68c0\:67e5\:70b9\
\:91cd\:65b0\:8ba1\:7b97 I6 \:4e0e\:622a\:9762\:3002\:8be5\:5355\:70b9\:6bd4\
\:8f83\:7528\:4e8e\:68c0\:67e5\:6c42\:79ef\:7a33\:5b9a\:6027\:3002", "Text",Ex\
pressionUUID->"bdd2b296-5385-084e-9ae1-f7f1f3ada634"],

Cell[CellGroupData[{

Cell["\<\
(* \:589e\:5927 W\.b2\:3001\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:7684\:79ef\
\:5206\:9636\:6570\:540e\:91cd\:65b0\:8ba1\:7b97\:3002 *)
selectedI6FineGeV2 = Fig2`I6[
  darkMatterMassGeV, selectedScalarMassGeV, selectedSplittingGeV,
  selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS,
  finePhaseSpaceOrders, selectedWidthGeV
];
selectedDSigmaFine = selectedPrefactorGeVMinus5 * selectedI6FineGeV2;
selectedFineDifference = If[selectedDSigmaFine != 0,
  selectedDSigmaGeVMinus3 / selectedDSigmaFine - 1,
  If[selectedDSigmaGeVMinus3 == 0, 0, Indeterminate]
];
Grid[{
  {\"\:79ef\:5206\:9636\:6570\", \"I6 [GeV\.b2]\", \"d sigma/d ER \
[GeV^-3]\"},
  {phaseSpaceOrders, selectedI6GeV2, selectedDSigmaGeVMinus3},
  {finePhaseSpaceOrders, selectedI6FineGeV2, selectedDSigmaFine},
  {\"\:7c97/\:7ec6 - 1\", \"\", selectedFineDifference}
}, Frame -> All]\
\>", "Input",ExpressionUUID->"d6f0e25d-c974-2945-8574-97e6bd505e48"],

