Cell[CellGroupData[{

Cell["\:56db\:3001\:5bbd\:5ea6\:4e0e\:4e09\:4f53\:79ef\:5206\:7684\:4ee3\:8868\
\:70b9\:68c0\:9a8c", "Section",ExpressionUUID->"c4173770-c762-904b-8810-\
8c8dd0db3c69"],

Cell["\<\
\:8fd9\:662f\:56fa\:5b9a\:7684\:7a0b\:5e8f\:81ea\:68c0\:70b9\:ff0c\:4e0e\:7b2c\
\:4e00\:8282\:7684\:4f5c\:56fe\:8f93\:5165\:72ec\:7acb\:3002\:6d4b\:8bd5\:70b9\
 mchi=1000 GeV\:3001mA=122 GeV\:3001ms=300 keV\:3001Delta m=1 MeV\:3001ER=200 \
keV\:3001v=776 km/s\:3002\:5bf9\:7167\:503c\:7531\:72ec\:7acb Python \:7a0b\
\:5e8f\:5728\:76f8\:540c Dirac \:632f\:5e45\:3001\:56fa\:5b9a\:5bbd\:5ea6\
\:5904\:65b9\:4e0e\:540c\:4e00\:79ef\:5206\:9636\:6570\:4e0b\:5f97\:5230\:3002\
\>", "Text",ExpressionUUID->"7f4b2f84-fabb-3647-824a-1a03e9526228"],

Cell["\<\
haloNorm=NIntegrate[Fig2`SpeedPDF[v,220.,232.,544.],{v,0,312,776}];
testWidth=Fig2`Chi2Width[1000.,0.0003,0.001,1.];
testZero=Fig2`I6[1000.,0.0003,0.001,122.,0.0002,776.,{16,16,8},0.];
testPole=Fig2`I6[1000.,0.0003,0.001,122.,0.0002,776.,{16,16,8},testWidth];
Grid[{{\"check\", \"Mathematica\", \"reference\"},
 {\"halo integral\",haloNorm,1.}, {\"pole width [keV]\",10^6 \
testWidth,151.8239115788},
 {\"I6 zero [GeV^2]\",testZero,878098.5567396},
 {\"I6 g2=1 pole [GeV^2]\",testPole,868246.7879206}},Frame->All]\
\>", "Input",ExpressionUUID->"887c5e5f-83db-f546-b9f9-4669361f99b8"],

Cell["\<\
If[Abs[haloNorm-1.]>10^-6 || Abs[testWidth/0.0001518239115787696-1]>10^-8 ||
 Abs[testZero/878098.5567396-1]>10^-6 || \
Abs[testPole/868246.7879206-1]>10^-6,
 Print[\"ERROR: diagnostic check failed.\"];Abort[],Print[\"PASS: independent \
benchmark checks.\"]]\
\>", "Input",ExpressionUUID->"a5780de3-8a8d-9b42-b98f-02fea0ece3f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:4e94\:3001\:5206\:522b\:8ba1\:7b97\:96f6\:5bbd\:5ea6\:548c\:6781\:70b9\
\:5bbd\:5ea6\:66f2\:7ebf", "Section",ExpressionUUID->"d04ae13e-fc20-c343-88d2-\
cf9be15e5dd4"],

Cell["\<\
\:66f2\:7ebf\:662f\:5355\:4f4d\:66dd\:5149\:3001\:5355\:4f4d\:6838\:53cd\:51b2\
\:80fd\:91cf\:7684\:7406\:8bba\:4e8b\:4ef6\:7387\:ff0c\:5355\:4f4d \
events/(tonne year keV)\:ff0c\:672a\:52a0\:63a2\:6d4b\:5668\:6548\:7387\:3001\
\:80fd\:91cf\:5206\:8fa8\:7387\:6216\:80cc\:666f\:3002\:9ed8\:8ba4\:80fd\:91cf\
\:6b65\:957f\:4e3a 10 keV\:ff0c\:5e76\:989d\:5916\:52a0\:5165 101\:3001267\
\:3001542 keV\:ff0c\:79ef\:5206\:9636\:6570\:4e3a\:5feb\:901f\:63a2\:7d22\
\:8bbe\:7f6e\:ff1b\:7528\:4e8e\:8bba\:6587\:5e94\:6309\:4e0b\:4e00\:8282\:9010\
\:70b9\:68c0\:67e5\:6536\:655b\:3002\
\>", "Text",ExpressionUUID->"7bd5275e-8c89-0344-9bba-bd41c2842f19"],

Cell["\<\
(* \:5c06\:5bf9\:7167\:80fd\:91cf\:5e76\:5165\:7f51\:683c\:ff0c\:65b9\:4fbf\
\:4fee\:6539\:8d77\:70b9\:3001\:7ec8\:70b9\:4e0e\:6b65\:957f\:3002 *)
energies = Sort[DeleteDuplicates[N[Join[
  Range[recoilMinKeV, recoilMaxKeV, recoilStepKeV],
  extraRecoilEnergiesKeV,
  comparisonEnergiesKeV
]]]];
Print[\"Calculating zero-width reference ...\"];
t0=AbsoluteTiming[curvesZero=Fig2`MakeCurves[energies,benchmarks,pZero];][[1]];
Print[\"Calculating g2=\",g2val,\" fixed-pole-width curves ...\"];
t1=AbsoluteTiming[curvesPole=Fig2`MakeCurves[energies,benchmarks,pPole];][[1]];
Print[\"Energy points: \",Length[energies],\"; elapsed seconds: zero=\",t0,\" \
pole=\",t1]\
\>", "Input",ExpressionUUID->"0cca76df-83a8-374f-8480-500ec8a6b663"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:516d\:3001\:7ed8\:56fe\:ff1a\:5b9e\:7ebf\:662f\:6307\:5b9a g\:2082 \
\:7684\:6781\:70b9\:5bbd\:5ea6\:ff0c\:865a\:7ebf\:662f\:96f6\:5bbd\:5ea6", \
"Section",ExpressionUUID->"8a2a2079-2854-174f-80e6-3280249ea3ba"],

Cell["\:6bcf\:4e2a\:989c\:8272\:5bf9\:5e94\:540c\:4e00\:7ec4\:8d28\:91cf\:53c2\
\:6570\:ff1b\:540c\:8272\:5b9e\:7ebf\:4e0e\:865a\:7ebf\:53ea\:6539\:53d8\:4f20\
\:64ad\:5b50\:5bbd\:5ea6\:3002\:4e24\:6761\:7ebf\:53ef\:80fd\:975e\:5e38\:63a5\
\:8fd1\:ff0c\:53ef\:7ed3\:5408\:540e\:9762\:7684\:6bd4\:503c\:56fe\:548c\:6570\
\:8868\:67e5\:770b\:5dee\:5f02\:3002", "Text",ExpressionUUID->"db8a30d8-f98a-\
9646-8a53-560b85879776"],

Cell["\<\
(* \:4ece\:8d28\:91cf\:8868\:751f\:6210\:56fe\:4f8b\:ff0c\:4fee\:6539\:8d28\
\:91cf\:7ec4\:5408\:65f6\:81ea\:52a8\:540c\:6b65\:3002 *)
baseColors = {Red, RGBColor[0,.5,0], Black, Blue};
colors = Table[baseColors[[1 + Mod[i - 1, Length[baseColors]]]],
  {i, Length[benchmarks]}];

benchmarkLabel[{scalarMassKeV_, massSplittingMeV_}] :=
  \"ms=\" <> ToString[scalarMassKeV] <> \" keV, dm=\" <>
  ToString[massSplittingMeV] <> \" MeV\";
labels = benchmarkLabel /@ benchmarks;

positiveZero=(Select[#,Last[#]>0&]&)/@curvesZero;
positivePole=(Select[#,Last[#]>0&]&)/@curvesPole;
stylesZero=Directive[#,Dashed,Opacity[.7]]&/@colors;
stylesPole=Directive[#,Thick]&/@colors;
ratePlot=ListLogPlot[Join[positivePole,positiveZero],Joined->True,
 PlotStyle->Join[stylesPole,stylesZero],PlotRange->All,Frame->True,
 FrameLabel->{\"Recoil energy E_R (keV)\",\"Rate [events/(tonne year \
keV)]\"},
 PlotLegends->Placed[Join[(#<>\"; pole\"&)/@labels,(#<>\"; \
zero\"&)/@labels],Below],
 ImageSize->Large,PlotLabel->\"Vector-vector model: fixed pole width vs \
zero-width reference\"];
ratePlot\
\>", "Input",ExpressionUUID->"e9005ada-a540-2e49-b45b-670cd3e8c1f0"],

Cell["\<\
ratioCurves=Table[Select[MapThread[If[#1[[2]]>0 && \
#2[[2]]>0,{#1[[1]],#2[[2]]/#1[[2]]},Nothing]&,
 {curvesZero[[i]],curvesPole[[i]]}],ListQ],{i,Length[benchmarks]}];
ratioPlot=ListLinePlot[ratioCurves,Joined->True,PlotStyle->(Directive[#,Thick]\
&/@colors),
 PlotRange->All,Frame->True,FrameLabel->{\"Recoil energy E_R (keV)\",\"Pole \
width / zero-width rate\"},
 PlotLegends->Placed[labels,Below],ImageSize->Large,
 PlotLabel->\"Width sensitivity (points with zero reference omitted)\"];
ratioPlot\
\>", "Input",ExpressionUUID->"e528b5e3-7de0-5449-80bf-d690be9fc38f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:4e03\:3001\:4ee3\:8868\:80fd\:91cf\:9010\:9879\:5bf9\:7167", "Section",ExpressionUUID->"5639215f-d490-d546-bfd4-97c0d78a9c4f"],

Cell["\<\
\:96f6\:5bbd\:5ea6\:4e8b\:4ef6\:7387\:4e3a\:96f6\:65f6\:ff0c\:7269\:7406\:4e0a\
\:8be5\:7f51\:683c\:70b9\:76f8\:7a7a\:95f4\:5173\:95ed\:6216\:7ed3\:679c\:4e3a\
\:96f6\:ff0c\:6b64\:65f6\:4e0d\:8ba1\:7b97\:6bd4\:4f8b\:3002300 keV benchmark \
\:7b2c\:4e00\:8c37\:9644\:8fd1\:5c24\:5176\:5e94\:533a\:5206\:6838\:54cd\:5e94\
\:8c37\:503c\:548c\:8fd0\:52a8\:5b66\:9608\:503c\:3002\
\>", "Text",ExpressionUUID->"5eaabecd-2e6b-9045-b9c6-95a0b9e622ca"],

Cell["\<\
energiesToCheck = N[comparisonEnergiesKeV];
compareRows=Flatten[Table[
 Module[{idx,zero,pole},idx=First@FirstPosition[energies,er];
  zero=curvesZero[[i,idx,2]];pole=curvesPole[[i,idx,2]];
  {i,er,zero,pole,If[zero>0,100 (pole/zero-1),\"closed/zero\"]}],
 {i,Length[benchmarks]},{er,energiesToCheck}],1];
Grid[Prepend[compareRows,{\"benchmark\",\"ER [keV]\",\"zero \
width\",\"g2=\"<>ToString[g2val]<>\" pole width\",\"change [%]\"}],Frame->All]\
\>", "Input",ExpressionUUID->"dacf7a5a-bae7-e848-bc2d-7b92c0a19d07"]
}, Open  ]],

