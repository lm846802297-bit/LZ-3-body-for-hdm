Cell[CellGroupData[{

Cell["3.6 \:56fa\:5b9a\:901f\:5ea6\:5fae\:5206\:622a\:9762\:66f2\:7ebf", \
"Subsection",ExpressionUUID->"a029c3f0-08fe-764d-9793-9bf418dd63a4"],

Cell["\:4e0b\:56fe\:4f7f\:7528\:7b2c\:4e00\:8282\:7684\:540c\:4f4d\:7d20\:4e0e\
\:5165\:5c04\:901f\:5ea6\:ff0c\:4ee5\:53ca\:7b2c\:4e8c\:8282\:7684\:80fd\:91cf\
\:7f51\:683c\:3002\:6bcf\:6761\:66f2\:7ebf\:5bf9\:5e94\:4e00\:7ec4\:6807\:91cf\
\:8d28\:91cf\:548c\:8d28\:91cf\:5288\:88c2\:ff0c\:7eb5\:8f74\:5355\:4f4d\:4e3a\
 cm\.b2/keV\:3002", "Text",ExpressionUUID->"31404578-f13b-2c4b-bdcb-\
d734d559830e"],

Cell[CellGroupData[{

Cell["\<\
(* \:4f7f\:7528\:7b2c\:4e8c\:8282\:7684\:53cd\:51b2\:80fd\:91cf\:7f51\:683c\
\:ff0c\:5e76\:628a\:989d\:5916\:68c0\:67e5\:70b9\:52a0\:5165\:3002 *)
fixedSpeedEnergyGridKeV = Sort[DeleteDuplicates[N[Join[
  Range[recoilMinKeV, recoilMaxKeV, recoilStepKeV],
  extraRecoilEnergiesKeV,
  comparisonEnergiesKeV
]]]];

(* \:5bf9\:6bcf\:7ec4\:8d28\:91cf\:9010\:70b9\:8ba1\:7b97\:672c\:8282\:516c\
\:5f0f\:ff0c\:7ed3\:679c\:4fdd\:5b58\:4e3a {ER, d sigma/d ER}\:3002 *)
fixedSpeedCrossSections = Table[
  Table[{
    recoilKeV,
    Fig2`DifferentialCrossSection[
      diagnosticIsotope, recoilKeV, diagnosticSpeedKmPerS,
      benchmark[[1]] * keVToGeV, benchmark[[2]] * megaElectronVoltToGeV,
      diagnosticParameters
    ] * gevMinus2ToCm2 * 10^-6
  }, {recoilKeV, fixedSpeedEnergyGridKeV}],
  {benchmark, benchmarks}
];

(* \:5bf9\:6570\:5750\:6807\:53ea\:7ed8\:5236\:622a\:9762\:4e3a\:6b63\:7684\
\:70b9\:3002 *)
positiveCrossSections = (Select[#, Last[#] > 0 &] &) /@ \
fixedSpeedCrossSections;
activeCrossSectionIndices = Select[Range[Length[benchmarks]],
  Length[positiveCrossSections[[#]]] > 0 &];

If[Length[activeCrossSectionIndices] == 0,
  Print[\"\:6240\:9009\:901f\:5ea6\:548c\:80fd\:91cf\:8303\:56f4\:5185\:7684\
\:622a\:9762\:5747\:4e3a\:96f6\:3002\"],
  fixedSpeedLabels = (\"ms=\" <> ToString[#[[1]]] <> \" keV, Delta m=\" <>
      ToString[#[[2]]] <> \" MeV\" &) /@ benchmarks;
  fixedSpeedPlot = ListLogPlot[
    positiveCrossSections[[activeCrossSectionIndices]],
    Joined -> True,
    PlotRange -> All,
    Frame -> True,
    (* \:548c\:540e\:9762\:7684\:4e8b\:4ef6\:7387\:56fe\:4f7f\:7528\:76f8\
\:540c\:7684\:57fa\:51c6\:989c\:8272\:3002 *)
    PlotStyle -> Table[
      {Red, RGBColor[0, .5, 0], Black, Blue}[[1 + Mod[index - 1, 4]]],
      {index, activeCrossSectionIndices}
    ],
    FrameLabel -> {\"Recoil energy ER (keV)\", \"d sigma / d ER \
(cm^2/keV)\"},
    PlotLegends -> Placed[fixedSpeedLabels[[activeCrossSectionIndices]], \
Below],
    PlotLabel -> \"Fixed-speed cross section, Xe-\" <> \
ToString[diagnosticIsotope] <>
      \", v=\" <> ToString[diagnosticSpeedKmPerS] <> \" km/s\",
    ImageSize -> Large
  ];
  fixedSpeedPlot
]\
\>", "Input",ExpressionUUID->"7913bc08-47d3-e248-b16c-306168de61e8"],

