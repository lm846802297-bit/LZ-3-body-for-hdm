 TagBox[GridBox[{
    {"\<\"\:79ef\:5206\:9636\:6570\"\>", "\<\"I6 [GeV\.b2]\"\>", "\<\"d \
sigma/d ER [GeV^-3]\"\>"},
    {
     RowBox[{"{", 
      RowBox[{"6", ",", "6", ",", "4"}], "}"}], "863152.0286077217`", 
