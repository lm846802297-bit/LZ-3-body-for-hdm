Cell["\<\
I6 \:5bf9 W\.b2\:3001z \:548c\:65b9\:4f4d\:89d2\:8fdb\:884c\:6570\:503c\:79ef\
\:5206\:ff0c\:5176\:4e2d\:65b9\:4f4d\:89d2\:6743\:91cd\:5df2\:7ecf\:5305\:542b\
\:5e73\:5747\:56e0\:5b50 1/(2\[Pi])\:3002AFH \:7684\:6838\:54cd\:5e94\:91c7\
\:7528\:6240\:9009\:540c\:4f4d\:7d20\:548c\:5f53\:524d\:53cd\:51b2\:80fd\:91cf\
\:3002\
\>", "Text",ExpressionUUID->"c334639a-6db4-3c49-983b-c5257d62188d"],

Cell[CellGroupData[{

Cell["\<\
(* \:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6\:548c AFH \:76f8\:5e72\:6838\:54cd\
\:5e94 R_A\:3002 *)
selectedWidthGeV = If[diagnosticWidthMode === \"pole\",
  Fig2`Chi2Width[darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV, g2val],
  0.
];
selectedNuclearResponse = Fig2`NuclearResponse[diagnosticIsotope, \
diagnosticRecoilKeV];

(* I6 = \:79ef\:5206 dW\.b2 sqrt(lambda) \:79ef\:5206 dz <L00>_phi\:3002
   Fig2`I6 \:4f7f\:7528 2 \:8282\:4e2d\:7ed9\:5b9a\:7684\:4e09\:4f53\:79ef\
\:5206\:9636\:6570\:3002 *)
selectedI6GeV2 = Fig2`I6[
  darkMatterMassGeV,
  selectedScalarMassGeV,
  selectedSplittingGeV,
  selectedNuclearMassGeV,
  selectedRecoilGeV,
  diagnosticSpeedKmPerS,
  phaseSpaceOrders,
  selectedWidthGeV
];

Grid[{
  {\"\:7269\:7406\:91cf\", \"\:6570\:503c\", \"\:5355\:4f4d\"},
  {\"Gamma chi2\", selectedWidthGeV * gevToKeV, \"keV\"},
  {\"R_A(ER)\", selectedNuclearResponse, \"\:65e0\:91cf\:7eb2\"},
  {\"I6\", selectedI6GeV2, \"GeV\.b2\"}
}, Frame -> All]\
\>", "Input",ExpressionUUID->"3ee117c4-12ab-b949-888c-c4abc6c46fc2"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"\:7269\:7406\:91cf\"\>", "\<\"\:6570\:503c\"\>", \
"\<\"\:5355\:4f4d\"\>"},
    {"\<\"Gamma chi2\"\>", "151.82391157876955`", "\<\"keV\"\>"},
    {"\<\"R_A(ER)\"\>", "9.628443520056782`", "\<\"\:65e0\:91cf\:7eb2\"\>"},
    {"\<\"I6\"\>", "863152.0286077217`", "\<\"GeV\.b2\"\>"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
