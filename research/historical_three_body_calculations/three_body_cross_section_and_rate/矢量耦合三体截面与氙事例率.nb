Cell["\<\
\:4e0b\:9762\:76f4\:63a5\:628a\:521a\:5f97\:5230\:7684 R_A \:548c I6 \:4ee3\
\:5165\:4e0a\:65b9\:516c\:5f0f\:3002\:6700\:540e\:4e00\:5217\:5bf9\:7167\:72ec\
\:7acb\:8c03\:7528\:7684\:56fa\:5b9a\:901f\:5ea6\:622a\:9762\:51fd\:6570\:ff1b\
\:4e8b\:4ef6\:7387\:79ef\:5206\:4e5f\:4f7f\:7528\:8be5\:51fd\:6570\:6240\:5c5e\
\:7684\:540c\:4e00\:622a\:9762\:5b9e\:73b0\:3002\
\>", "Text",ExpressionUUID->"37287f4c-713e-0841-96ca-dcee20e903c8"],

Cell[CellGroupData[{

Cell["\<\
(* \:516c\:5f0f\:4e2d\:7684\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd\:548c\
\:4e0d\:542b I6 \:7684\:6574\:4f53\:524d\:56e0\:5b50\:3002 *)
selectedMediatorDenominator =
  (mediatorMassGeV^2 + 2 * selectedNuclearMassGeV * selectedRecoilGeV)^2;
If[!TrueQ[selectedMediatorDenominator > 0],
  Print[\"\:9519\:8bef\:ff1a\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd\:4e3a\
\:96f6\:3002\"]; Abort[]];

selectedPrefactorGeVMinus5 =
  selectedNuclearMassGeV * couplingProductSquared * selectedNuclearResponse /
  (256 * Pi^3 * selectedChiMomentumGeV^2 * selectedMediatorDenominator);

(* \:628a\:4e24\:91cd\:79ef\:5206\:4e58\:56de\:524d\:56e0\:5b50\:ff0c\:5f97\
\:5230 d sigma_A / d ER\:3002 *)
selectedDSigmaGeVMinus3 = selectedPrefactorGeVMinus5 * selectedI6GeV2;
gevMinus2ToCm2 = 0.3893793721 * 10^-27;
selectedDSigmaCm2PerKeV = selectedDSigmaGeVMinus3 * gevMinus2ToCm2 * 10^-6;

(* \:7528\:4f9b\:540e\:7eed\:4e8b\:4ef6\:7387\:8c03\:7528\:7684\:622a\:9762\
\:63a5\:53e3\:590d\:6838\:76f8\:540c\:8f93\:5165\:3002 *)
selectedDSigmaCheck = Fig2`DifferentialCrossSection[
  diagnosticIsotope, diagnosticRecoilKeV, diagnosticSpeedKmPerS,
  selectedScalarMassGeV, selectedSplittingGeV, diagnosticParameters
];
selectedRelativeDifference = If[selectedDSigmaGeVMinus3 != 0,
  selectedDSigmaCheck / selectedDSigmaGeVMinus3 - 1,
  If[selectedDSigmaCheck == 0, 0, Indeterminate]
];

Grid[{
  {\"\:7269\:7406\:91cf\", \"\:6570\:503c\", \"\:5355\:4f4d\"},
  {\"\:622a\:9762\:524d\:56e0\:5b50\", selectedPrefactorGeVMinus5, \"GeV^-5\"},
  {\"d sigma / d ER\", selectedDSigmaGeVMinus3, \"GeV^-3\"},
  {\"d sigma / d ER\", selectedDSigmaCm2PerKeV, \"cm\.b2/keV\"},
  {\"\:63a5\:53e3\:6838\:5bf9\:76f8\:5bf9\:5dee\", \
selectedRelativeDifference, \"\:65e0\:91cf\:7eb2\"}
}, Frame -> All]\
\>", "Input",ExpressionUUID->"a85ced38-ff8b-b342-a441-f6177a681bef"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"\:7269\:7406\:91cf\"\>", "\<\"\:6570\:503c\"\>", \
"\<\"\:5355\:4f4d\"\>"},
    {"\<\"\:622a\:9762\:524d\:56e0\:5b50\"\>", 
     "2.204941934283607`*^-6", "\<\"GeV^-5\"\>"},
    {"\<\"d sigma / d ER\"\>", "1.9032001035391293`", "\<\"GeV^-3\"\>"},
    {"\<\"d sigma / d ER\"\>", 
     "7.410668612967212`*^-34", "\<\"cm\.b2/keV\"\>"},
    {"\<\"\:63a5\:53e3\:6838\:5bf9\:76f8\:5bf9\:5dee\"\>", 
     RowBox[{"-", "1.1102230246251565`*^-16"}], "\<\"\:65e0\:91cf\:7eb2\"\>"}
   },
