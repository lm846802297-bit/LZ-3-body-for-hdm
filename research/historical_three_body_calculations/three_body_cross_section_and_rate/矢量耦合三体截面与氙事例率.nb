\:8d28\:91cf\:4f7f\:7528 GeV\:ff0c\:901f\:5ea6\:6362\:7b97\:4e3a v/c\:3002\
\>", "Text",ExpressionUUID->"820ce080-ac14-e747-bcd9-51163e1e94e6"],

Cell[CellGroupData[{

Cell["\<\
(* AME2020 neutral-atom masses, converted to bare nuclear masses. *)
(* M_nucleus = (M_atom - Z m_e) u + B_e(Z); masses are GeV. *)
Global`ame2020XenonAtomicMassU = <|
  124 -> 123905885174/10^9, 126 -> 125904297422/10^9,
  128 -> 12790353075341/10^11, 129 -> 12890478085742/10^11,
  130 -> 129903509346/10^9, 131 -> 13090508412808/10^11,
  132 -> 13190415508346/10^11, 134 -> 133905393030/10^9,
  136 -> 135907214474/10^9 |>;
Global`xenonZ = 54;
Global`xenonAtomicMassUnitGeV = 93149410372/10^11; (* CODATA 2022 *)
Global`electronMassU = 5485799090441/10^16; (* CODATA 2022 *)
Global`xenonElectronBindingEnergyGeV =
  N[(144381/10^4 Global`xenonZ^(239/100) +
      155468/10^11 Global`xenonZ^(535/100)) 10^-9, 30];
Global`xenonNuclearMassGeV[A_Integer] := Module[{mAtom},
  mAtom = Lookup[Global`ame2020XenonAtomicMassU, A, Null];
  If[mAtom === Null, Return[$Failed]];
  N[(mAtom - Global`xenonZ Global`electronMassU) \
Global`xenonAtomicMassUnitGeV +
    Global`xenonElectronBindingEnergyGeV, 20]
];
Print[Table[{A, Global`xenonNuclearMassGeV[A]},
  {A, {128,129,130,131,132,134,136}}]];

(* \:4ece\:7b2c\:4e00\:8282\:9009\:62e9\:540c\:4f4d\:7d20\:3001\:8d28\:91cf\
\:7ec4\:5408\:3001\:53cd\:51b2\:80fd\:91cf\:548c\:901f\:5ea6\:3002 *)
If[!MemberQ[isotopes, diagnosticIsotope],
  Print[\"\:9519\:8bef\:ff1a\:8bf7\:5728 1.3 \:8282\:7684\:540c\:4f4d\:7d20\
\:8868\:4e2d\:52a0\:5165\:6240\:9009\:540c\:4f4d\:7d20\:3002\"]; Abort[]];
If[!IntegerQ[diagnosticBenchmarkIndex] ||
   !Between[diagnosticBenchmarkIndex, {1, Length[benchmarks]}],
  Print[\"\:9519\:8bef\:ff1a\:8d28\:91cf\:7ec4\:5408\:5e8f\:53f7\:8d85\:51fa \
benchmarks \:8303\:56f4\:3002\"]; Abort[]];
If[!TrueQ[0 < diagnosticSpeedKmPerS < 299792.458] ||
   !TrueQ[diagnosticRecoilKeV >= 0],
  Print[\"\:9519\:8bef\:ff1a\:8981\:6c42 0 < v < c \:4e14 ER >= 0\:3002\"]; \
Abort[]];

diagnosticParameters = Switch[diagnosticWidthMode,
  \"pole\", pPole,
  \"zero\", pZero,
  _, Print[\"\:9519\:8bef\:ff1a\:5bbd\:5ea6\:5904\:65b9\:8bf7\:9009\:62e9 \
pole \:6216 zero\:3002\"]; Abort[]
];

selectedScalarMassGeV = benchmarks[[diagnosticBenchmarkIndex, 1]] * keVToGeV;
selectedSplittingGeV = benchmarks[[diagnosticBenchmarkIndex, 2]] * \
megaElectronVoltToGeV;
selectedNuclearMassGeV = Global`xenonNuclearMassGeV[diagnosticIsotope];
selectedRecoilGeV = diagnosticRecoilKeV * keVToGeV;
selectedBeta = diagnosticSpeedKmPerS / 299792.458;
selectedChiEnergyGeV = darkMatterMassGeV / Sqrt[1 - selectedBeta^2];
selectedChiMomentumGeV = selectedChiEnergyGeV * selectedBeta;
selectedQGeV = Sqrt[2 * selectedNuclearMassGeV * selectedRecoilGeV + \
selectedRecoilGeV^2];

(* \:539f\:7a3f\:4e2d\:7684\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0a\:4e0b\
\:9650\:ff0c\:5355\:4f4d GeV\.b2\:3002 *)
selectedW2Min = (darkMatterMassGeV + selectedScalarMassGeV)^2;
selectedW2Max = darkMatterMassGeV^2 + 2 * selectedChiMomentumGeV * \
selectedQGeV -
  2 * (selectedChiEnergyGeV + selectedNuclearMassGeV) * selectedRecoilGeV;

Grid[{
  {\"\:7269\:7406\:91cf\", \"\:6570\:503c\", \"\:5355\:4f4d\"},
  {\"A\", diagnosticIsotope, \"\:65e0\:91cf\:7eb2\"},
  {\"mA\", selectedNuclearMassGeV, \"GeV\"},
  {\"p chi1\", selectedChiMomentumGeV, \"GeV\"},
  {\"Wmin\.b2\", NumberForm[selectedW2Min, {16, 6}, ExponentFunction -> (Null \
&)], \"GeV\.b2\"},
  {\"Wmax\.b2\", NumberForm[selectedW2Max, {16, 6}, ExponentFunction -> (Null \
&)], \"GeV\.b2\"},
  {\"Wmax\.b2 - Wmin\.b2\", selectedW2Max - selectedW2Min, \"GeV\.b2\"},
  {\"\:4e09\:4f53\:76f8\:7a7a\:95f4\", If[selectedW2Max > selectedW2Min, \"\
\:6253\:5f00\", \"\:5173\:95ed\"], \"\"}
}, Frame -> All]\
\>", "Input",ExpressionUUID->"32ae0f8c-8072-5a40-a235-a055ca3914f9"],

