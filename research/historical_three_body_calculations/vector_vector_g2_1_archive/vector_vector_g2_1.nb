afhPath = FileNameJoin[{baseDir,\"dmformfactor-V6.m\"}];
If[!FileExistsQ[enginePath] || !FileExistsQ[afhPath],Print[\"ERROR: engine or \
AFH package missing.\"];Abort[]];
expectedHash=\"\
dc0742f1c50b0a478adab62f2ddef6c82978ee034c1f177e0ed917deab5dd372\";
If[ToLowerCase[FileHash[afhPath,\"SHA256\",\"HexString\"]]=!=expectedHash,\
Print[\"ERROR: unexpected AFH source hash.\"];Abort[]];
Get[enginePath];
Fig2`LoadResponses[afhPath,isotopes];
Print[\"Version: \",$Version,\"; AFH source SHA-256 verified.\"]\
\>", "Input",ExpressionUUID->"6fc4c8c7-f8d9-f845-b1bb-47e8e4d540c6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3 \
\:5c06\:7269\:7406\:8f93\:5165\:4f20\:7ed9\:6570\:503c\:7a0b\:5e8f", \
"Subsection",ExpressionUUID->"21ae343e-0a77-2e4d-a4ec-8687ca533864"],

Cell["\:4e0b\:9762\:7684\:5173\:8054\:8868\:628a\:6709\:5355\:4f4d\:7684\:7269\
\:7406\:53d8\:91cf\:5bf9\:5e94\:5230\:6c42\:89e3\:5668\:53c2\:6570\:540d\:3002\
\:4e24\:5957\:8ba1\:7b97\:5171\:7528\:540c\:4e00\:7ec4\:8f93\:5165\:ff0c\:901a\
\:8fc7 widthMode \:9009\:62e9\:4f20\:64ad\:5b50\:5904\:65b9\:3002", "Text",Exp\
ressionUUID->"51c9fcf6-a2a0-204d-8a11-367595d203b2"],

Cell["\<\
parameters = <|
  \"mchi\"       -> darkMatterMassGeV,
  \"mV\"         -> mediatorMassGeV,
  \"g2\"         -> g2val,
  \"couplingSq\" -> couplingProductSquared,
  \"rho\"        -> localDensityGeVPerCm3,
  \"v0\"         -> haloSpeedScaleKmPerS,
  \"vEarth\"     -> earthSpeedKmPerS,
  \"vEsc\"       -> escapeSpeedKmPerS,
  \"molarMass\"  -> xenonMolarMassGPerMol,
  \"isotopes\"   -> isotopes,
  \"abundance\"  -> abundances,
  \"quad\"       -> phaseSpaceOrders,
  \"nv\"         -> speedOrder
|>;

pZero = Append[parameters, \"widthMode\" -> \"zero\"];
pPole = Append[parameters, \"widthMode\" -> \"pole\"];\
\>", "Input",ExpressionUUID->"f95b6b93-d06d-a540-b33b-d8f6c65faa66"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.4 \:8ba1\:7b97\:5404\:7ec4\:6781\:70b9\:5bbd\:5ea6", "Subsection",ExpressionUUID->"84c18b14-dbff-ce45-892b-01ab008c2cb3"],

Cell["\<\
(* \:8f93\:5165\:7684\:8d28\:91cf\:5148\:6362\:7b97\:4e3a GeV\:ff0c\:5bbd\
\:5ea6\:7ed3\:679c\:518d\:6362\:56de keV\:3002 *)
keVToGeV = 10^-6;
megaElectronVoltToGeV = 10^-3;
gevToKeV = 10^6;

poleWidthRow[{scalarMassKeV_, massSplittingMeV_}] := Module[
  {scalarMassGeV, massSplittingGeV, widthGeV},
  scalarMassGeV = scalarMassKeV * keVToGeV;
  massSplittingGeV = massSplittingMeV * megaElectronVoltToGeV;

  widthGeV = Fig2`Chi2Width[
    darkMatterMassGeV,
    scalarMassGeV,
    massSplittingGeV,
    g2val
  ];

  {scalarMassKeV, massSplittingMeV, widthGeV * gevToKeV}
];

widthTable = poleWidthRow /@ benchmarks;
Print[\"Included isotope abundance: \", Total[Values[abundances]]];
Print[\"g2 = \", g2val];

Grid[
  Prepend[widthTable, {\"ms [keV]\", \"Delta m [MeV]\", \"Pole width [keV]\"}],
  Frame -> All
]\
\>", "Input",ExpressionUUID->"442dcb22-ff33-6047-bd17-bdd45e152c57"]
}, Open  ]]
}, Open  ]],

