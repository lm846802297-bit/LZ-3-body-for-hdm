        Cell["outDir=FileNameJoin[{baseDir,\"g2_output\"}];If[!DirectoryQ[out\
Dir],CreateDirectory[outDir]];\n(* ASCII CSV: e notation, explicit quoting \
for strings; compatible with Excel/Python. \
*)\nformatNumber[n_?NumericQ]:=StringReplace[StringReplace[ToString[InputForm\
[N[n]],CharacterEncoding->\"ASCII\"],\n \
RegularExpression[\"`[0-9.]*\"]->\"\"],\"*^\"->\"e\"];\nformatField[s_String]\
:=\"\\\"\"<>StringReplace[s,\"\\\"\"->\"\\\"\\\"\"]<>\"\\\"\";\nformatField[n\
_?NumericQ]:=formatNumber[n];\nwriteCSV[path_,rows_]:=Module[{stream=OpenWrit\
e[path,CharacterEncoding->\"ASCII\"]},\n \
Scan[(WriteString[stream,StringRiffle[formatField/@#,\",\"],\"\\n\"])&,rows];\
Close[stream];path];\nDo[writeCSV[FileNameJoin[{outDir,\"benchmark_\"<>ToStri\
ng[i]<>\"_g2_compare.csv\"}],\n \
Prepend[MapThread[{#1[[1]],#1[[2]],#2[[2]],If[#1[[2]]>0,#2[[2]]/#1[[2]],\"NA\
\"]}&,\n  \
{curvesZero[[i]],curvesPole[[i]]}],{\"ER_keV\",\"rate_zero\",\"rate_pole\",\"\
pole_over_zero\"}]],{i,Length[benchmarks]}];\nwriteCSV[FileNameJoin[{outDir,\
\"pole_widths.csv\"}],Prepend[widthTable,{\"ms_keV\",\"delta_m_MeV\",\"gamma_\
keV\"}]];\nwriteCSV[FileNameJoin[{outDir,\"selected_energies.csv\"}],Prepend[\
compareRows,{\"benchmark\",\"ER_keV\",\"rate_zero\",\"rate_pole\",\"change_pe\
rcent\"}]];\nExport[FileNameJoin[{outDir,\"rate_compare.png\"}],ratePlot,\"PN\
G\",ImageResolution->180];\nExport[FileNameJoin[{outDir,\"ratio_compare.png\"\
}],ratioPlot,\"PNG\",ImageResolution->180];\nPrint[\"Results exported to: \
\",outDir]", "Input", ExpressionUUID -> 
