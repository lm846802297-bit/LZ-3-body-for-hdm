\:91cf\:ff0c\:6bd4\:8f83\:4e24\:79cd\:5bbd\:5ea6\:5904\:65b9\:7684\:7c97\
\:7ec6\:6c42\:79ef\:ff1b\:8fd9\:53ea\:662f\:4ee3\:8868\:70b9\:ff0c\:4e0d\
\:4fdd\:8bc1\:6240\:6709\:66f2\:7ebf\:3001\:8c37\:5e95\:548c\:9608\:503c\
\:5747\:6536\:655b\:3002\:8bf7\:5728\:91cd\:8981\:7684\:80fd\:91cf\:548c \
benchmark \:5904\:63d0\:9ad8 \
quad\:3001nv\:ff0c\:518d\:51cf\:5c0f\:80fd\:91cf\:6b65\:957f\:3002", "Text", 
         ExpressionUUID -> "9973d706-9574-864e-bf59-5a88efa84e02"], 
        Cell["(* \
\:6536\:655b\:70b9\:548c\:66f4\:7ec6\:7684\:79ef\:5206\:9636\:6570\:8bfb\
\:53d6\:7b2c\:4e8c\:8282\:7684\:8bbe\:7f6e\:3002 *)\n{convergenceMsKeV, \
convergenceDeltaMMeV} =\n  \
benchmarks[[convergenceBenchmarkIndex]];\nconvergenceMsGeV = convergenceMsKeV \
* keVToGeV;\nconvergenceDeltaMGeV = convergenceDeltaMMeV * \
megaElectronVoltToGeV;\n\nfineOrders = <|\"quad\" -> finePhaseSpaceOrders, \
\"nv\" -> fineSpeedOrder|>;\npZeroFine = Join[pZero, fineOrders];\npPoleFine \
= Join[pPole, fineOrders];\n\ncoarse0 = Fig2`Rate[convergenceRecoilKeV, \
convergenceMsGeV, convergenceDeltaMGeV, pZero];\nfine0 = \
Fig2`Rate[convergenceRecoilKeV, convergenceMsGeV, convergenceDeltaMGeV, \
pZeroFine];\ncoarse1 = Fig2`Rate[convergenceRecoilKeV, convergenceMsGeV, \
convergenceDeltaMGeV, pPole];\nfine1 = Fig2`Rate[convergenceRecoilKeV, \
convergenceMsGeV, convergenceDeltaMGeV, \
pPoleFine];\n\nrelativeDifference[coarse_, fine_] :=\n  If[fine > 0, \
coarse/fine - 1, \"NA\"];\nPrint[\"Convergence point: \", \
benchmarkLabel[benchmarks[[convergenceBenchmarkIndex]]],\n  \", ER=\", \
convergenceRecoilKeV, \" keV\"];\nGrid[{{\"width \
prescription\",\"coarse\",\"fine\",\"coarse/fine-1\"},\n {\"zero \
width\",coarse0,fine0,relativeDifference[coarse0, fine0]},\n {\"pole \
