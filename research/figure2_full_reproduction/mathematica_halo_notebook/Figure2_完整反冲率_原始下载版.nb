\:65b9\:4fbf\:4fee\:6539\:8d77\:70b9\:3001\:7ec8\:70b9\:4e0e\:6b65\:957f\
\:3002 *)\nenergies = Sort[DeleteDuplicates[N[Join[\n  Range[recoilMinKeV, \
recoilMaxKeV, recoilStepKeV],\n  extraRecoilEnergiesKeV,\n  \
comparisonEnergiesKeV\n]]]];\nPrint[\"Calculating zero-width reference \
...\"];\nt0=AbsoluteTiming[curvesZero=Fig2`MakeCurves[energies,benchmarks,pZe\
ro];][[1]];\nPrint[\"Calculating g2=\",g2val,\" fixed-pole-width curves \
...\"];\nt1=AbsoluteTiming[curvesPole=Fig2`MakeCurves[energies,benchmarks,pPo\
le];][[1]];\nPrint[\"Energy points: \",Length[energies],\"; elapsed seconds: \
zero=\",t0,\" pole=\",t1]", "Input", ExpressionUUID -> 
