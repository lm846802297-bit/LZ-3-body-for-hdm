Module[{idx,zero,pole},idx=First@FirstPosition[energies,er];\n  \
zero=curvesZero[[i,idx,2]];pole=curvesPole[[i,idx,2]];\n  \
{i,er,zero,pole,If[zero>0,100 (pole/zero-1),\"closed/zero\"]}],\n \
{i,Length[benchmarks]},{er,energiesToCheck}],1];\nGrid[Prepend[compareRows,{\
\"benchmark\",\"ER [keV]\",\"zero width\",\"g2=\"<>ToString[g2val]<>\" pole \
width\",\"change [%]\"}],Frame->All]", "Input", ExpressionUUID -> 
          "dacf7a5a-bae7-e848-bc2d-7b92c0a19d07"]}, Open]], 
