        Cell["haloNorm=NIntegrate[Fig2`SpeedPDF[v,220.,232.,544.],{v,0,312,77\
6}];\ntestWidth=Fig2`Chi2Width[1000.,0.0003,0.001,1.];\ntestZero=Fig2`I6[1000\
.,0.0003,0.001,122.,0.0002,776.,{16,16,8},0.];\ntestPole=Fig2`I6[1000.,0.0003\
,0.001,122.,0.0002,776.,{16,16,8},testWidth];\nGrid[{{\"check\", \
\"Mathematica\", \"reference\"},\n {\"halo integral\",haloNorm,1.}, {\"pole \
width [keV]\",10^6 testWidth,151.8239115788},\n {\"I6 zero \
[GeV^2]\",testZero,878098.5567396},\n {\"I6 g2=1 pole \
[GeV^2]\",testPole,868246.7879206}},Frame->All]", "Input", 
         ExpressionUUID -> "887c5e5f-83db-f546-b9f9-4669361f99b8"], 
        Cell["If[Abs[haloNorm-1.]>10^-6 || \
Abs[testWidth/0.0001518239115787696-1]>10^-8 ||\n \
Abs[testZero/878098.5567396-1]>10^-6 || \
Abs[testPole/868246.7879206-1]>10^-6,\n Print[\"ERROR: diagnostic check \
failed.\"];Abort[],Print[\"PASS: independent benchmark checks.\"]]", "Input", 
