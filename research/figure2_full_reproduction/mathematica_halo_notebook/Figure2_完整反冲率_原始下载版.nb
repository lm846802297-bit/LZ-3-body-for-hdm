          {Cell["(* \
\:7b2c\:4e00\:6761\:ff1a\:5355\:540c\:4f4d\:7d20\:7684\:6838\:54cd\:5e94 \
R_A/A\262\:3002 *)\nnuclearShape = Table[\n  {energy, \
Fig2`NuclearResponse[diagnosticIsotope, energy] / diagnosticIsotope^2},\n  \
{energy, energies}\n];\n\n(* \
\:7b2c\:4e8c\:6761\:ff1a\:540c\:4e00\:540c\:4f4d\:7d20\:3001\:540c\:4e00\
\:5165\:5c04\:901f\:5ea6\:7684\:5fae\:5206\:622a\:9762\:3002 \
*)\nfixedSpeedShape = fixedSpeedCrossSections[[haloBenchmarkIndex]];\n\n(* \
\:7b2c\:4e09\:6761\:ff1a\:540c\:4e00\:8d28\:91cf\:7ec4\:5408\:7684\:5929\
\:7136\:6c19 halo \:5e73\:5747\:53cd\:51b2\:7387\:3002 *)\nnaturalHaloShape = \
curvesPole[[haloBenchmarkIndex]];\n\n(* \
\:4e09\:6761\:66f2\:7ebf\:5355\:4f4d\:4e0d\:540c\:ff0c\:5206\:522b\:6309\
\:5404\:81ea\:6700\:5927\:503c\:5f52\:4e00\:5316\:3002 \
*)\nnormalizeShape[data_] := Module[{peak},\n  peak = Max[data[[All, 2]]];\n  \
If[peak > 0,\n    Select[({#[[1]], #[[2]] / peak} & /@ data), Last[#] > 0 \
&],\n    {}\n  ]\n];\nshapeCurves = normalizeShape /@ {nuclearShape, \
fixedSpeedShape, naturalHaloShape};\nactiveShapeIndices = Select[Range[3], \
Length[shapeCurves[[#]]] > 0 &];\nshapeLabels = {\n  \"Xe-131 nuclear \
response\",\n  \"Xe-131 fixed-speed cross section\",\n  \"natural-xenon \
halo-folded rate\"\n};\n(* \
\:5982\:4fee\:6539\:540c\:4f4d\:7d20\:ff0c\:56fe\:4f8b\:81ea\:52a8\:540c\
\:6b65\:3002 *)\nshapeLabels[[1]] = \"Xe-\" <> ToString[diagnosticIsotope] <> \
\" nuclear response\";\nshapeLabels[[2]] = \"Xe-\" <> \
ToString[diagnosticIsotope] <> \" fixed-speed cross \
section\";\n\nIf[Length[activeShapeIndices] == 0,\n  \
Print[\"\:5f53\:524d\:53c2\:6570\:4e0b\:6ca1\:6709\:6b63\:503c\:66f2\:7ebf\
\:3002\"],\n  shapeComparisonPlot = ListLogPlot[\n    \
shapeCurves[[activeShapeIndices]],\n    Joined -> True,\n    Frame -> True,\n \
   PlotRange -> All,\n    FrameLabel -> {\"Recoil energy ER (keV)\", \"Each \
curve / its own maximum\"},\n    PlotLegends -> \
Placed[shapeLabels[[activeShapeIndices]], Below],\n    ImageSize -> Large\n  \
];\n  shapeComparisonPlot\n]", "Input"], Cell[BoxData[TemplateBox[
