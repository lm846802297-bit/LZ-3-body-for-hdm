\:91cf\:7ec4\:5408\:548c\:540c\:4f4d\:7d20\:8d21\:732e", "Subsection"], 
        Cell[CellGroupData[{Cell["(* \
\:9009\:62e9\:5f85\:6bd4\:8f83\:7684\:8d28\:91cf\:7ec4\:5408\:548c\:53cd\
\:51b2\:80fd\:91cf\:3002 *)\nhaloBenchmarkIndex = \
diagnosticBenchmarkIndex;\nhaloRecoilKeV = \
diagnosticRecoilKeV;\nhaloScalarMassGeV = benchmarks[[haloBenchmarkIndex, 1]] \
* keVToGeV;\nhaloSplittingGeV = benchmarks[[haloBenchmarkIndex, 2]] * \
megaElectronVoltToGeV;\n\n(* \
\:5bf9\:5b9e\:9a8c\:5ba4\:901f\:7387\:5206\:5e03\:79ef\:5206\:3002\:5206\
\:754c\:70b9\:6765\:81ea\:9003\:9038\:901f\:5ea6\:622a\:65ad\:3002 \
*)\nhaloBoundary = parameters[\"vEsc\"] - \
parameters[\"vEarth\"];\nhaloMaximum = parameters[\"vEsc\"] + \
parameters[\"vEarth\"];\nhaloNormalization = NIntegrate[\n  Fig2`SpeedPDF[v, \
parameters[\"v0\"], parameters[\"vEarth\"], parameters[\"vEsc\"]],\n  {v, 0, \
haloBoundary, haloMaximum}\n];\n\n(* \
\:6bcf\:6b21\:53ea\:4fdd\:7559\:4e00\:4e2a\:540c\:4f4d\:7d20\:ff0c\:4fdd\
\:7559\:5176\:5929\:7136\:4e30\:5ea6\:548c\:5929\:7136\:6c19\:5e73\:5747\
\:6469\:5c14\:8d28\:91cf\:3002 *)\nisotopeContributions = Table[\n  \
Module[{oneIsotopeParameters, threshold, contribution},\n    \
oneIsotopeParameters = Join[pPole, <|\"isotopes\" -> {isotope}|>];\n    \
threshold = Fig2`VMin[\n      darkMatterMassGeV, haloScalarMassGeV,\n      \
isotope * 0.93149410242, haloRecoilKeV * keVToGeV\n    ];\n    contribution = \
Fig2`Rate[\n      haloRecoilKeV, haloScalarMassGeV, haloSplittingGeV,\n      \
oneIsotopeParameters\n    ];\n    {isotope, abundances[isotope], threshold, \
contribution}\n  ],\n  {isotope, isotopes}\n];\n\n(* \
\:76f4\:63a5\:6c42\:5929\:7136\:6c19\:4e8b\:4ef6\:7387\:ff0c\:5e76\:4e0e\
\:9010\:540c\:4f4d\:7d20\:7ed3\:679c\:4e4b\:548c\:5bf9\:7167\:3002 \
*)\nhaloRateTotal = Fig2`Rate[\n  haloRecoilKeV, haloScalarMassGeV, \
haloSplittingGeV, pPole\n];\nisotopeRateSum = \
Total[isotopeContributions[[All, 4]]];\nsumRelativeDifference = \
If[haloRateTotal != 0,\n  isotopeRateSum / haloRateTotal - 1,\n  \
If[isotopeRateSum == 0, 0, \
Indeterminate]\n];\n\nPrint[\"\:901f\:7387\:5206\:5e03\:5f52\:4e00\:5316 = \
\", \
haloNormalization];\nPrint[\"\:7eb3\:5165\:540c\:4f4d\:7d20\:7684\:5929\:7136\
\:4e30\:5ea6\:4e4b\:548c = \", Total[Values[abundances]]];\nPrint[Grid[\n  \
Prepend[isotopeContributions,\n    {\"A\", \"\:6570\:76ee\:4e30\:5ea6\", \
\"\:4e09\:4f53\:9608\:503c\:901f\:5ea6 [km/s]\", \"\:8d21\:732e \
[events/(tonne year keV)]\"}],\n  Frame -> All\n]];\nGrid[{\n  \
{\"\:9010\:540c\:4f4d\:7d20\:4e4b\:548c\", isotopeRateSum},\n  \
{\"\:76f4\:63a5\:8ba1\:7b97\:5929\:7136\:6c19\:603b\:7387\", \
haloRateTotal},\n  {\"\:4e24\:8005\:76f8\:5bf9\:5dee\", \
sumRelativeDifference}\n}, Frame -> All]", "Input"], 
