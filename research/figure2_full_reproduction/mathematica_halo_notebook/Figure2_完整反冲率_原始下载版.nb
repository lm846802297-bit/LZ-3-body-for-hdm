                 "R", "Xe"]}], RowBox[{"d", SubscriptBox["E", "R"]}]], "=", 
             FractionBox[SubscriptBox["N", "Av"], OverscriptBox[SubscriptBox[
                "M", "Xe"], "_"]], FractionBox[SubscriptBox["\[Rho]", 
               "\[Chi]"], SubscriptBox["m", SubscriptBox["\[Chi]", "1"]]], 
             SubscriptBox["\[Sum]", "A"], SubscriptBox["x", "A"], " ", 
