        Cell["(* \:4ece\:8d28\:91cf\:8868\:751f\:6210\:56fe\:4f8b\:ff0c\:4fee\
\:6539\:8d28\:91cf\:7ec4\:5408\:65f6\:81ea\:52a8\:540c\:6b65\:3002 \
*)\nbaseColors = {Red, RGBColor[0,.5,0], Black, Blue};\ncolors = \
Table[baseColors[[1 + Mod[i - 1, Length[baseColors]]]],\n  {i, \
Length[benchmarks]}];\n\nbenchmarkLabel[{scalarMassKeV_, massSplittingMeV_}] \
:=\n  \"ms=\" <> ToString[scalarMassKeV] <> \" keV, dm=\" <>\n  \
ToString[massSplittingMeV] <> \" MeV\";\nlabels = benchmarkLabel /@ \
benchmarks;\n\npositiveZero=(Select[#,Last[#]>0&]&)/@curvesZero;\npositivePol\
e=(Select[#,Last[#]>0&]&)/@curvesPole;\nstylesZero=Directive[#,Dashed,Opacity\
[.7]]&/@colors;\nstylesPole=Directive[#,Thick]&/@colors;\nratePlot=ListLogPlo\
t[Join[positivePole,positiveZero],Joined->True,\n \
PlotStyle->Join[stylesPole,stylesZero],PlotRange->All,Frame->True,\n \
FrameLabel->{\"Recoil energy E_R (keV)\",\"Rate [events/(tonne year \
keV)]\"},\n PlotLegends->Placed[Join[(#<>\"; pole\"&)/@labels,(#<>\"; \
zero\"&)/@labels],Below],\n ImageSize->Large,PlotLabel->\"Vector-vector \
model: fixed pole width vs zero-width reference\"];\nratePlot", "Input", 
         ExpressionUUID -> "e9005ada-a540-2e49-b45b-670cd3e8c1f0"], 
        Cell["ratioCurves=Table[Select[MapThread[If[#1[[2]]>0 && \
#2[[2]]>0,{#1[[1]],#2[[2]]/#1[[2]]},Nothing]&,\n \
{curvesZero[[i]],curvesPole[[i]]}],ListQ],{i,Length[benchmarks]}];\nratioPlot\
=ListLinePlot[ratioCurves,Joined->True,PlotStyle->(Directive[#,Thick]&/@color\
s),\n PlotRange->All,Frame->True,FrameLabel->{\"Recoil energy E_R \
(keV)\",\"Pole width / zero-width rate\"},\n \
PlotLegends->Placed[labels,Below],ImageSize->Large,\n PlotLabel->\"Width \
sensitivity (points with zero reference omitted)\"];\nratioPlot", "Input", 
         ExpressionUUID -> "e528b5e3-7de0-5449-80bf-d690be9fc38f"]}, Open]], 
     Cell[CellGroupData[
