\:8ba1\:7b97\:5757 *)\n  scalarMassGeV = scalarMassKeV * keVToGeV;  (* \
\:5c06\:6807\:91cf\:8d28\:91cf\:4ece keV \:6362\:7b97\:4e3a GeV *)\n  \
massSplittingGeV = massSplittingMeV * megaElectronVoltToGeV;  (* \
\:5c06\:8d28\:91cf\:5288\:88c2\:4ece MeV \:6362\:7b97\:4e3a GeV *)\n\n  \
