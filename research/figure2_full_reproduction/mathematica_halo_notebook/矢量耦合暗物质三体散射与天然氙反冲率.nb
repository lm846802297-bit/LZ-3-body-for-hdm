*)\nmegaElectronVoltToGeV = 10^-3;  (* \:5b9a\:4e49 MeV \:5230 GeV \
\:7684\:6362\:7b97\:56e0\:5b50 *)\ngevToKeV = 10^6;  (* \:5b9a\:4e49 GeV \
\:5230 keV \:7684\:6362\:7b97\:56e0\:5b50 *)\n\npoleWidthRow[{scalarMassKeV_, \
