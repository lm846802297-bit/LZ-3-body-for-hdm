  Cell["\:5efa\:7acb\:5355\:4f4d\:6362\:7b97\:3001\:5bf9\:7167\:7528 Gauss \
\:8282\:70b9\:3001\:56db\:77e2\:91cf\:548c Dirac \:77e9\:9635\:3002", 
   "Text"], Cell["cKm=299792.458;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n cCm=2.99792458*10^10;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n GeV2cm2=0.3893793721*10^-27;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\n(* GL weights from Jacobi matrix. \
The angular phi weights sum to one. \
*)\ngl[n_Integer?Positive]:=gl[n]=Module[{b,vals,vec,order},\n \
b=Table[k/Sqrt[4. k^2-1.],{k,1,n-1}];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)\n\n \
{vals,vec}=Eigensystem[DiagonalMatrix[b,1]+DiagonalMatrix[b,-1]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\n order=Ordering[vals];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n Transpose[{vals[[order]],2 \
(vec[[order,1]])^2}]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\nmdot[a_,b_]:=a[[1]] \
b[[1]]-a[[2;;4]].b[[2;;4]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\nboost[a_,beta_]:=Module[{b2=beta.beta,g,p},\n If[b2<10^-30,Return[a]];  \
(* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n If[b2>=1,Throw[\"Invalid boost\"]]; \
 (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\n g=1/Sqrt[1-b2];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n p=a[[2;;4]].beta;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:5e38\:6570\:3001\:79ef\:5206\:8282\:70b9\
\:4e0e\:56db\:52a8\:91cf\:5de5\:5177\[CloseCurlyDoubleQuote]\:4e2d\:7684\
