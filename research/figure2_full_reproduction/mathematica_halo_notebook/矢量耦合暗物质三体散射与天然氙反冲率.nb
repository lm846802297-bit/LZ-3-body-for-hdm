  Cell["(* Run in a separate kernel: original FeynArts and FeynCalc export \
overlapping names. *)\nbase = DirectoryName[$InputFileName];\nfaDir = \
FileNameJoin[{base,\"feynarts\",\"FeynArts-3.12\"}];\nIf[!FileExistsQ[FileNam\
eJoin[{faDir,\"FeynArts.m\"}]],Print[\"FeynArts missing: \
\",faDir];Exit[1]];\nAppendTo[$Path,faDir];\nGet[\"FeynArts`\"];\ntopologies=\
CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];\ndiagram\
s=InsertFields[topologies,{F[1],V[1]}->{F[1],S[1]},\n \
Model->\"ChiRadiation\",InsertionLevel->{Classes}];\namplitudes=CreateFeynAmp\
[diagrams,Truncated->True];\nPrint[\"Number of inserted diagrams: \
\",Length[diagrams]];\nPrint[\"Number of amplitudes: \
\",Length[amplitudes]];\nPrint[\"Amplitudes (FeynArts \
notation):\"];\nPrint[ToString[InputForm[amplitudes],PageWidth->Infinity]];\n\
If[Length[diagrams]!=2||Length[amplitudes]!=2,Exit[2]];\nExit[0];\n", 
   "Program", CellTags -> "embeddedFA"], Cell["(* \:5355\:72ec\:542f\:52a8 \
