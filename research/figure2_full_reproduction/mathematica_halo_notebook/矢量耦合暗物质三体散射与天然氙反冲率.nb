  Cell["root=DirectoryName[$InputFileName];\nbase=FileNameJoin[{root,\"feynru\
les-current\"}];\n$FeynRulesPath=base;FR$Parallel=False;FeynRules`MatrixSymbo\
l;\nGet[FileNameJoin[{base,\"FeynRules.m\"}]];\nSetDirectory[root];\nLoadMode\
l[FileNameJoin[{root,\"ThreeBodyVV.fr\"}]];\nPrint[\"LAGRANGIAN: \
\",ToString[InputForm[LInteraction],PageWidth->Infinity]];\nrules=FeynmanRule\
s[LInteraction];\nPrint[\"RULE COUNT: \",Length[rules]];\nPrint[\"RULES: \
\",ToString[InputForm[rules],PageWidth->Infinity]];\nscalar=Select[rules,!Fre\
eQ[#[[2]],gS]&];vector=Select[rules,!FreeQ[#[[2]],gX]&];nuclear=Select[rules,\
!FreeQ[#[[2]],gN]&];\nPrint[\"SCALAR, VECTOR, NUCLEON COUNTS: \
\",{Length[scalar],Length[vector],Length[nuclear]}];\nPrint[\"SCALAR \
STRUCTURE OK: \",And@@(FreeQ[#[[2]],Ga]&&!FreeQ[#[[2]],IndexDelta]& /@ \
scalar)];\nPrint[\"VECTOR STRUCTURE OK: \",And@@(!FreeQ[#[[2]],Ga]& /@ \
Join[vector,nuclear])];\nPrint[\"SCALAR COEFFICIENTS: \
\",ToString[InputForm[Simplify[#[[2]]/(I*gS)]& /@ scalar]]];\nPrint[\"VECTOR \
COEFFICIENTS: \",ToString[InputForm[Simplify[#[[2]]/(I*gX)]& /@ \
vector]]];\nhermiticity=CheckHermiticity[LInteraction];\nPrint[\"HERMITICITY \
RESULT: \
\",ToString[InputForm[hermiticity]]];\nExport[FileNameJoin[{root,\"feynrules_\
derived_rules.txt\"}],ToString[InputForm[rules],PageWidth->Infinity],\"Text\"\
];\nscalarOK=And@@(FreeQ[#[[2]],Ga]&&!FreeQ[#[[2]],IndexDelta]& /@ \
scalar);\nvectorOK=And@@(!FreeQ[#[[2]],Ga]& /@ \
Join[vector,nuclear]);\nIf[Length[rules]!=5||Length[scalar]!=2||Length[vector\
]!=2||Length[nuclear]!=1||!TrueQ[scalarOK]||!TrueQ[vectorOK]||hermiticity=!={\
},Exit[2]];\nPrint[\"CHECK: PASS\"];Exit[0];\n", "Program", 
