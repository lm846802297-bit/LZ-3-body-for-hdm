  Cell["FeynRules \:6a21\:578b\:4e0e\:62c9\:6c0f\:91cf", "Subsection"], 
  Cell["M$ModelName = \"InelasticScalarRadiation\";\nM$Information = {Authors \
-> {\"Independent verification\"}, Version -> \"1.0\"};\nM$Parameters = {\n \
gX == {ParameterType -> External, ComplexParameter -> False, Value -> 1.0, \
InteractionOrder -> {NP,1}, Description -> \"Off-diagonal vector \
coupling\"},\n gS == {ParameterType -> External, ComplexParameter -> False, \
Value -> 1.0, InteractionOrder -> {NP,1}, Description -> \"Off-diagonal \
scalar coupling\"},\n gN == {ParameterType -> External, ComplexParameter -> \
False, Value -> 1.0, InteractionOrder -> {NP,1}, Description -> \"Pointlike \
nucleon vector coupling\"}\n};\nM$ClassesDescription = {\n F[1] == {ClassName \
-> chiOne, AntiClassName -> chiOnebar, SelfConjugate -> False, Mass -> \
{MChiOne,1000.}, Width -> 0, PDG -> {9000001}},\n F[2] == {ClassName -> \
chiTwo, AntiClassName -> chiTwobar, SelfConjugate -> False, Mass -> \
{MChiTwo,1000.001}, Width -> {WChiTwo,0.0001518239116}, PDG -> {9000002}},\n \
F[3] == {ClassName -> nuc, AntiClassName -> nucbar, SelfConjugate -> False, \
Mass -> {MNuc,0.938272}, Width -> 0, PDG -> {9000003}},\n V[1] == {ClassName \
-> med, SelfConjugate -> True, Mass -> {MMed,10.}, Width -> 0, PDG -> \
{9000004}},\n S[1] == {ClassName -> scal, SelfConjugate -> True, Mass -> \
{MScal,0.0003}, Width -> 0, PDG -> {9000005}}\n};\nLX := gX med[mu] \
chiTwobar.Ga[mu].chiOne;\nLS := gS scal chiTwobar.chiOne;\nLN := gN med[mu] \
nucbar.Ga[mu].nuc;\nLInteraction := LX + HC[LX] + LS + HC[LS] + LN;\n\n\n", 
   "Program", CellTags -> "embeddedModel"], 
  Cell["\:72ec\:7acb\:76f8\:7a7a\:95f4\:4e0e NIntegrate \:6e90\:7801", 
   "Subsection"], Cell["(* Independent construction: axes aligned with the \
chi1+s system momentum.\n   Uses the existing trace only; no private momentum \
or quadrature functions. \
*)\nClearAll[niDot,niKinematics,niIntegrand,niI6];\nniDot[a_,b_]:=a[[1]] \
b[[1]]-a[[2;;4]].b[[2;;4]];\nniKinematics[m_?NumericQ,ms_?NumericQ,mA_?Numeri\
cQ,er_?NumericQ,v_?NumericQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[\n \
{beta,e,p,q,wmin,wmax,w2,angle,qvec,pin,Q,W,Qvec,Qmag,ez,ex,ey,rad,est,kstar,\
ks,ks4,pp,threshold,delta},\n beta=v/299792.458;e=m/Sqrt[1-beta^2];p=e \
beta;q=Sqrt[er (2 mA+er)];\n wmin=(m+ms)^2;wmax=m^2+2 p \
q-2(e+mA)er;delta=wmax-wmin;\n If[delta<=0,Return[$Failed]];\n w2=wmin+delta \
u^2;\n angle=(w2-m^2+2(e+mA)er)/(2 p q);\n \
If[Abs[angle]>1+10^-8,Return[$Failed]];\n qvec=q \
{Sqrt[Max[0,1-angle^2]],0,angle};\n \
pin={e,0,0,p};Q=Join[{e-er},{0,0,p}-qvec];\n \
W=Sqrt[w2];Qvec=Q[[2;;4]];Qmag=Norm[Qvec];\n \
ez=If[Qmag>0,Qvec/Qmag,{0,0,1}];\n \
ex=Normalize[Cross[If[Abs[ez[[3]]]<0.9,{0,0,1},{0,1,0}],ez]];ey=Cross[ez,ex];\
\n rad=Sqrt[Max[0,(w2-(m+ms)^2)(w2-(m-ms)^2)]];\n est=(w2-m^2+ms^2)/(2 \
W);kstar=rad/(2 W);\n ks=kstar (z ez+Sqrt[Max[0,1-z^2]](Cos[phi] ex+Sin[phi] \
ey));\n ks4=Join[{(Q[[1]] est+Qvec.ks)/W},ks+Qvec (est/W+(Qvec.ks)/(W \
(Q[[1]]+W)))];\n pp=Q-ks4;\n \
<|\"pin\"->pin,\"pout\"->pp,\"k\"->ks4,\"Q\"->Q,\"w2\"->w2,\"qvec\"->qvec,\n  \
 \"jac\"->2 delta \
u,\"phase\"->rad/w2,\"delta\"->delta|>\n];\nniIntegrand[m_?NumericQ,ms_?Numer\
icQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,width_?NumericQ,u_?Num\
ericQ,z_?NumericQ,phi_?NumericQ]:=Module[{kin},\n \
kin=niKinematics[m,ms,mA,er,v,u,z,phi];\n If[kin===$Failed,Return[0.]];\n \
kin[\"jac\"] kin[\"phase\"] \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],width]/(2 \
Pi)\n];\nOptions[niI6]={AccuracyGoal->3,PrecisionGoal->3,MaxRecursion->6};\nn\
iI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?Numeri\
cQ,width_?NumericQ,OptionsPattern[]]:=Module[{b,e,p,q,wmax},\n \
If[!TrueQ[m>0&&ms>=0&&dm>=0&&mA>0&&er>0&&0<v<299792.458&&width>=0],Print[\"In\
valid inputs\"];Return[$Failed]];\n b=v/299792.458;e=m/Sqrt[1-b^2];p=e \
b;q=Sqrt[er(2mA+er)];wmax=m^2+2p q-2(e+mA)er;\n \
If[wmax<=(m+ms)^2,Return[0.]];\n If[wmax>=(m+dm)^2,Print[\"On-shell chi2 \
accessible; off-shell calculation aborted.\"];Return[$Failed]];\n \
NIntegrate[niIntegrand[m,ms,dm,mA,er,v,width,u,z,phi],{u,0,1},{z,-1,1},{phi,0\
,2Pi},\n   \
Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0},AccuracyGoal->OptionVa\
lue[AccuracyGoal],\n   \
PrecisionGoal->OptionValue[PrecisionGoal],MaxRecursion->OptionValue[MaxRecurs\
ion]]\n];\n", "Program", CellTags -> "embeddedNI"], 
  Cell["FeynArts \:81ea\:52a8\:5bfc\:51fa\:7684\:901a\:7528\:6a21\:578b", 
   "Subsection"], Cell["(* Patched for use with FeynCalc *)\n(* * * * * * * * \
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *)\n(*        \
                                                                       *)\n(* \
        This file has been automatically generated by FeynRules.              \
*)\n(*                                                                        \
       *)\n(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * * * * * * *)\n\n\n\n(*     Kinematic indices    *)\n\nKinematicIndices[ F \
] = {};\nKinematicIndices[ V ] = {Lorentz};\nKinematicIndices[ S ] = \
{};\nKinematicIndices[ SV ] = {Lorentz};\nKinematicIndices[ U ] = \
{};\n\n$FermionLines = True;\n\n(*     Simplification rules    \
*)\n\nAttributes[ FAMetricTensor ] = Attributes[ FAScalarProduct ] = \
{Orderless}\n\nFAFourVector/: -FAFourVector[ mom_, mu_ ] := \
FAFourVector[Expand[-mom], mu]\n\nFAFourVector[ 0, _ ] = \
0\n\nSpinorType[j_Integer, ___] := MajoranaSpinor /; \
SelfConjugate[F[j]]\n\nSpinorType[_Integer, __] = FADiracSpinor\n\n(*     \
Generic propagators    *)\n\nM$GenericPropagators={\n\n(*general fermion \
propagator:*)\n\nAnalyticalPropagator[External][s1 \
F[j1,mom]]==\nFANonCommutative[SpinorType[j1][-mom,Mass[F[j1]]]],\n\nAnalytic\
alPropagator[Internal][s1 \
F[j1,mom]]==\nFANonCommutative[FADiracSlash[-mom]+Mass[F[j1]]]*\nI \
FAPropagatorDenominator[mom,Mass[F[j1]]],\n\n(*general vector boson \
propagator:*)\n\nAnalyticalPropagator[External][s1 \
V[j1,mom,{li2}]]==\nFAPolarizationVector[V[j1],mom,li2],\n\nAnalyticalPropaga\
tor[Internal][s1 V[j1,mom,{li1}->{li2}]]==\n-I \
FAPropagatorDenominator[mom,Mass[V[j1]]]*\n(FAMetricTensor[li1,li2]-(1-FAGaug\
eXi[V[j1]])*\nFAFourVector[mom,li1] \
FAFourVector[mom,li2]*\nFAPropagatorDenominator[mom,Sqrt[FAGaugeXi[V[j1]]] \
Mass[V[j1]]]),\n\n(*general mixing scalar-vector \
propagator:*)\n\nAnalyticalPropagator[Internal][s1 \
SV[j1,mom,{li1}->{li2}]]==\nI Mass[SV[j1]] \
FAPropagatorDenominator[mom,Mass[SV[j1]]]*\nFAFourVector[mom,If[s1==1||s1==-2\
,li1,li2]],\n\n(*general scalar \
propagator:*)\n\nAnalyticalPropagator[External][s1 \
S[j1,mom]]==1,\n\nAnalyticalPropagator[Internal][s1 S[j1,mom]]==\nI \
FAPropagatorDenominator[mom,Sqrt[FAGaugeXi[S[j1]]] Mass[S[j1]]],\n\n(*general \
Fadeev-Popov ghost propagator:*)\n\nAnalyticalPropagator[External][s1 \
U[j1,mom]]==1,\n\nAnalyticalPropagator[Internal][s1 \
U[j1,mom]]==\nI*FAPropagatorDenominator[mom,Sqrt[FAGaugeXi[U[j1]]] \
Mass[U[j1]]]\n}\n\n(*     Generic couplings    *)\n\nM$GenericCouplings = \
{\n\n\t (* FFS *)\n\nAnalyticalCoupling[s1 F[j1, mom1], s2 F[j2, mom2], s3 \
S[j3, mom3] ] ==\nG[-1][s1 F[j1], s2 F[j2], s3 \
S[j3]].{FANonCommutative[FAChiralityProjector[-1]], \
FANonCommutative[FAChiralityProjector[+1]]},\n\n\t (* FFV \
*)\n\nAnalyticalCoupling[s1 F[j1, mom1], s2 F[j2, mom2], s3 V[j3, mom3, \
{li3}] ] ==\nG[-1][s1 F[j1], s2 F[j2], s3 \
V[j3]].{FANonCommutative[FADiracMatrix[li3], FAChiralityProjector[-1] ], \
FANonCommutative[FADiracMatrix[li3], FAChiralityProjector[+1] ]}\n}\n\n(* \
FlippingRules: the flipping rules determines how Dirac\n   objects change \
when the order of fermion fields in the\n   coupling is reversed. In other \
words, it defines how the \n   coupling C[F, -F, ...] is derived from C[-F, \
F, ...].*)\n\nM$FlippingRules = {\nFANonCommutative[dm1:_FADiracMatrix | \
_FADiracSlash,dm2:_FADiracMatrix | _FADiracSlash, FAChiralityProjector[+1]] \
->\n FANonCommutative[dm2,dm1, \
FAChiralityProjector[+1]],\nFANonCommutative[dm1:_FADiracMatrix | \
_FADiracSlash,dm2:_FADiracMatrix | _FADiracSlash, FAChiralityProjector[-1]] \
->\n FANonCommutative[dm2,dm1, \
FAChiralityProjector[-1]],\nFANonCommutative[dm:_FADiracMatrix | \
_FADiracSlash, FAChiralityProjector[+1]] ->\n-FANonCommutative[dm, \
FAChiralityProjector[-1]],\nFANonCommutative[dm:_FADiracMatrix | \
_FADiracSlash, FAChiralityProjector[-1]] ->\n-FANonCommutative[dm, \
FAChiralityProjector[+1]]}\n\n\t(* TruncationRules: rule for omitting the \
wave functions of\n\t   external Propagators defined in this file. \
*)\n\nM$TruncationRules = {\n  _FAPolarizationVector -> 1,\n  _FADiracSpinor \
-> 1,\n  _MajoranaSpinor -> 1 \n}\n\t(* LastGenericRules: the very last rules \
that are applied to an\n\t   amplitude before it is returned by \
CreateFeynAmp. *)\n\nM$LastGenericRules = {\n  FAPolarizationVector[p_, _. \
mom:FourMomentum[Outgoing, _], li_] :>\n    \
Conjugate[FAPolarizationVector][p, mom, li]\n}\n\t(* cosmetics: *)\n\n\t(*  \
left spinor in chain + mom incoming -> \bar v\n\t    left spinor in chain + \
mom outgoing -> \bar u\n\t   right spinor in chain + mom incoming -> u\n\t   \
right spinor in chain + mom outgoing -> v *)\nFormat[\n  FermionChain[\n    \
FANonCommutative[_[s1_. mom1_, mass1_]],\n    r___,\n    \
FANonCommutative[_[s2_. mom2_, mass2_]]] ] :=\n  Overscript[If[FreeQ[mom1, \
Incoming], \"u\", \"v\"], \"_\"][mom1, mass1] .\n    r . If[FreeQ[mom2, \
Outgoing], \"u\", \"v\"][mom2, mass2]\n\nFormat[ FADiracSlash ] = \
\"gs\"\n\nFormat[ FADiracMatrix ] = \"ga\"\n\nFormat[ FAChiralityProjector[1] \
] = SequenceForm[\"om\", Subscript[\"+\"]]\n\nFormat[ \
FAChiralityProjector[-1] ] = SequenceForm[\"om\", \
Subscript[\"-\"]]\n\nFormat[ FAGaugeXi[a_] ] := SequenceForm[\"xi\", \
Subscript[a]]\n\nFormat[ FAPolarizationVector ] = \
\"ep\"\n\nUnprotect[Conjugate];\nFormat[ Conjugate[a_] ] = SequenceForm[a, \
Superscript[\"*\"]];\nProtect[Conjugate]\n\nFormat[ FAMetricTensor ] = \
\"g\"\n\nFormat[ FAScalarProduct[a__] ] := Dot[a]\n\nFormat[ FAFourVector[a_, \
b_] ] := a[b]\n\n", "Program", CellTags -> "embeddedFAgen"], 
  Cell["FeynArts \:81ea\:52a8\:5bfc\:51fa\:7684\:573a\:548c\:9876\:89d2", 
   "Subsection"], Cell["(* Patched for use with FeynCalc *)\n(* * * * * * * * \
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *)\n(*        \
                                                                     *)\n(*   \
      This file has been automatically generated by FeynRules.            \
*)\n(*                                                                        \
     *)\n(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * * * * * *)\n\n\nFR$ModelInformation={\n  \
ModelName->\"InelasticScalarRadiation\",\n  Authors -> {\"Independent \
verification\"},\n  Version -> \
\"1.0\"};\n\nFR$ClassesTranslation={};\n\nFR$InteractionOrderPerturbativeExpa\
nsion={{NP, 0}};\n\nFR$GoldstoneList={};\n\n(*     Declared indices    \
*)\n\n(*     Declared particles    *)\n\nM$ClassesDescription = {\nF[1] == \
{\n    SelfConjugate -> False,\n    PropagatorLabel -> chiOne,\n    \
PropagatorType -> Straight,\n    PropagatorArrow -> Forward,\n    Mass -> \
MChiOne,\n    Indices -> {} },\n\nF[2] == {\n    SelfConjugate -> False,\n    \
PropagatorLabel -> chiTwo,\n    PropagatorType -> Straight,\n    \
PropagatorArrow -> Forward,\n    Mass -> MChiTwo,\n    Indices -> {} \
},\n\nF[3] == {\n    SelfConjugate -> False,\n    PropagatorLabel -> nuc,\n   \
 PropagatorType -> Straight,\n    PropagatorArrow -> Forward,\n    Mass -> \
MNuc,\n    Indices -> {} },\n\nV[1] == {\n    SelfConjugate -> True,\n    \
PropagatorLabel -> med,\n    PropagatorType -> Sine,\n    PropagatorArrow -> \
None,\n    Mass -> MMed,\n    Indices -> {} },\n\nS[1] == {\n    \
SelfConjugate -> True,\n    PropagatorLabel -> scal,\n    PropagatorType -> \
ScalarDash,\n    PropagatorArrow -> None,\n    Mass -> MScal,\n    Indices -> \
{} }\n}\n\n\n(*        Definitions       *)\n\n\nMChiOne[ ___ ] := \
MChiOne;\nMChiTwo[ ___ ] := MChiTwo;\nMNuc[ ___ ] := MNuc;\nMMed[ ___ ] := \
MMed;\nMScal[ ___ ] := MScal;\n\n\n\n\n(*      Couplings (calculated by \
FeynRules)      *)\n\nM$CouplingMatrices = {\n\nC[ -F[1] , F[2] , S[1] ] == \
{{I*gc1, 0}, {I*gc1, 0}},\n\nC[ -F[2] , F[1] , S[1] ] == {{I*gc2, 0}, {I*gc2, \
0}},\n\nC[ -F[1] , F[2] , V[1] ] == {{I*gc3, 0}, {I*gc3, 0}},\n\nC[ -F[2] , \
F[1] , V[1] ] == {{I*gc4, 0}, {I*gc4, 0}},\n\nC[ -F[3] , F[3] , V[1] ] == \
{{I*gc5, 0}, {I*gc5, 0}}\n\n}\n\n(* * * * * * * * * * * * * * * * * * * * * * \
* * * * * * * * * * * * * *)\n\n(* Parameter replacement lists (These lists \
were created by FeynRules) *)\n\n(* FA Couplings *)\n\nM$FACouplings = {\n    \
 gc1 -> gS,\n     gc2 -> gS,\n     gc3 -> gX,\n     gc4 -> gX,\n     gc5 -> \
gN};\n\n", "Program", CellTags -> "embeddedFAmod"], 
  Cell["FeynArts \:6697\:7269\:8d28\:8f90\:5c04\:6a21\:578b", "Subsection"], 
  Cell["M$ClassesDescription = {\n F[1] == {SelfConjugate->False, \
Mass->Mchi1, PropagatorLabel->\"chi1\", PropagatorType->Straight, \
PropagatorArrow->Forward},\n F[2] == {SelfConjugate->False, Mass->Mchi2, \
PropagatorLabel->\"chi2\", PropagatorType->Straight, \
PropagatorArrow->Forward},\n V[1] == {SelfConjugate->True, Mass->MV, \
