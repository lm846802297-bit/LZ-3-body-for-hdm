\:628a\:7ed3\:679c\:7528\:4e8e \
I6\:3001\:5fae\:5206\:622a\:9762\:548c\:4e8b\:4ef6\:7387\:3002\:8fd9\:91cc\
\:4e0d\:4f9d\:8d56 FeynArts \:81ea\:52a8\:751f\:6210\:8d39\:66fc\:56fe\:3002"\
, "Text"], Cell["FCClearScalarProducts[];  (* \
\:6e05\:9664\:6b64\:524d\:8bbe\:7f6e\:7684 FeynCalc \:6807\:91cf\:79ef \
*)\nfcChain1 = GA[0].(GS[fcP]-GS[fcK]+fcM2);  (* \
\:6784\:9020\:7b2c\:4e00\:5f20\:8f90\:5c04\:56fe\:7684 Dirac \
\:77e9\:9635\:94fe *)\nfcChain2 = (GS[fcR]+GS[fcK]+fcM2).GA[0];  (* \
\:6784\:9020\:7b2c\:4e8c\:5f20\:8f90\:5c04\:56fe\:7684 Dirac \
\:77e9\:9635\:94fe *)\nfcChains = {fcChain1, fcChain2};  (* \
\:6536\:96c6\:4e24\:5f20\:56fe\:7684\:77e9\:9635\:94fe *)\n(* FeynCalc \:7684 \
ComplexConjugate \:751f\:6210 Dirac \
\:5171\:8f6d\:ff0c\:4ea4\:6362\:94fe\:7684\:987a\:5e8f\:3002 \
*)\nfcTraceMatrix = Table[  (* \
\:9010\:5bf9\:8ba1\:7b97\:632f\:5e45\:7684\:81ea\:65cb\:8ff9\:ff0c\:5305\
\:62ec\:5e72\:6d89\:9879 *)\n \
DiracSimplify[DiracTrace[(GS[fcR]+fcM).fcChains[[i]].(GS[fcP]+fcM).  (* \
\:5316\:7b80 FeynCalc \:7684 Dirac \:8ff9 *)\n   \
ComplexConjugate[fcChains[[j]]]], DiracTraceEvaluate->True]/2,  (* \
\:6784\:9020\:632f\:5e45\:7684 Dirac \:5171\:8f6d *)\n {i,2},{j,2}];  (* \
\:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\
\:8ba1\:7b97\:5757 *)", "Input"], Cell["\:5c06 FeynCalc \
\:7b26\:53f7\:81ea\:65cb\:8ff9\:4ee3\:5165\:56db\:52a8\:91cf\:548c\:4f20\
\:64ad\:5b50\:ff1b\:540e\:7eed\:7528 NIntegrate \:79ef\:5206\:3002", "Text"], 
  Cell["Clear[fcTraceNumeric];  (* \:6e05\:9664\:65e7\:5b9a\:4e49 \
*)\nfcTraceNumeric[pin_, pp_, k_, m_, m2_, w2_, width_] := Module[  (* \
\:5b9a\:4e49\:5c06 FeynCalc \
\:8ff9\:4ee3\:5165\:6570\:503c\:56db\:52a8\:91cf\:7684\:51fd\:6570 *)\n \
{vectors, dot, rules, d1, d2, coeff, matrix},  (* \
\:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\
\:8ba1\:7b97\:5757 *)\n vectors = <|fcP->pin, fcR->pp, fcK->k|>;  (* \
\:5173\:8054\:7b26\:53f7\:56db\:52a8\:91cf\:4e0e\:6570\:503c\:56db\:52a8\
\:91cf *)\n dot[a_,b_] := a[[1]] b[[1]] - a[[2;;4]].b[[2;;4]];  (* \
\:5b9a\:4e49\:95f5\:53ef\:592b\:65af\:57fa\:6807\:91cf\:79ef\:ff0c\:5ea6\
\:89c4\:4e3a\:6b63\:8d1f\:8d1f\:8d1f *)\n rules = \
{HoldPattern[Pair[Momentum[a_],Momentum[b_]]] :> dot[vectors[a],vectors[b]],  \
(* \:5efa\:7acb FeynCalc \
\:7b26\:53f7\:4e0e\:6570\:503c\:6807\:91cf\:79ef\:7684\:66ff\:6362\:89c4\
\:5219 *)\n   \
HoldPattern[TemporalPair[ExplicitLorentzIndex[0],TemporalMomentum[a_]]] :> \
vectors[a][[1]],  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:5173\:8054\:7b26\:53f7\:56db\:52a8\:91cf\
\:4e0e\:6570\:503c\:56db\:52a8\:91cf *)\n   fcM->m,fcM2->m2};  (* \
\:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\
\:5219\:6216\:663e\:793a\:9009\:9879 *)\n d1=dot[pin-k,pin-k]-m2^2; \
d2=w2-m2^2+I m2 width;  (* \
\:8ba1\:7b97\:8f90\:5c04\:524d\:4e2d\:95f4\:6001\:7684\:4f20\:64ad\:5b50\
\:5206\:6bcd *)\n coeff={1/d1,1/d2};  (* \
\:4fdd\:5b58\:4e24\:5f20\:56fe\:7684\:4f20\:64ad\:5b50\:7cfb\:6570 *)\n \
matrix=fcTraceMatrix /. rules;  (* \
\:628a\:6570\:503c\:56db\:52a8\:91cf\:4ee3\:5165 FeynCalc \
\:81ea\:65cb\:8ff9\:77e9\:9635 *)\n Re[Sum[coeff[[i]] Conjugate[coeff[[j]]] \
matrix[[i,j]],{i,2},{j,2}]]  (* \:5bf9\:6307\:5b9a\:6307\:6807\:6c42\:548c \
*)\n];  (* \
\:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)\n(* \
\:590d\:7528\:539f\:4e09\:4f53\:8fd0\:52a8\:5b66\:548c Gauss \
\:79ef\:5206\:8282\:70b9\:ff0c\:5c06\:81ea\:65cb\:8ff9\:66ff\:6362\:4e3a \
FeynCalc \:7ed3\:679c\:3002 *)\nClear[fcI6];  (* \
\:6e05\:9664\:65e7\:5b9a\:4e49 *)\nfcI6[m_,ms_,dm_,mA_,er_,v_,orders_,width_] \
:=  (* \:4ee5 FeynCalc \
\:81ea\:65cb\:8ff9\:4ee3\:66ff\:539f\:77e9\:9635\:8ff9\:5e76\:6267\:884c\
\:79ef\:5206 *)\n Block[{trace=fcTraceNumeric},  (* \
\:4e34\:65f6\:66ff\:6362\:5c40\:90e8\:51fd\:6570\:6216\:53d8\:91cf *)\n  \
I6[m,ms,dm,mA,er,v,orders,width]];  (* \
\:8ba1\:7b97\:56fa\:5b9a\:8fd0\:52a8\:5b66\:7684\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 *)\nPrint[\"FeynCalc trace prepared. \
\",FreeQ[fcTraceMatrix,DiracTrace]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)", 
   "Input"], Cell["\:542f\:7528 FeynCalc \:4f5c\:4e3a\:4e3b\:8ba1\:7b97", 
   "Subsubsection"], Cell["\:540e\:7eed\:56fa\:5b9a\:901f\:5ea6\:622a\:9762\
\:3001\:5929\:7136\:6c19\:4e8b\:4ef6\:7387\:53ca\:4f5c\:56fe\:9ed8\:8ba4\
\:4f7f\:7528 FeynCalc \
\:8ff9\:3002\:624b\:5199\:8ff9\:53ea\:4f5c\:4e3a\:6700\:540e\:7684\:5bf9\
\:7167\:ff1b\:66f4\:6539\:6e90\:4ee3\:7801\:540e\:8bf7\:4ece\:5934\:8fd0\
\:884c\:3002", "Text"], 
  Cell["(* \:4fdd\:7559\:624b\:5199\:77e9\:9635\:8ff9\:ff0c\:4f9b\:7b14\:8bb0\
\:672c\:672b\:5c3e\:72ec\:7acb\:5bf9\:7167\:4f7f\:7528\:3002 \
*)\nIf[!ValueQ[fcTraceMatrix] || !FreeQ[fcTraceMatrix, _DiracTrace],\n  \
Print[\"\:9519\:8bef\:ff1aFeynCalc \
\:81ea\:65cb\:8ff9\:5c1a\:672a\:5b8c\:6210\:ff0c\:4e0d\:80fd\:5f00\:59cb\
\:4e3b\:8ba1\:7b97\:3002\"]; Abort[]\n];\nIf[FreeQ[DownValues[trace], \
fcTraceNumeric],\n  Clear[manualTrace];\n  DownValues[manualTrace] = \
DownValues[trace] /. HoldPattern[trace] -> manualTrace;\n];\n(* \
\:4e09\:4f53\:79ef\:5206\:7684\:81ea\:65cb\:8ff9\:6539\:7531 FeynCalc \
\:7684\:8868\:8fbe\:5f0f\:8ba1\:7b97\:ff1b\:79ef\:5206\:4f7f\:7528\:540e\
\:9762\:7684 NIntegrate \:5355\:5143\:3002 *)\nClear[trace];\ntrace[args___] \
:= fcTraceNumeric[args];\nPrint[\"\:4e3b\:8ba1\:7b97\:5df2\:542f\:7528 \
FeynCalc \
\:81ea\:65cb\:8ff9\:ff1b\:624b\:5199\:77e9\:9635\:8ff9\:4fdd\:7559\:5728 \
manualTrace \:4e2d\:3002\"];", "Input"], Cell["Mathematica \
NIntegrate\:ff1a\:4e09\:4f53\:76f8\:7a7a\:95f4\:548c\:6655\:901f\:5ea6\:79ef\
\:5206", "Subsection"], Cell["\:5148\:6784\:9020\:56db\:52a8\:91cf\:4e0e\
\:76f8\:7a7a\:95f4 Jacobian\:ff0c\:518d\:7528 NIntegrate \
\:5bf9\:4e0d\:53d8\:8d28\:91cf\:548c\:4e24\:4e2a\:89d2\:79ef\:5206\:ff1b\
\:5bf9\:6bcf\:79cd\:6c19\:540c\:4f4d\:7d20\:ff0c\:518d\:7528 NIntegrate \
\:5bf9\:5b9e\:9a8c\:5ba4\:901f\:7387\:5206\:5e03\:79ef\:5206\:3002\:79ef\
\:5206\:7cbe\:5ea6\:7531\:7b2c\:4e8c\:8282\:63a7\:5236\:3002", "Text"], 
  Cell["(* \
\:6784\:9020\:672b\:6001\:56db\:52a8\:91cf\:ff1b\:76f8\:7a7a\:95f4\:6620\
\:5c04\:4e0d\:8c03\:7528\:539f\:7a0b\:5e8f\:7684 boost \:6216 Gauss \
\:6c42\:79ef\:51fd\:6570\:3002 \
*)\nClearAll[niDot,niKinematics,niIntegrand,niI6];  (* \
\:6e05\:9664\:7b26\:53f7\:7684\:65e7\:5b9a\:4e49\:53ca\:5c5e\:6027 \
*)\nniDot[a_,b_]:=a[[1]] b[[1]]-a[[2;;4]].b[[2;;4]];  (* \
\:5b9a\:4e49\:95f5\:53ef\:592b\:65af\:57fa\:56db\:5411\:91cf\:70b9\:79ef \
*)\nniKinematics[m_?NumericQ,ms_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?Numeri\
cQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[  (* \
\:72ec\:7acb\:5b9a\:4e49\:76f8\:7a7a\:95f4\:70b9\:548c\:672b\:6001\:56db\
\:52a8\:91cf\:7684\:6784\:9020 *)\n \
{beta,e,p,q,wmin,wmax,w2,angle,qvec,pin,Q,W,Qvec,Qmag,ez,ex,ey,rad,est,kstar,\
ks,ks4,pp,threshold,delta},  (* \
\:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\
\:8ba1\:7b97\:5757 *)\n beta=v/(299792458/1000);e=m/Sqrt[1-beta^2];p=e \
beta;q=Sqrt[er (2 mA+er)];  (* \
\:8ba1\:7b97\:5165\:5c04\:7c92\:5b50\:7684\:65e0\:91cf\:7eb2\:901f\:5ea6 *)\n \
wmin=(m+ms)^2;wmax=m^2+2 p q-2(e+mA)er;delta=wmax-wmin;  (* \
\:8ba1\:7b97\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:7684\:4e0a\:4e0b\:9650\
\:53ca\:533a\:95f4\:5bbd\:5ea6 *)\n If[delta<=0,Return[$Failed]];  (* \
\:82e5\:4e0d\:53d8\:8d28\:91cf\:4e0a\:4e0b\:9650\:5012\:7f6e\:ff0c\:8fd4\
\:56de\:5931\:8d25 *)\n w2=wmin+delta u^2;  (* \:7528 u \
\:7684\:5e73\:65b9\:6620\:5c04\:5230\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\
\:533a\:95f4 *)\n angle=(w2-m^2+2(e+mA)er)/(2 p q);  (* \
\:7531\:80fd\:91cf\:52a8\:91cf\:5b88\:6052\:8ba1\:7b97\:6838\:53cd\:51b2\
\:65b9\:5411\:4f59\:5f26 *)\n If[Abs[angle]>1+10^-8,Return[$Failed]];  (* \
\:68c0\:67e5\:53cd\:51b2\:89d2\:4f59\:5f26\:662f\:5426\:8d85\:51fa\:5141\
\:8bb8\:8303\:56f4 *)\n qvec=q {Sqrt[Max[0,1-angle^2]],0,angle};  (* \
\:6784\:9020\:5b9e\:9a8c\:5ba4\:7cfb\:6838\:53cd\:51b2\:4e09\:52a8\:91cf *)\n \
pin={e,0,0,p};Q=Join[{e-er},{0,0,p}-qvec];  (* \
\:6784\:9020\:5165\:5c04\:6697\:7269\:8d28\:56db\:52a8\:91cf *)\n \
W=Sqrt[w2];Qvec=Q[[2;;4]];Qmag=Norm[Qvec];  (* \
\:8ba1\:7b97\:672b\:6001\:4e0d\:53d8\:8d28\:91cf\:4e0e\:603b\:4e09\:52a8\
\:91cf\:7684\:5927\:5c0f *)\n ez=If[Qmag>0,Qvec/Qmag,{0,0,1}];  (* \
\:4ee5\:672b\:6001\:603b\:52a8\:91cf\:65b9\:5411\:5b9a\:4e49\:6781\:8f74 *)\n \
ex=Normalize[Cross[If[Abs[ez[[3]]]<0.9,{0,0,1},{0,1,0}],ez]];ey=Cross[ez,ex]; \
 (* \
\:5efa\:7acb\:4e0e\:672b\:6001\:603b\:52a8\:91cf\:5782\:76f4\:7684\:4e24\
\:4e2a\:6b63\:4ea4\:57fa\:65b9\:5411 *)\n \
rad=Sqrt[Max[0,(w2-(m+ms)^2)(w2-(m-ms)^2)]];  (* \
\:8ba1\:7b97\:6709\:91cf\:7eb2 K\[ADoubleDot]ll\[EAcute]n \
\:51fd\:6570\:7684\:5e73\:65b9\:6839 *)\n est=(w2-m^2+ms^2)/(2 \
W);kstar=rad/(2 W);  (* \
\:8ba1\:7b97\:6807\:91cf\:5728\:672b\:6001\:8d28\:5fc3\:7cfb\:7684\:80fd\
\:91cf *)\n ks=kstar (z ez+Sqrt[Max[0,1-z^2]](Cos[phi] ex+Sin[phi] ey));  (* \
\:6309\:8d28\:5fc3\:7cfb\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:6784\:9020\
\:6807\:91cf\:4e09\:52a8\:91cf *)\n ks4=Join[{(Q[[1]] est+Qvec.ks)/W},ks+Qvec \
(est/W+(Qvec.ks)/(W (Q[[1]]+W)))];  (* \
\:5c06\:6807\:91cf\:56db\:52a8\:91cf\:4ece\:8d28\:5fc3\:7cfb\:53d8\:6362\
\:81f3\:5b9e\:9a8c\:5ba4\:7cfb *)\n pp=Q-ks4;  (* \
\:7531\:56db\:52a8\:91cf\:5b88\:6052\:5f97\:5230\:672b\:6001\:6697\:7269\
\:8d28\:56db\:52a8\:91cf *)\n \
<|\"pin\"->pin,\"pout\"->pp,\"k\"->ks4,\"Q\"->Q,\"w2\"->w2,\"qvec\"->qvec,  \
(* \
\:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\
\:5219\:6216\:663e\:793a\:9009\:9879 *)\n   \"jac\"->2 delta \
u,\"phase\"->rad/w2,\"delta\"->delta|>  (* \
\:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\
\:5219\:6216\:663e\:793a\:9009\:9879 *)\n];  (* \
\:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)", "Input"], Cell["niIntegrand[m_?NumericQ,ms_?Num\
ericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,width_?NumericQ,u_?N\
umericQ,z_?NumericQ,phi_?NumericQ]:=Module[{kin},  (* \:5b9a\:4e49\:542b \
Jacobian\:3001\:76f8\:7a7a\:95f4\:6743\:91cd\:548c\:81ea\:65cb\:8ff9\:7684\
\:88ab\:79ef\:51fd\:6570 *)\n kin=niKinematics[m,ms,mA,er,v,u,z,phi];  (* \
\:5728\:5f53\:524d\:79ef\:5206\:70b9\:6784\:9020\:8fd0\:52a8\:5b66\:56db\
\:52a8\:91cf *)\n If[kin===$Failed,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:70b9\:65e0\:6548\:65f6\:4ee4\:8be5\:79ef\:5206\:70b9\
\:8d21\:732e\:4e3a\:96f6 *)\n kin[\"jac\"] kin[\"phase\"] \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],width]/(2 Pi)  \
(* \:76f8\:7a7a\:95f4 Jacobian \
\:4e58\:76f8\:7a7a\:95f4\:56e0\:5b50\:3001\:81ea\:65cb\:8ff9\:53ca\:65b9\
\:4f4d\:5e73\:5747\:7cfb\:6570 *)\n];  (* \
\:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f \
*)\nOptions[niI6]={AccuracyGoal->3,PrecisionGoal->3,MaxRecursion->6,WorkingPr\
ecision->30};  (* \
\:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\:5ea6\:76ee\:6807\:6216\
\:6700\:5927\:9012\:5f52\:6b21\:6570 \
*)\nniI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?N\
umericQ,width_?NumericQ,OptionsPattern[]]:=Module[{b,e,p,q,wmax},  (* \
\:5b9a\:4e49\:5c40\:90e8\:53d8\:91cf\:548c\:5c40\:90e8\:8ba1\:7b97 *)\n \
If[!TrueQ[m>0&&ms>=0&&dm>=0&&mA>0&&er>0&&0<v<(299792458/1000)&&width>=0],Prin\
t[\"Invalid inputs\"];Return[$Failed]];  (* \
\:68c0\:67e5\:8d28\:91cf\:3001\:53cd\:51b2\:80fd\:91cf\:3001\:901f\:5ea6\
\:548c\:5bbd\:5ea6\:662f\:5426\:4f4d\:4e8e\:5141\:8bb8\:8303\:56f4 *)\n \
b=v/(299792458/1000);e=m/Sqrt[1-b^2];p=e b;q=Sqrt[er(2mA+er)];wmax=m^2+2p \
q-2(e+mA)er;  (* \
\:8ba1\:7b97\:5165\:5c04\:901f\:5ea6\:3001\:80fd\:91cf\:3001\:52a8\:91cf\
\:4e0e\:4e0d\:53d8\:8d28\:91cf\:4e0a\:9650 *)\n \
