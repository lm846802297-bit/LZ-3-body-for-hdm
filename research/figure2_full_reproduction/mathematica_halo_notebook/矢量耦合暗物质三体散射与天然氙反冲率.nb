   "Subsubsection"], Cell["\:4e0b\:9762\:7684\:4ee3\:7801\:76f4\:63a5\:4fdd\
\:5b58\:5728\:672c\:7b14\:8bb0\:672c\:ff0c\:53ef\:5c55\:5f00\:9605\:8bfb\
\:6216\:7f16\:8f91\:ff1b\:6267\:884c\:5176\:540e\:7684\:8fd0\:884c\:5355\
\:5143\:65f6\:ff0c\:5c06\:5728\:72ec\:7acb\:5185\:6838\:4e2d\:4f7f\:7528\
\:8fd9\:91cc\:7684\:4ee3\:7801\:3002", "Text"], 
  Cell["base=DirectoryName[$InputFileName]; \
AppendTo[$Path,FileNameJoin[{base,\"feynarts\",\"FeynArts-3.12\"}]];\nGet[\"F\
eynArts`\"]; (* INSERT_NOTEBOOK_ENGINE \
*)\ntop=CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];\
\nins=InsertFields[top,{F[1],V[1]}->{F[1],S[1]},Model->\"ChiRadiation\",Inser\
tionLevel->{Classes}];\namp=CreateFeynAmp[ins,Truncated->True];\nterms=List@@\
amp;\nPrint[\"amp terms \
\",Length[terms]];\nchains=Cases[terms,FermionChain[a_,b_,c_]:>{a,b,c},Infini\
ty];\ndens=Cases[terms,PropagatorDenominator[a_,Mchi2]:>a,Infinity];\nPrint[\
\"chains \",Length[chains],\" dens \",Length[dens]];\nPrint[\"chain1 \
\",ToString[InputForm[chains[[1]]]]];\nPrint[\"den1 \
\",ToString[InputForm[dens[[1]]]]];\nIf[Length[chains]!=2||Length[dens]!=2,Ex\
it[1]];\nClear[faNumericTrace,faPieces];\nfaPieces[pin_,pp_,k_,m2_,width_]:=M\
odule[{qv,vectors,mom,vert,parts,den,vals},\n qv=pp+k-pin;\n \
vectors={FourMomentum[Incoming,1]->pin,FourMomentum[Incoming,2]->qv,\n        \
  FourMomentum[Outgoing,1]->pp,FourMomentum[Outgoing,2]->k};\n \
mom[x_]:=x/.vectors;\n vert[x_]:=x/.{\n   \
HoldPattern[NonCommutative[ChiralityProjector[_]]] :> id/2,\n   \
HoldPattern[NonCommutative[DiracMatrix[Index[Lorentz,1]],ChiralityProjector[_\
]]] :> g0/2,\n   HoldPattern[NonCommutative[Mchi2+DiracSlash[t_]]] :> (m2 \
id+slash[mom[t]]),\n   gs->1,gv->1};\n parts=Map[vert,chains,{2}];\n \
den=Table[mdot[mom[dens[[i]]],mom[dens[[i]]]]-m2^2+If[i==1,I m2 \
width,0],{i,2}];\n vals=Table[Dot@@parts[[i]]/den[[i]],{i,2}];\n (* Each \
FeynArts vertex contributes i; remove their common -1 phase. *)\n \
-vals\n];\nfaNumericTrace[pin_,pp_,k_,m_,m2_,w2_,width_]:=Module[{g,bar},\n \
g=Total[faPieces[pin,pp,k,m2,width]];bar=g0.ConjugateTranspose[g].g0;\n \
Re[Tr[(slash[pp]+m id).g.(slash[pin]+m \
id).bar]]/2];\nargs=Rest[$ScriptCommandLine];\nIf[Length[args]==10,\n \
{m,ms,dm,mA,er,v,nw,nz,np,g2input}=ToExpression /@ args;ord={nw,nz,np},\n \
m=1000.;ms=.0003;dm=.001;mA=131*.93149410242;er=.0002;v=776.;ord={6,6,4};g2in\
put=1.];\npole=Chi2Width[m,ms,dm,g2input];\nsamples=Reap[Block[{trace=Functio\
n[{p,r,k,m1,m2,w,g},Sow[{p,r,k,m1,m2,w,g}];0.]},I6[m,ms,dm,mA,er,v,{2,2,2},po\
le]]][[2,1]];\nsample=First[samples];{pin,pp,k,m1,m2,w2,width}=sample;\nfa=fa\
Pieces[pin,pp,k,m2,width];\nref={ (slash[pp+k]+m2 id).g0/(w2-m2^2+I m2 \
width),\n g0.(slash[pin-k]+m2 \
id)/(mdot[pin-k,pin-k]-m2^2)};\nPrint[\"amplitude relative matrix norms: \
\",Table[Norm[Flatten[fa[[i]]-ref[[i]]]]/Norm[Flatten[ref[[i]]]],{i,2}]];\nt0\
=trace@@sample;t1=faNumericTrace@@sample;\nPrint[\"trace original=\",t0,\" \
FA=\",t1,\" relative=\",t1/t0-1];\nDo[\n \
original=I6[m,ms,dm,mA,er,v,ord,width];\n \
generated=Block[{trace=faNumericTrace},I6[m,ms,dm,mA,er,v,ord,width]];\n \
Print[\"width=\",width,\" original I6=\",original,\" FA I6=\",generated,\" \
relative=\",generated/original-1],\n {width,{pole}}];\n", "Program", 
   CellTags -> "embeddedFANumeric"], 
  Cell["(* \:8c03\:7528\:72ec\:7acb\:5185\:6838\:ff0c\:4f20\:5165\:5f53\:524d\
\:5df2\:9009\:62e9\:7684\:8d28\:91cf\:3001\:80fd\:91cf\:3001\:901f\:5ea6\
\:3001\:9636\:6570\:548c g2\:3002 *)\nfaCheckScript = \
writeEmbeddedScript[\"embeddedFANumeric\", False];  (* \:5b9a\:4f4d FeynArts \
\:6570\:503c\:5bf9\:7167\:811a\:672c *)\nfaCheckExecutable = \
SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \"Windows\", \
\"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed];  (* \
\:67e5\:627e\:6267\:884c\:5bf9\:7167\:6240\:9700\:7684 Wolfram \:7a0b\:5e8f \
*)\nfaCheckInputs = Join[{  (* \
