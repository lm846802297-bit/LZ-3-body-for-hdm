Gauss \:6c42\:79ef\:6bd4\:8f83\:3002", "Text"], 
  Cell["\:8be5\:5b9e\:73b0\:8ba1\:7b97\:56fa\:5b9a\:901f\:5ea6\:7684\:5355\
\:540c\:4f4d\:7d20\:4e09\:4f53\:622a\:9762\:ff0c\:4e0d\:5305\:542b\:5929\
\:7136\:6c19\:901f\:5ea6\:5e73\:5747\:6216\:63a2\:6d4b\:5668\:54cd\:5e94\
\:ff1bFeynCalc \
\:4e0e\:539f\:7a0b\:5e8f\:5171\:7528\:76f8\:540c\:7406\:8bba\:76f8\:7a7a\
