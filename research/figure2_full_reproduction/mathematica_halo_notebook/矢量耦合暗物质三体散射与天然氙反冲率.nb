lue[AccuracyGoal],  (* \
\:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\:5ea6\:76ee\:6807\:6216\
\:6700\:5927\:9012\:5f52\:6b21\:6570 *)\n   \
PrecisionGoal->OptionValue[PrecisionGoal],MaxRecursion->OptionValue[MaxRecurs\
ion]]  (* \
\:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\:5ea6\:76ee\:6807\:6216\
\:6700\:5927\:9012\:5f52\:6b21\:6570 *)\n];  (* \
\:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)", "Input"], Cell["(* \:5c06\:539f Gauss I6 \
\:4fdd\:5b58\:4e3a\:672b\:5c3e\:7684\:5bf9\:7167\:51fd\:6570\:3002 \
*)\nClear[gaussI6];\nDownValues[gaussI6]=DownValues[I6]/.HoldPattern[I6]->gau\
ssI6;\n(* \:4e3b\:8ba1\:7b97\:ff1a\:4f7f\:7528 Mathematica NIntegrate \
\:79ef\:5206\:4e09\:4f53\:76f8\:7a7a\:95f4\:3002 \
*)\nClear[I6];\nI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?Num\
ericQ,\n \
v_?NumericQ,opts_Association,width_?NumericQ]:=Module[{wp,vals,result},\n \
If[er<=0,Return[0.]];\n wp=opts[\"WorkingPrecision\"];\n (* \
\:4ee5\:6307\:5b9a\:5de5\:4f5c\:7cbe\:5ea6\:8ba1\:7b97\:ff1b\:8fd9\:4e0d\
\:4f1a\:6062\:590d\:7528\:6237\:8f93\:5165\:672c\:8eab\:672a\:63d0\:4f9b\
\:7684\:6709\:6548\:6570\:5b57\:3002 *)\n \
vals=N[Rationalize[{m,ms,dm,mA,er,v,width},0],wp];\n \
result=niI6[Sequence@@vals,AccuracyGoal->opts[\"AccuracyGoal\"],\n  \
PrecisionGoal->opts[\"PrecisionGoal\"],MaxRecursion->opts[\"MaxRecursion\"],W\
orkingPrecision->wp];\n If[!NumericQ[result],Throw[\"NIntegrate phase-space \
calculation failed\"]];result\n];\n(* \
\:4e3b\:8ba1\:7b97\:ff1a\:6bcf\:4e2a\:6c19\:540c\:4f4d\:7d20\:7684\:5b9e\
\:9a8c\:5ba4\:901f\:5ea6\:5206\:5e03\:4e5f\:7528 NIntegrate \
\:79ef\:5206\:3002 \
*)\nClear[Rate];\nRate[erKeV_?NumericQ,ms_?NumericQ,dm_?NumericQ,pars_Associa\
tion]:=Module[\n \
{m=pars[\"mchi\"],v0=pars[\"v0\"],ve=pars[\"vEarth\"],vesc=pars[\"vEsc\"],\n  \
rho=pars[\"rho\"],weights=pars[\"abundance\"],speedOpts=pars[\"nv\"],vmax,vmi\
n,mA,acc,sum=0.,conv,integrand},\n vmax=ve+vesc;\n \
Do[mA=a*0.93149410242;vmin=VMin[m,ms,mA,erKeV*10^-6];\n  If[vmin<vmax,\n   \
integrand[v_?NumericQ]:=SpeedPDF[v,v0,ve,vesc]*(v/299792.458)*\n    \
DifferentialCrossSection[a,erKeV,v,ms,dm,pars];\n   \
acc=NIntegrate[integrand[v],{v,vmin,vmax},\n    \
Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0},\n    \
AccuracyGoal->speedOpts[\"AccuracyGoal\"],PrecisionGoal->speedOpts[\"Precisio\
nGoal\"],\n    MaxRecursion->speedOpts[\"MaxRecursion\"]];\n   \
If[!NumericQ[acc],Throw[\"NIntegrate velocity calculation \
failed\"]];sum+=weights[a]*acc],\n  {a,pars[\"isotopes\"]}];\n (* \
\:6570\:5bc6\:5ea6\:3001\:5355\:4f4d\:9776\:6838\:6570\:3001\:622a\:9762\
\:3001\:80fd\:91cf\:4e0e\:65f6\:95f4\:5355\:4f4d\:8f6c\:6362\:3002 *)\n \
conv=(rho/m)*2.99792458*10^10*(6.02214076*10^23*1000/pars[\"molarMass\"])*\n  \
0.3893793721*10^-27*10^-6*86400*365250;\n \
conv*sum\n];\nPrint[\"\:4e3b\:8ba1\:7b97\:5df2\:542f\:7528 FeynCalc + \
NIntegrate\:ff08\:4e09\:4f53\:76f8\:7a7a\:95f4\:53ca\:901f\:5ea6\:5206\:5e03\
\:ff09\:3002\"];", "Input"], 
  Cell[
