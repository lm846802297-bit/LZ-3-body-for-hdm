\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n   ang+=zn[[2]] \
pa,{zn,quadrZ}];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 \
*)\n\n  sum+=weight Sqrt[lam]/w2 ang,{node,quadrW}];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\nsum];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\n\n", "Input", CellTags -> "inlineEngine"], 
  Cell["\:6fc0\:53d1\:6001\:8870\:53d8\:5bbd\:5ea6 Chi2Width", 
   "Subsubsection"], Cell["\:8ba1\:7b97 chi2 \[RightArrow] chi1+s \
\:7684\:7eaf\:6807\:91cf\:90e8\:5206\:5bbd\:5ea6\:ff1b\:8d28\:91cf\:7edf\
\:4e00\:4e3a \
GeV\:3002\:95ed\:5408\:6216\:6070\:5904\:9608\:503c\:65f6\:8fd4\:56de\:96f6\
\:3002\:56e0\:5f0f\:5206\:89e3\:907f\:514d\:5927\:8d28\:91cf\:76f8\:51cf\
\:635f\:5931\:7cbe\:5ea6\:3002", "Text"], Cell["(* Factorized Kallen function \
avoids loss of precision for TeV masses and keV splittings.\n   Assumptions: \
Dirac fermions, pure scalar Yukawa g2 s chibar2 chi1,\n   one open decay \
channel. The returned partial width is used as the total width. \
*)\nChi2Width[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,g_?NumericQ]:=Module[{m2,\
phase,heavy},\n If[!TrueQ[m>0 && ms>=0 && dm>=0],Throw[\"Invalid masses in \
Chi2Width\"]];  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:90e8\:5206\:5bbd\:5ea6 \
*)\n\n If[dm<=ms,Return[0.]];  (* \
\:8870\:53d8\:9608\:503c\:672a\:6253\:5f00\:65f6\:5bbd\:5ea6\:4e3a\:96f6 \
*)\n\n m2=m+dm;  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf \
*)\nphase=dm^2-ms^2;  (* \
\:8ba1\:7b97\:8d28\:91cf\:5288\:88c2\:5bf9\:5e94\:7684\:9608\:503c\:56e0\
\:5b50 *)\nheavy=(2 m+dm)^2-ms^2;  (* \
\:8ba1\:7b97\:8d28\:91cf\:548c\:5bf9\:5e94\:7684\:8fd0\:52a8\:5b66\:56e0\
\:5b50 *)\n\n Abs[g]^2 Sqrt[phase] heavy^(3/2)/(16 Pi m2^3)];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6fc0\:53d1\:6001\:8870\:53d8\:5bbd\:5ea6 \
Chi2Width\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\
\:9aa4 *)\n\n", "Input", CellTags -> "inlineEngine"], 
  Cell["\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\:5206\:5e03", 
   "Subsubsection"], Cell["\:8ba1\:7b97\:6700\:5c0f\:5165\:5c04\:901f\:5ea6\
\:548c\:622a\:65ad\:901f\:5ea6\:5206\:5e03\:3002", "Text"], 
  Cell["VMin[m_,ms_,mA_,er_]:=Module[{q,a},If[er<=0,Return[Infinity]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\n q=Sqrt[2 mA er+er^2];  (* \
\:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf \
*)\na=ms+(mA er+ms^2/2)/m;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\n cKm (q er+a Sqrt[q^2-er^2+a^2])/(q^2+a^2)];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\nSpeedPDF[v_,v0_,ve_,vesc_]:=Module[{z,n,b},\n If[v<0 || \
v>=vesc+ve,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)\n\n \
z=vesc/v0;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\nn=Erf[z]-2 z Exp[-z^2]/Sqrt[Pi];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\n \
b=If[v<vesc-ve,Exp[-((v-ve)/v0)^2]-Exp[-((v+ve)/v0)^2],Exp[-((v-ve)/v0)^2]-Ex\
p[-z^2]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\n v b/(Sqrt[Pi] v0 ve n)];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\
\:5206\:5e03\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)\n\n", "Input", CellTags -> "inlineEngine"], 
  Cell["AFH \:6838\:54cd\:5e94", "Subsubsection"], 
  Cell["\:52a0\:8f7d\:5916\:90e8 AFH \
\:7a0b\:5e8f\:ff0c\:63d0\:53d6\:5e76\:7f13\:5b58\:5404\:6c19\:540c\:4f4d\
\:7d20\:7684 M \:578b\:7b49\:6807\:91cf\:54cd\:5e94\:3002", "Text"], 
  Cell["(* Normalization R(0)=A^2 removes finite-precision density table \
offset. *)\nLoadResponses[path_String,isotopes_List]:=Module[{expr,aa,b},\n \
If[!FileExistsQ[path],Throw[\"AFH package missing\"]];  (* \
\:51c6\:5907\:5404\:540c\:4f4d\:7d20\:6838\:54cd\:5e94 *)\nGet[path];  (* \
\:52a0\:8f7d AFH \:539f\:7a0b\:5e8f *)\n\n Do[aa=iso;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 \
*)\ndmformfactor`SetIsotope[54,aa,\"default\",\"default\"];  (* \
\:9009\:62e9\:6838\:7d20\:53ca\:5176\:6838\:5bc6\:5ea6 *)\n\n \
expr=dmformfactor`ResponseNuclear[Global`y,1,0,0];  (* \:63d0\:53d6 M \
\:578b\:6838\:54cd\:5e94 *)\n\n \
If[!NumericQ[N[expr/.Global`y->0]],Throw[\"AFH response failed\"]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n b=5.0677 Sqrt[41.467/(45. aa^(-1./3.)-25. \
aa^(-2./3.))];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n responseExpr[aa]=expr;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\nresponseZero[aa]=N[expr/.Global`y->0];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\nbInv[aa]=b,\n {iso,isotopes}];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\nisotopes];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\nresponse[a_,er_,mA_]:=a^2 \
N[responseExpr[a]/.Global`y->((Sqrt[2 mA er+er^2] \
bInv[a]/2)^2)]/responseZero[a];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n(* The recoil energy accepted by this public \
function is in keV. *)\nNuclearResponse[a_Integer, recoilKeV_?NumericQ] := \
Module[{nuclearMass},\n If[!TrueQ[recoilKeV >= 0], Throw[\"Recoil energy must \
be nonnegative\"]];  (* \
\:8ba1\:7b97\:8be5\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\
\:5e94 *)\n\n If[!ValueQ[responseZero[a]], Throw[\"Load the requested isotope \
before evaluating its response\"]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n nuclearMass = a*0.93149410242;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n response[a, recoilKeV*10^-6, nuclearMass]\n];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]AFH \
\:6838\:54cd\:5e94\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n\n", "Input", CellTags -> "inlineEngine"], 
  Cell["\:8ba1\:7b97\:6a21\:578b\:7684\:6781\:70b9\:5bbd\:5ea6", 
   "Subsubsection"], Cell["\:6839\:636e\:8d28\:91cf\:548c g\:2082 \
\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6\:ff1b\:6b64\:5bbd\:5ea6\:53ea\:5305\
\:542b\:5df2\:5efa\:6a21\:7684\:8870\:53d8\:9053\:3002", "Text"], 
  Cell["(* \
\:622a\:9762\:548c\:4e8b\:4ef6\:7387\:5171\:7528\:540c\:4e00\:6781\:70b9\
\:5bbd\:5ea6\:ff1b\:4e0d\:63d0\:4f9b\:96f6\:5bbd\:5ea6\:8ba1\:7b97\:5904\
\:65b9\:3002 *)\nwidthForParameters[mass_, scalarMass_, splitting_, \
params_Association] := Module[{mode},\n mode = Lookup[params, \"widthMode\", \
\"pole\"];  (* \:9ed8\:8ba4\:4e3a\:6781\:70b9\:5bbd\:5ea6 *)\n If[mode =!= \
\"pole\" || !KeyExistsQ[params, \"g2\"],\n  Throw[\"Only pole width is \
supported; g2 is required\"]];\n Chi2Width[mass, scalarMass, splitting, \
params[\"g2\"]]  (* \:6309\:8d28\:91cf\:548c g2 \:8ba1\:7b97\:5bbd\:5ea6 \
*)\n];", "Input", CellTags -> "inlineEngine"], 
  Cell["\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\:5206\:622a\:9762", 
   "Subsubsection"], Cell["\:5c06\:81ea\:65cb\:8ff9\:3001\:76f8\:7a7a\:95f4\
\:79ef\:5206\:3001\:4f20\:64ad\:5b50\:548c AFH \
\:6838\:54cd\:5e94\:5408\:6210\:4e3a\:56fa\:5b9a\:901f\:5ea6\:622a\:9762\
\:3002", "Text"], Cell["(* Eq. (radiative-recoil): I6 includes dW^2, dz and \
the phi average.\n   Inputs are GeV except speedKms. The result is in GeV^-3. \
*)\nfixedSpeedCrossSection[nuclearMass_, recoilGeV_, speedKms_, mass_, \
scalarMass_,\n   splitting_, mediatorMass_, couplingSquared_, orders_, \
width_, nuclearResponse_] :=\n Module[{beta, incomingMomentum, \
mediatorDenominator, integral},\n  If[!TrueQ[0 < speedKms < cKm], \
Throw[\"Fixed-speed cross section requires 0 < v < c\"]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  beta = speedKms/cKm;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  incomingMomentum = mass*beta/Sqrt[1-beta^2];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  mediatorDenominator = \
(mediatorMass^2+2*nuclearMass*recoilGeV)^2;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  If[!TrueQ[mediatorDenominator > 0], Throw[\"Vector \
mediator denominator is zero\"]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  integral = I6[mass, scalarMass, splitting, \
nuclearMass, recoilGeV, speedKms, orders, width];  (* \
\:8fdb\:884c\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 *)\n\n  \
nuclearMass*couplingSquared*nuclearResponse*integral/\n   \
(256*Pi^3*incomingMomentum^2*mediatorDenominator)\n ];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n\nDifferentialCrossSection[a_Integer, \
recoilKeV_?NumericQ, speedKms_?NumericQ,\n   scalarMassGeV_?NumericQ, \
splittingGeV_?NumericQ, params_Association] :=\n Module[{nuclearMass, \
nuclearResponse, width},\n  nuclearResponse = NuclearResponse[a, recoilKeV];  \
(* \
\:8ba1\:7b97\:8be5\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\
\:5e94 *)\n\n  nuclearMass = a*0.93149410242;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\
\:5206\:622a\:9762\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)\n\n  width = widthForParameters[params[\"mchi\"], \
scalarMassGeV, splittingGeV, params];  (* \
\:6309\:5bbd\:5ea6\:9009\:9879\:51b3\:5b9a\:4f20\:64ad\:5b50\:5bbd\:5ea6 \
*)\n\n  fixedSpeedCrossSection[nuclearMass, recoilKeV*10^-6, speedKms,\n   \
params[\"mchi\"], scalarMassGeV, splittingGeV, params[\"mV\"],\n   \
params[\"couplingSq\"], params[\"quad\"], width, nuclearResponse]\n ];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n\n", "Input", 
   CellTags -> "inlineEngine"], Cell["\:540c\:4f4d\:7d20\:52a0\:6743\:3001\
\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e", "Subsubsection"], 
  Cell["\:5bf9\:901f\:5ea6\:5206\:5e03\:4e0e\:5929\:7136\:6c19\:540c\:4f4d\
\:7d20\:4e30\:5ea6\:6c42\:548c\:ff0c\:8f6c\:6362\:5355\:4f4d\:5e76\:8ba1\
\:7b97\:66f2\:7ebf\:3002", "Text"], Cell["Rate[erKeV_?NumericQ,ms_?NumericQ,d\
m_?NumericQ,p_Association]:=Module[\n {er=erKeV \
10^-6,m=p[\"mchi\"],v0=p[\"v0\"],ve=p[\"vEarth\"],vesc=p[\"vEsc\"],coupling=p\
[\"couplingSq\"],mv=p[\"mV\"],order=p[\"quad\"],isotopes=p[\"isotopes\"],weig\
hts=p[\"abundance\"],nv=p[\"nv\"],rho=p[\"rho\"],sum=0.,mA,vmin,vmax,acc,v,w,\
conv,width,nuclearResponse},\n width=widthForParameters[m,ms,dm,p];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)\n\n vmax=ve+vesc;  \
(* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\
\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\n Do[mA=a \
0.93149410242;  (* \:8bbe\:7f6e\:9776\:6838\:8d28\:91cf \
*)\nvmin=VMin[m,ms,mA,er];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\
\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)\n\n If[vmin<vmax,\n  \
acc=0.;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\
\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nnuclearResponse=NuclearResponse[a,erKeV];  (* \
\:8ba1\:7b97\:8be5\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\
\:5e94 *)\n\n  Do[v=(vmax+vmin)/2+(vmax-vmin)node[[1]]/2;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\
\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 \
*)\nw=node[[2]](vmax-vmin)/2;  (* \
