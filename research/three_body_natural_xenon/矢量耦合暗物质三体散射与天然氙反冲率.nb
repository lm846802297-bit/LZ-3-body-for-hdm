Cell[CellGroupData[{

Cell["\:672c\:8282\:8ba1\:7b97\:6e90\:4ee3\:7801\:ff1aFeynArts\:ff1a\:632f\
\:5e45\:4e0e\:79ef\:5206\:5bf9\:7167", "Subsubsection",ExpressionUUID->\
"a579dd6a-7dce-4849-a4d6-2fdf37118b25"],

Cell["\:4e0b\:9762\:7684\:4ee3\:7801\:76f4\:63a5\:4fdd\:5b58\:5728\:672c\:7b14\
\:8bb0\:672c\:ff0c\:53ef\:5c55\:5f00\:9605\:8bfb\:6216\:7f16\:8f91\:ff1b\:6267\
