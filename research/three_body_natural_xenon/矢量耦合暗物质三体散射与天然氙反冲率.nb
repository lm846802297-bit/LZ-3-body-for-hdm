\:7acb\:5185\:6838\:4e2d\:4f7f\:7528\:8fd9\:91cc\:7684\:4ee3\:7801\:3002", \
"Text",ExpressionUUID->"39a3b9c8-4099-2b47-8fbe-2fed99a51535"],

Cell["\<\
base=DirectoryName[$InputFileName]; \
PrependTo[$Path,FileNameJoin[{base,\"..\",\"three_body_calculation_and_\
validation\",\"mathematica_halo_notebook\",\"FeynRules_check\",\"FeynArts-3.\
12\"}]];
Get[\"FeynArts`\"]

top=CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];
ins=InsertFields[top,{F[1],V[1]}->{F[1],S[1]},Model->\"ChiRadiation\",\
InsertionLevel->{Classes}];
amp=CreateFeynAmp[ins,Truncated->True];
(* INSERT_NOTEBOOK_ENGINE *)
terms=List@@amp;
Print[\"amp terms \",Length[terms]];
chains=Cases[terms,FermionChain[a_,b_,c_]:>{a,b,c},Infinity];
dens=Cases[terms,PropagatorDenominator[a_,Mchi2]:>a,Infinity];
Print[\"chains \",Length[chains],\" dens \",Length[dens]];
Print[\"chain1 \",ToString[InputForm[chains[[1]]]]];
Print[\"den1 \",ToString[InputForm[dens[[1]]]]];
If[Length[chains]!=2||Length[dens]!=2,Exit[1]];
Clear[faNumericTrace,faPieces];
faPieces[pin_,pp_,k_,m2_,width_]:=Module[{qv,vectors,mom,vert,parts,den,vals},\

 qv=pp+k-pin;
 vectors={FourMomentum[Incoming,1]->pin,FourMomentum[Incoming,2]->qv,
          FourMomentum[Outgoing,1]->pp,FourMomentum[Outgoing,2]->k};
 mom[x_]:=x/.vectors;
 vert[x_]:=x/.{
   HoldPattern[NonCommutative[ChiralityProjector[_]]] :> id/2,
   HoldPattern[NonCommutative[DiracMatrix[Index[Lorentz,1]],\
ChiralityProjector[_]]] :> g0/2,
   HoldPattern[NonCommutative[Mchi2+DiracSlash[t_]]] :> (m2 \
id+slash[mom[t]]),
   gs->1,gv->1};
 parts=Map[vert,chains,{2}];
 den=Table[mdot[mom[dens[[i]]],mom[dens[[i]]]]-m2^2+If[i==1,I m2 \
width,0],{i,2}];
 vals=Table[Dot@@parts[[i]]/den[[i]],{i,2}];
 (* Each FeynArts vertex contributes i; remove their common -1 phase. *)
 -vals
];
faNumericTrace[pin_,pp_,k_,m_,m2_,w2_,width_]:=Module[{g,bar},
 g=Total[faPieces[pin,pp,k,m2,width]];bar=g0.ConjugateTranspose[g].g0;
 Re[Tr[(slash[pp]+m id).g.(slash[pin]+m id).bar]]/2];
args=Rest[$ScriptCommandLine];
If[Length[args]==10,
 {m,ms,dm,mA,er,v,nw,nz,np,g2input}=ToExpression /@ args;ord={nw,nz,np},
 m=1000.;ms=.0003;dm=.001;mA=131*.93149410242;er=.0002;v=776.;ord={6,6,4};\
g2input=1.];
pole=Chi2Width[m,ms,dm,g2input];
samples=Reap[Block[{trace=Function[{p,r,k,m1,m2,w,g},Sow[{p,r,k,m1,m2,w,g}];0.\
]},I6[m,ms,dm,mA,er,v,{2,2,2},pole]]][[2,1]];
sample=First[samples];{pin,pp,k,m1,m2,w2,width}=sample;
fa=faPieces[pin,pp,k,m2,width];
ref={ (slash[pp+k]+m2 id).g0/(w2-m2^2+I m2 width),
 g0.(slash[pin-k]+m2 id)/(mdot[pin-k,pin-k]-m2^2)};
Print[\"amplitude relative matrix norms: \
\",Table[Norm[Flatten[fa[[i]]-ref[[i]]]]/Norm[Flatten[ref[[i]]]],{i,2}]];
t0=trace@@sample;t1=faNumericTrace@@sample;
Print[\"trace original=\",t0,\" FA=\",t1,\" relative=\",t1/t0-1];
Do[
 original=I6[m,ms,dm,mA,er,v,ord,width];
 generated=Block[{trace=faNumericTrace},I6[m,ms,dm,mA,er,v,ord,width]];
 Print[\"width=\",width,\" original I6=\",original,\" FA I6=\",generated,\" \
relative=\",generated/original-1],
 {width,{pole}}];
Print[\"FA_DATA:\",ExportString[N[{t0,t1,original,generated},16],\"RawJSON\",\
\"Compact\"->True]];
\
\>", "Program",
 CellTags->
  "embeddedFANumeric",ExpressionUUID->"89d1371a-201e-0d44-a4ea-bdbc99d529fa"],

Cell["\<\
Clear[faCheckResult,faData,faDataLines]; (* \:6e05\:9664\:4e0a\:6b21 FeynArts \
\:632f\:5e45\:5bf9\:7167\:72b6\:6001 *)
(* \:8c03\:7528\:72ec\:7acb\:5185\:6838\:ff0c\:4f20\:5165\:5f53\:524d\:5df2\
\:9009\:62e9\:7684\:8d28\:91cf\:3001\:80fd\:91cf\:3001\:901f\:5ea6\:3001\:9636\
\:6570\:548c g2\:3002 *)
faCheckScript = writeEmbeddedScript[\"embeddedFANumeric\", False];  (* \:5b9a\
\:4f4d FeynArts \:6570\:503c\:5bf9\:7167\:811a\:672c *)
faCheckExecutable = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \
\"Windows\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed];  (* \:67e5\:627e\:6267\:884c\:5bf9\
\:7167\:6240\:9700\:7684 Wolfram \:7a0b\:5e8f *)
faCheckInputs = Join[{  (* \:6536\:96c6\:5f53\:524d\:8d28\:91cf\:3001\:53cd\
\:51b2\:80fd\:91cf\:3001\:901f\:5ea6\:53ca\:79ef\:5206\:9636\:6570 *)
  darkMatterMassGeV, selectedScalarMassGeV, selectedSplittingGeV,  (* \:672c\
\:884c\:6d89\:53ca\:ff1a\:8f93\:5165\:6697\:7269\:8d28 chi1 \
\:8d28\:91cf\:ff0c\:5355\:4f4d GeV\:ff1b\:9009\:62e9\:5e76\:6362\:7b97\:6807\
\:91cf\:8d28\:91cf\:4e3a GeV\:ff1b\:9009\:62e9\:5e76\:6362\:7b97\:8d28\:91cf\
\:5288\:88c2\:4e3a GeV *)
  selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS  (* \:672c\
\:884c\:6d89\:53ca\:ff1a\:8bbe\:7f6e\:68c0\:67e5\:7528\:5165\:5c04\:901f\:5ea6\
 km/s\:ff1b\:7528 A \:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\
\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\:51b2\:80fd\:91cf\:6362\:7b97\:4e3a GeV *)
}, gaussCheckOrders, {g2val}];  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\
\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
If[!FileExistsQ[faCheckScript] || faCheckExecutable === $Failed ||  (* \:5224\
\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\
\:652f *)
   !And @@ (NumericQ /@ faCheckInputs),  (* \:7ee7\:7eed\:68c0\:67e5\:8f93\
\:5165\:6761\:4ef6\:6216\:6570\:503c\:6709\:6548\:6027 *)
  Print[\"\:8bf7\:5148\:8fd0\:884c\:7b2c\:4e00\:81f3\:7b2c\:4e09\:8282\:ff0c\
\:5e76\:68c0\:67e5 FeynArts \:6587\:4ef6\:548c wolframscript\:3002\"],  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
  faCheckResult = RunProcess[Join[{faCheckExecutable, \"-file\", \
faCheckScript},  (* \:6267\:884c FeynArts \
\:632f\:5e45\:4e0e\:79ef\:5206\:7684\:6570\:503c\:5bf9\:7167 *)
    ToString[#, InputForm] & /@ faCheckInputs]];  (* \:5c06\:6570\:503c\:6216\
\:8868\:8fbe\:5f0f\:8f6c\:6362\:4e3a\:6587\:5b57 *)
  Print[faCheckResult[\"StandardOutput\"]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
  If[faCheckResult[\"StandardError\"] =!= \"\", \
Print[faCheckResult[\"StandardError\"]]];  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
  Print[\"\:6267\:884c\:9000\:51fa\:7801\:ff1a\", \
faCheckResult[\"ExitCode\"]]  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\
\:8ba1\:7b97\:7ed3\:679c *)
]  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)
If[ValueQ[faCheckResult] && faCheckResult[\"ExitCode\"] === 0,
 faDataLines = StringCases[faCheckResult[\"StandardOutput\"], \
RegularExpression[\"FA_DATA:([^\\\\r\\\\n]+)\"] -> \"$1\"]; (* \:63d0\:53d6\
\:5b50\:5185\:6838\:8f93\:51fa\:7684 JSON \:6570\:636e *)
 If[Length[faDataLines] == 1,
  faData = \
Quiet[Check[ImportString[First[faDataLines],\"RawJSON\"],$Failed]]; (* \:8bfb\
\:53d6\:624b\:5199\:548c FeynArts \:7684\:5bf9\:7167\:503c *)
  If[ListQ[faData] && Length[faData] == 4, \
Print[Grid[{{\"\:68c0\:67e5\:9879\",\"\:624b\:5199\:77e9\:9635\",\"FeynArts\",\
\"\:76f8\:5bf9\:5dee\"},{\"\:5355\:4e2a\:76f8\:7a7a\:95f4\:70b9\:7684\:81ea\
\:65cb\:8ff9\",faData[[1]],faData[[2]],If[faData[[1]]!=0,faData[[2]]/faData[[\
1]]-1,Indeterminate]},{\"Gauss I6 \
(GeV\.b2)\",faData[[3]],faData[[4]],If[faData[[3]]!=0,faData[[4]]/faData[[3]]-\
1,Indeterminate]}},Frame->All]]; Print[\"\:4e24\:6761\:8ba1\:7b97\:5171\:7528\
\:76f8\:7a7a\:95f4\:6620\:5c04\:3001\:79ef\:5206\:8282\:70b9\:548c\:5bbd\:5ea6\
\:ff1b\:8be5\:5bf9\:7167\:68c0\:67e5\:632f\:5e45\:4e0e\:81ea\:65cb\:8ff9\:ff0c\
\:4e0d\:5355\:72ec\:8bc1\:660e\:6838\:54cd\:5e94\:6216\:6574\:4e2a\:79ef\:5206\
\:5b9e\:73b0\:3002\"], Print[\"FeynArts \:6570\:503c\:7ed3\:679c\:683c\:5f0f\
\:65e0\:6548\:ff0c\:8bf7\:67e5\:770b\:4e0a\:65b9\:65e5\:5fd7\:3002\"]],
  Print[\"\:672a\:627e\:5230 FeynArts \:6570\:503c\:7ed3\:679c\:ff1b\:8bf7\
\:67e5\:770b\:4e0a\:65b9\:65e5\:5fd7\:6216\:68c0\:67e5\:76f8\:7a7a\:95f4\:662f\
\:5426\:5173\:95ed\:3002\"]]];\
\>", "Input",
 CellLabel->
  "In[1273]:=",ExpressionUUID->"5d96aa57-8592-774c-9d81-2fc452117853"],

