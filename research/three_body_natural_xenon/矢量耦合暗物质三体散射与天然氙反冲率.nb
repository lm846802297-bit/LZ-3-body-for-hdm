\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\:51b2\:80fd\:91cf\:6362\:7b97\:4e3a GeV *)
}, gaussCheckOrders, {g2val}];  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\
\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
If[!FileExistsQ[faCheckScript] || faCheckExecutable === $Failed ||  (* \:5224\
\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\
\:652f *)
   !And @@ (NumericQ /@ faCheckInputs),  (* \:7ee7\:7eed\:68c0\:67e5\:8f93\
\:5165\:6761\:4ef6\:6216\:6570\:503c\:6709\:6548\:6027 *)
