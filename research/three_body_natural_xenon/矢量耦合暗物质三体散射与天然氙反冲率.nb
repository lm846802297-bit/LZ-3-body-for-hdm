\\:5728\\:56fa\\:5b9a\\:70b9\\:53ca benchmark \\:8868\\:663e\\:793a\\:3002\"\
\>", "Print",ExpressionUUID->"902c4431-afca-2446-a2aa-a6e324cde1ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* \:4e3b\:8ba1\:7b97\:76f4\:63a5\:91c7\:7528 NIntegrate\:ff1bGauss \:6bd4\
\:8f83\:51fd\:6570\:5728\:9a8c\:8bc1\:90e8\:5206\:5b9a\:4e49\:3002 *)
(* \:4e3b\:8ba1\:7b97\:ff1a\:4f7f\:7528 Mathematica NIntegrate \:79ef\:5206\
\:4e09\:4f53\:76f8\:7a7a\:95f4\:3002 *)
Clear[I6];
I6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,
 v_?NumericQ,opts_Association,width_?NumericQ]:=Module[{wp,vals,result},
 If[er<=0,Return[0.]];
 wp=opts[\"WorkingPrecision\"];
 (* \:4ee5\:6307\:5b9a\:5de5\:4f5c\:7cbe\:5ea6\:8ba1\:7b97\:ff1b\:8fd9\:4e0d\
\:4f1a\:6062\:590d\:7528\:6237\:8f93\:5165\:672c\:8eab\:672a\:63d0\:4f9b\:7684\
\:6709\:6548\:6570\:5b57\:3002 *)
 vals=N[Rationalize[{m,ms,dm,mA,er,v,width},0],wp];
 result=niI6[Sequence@@vals,AccuracyGoal->opts[\"AccuracyGoal\"],
  PrecisionGoal->opts[\"PrecisionGoal\"],MaxRecursion->opts[\"MaxRecursion\"],\
WorkingPrecision->wp];
 If[!NumericQ[result],Throw[\"NIntegrate phase-space calculation \
failed\"]];result
];
(* \:4e3b\:8ba1\:7b97\:ff1a\:6bcf\:4e2a\:6c19\:540c\:4f4d\:7d20\:7684\:5b9e\
\:9a8c\:5ba4\:901f\:5ea6\:5206\:5e03\:4e5f\:7528 NIntegrate \
\:79ef\:5206\:3002 *)
Clear[Rate];
Rate[erKeV_?NumericQ,ms_?NumericQ,dm_?NumericQ,pars_Association]:=Module[
 {m=pars[\"mchi\"],v0=pars[\"v0\"],ve=pars[\"vEarth\"],vesc=pars[\"vEsc\"],
  rho=pars[\"rho\"],weights=pars[\"abundance\"],speedOpts=pars[\"nv\"],vmax,\
vmin,mA,acc,sum=0.,conv,integrand},
 vmax=ve+vesc;
 Do[mA=Global`xenonNuclearMassGeV[a];vmin=VMin[m,ms,mA,erKeV*10^-6];
  If[vmin<vmax,
   integrand[v_?NumericQ]:=SpeedPDF[v,v0,ve,vesc]*(v/299792.458)*
    DifferentialCrossSection[a,erKeV,v,ms,dm,pars];
   acc=NIntegrate[integrand[v],{v,vmin,vmax},
    Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0},
    AccuracyGoal->speedOpts[\"AccuracyGoal\"],PrecisionGoal->speedOpts[\"\
PrecisionGoal\"],
    MaxRecursion->speedOpts[\"MaxRecursion\"]];
   If[!NumericQ[acc],Throw[\"NIntegrate velocity calculation \
failed\"]];sum+=weights[a]*acc],
  {a,pars[\"isotopes\"]}];
 (* \:6570\:5bc6\:5ea6\:3001\:5355\:4f4d\:9776\:6838\:6570\:3001\:622a\:9762\
\:3001\:80fd\:91cf\:4e0e\:65f6\:95f4\:5355\:4f4d\:8f6c\:6362\:3002 *)
 conv=(rho/m)*2.99792458*10^10*(6.02214076*10^23*1000/pars[\"molarMass\"])*
  0.3893793721*10^-27*10^-6*86400*365250;
 conv*sum
];
Print[\"\:4e3b\:8ba1\:7b97\:5df2\:542f\:7528 FeynCalc + \
NIntegrate\:ff08\:4e09\:4f53\:76f8\:7a7a\:95f4\:53ca\:901f\:5ea6\:5206\:5e03\
\:ff09\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1039]:=",ExpressionUUID->"a70205bb-46bf-224a-9882-858da3ba37a9"],

Cell["\<\
\"\\:4e3b\\:8ba1\\:7b97\\:5df2\\:542f\\:7528 FeynCalc + \
NIntegrate\\:ff08\\:4e09\\:4f53\\:76f8\\:7a7a\\:95f4\\:53ca\\:901f\\:5ea6\\:\
5206\\:5e03\\:ff09\\:3002\"\
\>", "Print",ExpressionUUID->"4c89130f-5495-694c-b51b-24859f11d2d5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4 \
\:5c06\:7269\:7406\:8f93\:5165\:4f20\:7ed9\:6570\:503c\:7a0b\:5e8f", \
"Subsection",ExpressionUUID->"21ae343e-0a77-2e4d-a4ec-8687ca533864"],

Cell["\:4e0b\:9762\:7684\:5173\:8054\:8868\:628a\:7269\:7406\:53d8\:91cf\:5bf9\
\:5e94\:5230\:6c42\:89e3\:5668\:53c2\:6570\:ff1b\:7edf\:4e00\:4f7f\:7528\:6781\
\:70b9\:5bbd\:5ea6\:3002", "Text",ExpressionUUID->"51c9fcf6-a2a0-204d-8a11-\
367595d203b2"],

Cell["\<\
parameters = <|  (* \:6c47\:603b\:540e\:7eed\:4e8b\:4ef6\:7387\:51fd\:6570\
\:4f7f\:7528\:7684\:8f93\:5165\:53c2\:6570 *)
  \"mchi\"       -> darkMatterMassGeV,  (* \:53c2\:6570 \
mchi\:ff1a\:6697\:7269\:8d28 chi1 \:8d28\:91cf GeV *)
  \"mV\"         -> mediatorMassGeV,  (* \:53c2\:6570 mV\:ff1a\:77e2\:91cf\
\:5a92\:4ecb\:8d28\:91cf GeV *)
  \"g2\"         -> g2val,  (* \:53c2\:6570 g2\:ff1a\:6697\:7269\:8d28\:4e0e\
\:6807\:91cf\:8026\:5408 *)
  \"couplingSq\" -> couplingProductSquared,  (* \:53c2\:6570 couplingSq\:ff1a\
\:8026\:5408\:4e58\:79ef\:7684\:6a21\:5e73\:65b9 *)
  \"rho\"        -> localDensityGeVPerCm3,  (* \:53c2\:6570 rho\:ff1a\:6697\
\:7269\:8d28\:5c40\:57df\:5bc6\:5ea6 *)
  \"v0\"         -> haloSpeedScaleKmPerS,  (* \:53c2\:6570 v0\:ff1a\:6655\
\:901f\:5ea6\:5c3a\:5ea6 km/s *)
  \"vEarth\"     -> earthSpeedKmPerS,  (* \:53c2\:6570 vEarth\:ff1a\:5730\
\:7403\:901f\:5ea6 km/s *)
  \"vEsc\"       -> escapeSpeedKmPerS,  (* \:53c2\:6570 \
vEsc\:ff1a\:9003\:9038\:901f\:5ea6 km/s *)
  \"molarMass\"  -> xenonMolarMassGPerMol,  (* \:53c2\:6570 molarMass\:ff1a\
\:5929\:7136\:6c19\:6469\:5c14\:8d28\:91cf g/mol *)
  \"isotopes\"   -> isotopes,  (* \:53c2\:6570 isotopes\:ff1a\:53c2\:4e0e\
\:8ba1\:7b97\:7684\:6c19\:540c\:4f4d\:7d20 *)
  \"abundance\"  -> abundances,  (* \:53c2\:6570 abundance\:ff1a\:540c\:4f4d\
\:7d20\:6570\:76ee\:4e30\:5ea6 *)
  \"quad\"       -> phaseSpaceOrders,  (* \:53c2\:6570 quad\:ff1a\:4e09\:4f53\
\:76f8\:7a7a\:95f4 NIntegrate \:53c2\:6570 *)
  \"nv\"         -> speedOrder  (* \:53c2\:6570 nv\:ff1a\:901f\:5ea6 \
NIntegrate \:53c2\:6570 *)
|>;  (* \:63a5\:7eed\:4e0a\:4e00\:884c\:7684\:53c2\:6570\:6216\:8868\:8fbe\
\:5f0f *)

pPole = Append[parameters, \"widthMode\" -> \"pole\"];  (* \:521b\:5efa\:6781\
\:70b9\:5bbd\:5ea6\:53c2\:6570\:7ec4 *)\
\>", "Input",
 CellLabel->
  "In[1047]:=",ExpressionUUID->"f95b6b93-d06d-a540-b33b-d8f6c65faa66"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5 \:8ba1\:7b97\:5404\:7ec4\:6781\:70b9\:5bbd\:5ea6", "Subsection",ExpressionUUID->"84c18b14-dbff-ce45-892b-01ab008c2cb3"],

Cell[CellGroupData[{

Cell["\<\
(* \:8f93\:5165\:7684\:8d28\:91cf\:5148\:6362\:7b97\:4e3a GeV\:ff0c\:5bbd\
\:5ea6\:7ed3\:679c\:518d\:6362\:56de keV\:3002 *)
keVToGeV = 10^-6;  (* \:5b9a\:4e49 keV \:5230 GeV \:7684\:6362\:7b97\:56e0\
\:5b50 *)
megaElectronVoltToGeV = 10^-3;  (* \:5b9a\:4e49 MeV \:5230 GeV \:7684\:6362\
\:7b97\:56e0\:5b50 *)
gevToKeV = 10^6;  (* \:5b9a\:4e49 GeV \:5230 keV \:7684\:6362\:7b97\:56e0\
\:5b50 *)

poleWidthRow[{scalarMassKeV_, massSplittingMeV_}] := Module[  (* \:5b9a\:4e49\
\:5355\:7ec4\:8d28\:91cf\:7684\:6781\:70b9\:5bbd\:5ea6\:8ba1\:7b97\:51fd\:6570\
 *)
  {scalarMassGeV, massSplittingGeV, widthGeV},  (* \:7ec4\:7ec7\:5f53\:524d\
\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
  scalarMassGeV = scalarMassKeV * keVToGeV;  (* \
\:5c06\:6807\:91cf\:8d28\:91cf\:4ece keV \:6362\:7b97\:4e3a GeV *)
  massSplittingGeV = massSplittingMeV * megaElectronVoltToGeV;  (* \:5c06\
\:8d28\:91cf\:5288\:88c2\:4ece MeV \:6362\:7b97\:4e3a GeV *)

  widthGeV = Chi2Width[  (* \:6309\:5f53\:524d\:8026\:5408\:548c\:8d28\:91cf\
\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6 *)
    darkMatterMassGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:8f93\:5165\:6697\
\:7269\:8d28 chi1 \:8d28\:91cf\:ff0c\:5355\:4f4d GeV *)
    scalarMassGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:5c06\:6807\:91cf\:8d28\
\:91cf\:4ece keV \:6362\:7b97\:4e3a GeV *)
    massSplittingGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:5c06\:8d28\:91cf\
\:5288\:88c2\:4ece MeV \:6362\:7b97\:4e3a GeV *)
    g2val  (* \:4f20\:5165\:53c2\:6570\:ff1a\:8bbe\:7f6e\:6697\:7269\:8d28\
\:4e0e\:6807\:91cf\:7684\:8026\:5408 g2\:ff0c\:540c\:65f6\:5f71\:54cd\:6781\
\:70b9\:5bbd\:5ea6 *)
  ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

  {scalarMassKeV, massSplittingMeV, widthGeV * gevToKeV}  (* \:7ec4\:7ec7\
\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757\
 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

widthTable = poleWidthRow /@ benchmarks;  (* \:5bf9\:5168\:90e8\:8d28\:91cf\
\:7ec4\:5408\:9010\:4e00\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6 *)
Print[\"Included isotope abundance: \", Total[Values[abundances]]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[\"g2 = \", g2val];  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\
\:7b97\:7ed3\:679c *)

Print[\"\:5404 benchmark \:7684\:5bbd\:5ea6\:5df2\:8ba1\:7b97\:ff1b\:4e0b\
\:65b9\:5c06\:4e0e\:4f20\:64ad\:5b50\:5206\:6bcd\:4e00\:8d77\:663e\:793a\:3002\
\"];\
\>", "Input",
 CellLabel->
  "In[1050]:=",ExpressionUUID->"442dcb22-ff33-6047-bd17-bdd45e152c57"],

Cell["\<\
\"Included isotope abundance: \"0.9981580000000001
\"g2 = \"1.
\"\\:5404 benchmark \
\\:7684\\:5bbd\\:5ea6\\:5df2\\:8ba1\\:7b97\\:ff1b\\:4e0b\\:65b9\\:5c06\\:4e0e\
\\:4f20\\:64ad\\:5b50\\:5206\\:6bcd\\:4e00\\:8d77\\:663e\\:793a\\:3002\"\
\>", "Print",ExpressionUUID->"985e3f09-7b8a-654f-8624-9f7a910be048"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5.1 \:6bcf\:7ec4 benchmark \:7684\:6781\:70b9\:5bbd\:5ea6\:4e0e\:4f20\
\:64ad\:5b50", "Subsubsection",ExpressionUUID->"758d0335-b1bd-2d44-83ab-\
bfb00fb4a32e"],

Cell["\<\
\:6bcf\:7ec4 benchmark \:5148\:7531 m\[Chi]1\:3001ms\:3001\[CapitalDelta]m \
\:548c g2 \:8ba1\:7b97\:6781\:70b9\:90e8\:5206\:5bbd\:5ea6 \[CapitalGamma](\
\[Chi]2\[RightArrow]\[Chi]1s)\:ff0c\:518d\:628a\:8be5\:7ec4\:7684\:5bbd\:5ea6\
\:4ee3\:5165\:8f90\:5c04\:540e\:4f20\:64ad\:5b50\:3002\:5f53\:524d\:5047\:8bbe\
\:8be5\:90e8\:5206\:5bbd\:5ea6\:4ee3\:8868\:603b\:5bbd\:5ea6\:ff1b\:5982\:679c\
\:5176\:4ed6\:8870\:53d8\:901a\:9053\:6253\:5f00\:ff0c\:9700\:8981\:52a0\:5165\
\:5b83\:4eec\:7684\:5bbd\:5ea6\:3002\:4ee5\:4e0b\:53ea\:663e\:793a\:4f20\:64ad\
\:5b50\:7684\:4e00\:5904\:793a\:4f8b\:79ef\:5206\:70b9\:ff0c\:5b9e\:9645 \
NIntegrate \:4f1a\:904d\:5386\:6574\:4e2a\:5141\:8bb8\:76f8\:7a7a\:95f4\:3002\
\
\>", "Text",ExpressionUUID->"907e3dc5-4797-b94d-bb1e-b118c74eaaa5"],

Cell["\<\
\:6781\:70b9\:5bbd\:5ea6\:91c7\:7528 \[CapitalGamma]=|g2|\.b2 Sqrt[\
\[CapitalDelta]m\.b2\[Minus]ms\.b2] \
((2m\[Chi]1+\[CapitalDelta]m)\.b2\[Minus]ms\.b2)^(3/2)/(16 \[Pi] \
m\[Chi]2\.b3)\:ff0c\:5176\:4e2d m\[Chi]2=m\[Chi]1+\[CapitalDelta]m\:ff1b\
\[CapitalDelta]m\[LessEqual]ms \:65f6\:6b64\:8870\:53d8\:901a\:9053\:5173\
\:95ed\:3002\:4e24\:5f20\:56fe\:7684\:5206\:6bcd\:5206\:522b\:662f D1=(p\
\[Minus]k)\.b2\[Minus]m\[Chi]2\.b2\:ff0cD2=W\.b2\[Minus]m\[Chi]2\.b2+i \
m\[Chi]2 \[CapitalGamma]\:3002\:4e0b\:8868\:7684 Im(D2)=m\[Chi]2 \
\[CapitalGamma]\:ff1b\:8fd9\:4e0d\:662f\:5bbd\:5ea6\:81ea\:8eab\:ff0c\:5355\
\:4f4d\:662f GeV\.b2\:3002\
\>", "Text",ExpressionUUID->"49bd4cdb-555b-c240-9863-5dc08eacd9ab"],

Cell[CellGroupData[{

Cell["\<\
(* \:4f7f\:7528\:7b2c\:4e00\:8282\:7684 benchmark \:548c\:68c0\:67e5\:70b9\
\:ff1b\:8d28\:91cf\:5185\:90e8\:7edf\:4e00\:6362\:7b97\:4e3a GeV\:3002 *)
widthPropagationRows = Table[ (* \:5bf9\:6bcf\:7ec4\:8d28\:91cf\:5355\:72ec\
\:8ba1\:7b97\:ff0c\:800c\:4e0d\:662f\:91cd\:590d\:4f7f\:7528\:9ed8\:8ba4\:5bbd\
\:5ea6 *)
 Module[{m,ms,dm,m2,ma,er,v,g,width,kin,w2,realDen,imagDen,status}, (* \:5c40\
\:90e8\:53d8\:91cf\:5206\:522b\:8868\:793a\:8d28\:91cf\:3001\:5bbd\:5ea6\:4e0e\
\:793a\:4f8b\:4f20\:64ad\:5b50\:5206\:6bcd *)
  {m,ms,dm,ma,er,v,g}=N[Rationalize[{darkMatterMassGeV,benchmark[[1]]*10^-6,\
benchmark[[2]]*10^-3,Global`xenonNuclearMassGeV[diagnosticIsotope],\
diagnosticRecoilKeV*10^-6,diagnosticSpeedKmPerS,g2val},0],30]; (* \
\:6362\:7b97\:5355\:4f4d\:5e76\:4f7f\:7528 30 \:4f4d\:5de5\:4f5c\:7cbe\:5ea6\
\:ff1b\:4e0d\:589e\:52a0\:8f93\:5165\:7cbe\:5ea6 *)
  m2=m+dm; (* \:6fc0\:53d1\:6001\:6781\:70b9\:8d28\:91cf m\[Chi]2=m\[Chi]1+\
\[CapitalDelta]m *)
  width=Chi2Width[m,ms,dm,g]; (* \:5bf9\:672c\:7ec4\:53c2\:6570\:8ba1\:7b97 \
\[Chi]2\[RightArrow]\[Chi]1 s \
\:6781\:70b9\:90e8\:5206\:5bbd\:5ea6\:ff0c\:5355\:4f4d GeV *)
  imagDen=m2*width; (* \:7b2c\:4e8c\:4e2a\:4f20\:64ad\:5b50\:5206\:6bcd\:7684\
\:865a\:90e8\:7cfb\:6570\:ff0c\:5355\:4f4d GeV\.b2 *)
  kin=niKinematics[m,ms,ma,er,v,2/5,1/4,6/5]; (* \:793a\:4f8b\:53d6 u=0.4\
\:3001z=0.25\:3001phi=1.2\:ff0cW\.b2 \:968f\:79ef\:5206\:70b9\:53d8\:5316 *)
  If[kin===$Failed, realDen=\"\:76f8\:7a7a\:95f4\:5173\:95ed\"; status=\"\
\:8be5\:68c0\:67e5\:70b9\:5173\:95ed\", (* \:6ca1\:6709\:5141\:8bb8\:76f8\
\:7a7a\:95f4\:65f6\:4e0d\:6784\:9020\:8be5\:70b9\:7684 W\.b2 *)
   w2=kin[\"w2\"]; realDen=N[w2-m2^2,8]; (* \:8ba1\:7b97\:793a\:4f8b\:5206\
\:6bcd\:7684\:5b9e\:90e8 W\.b2\[Minus]m\[Chi]2\.b2\:ff0c\:5355\:4f4d GeV\.b2 *)
   status=If[TrueQ[kin[\"delta\"]+(m+ms)^2>=m2^2],\"\:53ef\:80fd\:5230\:8fbe\
\:6781\:70b9\:ff1a\:4e3b\:79ef\:5206\:4f1a\:505c\:6b62\",\"\:79bb\:58f3\:ff1a\
\:4e3b\:79ef\:5206\:53ef\:7ee7\:7eed\"] (* \:6807\:793a\:5f53\:524d\:7a0b\
\:5e8f\:7684\:6781\:70b9\:6761\:4ef6 *)
  ];
  {benchmark[[1]],benchmark[[2]],N[m2,12],N[width*10^6,8],N[imagDen,8],\
realDen,status} (* \:6309\:987a\:5e8f\:4fdd\:5b58\:672c\:7ec4\:8f93\:5165\
\:3001\:5bbd\:5ea6\:548c\:4f20\:64ad\:5b50\:5206\:6bcd *)
 ], {benchmark,benchmarks} (* \:904d\:5386\:7b2c\:4e00\:8282\:5168\:90e8 \
benchmark *)
];
Print[\"\:5171\:540c\:8f93\:5165\:ff1am\[Chi]1 = \",darkMatterMassGeV,\" GeV\
\:ff0cg2 = \",g2val,\"\:ff1b\:793a\:4f8b\:70b9 Xe-\",diagnosticIsotope,\"\
\:ff0cER = \",diagnosticRecoilKeV,\" keV\:ff0cv = \",diagnosticSpeedKmPerS,\" \
km/s\:3002\"]; (* \
\:663e\:793a\:5171\:540c\:8f93\:5165\:ff0c\:4fbf\:4e8e\:786e\:8ba4\:53c2\:6570\
 *)
Print[\"\:793a\:4f8b\:79ef\:5206\:53d8\:91cf\:ff1au=0.4\:ff0cz=0.25\:ff0cphi=\
1.2\:ff1b\:4f20\:64ad\:5b50\:7684\:5b9e\:90e8\:968f W\.b2 \:6539\:53d8\:ff0c\
\:5bbd\:5ea6\:6309\:8be5 benchmark \:56fa\:5b9a\:3002\"]; (* \:89e3\:91ca\
