Cell["\<\
(* \:68c0\:67e5\:4e00\:4e2a\:76f8\:7a7a\:95f4\:70b9\:7684\:672b\:6001\:8d28\
\:91cf\:58f3\:548c\:56db\:52a8\:91cf\:5b88\:6052\:3002 *)
niExample = niKinematics[darkMatterMassGeV, selectedScalarMassGeV,  (* \:9009\
\:53d6\:4e00\:4e2a\:76f8\:7a7a\:95f4\:70b9\:68c0\:67e5\:8fd0\:52a8\:5b66 *)
  selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS, 0.45, \
0.23, 1.2];  (* \:672c\:884c\:6d89\:53ca\:ff1a\:8bbe\:7f6e\:68c0\:67e5\:7528\
\:5165\:5c04\:901f\:5ea6 km/s\:ff1b\:7528 A \:4e58\:539f\:5b50\:8d28\:91cf\
\:5355\:4f4d\:8fd1\:4f3c\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\:51b2\:80fd\:91cf\
\:6362\:7b97\:4e3a GeV *)
If[niExample === $Failed,  (* \
\:5224\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\
\:5206\:652f *)
  Print[\"\:8be5\:53c2\:6570\:70b9\:7684\:4e09\:4f53\:76f8\:7a7a\:95f4\:5173\
\:95ed\:ff0c\:8bf7\:66f4\:6539\:7b2c 1.4 \:8282\:53c2\:6570\:3002\"],  (* \
