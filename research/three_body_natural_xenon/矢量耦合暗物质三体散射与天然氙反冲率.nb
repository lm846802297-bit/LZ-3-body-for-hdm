\>", "Text",ExpressionUUID->"e3eb4764-b427-6d46-989c-a400e80a4b06"],

Cell[BoxData[
 TagBox[
  RowBox[{"I6", "\[Equal]", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "1"}], "1"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", 
       RowBox[{"2", " ", "\[Pi]"}]], 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "delta", " ", "u"}], ")"}], " ", 
         SqrtBox["lambda"], " ", "L00"}], 
