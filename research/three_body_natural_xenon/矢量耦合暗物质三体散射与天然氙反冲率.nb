Cell["Gauss \
\:5bf9\:7167\:4ee3\:7801\:79fb\:81f3\:6700\:540e\:7684\:9a8c\:8bc1\:90e8\:5206\
", "Subsubsection",ExpressionUUID->"516bb9de-b283-3c41-97a3-88b7d3228d61"],

Cell["\<\
Gauss \:6c42\:79ef\:5b9e\:73b0\:53ea\:4f5c\:4e3a\:540e\:9762\:7684\:9a8c\:8bc1\
\:5bf9\:7167\:ff1b\:4e3b\:8ba1\:7b97\:76f4\:63a5\:5728 NIntegrate \
\:90e8\:5206\:5b9a\:4e49 I6\:3002\:4e3a\:517c\:5bb9\:72ec\:7acb\:5b50\:5185\
\:6838\:ff0c\:65e7\:6e90\:7801\:53e6\:4ee5\:9690\:85cf\:7a0b\:5e8f\:5355\:5143\
\:4fdd\:7559\:3002\
\>", "Text",ExpressionUUID->"3938ecb0-3399-3e4f-8273-73279941e776"],

Cell["\<\
I6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?\
NumericQ,order_List,width_?NumericQ]:=Module[
 {beta,lor,ee,pz,qq,wlo,whi,pin,quadrW,quadrZ,quadrP,sum=0.,w2,weight,cq,q,K,\
bK,ps,e3,ref,e1,e2,lam,W,kabs,Ek,Ep,z,phi,n,k,pp,ang,pa,m2},
 If[!NumericQ[width] || !TrueQ[width>=0],Throw[\"Invalid constant pole \
width\"]];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

 If[er<=0 || v<=0,Return[0.]];  (* \:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\
\:8fd4\:56de\:96f6 *)

 beta=v/cKm;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)
lor=1/Sqrt[1-beta^2];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
ee=m lor;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)
pz=m lor beta;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
qq=Sqrt[2 mA er+er^2];  (* \:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\
\:56db\:52a8\:91cf *)

 wlo=(m+ms)^2;  (* \:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\
\:5206\:4e0b\:9650 *)
whi=m^2+2 pz qq-2(ee+mA)er;  (* \:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\
\:91cf\:79ef\:5206\:4e0a\:9650 *)

 If[whi<=wlo,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)

 m2=m+dm;  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf *)

 If[whi>=m2^2,Throw[\"On-shell chi2 accessible: off-shell calculation aborted\
\"]];  (* \:68c0\:67e5\:6fc0\:53d1\:6001\:4f20\:64ad\:5b50\:7684\:9002\:7528\
\:6761\:4ef6 *)

 pin={ee,0.,0.,pz};  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\
\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\
\:8ba1\:7b97\:6b65\:9aa4 *)
quadrW=gl[order[[1]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)
quadrZ=gl[order[[2]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)
quadrP=gl[order[[3]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)

 Do[
  w2=(whi+wlo)/2+(whi-wlo)node[[1]]/2;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
weight=node[[2]](whi-wlo)/2;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\
\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

  cq=Clip[(w2-m^2+2(ee+mA)er)/(2 pz qq),{-1.,1.}];  (* \:8ba1\:7b97\:6838\
\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)

  q={er,qq Sqrt[Max[0.,1-cq^2]],0.,qq cq};  (* \:8ba1\:7b97\:6838\:53cd\:51b2\
\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)
K=pin-q;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
bK=K[[2;;4]]/K[[1]];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

  ps=boost[pin,-bK];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
e3=Normalize[ps[[2;;4]]];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
ref=If[Abs[e3[[1]]]>.9,{0.,1.,0.},{1.,0.,0.}];  (* \:5b8c\:6210\
\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

  e1=Normalize[Cross[ref,e3]];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\
\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\
\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
e2=Cross[e3,e1];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\
\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\
\:8ba1\:7b97\:6b65\:9aa4 *)

  lam=Max[0.,(w2-(m+ms)^2)(w2-(m-ms)^2)];  (* \:5b8c\:6210\
\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
 W=Sqrt[w2];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)

  kabs=Sqrt[lam]/(2 W);  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
Ek=(w2-m^2+ms^2)/(2 W);  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
Ep=(w2+m^2-ms^2)/(2 W);  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

  ang=0.;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)
Do[z=zn[[1]];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\
\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\
\:7b97\:6b65\:9aa4 *)
pa=0.;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\
\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)
Do[phi=Pi(pn[[1]]+1);  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\
\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

   n=z e3+Sqrt[Max[0.,1-z^2]](Cos[phi] e1+Sin[phi] e2);  (* \:5b8c\:6210\
\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

   k=boost[Join[{Ek},kabs n],bK];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\
\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\
\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
pp=boost[Join[{Ep},-kabs n],bK];  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 \
I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

   pa+=pn[[2]]/2 trace[pin,pp,k,m,m2,w2,width],{pn,quadrP}];  (* \:8bbe\:7f6e\
\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

   ang+=zn[[2]] pa,{zn,quadrZ}];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\
\:5206\:8282\:70b9 *)

  sum+=weight Sqrt[lam]/w2 ang,{node,quadrW}];  (* \:8bbe\:7f6e\:76f8\:7a7a\
\:95f4\:79ef\:5206\:8282\:70b9 *)
sum];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:4e09\:4f53\:76f8\:7a7a\:95f4\
\:79ef\:5206 I6\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\
\:6b65\:9aa4 *)

\
\>", "Program",
 CellOpen->False,
 CellTags->
  "inlineEngine",ExpressionUUID->"6468a938-d801-4b49-8999-ca09fbed0fe7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:6fc0\:53d1\:6001\:8870\:53d8\:5bbd\:5ea6 Chi2Width", "Subsubsection",ExpressionUUID->"ef0f40ed-c8f4-864e-a72b-f318aa2b30e1"],

Cell["\<\
\:8ba1\:7b97 chi2 \[RightArrow] chi1+s \:7684\:7eaf\:6807\:91cf\:90e8\:5206\
\:5bbd\:5ea6\:ff1b\:8d28\:91cf\:7edf\:4e00\:4e3a GeV\:3002\:95ed\:5408\:6216\
\:6070\:5904\:9608\:503c\:65f6\:8fd4\:56de\:96f6\:3002\:56e0\:5f0f\:5206\:89e3\
\:907f\:514d\:5927\:8d28\:91cf\:76f8\:51cf\:635f\:5931\:7cbe\:5ea6\:3002\
\>", "Text",ExpressionUUID->"1ddfe37d-d5f1-a846-b4f1-e1f3b3aedf3e"],

Cell["\<\
(* Factorized Kallen function avoids loss of precision for TeV masses and keV \
splittings.
   Assumptions: Dirac fermions, pure scalar Yukawa g2 s chibar2 chi1,
   one open decay channel. The returned partial width is used as the total \
width. *)
Chi2Width[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,g_?NumericQ]:=Module[{m2,\
phase,heavy},
 If[!TrueQ[m>0 && ms>=0 && dm>=0],Throw[\"Invalid masses in Chi2Width\"]];  \
(* \:8ba1\:7b97\:6fc0\:53d1\:6001\:90e8\:5206\:5bbd\:5ea6 *)

 If[dm<=ms,Return[0.]];  (* \:8870\:53d8\:9608\:503c\:672a\:6253\:5f00\:65f6\
\:5bbd\:5ea6\:4e3a\:96f6 *)

 m2=m+dm;  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf *)
phase=dm^2-ms^2;  (* \:8ba1\:7b97\:8d28\:91cf\:5288\:88c2\:5bf9\:5e94\:7684\
\:9608\:503c\:56e0\:5b50 *)
heavy=(2 m+dm)^2-ms^2;  (* \:8ba1\:7b97\:8d28\:91cf\:548c\:5bf9\:5e94\:7684\
\:8fd0\:52a8\:5b66\:56e0\:5b50 *)

 Abs[g]^2 Sqrt[phase] heavy^(3/2)/(16 Pi m2^3)];  (* \:8ba1\:7b97 \[Chi]2\
\[RightArrow]\[Chi]1 s \:7684\:6781\:70b9\:90e8\:5206\:8870\:53d8\:5bbd\:5ea6 \
*)

\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[962]:=",ExpressionUUID->"98aa30df-804b-0843-b2bd-51c4eadb5b9e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:6700\:5c0f\:901f\:5ea6\:4e0e\:901f\:5ea6\:5206\:5e03", "Subsubsection",ExpressionUUID->"c4d627ff-2a78-be40-b557-c4f1469b08a5"],

Cell["\:8ba1\:7b97\:6700\:5c0f\:5165\:5c04\:901f\:5ea6\:548c\:622a\:65ad\:901f\
\:5ea6\:5206\:5e03\:3002", "Text",ExpressionUUID->"e7177ced-81d6-0540-b95e-\
de3b21b9c677"],

Cell["\<\
VMin[m_,ms_,mA_,er_]:=Module[{q,a},If[er<=0,Return[Infinity]];  (* \:5b9a\
\:4e49\:4ea7\:751f\:6307\:5b9a\:53cd\:51b2\:80fd\:91cf\:6240\:9700\:7684\:6700\
\:5c0f\:5165\:5c04\:901f\:7387 *)

 q=Sqrt[2 mA er+er^2];  (* \:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\
\:56db\:52a8\:91cf *)
a=ms+(mA er+ms^2/2)/m;  (* \:5b9a\:4e49\:6c42\:89e3\:6700\:4f4e\:901f\:7387\
\:65f6\:4f7f\:7528\:7684\:8fd0\:52a8\:5b66\:7ec4\:5408 *)

 cKm (q er+a Sqrt[q^2-er^2+a^2])/(q^2+a^2)];  (* \:5c06\:6700\:4f4e\:901f\
\:7387 \[Beta]min \:6362\:6210 km/s *)

SpeedPDF[v_,v0_,ve_,vesc_]:=Module[{z,n,b},
 If[v<0 || v>=vesc+ve,Return[0.]];  (* \:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\
\:65f6\:8fd4\:56de\:96f6 *)

 z=vesc/v0;  (* \:8ba1\:7b97\:9003\:9038\:901f\:5ea6\:4e0e\:901f\:5ea6\:5c3a\
\:5ea6\:4e4b\:6bd4 *)
n=Erf[z]-2 z Exp[-z^2]/Sqrt[Pi];  (* \:8ba1\:7b97\:622a\:65ad Maxwell \:901f\
\:7387\:5206\:5e03\:7684\:5f52\:4e00\:5316\:56e0\:5b50 *)

 b=If[v<vesc-ve,Exp[-((v-ve)/v0)^2]-Exp[-((v+ve)/v0)^2],Exp[-((v-ve)/v0)^2]-\
Exp[-z^2]];  (* \:6309\:901f\:5ea6\:533a\:95f4\:8ba1\:7b97\:5730\:7403\:7cfb\
\:622a\:65ad\:901f\:7387\:5206\:5e03 *)

 v b/(Sqrt[Pi] v0 ve n)];  (* \:8fd4\:56de\:6bcf km/s \
\:7684\:5f52\:4e00\:5316\:901f\:7387\:6982\:7387\:5bc6\:5ea6 *)

\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[966]:=",ExpressionUUID->"114a4236-b96b-3043-98e3-3282e4295a73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["AFH \:6838\:54cd\:5e94", "Subsubsection",ExpressionUUID->"0a87e86d-6143-a84b-bff6-888af99c798e"],

Cell["\<\
\:672c\:8282\:5bf9\:6bcf\:4e2a\:6c19\:540c\:4f4d\:7d20\:8bfb\:53d6 AFH \:9ed8\
\:8ba4\:5bc6\:5ea6\:77e9\:9635\:4e0b\:7684 M \:578b\:7b49\:6807\:91cf\:54cd\
\:5e94 W_M^00(y)\:3002\:4ee3\:7801\:4f7f\:7528 RA=A\.b2 W(y)/W(0)\:ff0c\:5f3a\
\:5236 RA(0)=A\.b2\:ff1b\:8fd9\:662f\:7b49\:8d28\:5b50\:3001\:4e2d\:5b50\:77e2\
\:91cf\:8026\:5408\:4e0b\:7684\:5f52\:4e00\:5316\:7ea6\:5b9a\:3002RA \:5df2\
\:5305\:542b\:76f8\:5e72\:589e\:5f3a\:4e0e\:6838 form \
factor\:ff0c\:4e0d\:5e94\:518d\:6b21\:4e58\:540c\:4e00\:4e2a\:6838 form \
factor\:3002\:5355\:6838\:5b50\:8026\:5408 gVN \:53d6\:5e38\:6570\:ff0c\:672a\
\:5355\:72ec\:8ba1\:5165\:6838\:5b50\:6709\:9650\:5c3a\:5bf8\:7684\:52a8\:91cf\
\:4f9d\:8d56\:3002\
\>", "Text",ExpressionUUID->"550d8d40-7b0c-e842-88ae-dd50ad1900ee"],

Cell["\:52a0\:8f7d\:5916\:90e8 AFH \:7a0b\:5e8f\:ff0c\:63d0\:53d6\:5e76\:7f13\
\:5b58\:5404\:6c19\:540c\:4f4d\:7d20\:7684 M \:578b\:7b49\:6807\:91cf\:54cd\
\:5e94\:3002", "Text",ExpressionUUID->"e3826cf5-b3b2-4b4a-9410-4c0789974f01"],

Cell["\<\
(* Normalization R(0)=A^2 removes finite-precision density table offset. *)
LoadResponses[path_String,isotopes_List]:=Module[{expr,aa,b},
 If[!FileExistsQ[path],Throw[\"AFH package missing\"]];  (* \
\:51c6\:5907\:5404\:540c\:4f4d\:7d20\:6838\:54cd\:5e94 *)
Get[path];  (* \:52a0\:8f7d AFH \:539f\:7a0b\:5e8f *)

 Do[aa=iso;  (* \:9010\:4e2a\:9009\:62e9\:5929\:7136\:6c19\:540c\:4f4d\:7d20 *)
dmformfactor`SetIsotope[54,aa,\"default\",\"default\"];  (* \
\:9009\:62e9\:6838\:7d20\:53ca\:5176\:6838\:5bc6\:5ea6 *)

 expr=dmformfactor`ResponseNuclear[Global`y,1,0,0];  (* \:63d0\:53d6 M \:578b\
\:6838\:54cd\:5e94 *)

 If[!NumericQ[N[expr/.Global`y->0]],Throw[\"AFH response failed\"]];  (* \
\:68c0\:67e5 AFH \:54cd\:5e94\:5728\:96f6\:52a8\:91cf\:5904\:80fd\:5426\:5f97\
\:5230\:6570\:503c *)

 b=5.0677 Sqrt[41.467/(45. aa^(-1./3.)-25. aa^(-2./3.))];  (* \:6309 AFH \
\:9ed8\:8ba4\:632f\:5b50\:53c2\:6570\:516c\:5f0f\:8ba1\:7b97 b\:ff0c\:5e76\
\:8f6c\:6210 GeV^-1 *)

 responseExpr[aa]=expr;  (* \:4fdd\:5b58\:8be5\:540c\:4f4d\:7d20\:7684\:5b8c\
\:6574 AFH \:54cd\:5e94\:8868\:8fbe\:5f0f *)
responseZero[aa]=N[expr/.Global`y->0];  (* \:4fdd\:5b58\:96f6\:52a8\:91cf\
\:54cd\:5e94\:ff0c\:7528\:4e8e\:5f52\:4e00\:5316 *)
bInv[aa]=b,
 {iso,isotopes}];  (* \:7ed3\:675f\:5bf9\:540c\:4f4d\:7d20\:5217\:8868\:7684\
\:5faa\:73af *)
isotopes];  (* \:8fd4\:56de\:5df2\:52a0\:8f7d\:7684\:540c\:4f4d\:7d20\:5217\
\:8868 *)

response[a_,er_,mA_]:=a^2 N[responseExpr[a]/.Global`y->((Sqrt[2 mA er+er^2] \
bInv[a]/2)^2)]/responseZero[a];  (* \:8ba1\:7b97 A\.b2 W(y)/W(0)\:ff0c\:5305\
\:542b\:76f8\:5e72\:589e\:5f3a\:4e0e\:6838 form factor *)

(* The recoil energy accepted by this public function is in keV. *)
NuclearResponse[a_Integer, recoilKeV_?NumericQ] := Module[{nuclearMass},
 If[!TrueQ[recoilKeV >= 0], Throw[\"Recoil energy must be nonnegative\"]];  \
(* \:8ba1\:7b97\:8be5\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\
\:5e94 *)

 If[!ValueQ[responseZero[a]], Throw[\"Load the requested isotope before \
evaluating its response\"]];  (* \:5c1a\:672a\:52a0\:8f7d\:8be5\:540c\:4f4d\
\:7d20\:65f6\:505c\:6b62\:ff0c\:907f\:514d\:4f7f\:7528\:9519\:8bef\:7684\:6838\
\:54cd\:5e94 *)

 nuclearMass = a*0.93149410242;  (* \
\:7528\:8d28\:91cf\:6570\:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\
\:6838\:8d28\:91cf\:ff0c\:5355\:4f4d GeV *)

 response[a, recoilKeV*10^-6, nuclearMass]
];  (* \:7ed3\:675f\:5f53\:524d\:6838\:54cd\:5e94\:51fd\:6570\:5b9a\:4e49 *)


\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[971]:=",ExpressionUUID->"7078d049-ab9f-d14f-9804-5c5877272c17"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:8ba1\:7b97\:6a21\:578b\:7684\:6781\:70b9\:5bbd\:5ea6", "Subsubsection",ExpressionUUID->"5b567c16-9125-9749-ac54-313b6e9dc6ac"],

Cell["\:6839\:636e\:8d28\:91cf\:548c g\:2082 \:8ba1\:7b97\:6781\:70b9\:5bbd\
\:5ea6\:ff1b\:6b64\:5bbd\:5ea6\:53ea\:5305\:542b\:5df2\:5efa\:6a21\:7684\:8870\
\:53d8\:9053\:3002", "Text",ExpressionUUID->"3b738c66-563d-8d48-a2ab-\
409e24943f19"],

Cell["\<\
(* \:622a\:9762\:548c\:4e8b\:4ef6\:7387\:5171\:7528\:540c\:4e00\:6781\:70b9\
\:5bbd\:5ea6\:ff1b\:4e0d\:63d0\:4f9b\:96f6\:5bbd\:5ea6\:8ba1\:7b97\:5904\:65b9\
\:3002 *)
widthForParameters[mass_, scalarMass_, splitting_, params_Association] := \
Module[{mode},
 mode = Lookup[params, \"widthMode\", \"pole\"];  (* \:9ed8\:8ba4\:4e3a\:6781\
\:70b9\:5bbd\:5ea6 *)
 If[mode =!= \"pole\" || !KeyExistsQ[params, \"g2\"],
  Throw[\"Only pole width is supported; g2 is required\"]];
 Chi2Width[mass, scalarMass, splitting, params[\"g2\"]]  (* \
\:6309\:8d28\:91cf\:548c g2 \:8ba1\:7b97\:5bbd\:5ea6 *)
];\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[981]:=",ExpressionUUID->"7d7f24eb-2e97-1048-bbc9-259ec607e9ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\:5206\:622a\:9762", \
"Subsubsection",ExpressionUUID->"24622ca2-2ee9-c04b-97e5-b48815867453"],

Cell["\:5c06\:81ea\:65cb\:8ff9\:3001\:76f8\:7a7a\:95f4\:79ef\:5206\:3001\:4f20\
\:64ad\:5b50\:548c AFH \:6838\:54cd\:5e94\:5408\:6210\:4e3a\:56fa\:5b9a\:901f\
\:5ea6\:622a\:9762\:3002", "Text",ExpressionUUID->"088af27f-1d33-ba41-a074-\
abadfb77b1f5"],

Cell["\<\
(* Eq. (radiative-recoil): I6 includes dW^2, dz and the phi average.
   Inputs are GeV except speedKms. The result is in GeV^-3. *)
fixedSpeedCrossSection[nuclearMass_, recoilGeV_, speedKms_, mass_, scalarMass_,
   splitting_, mediatorMass_, couplingSquared_, orders_, width_, \
nuclearResponse_] :=
 Module[{beta, incomingMomentum, mediatorDenominator, integral},
  If[!TrueQ[0 < speedKms < cKm], Throw[\"Fixed-speed cross section requires 0 \
< v < c\"]];  (* \:68c0\:67e5\:8f93\:5165\:901f\:5ea6\:5728 0 \:4e0e\:5149\
\:901f\:4e4b\:95f4 *)

  beta = speedKms/cKm;  (* \:5c06\:8f93\:5165\:901f\:5ea6 km/s \:8f6c\:6362\
\:4e3a\:65e0\:91cf\:7eb2 v/c *)

  incomingMomentum = mass*beta/Sqrt[1-beta^2];  (* \:8ba1\:7b97\:5165\:5c04\
\:6697\:7269\:8d28\:7684\:76f8\:5bf9\:8bba\:4e09\:52a8\:91cf\:5927\:5c0f *)

  mediatorDenominator = (mediatorMass^2+2*nuclearMass*recoilGeV)^2;  (* \
\:8ba1\:7b97\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd (mV\.b2+2 mA ER)\.b2 *)

  If[!TrueQ[mediatorDenominator > 0], Throw[\"Vector mediator denominator is \
zero\"]];  (* \:9632\:6b62\:4f20\:64ad\:5b50\:5206\:6bcd\:4e3a\:96f6 *)

  integral = I6[mass, scalarMass, splitting, nuclearMass, recoilGeV, \
speedKms, orders, width];  (* \
\:8fdb\:884c\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 *)

  nuclearMass*couplingSquared*nuclearResponse*integral/
   (256*Pi^3*incomingMomentum^2*mediatorDenominator)
 ];  (* \:7ed3\:675f\:5f53\:524d\:622a\:9762\:51fd\:6570\:5b9a\:4e49 *)


DifferentialCrossSection[a_Integer, recoilKeV_?NumericQ, speedKms_?NumericQ,
   scalarMassGeV_?NumericQ, splittingGeV_?NumericQ, params_Association] :=
 Module[{nuclearMass, nuclearResponse, width},
  nuclearResponse = NuclearResponse[a, recoilKeV];  (* \:8ba1\:7b97\:8be5\
\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\:5e94 *)

  nuclearMass = a*0.93149410242;  (* \:7528\:8d28\:91cf\:6570\:4e58\:539f\
\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\:6838\:8d28\:91cf\:ff0c\:5355\:4f4d\
 GeV *)

  width = widthForParameters[params[\"mchi\"], scalarMassGeV, splittingGeV, \
params];  (* \:6309\:5bbd\:5ea6\:9009\:9879\:51b3\:5b9a\:4f20\:64ad\:5b50\
\:5bbd\:5ea6 *)

  fixedSpeedCrossSection[nuclearMass, recoilKeV*10^-6, speedKms,
   params[\"mchi\"], scalarMassGeV, splittingGeV, params[\"mV\"],
   params[\"couplingSq\"], params[\"quad\"], width, nuclearResponse]
 ];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)


\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[983]:=",ExpressionUUID->"eb37d1c3-6abc-9343-9cca-b9abd42aa862"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\
\:56fe\:6570\:636e", "Subsubsection",ExpressionUUID->"e3a88b99-9acf-464e-9f58-\
41eca2152c5a"],

Cell["\:5bf9\:901f\:5ea6\:5206\:5e03\:4e0e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\
\:4e30\:5ea6\:6c42\:548c\:ff0c\:8f6c\:6362\:5355\:4f4d\:5e76\:8ba1\:7b97\:66f2\
\:7ebf\:3002", "Text",ExpressionUUID->"cdd68582-20a6-ec48-ab04-17105206b776"],

Cell["\<\
Rate[erKeV_?NumericQ,ms_?NumericQ,dm_?NumericQ,p_Association]:=Module[
 {er=erKeV \
10^-6,m=p[\"mchi\"],v0=p[\"v0\"],ve=p[\"vEarth\"],vesc=p[\"vEsc\"],coupling=p[\
\"couplingSq\"],mv=p[\"mV\"],order=p[\"quad\"],isotopes=p[\"isotopes\"],\
weights=p[\"abundance\"],nv=p[\"nv\"],rho=p[\"rho\"],sum=0.,mA,vmin,vmax,acc,\
v,w,conv,width,nuclearResponse},
 width=widthForParameters[m,ms,dm,p];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

 vmax=ve+vesc;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\
\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 Do[mA=a 0.93149410242;  (* \:8bbe\:7f6e\:9776\:6838\:8d28\:91cf *)
vmin=VMin[m,ms,mA,er];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\
\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 If[vmin<vmax,
  acc=0.;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
nuclearResponse=NuclearResponse[a,erKeV];  (* \:8ba1\:7b97\:8be5\:53cd\:51b2\
\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\:5e94 *)

  Do[v=(vmax+vmin)/2+(vmax-vmin)node[[1]]/2;  (* \:5b8c\:6210\
\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\
\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
w=node[[2]](vmax-vmin)/2;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\
\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

   acc+=w SpeedPDF[v,v0,ve,vesc] (v/cKm)*
    fixedSpeedCrossSection[mA,er,v,m,ms,dm,mv,coupling,order,width,\
nuclearResponse],
   {node,gl[nv]}];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)

  sum+=weights[a] acc],{a,isotopes}];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\
\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\
\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\
\:9aa4 *)

 (* isotope weights are number fractions; average target molar mass is \
explicit *)
 conv=(rho/m) cCm (6.02214076 10^23 1000/p[\"molarMass\"]) GeV2cm2 10^-6 \
86400 365250;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 conv sum];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

MakeCurves[energies_List,bench_List,p_Association]:=Table[
 Print[\"Computing benchmark \",i,\" / \",Length[bench],\"; ms,dm = \
\",bench[[i]]];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\
\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 Table[{er,Rate[er,bench[[i,1]] 10^-6,bench[[i,2]] 10^-3,p]}, \
{er,energies}],{i,Length[bench]}];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\
\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\
\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\
\:9aa4 *)

\
\>", "Program",
 CellOpen->False,
 CellTags->
  "inlineEngine",ExpressionUUID->"064c13a3-a7f1-7d46-9f74-b8149557f3cc"],

Cell["\<\
\:65e7 Gauss \:901f\:5ea6\:79ef\:5206\:4fdd\:5b58\:5728\:72ec\:7acb\:9a8c\
\:8bc1\:6e90\:7801\:4e2d\:ff1b\:8fd9\:91cc\:5148\:5b9a\:4e49 MakeCurves\:ff0c\
\:4e3b Rate \:5728 NIntegrate \:90e8\:5206\:76f4\:63a5\:5b9a\:4e49\:3002\
\>", "Text",ExpressionUUID->"a0541150-855b-9947-88d5-59b7e8e03d21"],

