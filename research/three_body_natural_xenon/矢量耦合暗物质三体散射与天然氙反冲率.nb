Cell["\<\
\:9a8c\:8bc1\:5355\:5143\:4ece\:7b14\:8bb0\:672c\:5185\:5d4c\:7684 FeynRules \
\:6e90\:7801\:548c\:5148\:524d\:5bfc\:51fa\:7684 FeynArts \:6a21\:578b\:751f\
\:6210\:4e34\:65f6\:6587\:4ef6\:ff1b\:5e76\:975e\:6bcf\:6b21\:81ea\:52a8\:91cd\
\:65b0\:5bfc\:51fa\:6a21\:578b\:3002\:4fee\:6539\:6e90\:6a21\:578b\:540e\:5fc5\
\:987b\:7528 FeynRules \:91cd\:65b0\:5bfc\:51fa\:5e76\:5904\:7406 FeynArts \
