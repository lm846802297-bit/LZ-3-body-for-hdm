", "Section",ExpressionUUID->"28fb7cba-efdf-5c48-9f77-53f979907e9c"],

Cell["\<\
\:9a8c\:8bc1\:524d\:5148\:8fd0\:884c\:4e3b\:8ba1\:7b97\:3002\:4e0b\:65b9 \
gaussI6 \:4e0e\:4e3b I6 \
\:4f7f\:7528\:4e0d\:540c\:7684\:6570\:503c\:6c42\:79ef\:548c\:8fd0\:52a8\:5b66\
\:6784\:9020\:ff0c\:4f46\:5171\:7528\:7269\:7406\:6a21\:578b\:3001\:5bbd\:5ea6\
\:5904\:65b9\:548c\:81ea\:65cb\:8ff9\:ff1b\:5b83\:7528\:4e8e\:6570\:503c\:65b9\
\:6cd5\:5bf9\:7167\:ff0c\:5e76\:4e0d\:80fd\:5355\:72ec\:8bc1\:660e\:6838\:54cd\
\:5e94\:6216\:6574\:4e2a\:7406\:8bba\:5f52\:4e00\:5316\:3002\:6bcf\:4e2a\:9a8c\
\:8bc1\:90fd\:5e94\:6838\:5bf9\:5f53\:524d\:8f93\:5165\:3001\:8fd0\:884c\:72b6\
\:6001\:548c\:6bd4\:8f83\:8303\:56f4\:3002\
\>", "Text",ExpressionUUID->"3f13a98f-3d3c-6846-9c44-239345c35547"],

Cell[CellGroupData[{

Cell["Gauss \:6c42\:79ef\:5bf9\:7167\:51fd\:6570", "Subsection",ExpressionUUID->"2b06a371-afdd-4b40-b70a-d12eb63709f0"],

Cell[CellGroupData[{

Cell["\<\
gaussI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?\
NumericQ,order_List,width_?NumericQ]:=Module[
 {beta,lor,ee,pz,qq,wlo,whi,pin,quadrW,quadrZ,quadrP,sum=0.,w2,weight,cq,q,K,\
bK,ps,e3,ref,e1,e2,lam,W,kabs,Ek,Ep,z,phi,n,k,pp,ang,pa,m2},
 If[!NumericQ[width] || !TrueQ[width>=0],Throw[\"Invalid constant pole \
width\"]];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

 If[er<=0 || v<=0,Return[0.]];  (* \:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\
\:8fd4\:56de\:96f6 *)

 beta=v/cKm;  (* Gauss \:5bf9\:7167\:ff1a\:901f\:5ea6\:8f6c\:4e3a\:65e0\:91cf\
\:7eb2 \[Beta] *)
lor=1/Sqrt[1-beta^2];  (* Gauss \:5bf9\:7167\:ff1a\:8ba1\:7b97\:6d1b\:4f26\
\:5179\:56e0\:5b50 *)
ee=m lor;  (* Gauss \:5bf9\:7167\:ff1a\:8ba1\:7b97\:5165\:5c04\:6697\:7269\
\:8d28\:80fd\:91cf *)
pz=m lor beta;  (* Gauss \:5bf9\:7167\:ff1a\:8ba1\:7b97\:5165\:5c04\:6697\
\:7269\:8d28\:6cbf z \:8f74\:7684\:52a8\:91cf *)
qq=Sqrt[2 mA er+er^2];  (* \:8ba1\:7b97\:6838\:53cd\:51b2\:5bf9\:5e94\:7684\
\:56db\:52a8\:91cf *)

 wlo=(m+ms)^2;  (* \:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\:91cf\:79ef\
\:5206\:4e0b\:9650 *)
whi=m^2+2 pz qq-2(ee+mA)er;  (* \:8bbe\:7f6e\:4e09\:4f53\:4e0d\:53d8\:8d28\
\:91cf\:79ef\:5206\:4e0a\:9650 *)

 If[whi<=wlo,Return[0.]];  (* \
\:8fd0\:52a8\:5b66\:4e0d\:5141\:8bb8\:65f6\:8fd4\:56de\:96f6 *)

 m2=m+dm;  (* \:8ba1\:7b97\:6fc0\:53d1\:6001\:8d28\:91cf *)

 If[whi>=m2^2,Throw[\"On-shell chi2 accessible: off-shell calculation aborted\
\"]];  (* \:68c0\:67e5\:6fc0\:53d1\:6001\:4f20\:64ad\:5b50\:7684\:9002\:7528\
\:6761\:4ef6 *)

 pin={ee,0.,0.,pz};  (* Gauss \
\:5bf9\:7167\:ff1a\:6784\:9020\:5165\:5c04\:6697\:7269\:8d28\:56db\:52a8\:91cf\
 *)
quadrW=gl[order[[1]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)
quadrZ=gl[order[[2]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)
quadrP=gl[order[[3]]];  (* \:751f\:6210 Gauss \:79ef\:5206\:8282\:70b9\:548c\
\:6743\:91cd *)

 Do[
  w2=(whi+wlo)/2+(whi-wlo)node[[1]]/2;  (* \:5c06 Gauss \:8282\:70b9\:6620\
\:5c04\:5230 W\.b2 \:79ef\:5206\:533a\:95f4 *)
weight=node[[2]](whi-wlo)/2;  (* \:8ba1\:7b97\:8be5 W\.b2 \:8282\:70b9\:7684\
\:6743\:91cd\:548c\:533a\:95f4 Jacobian *)

  cq=Clip[(w2-m^2+2(ee+mA)er)/(2 pz qq),{-1.,1.}];  (* \:8ba1\:7b97\:6838\
\:53cd\:51b2\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)

  q={er,qq Sqrt[Max[0.,1-cq^2]],0.,qq cq};  (* \:8ba1\:7b97\:6838\:53cd\:51b2\
\:5bf9\:5e94\:7684\:56db\:52a8\:91cf *)
K=pin-q;  (* \:7531\:56db\:52a8\:91cf\:5b88\:6052\:5f97\:5230 \[Chi]1+s \
\:7cfb\:7edf\:56db\:52a8\:91cf *)
bK=K[[2;;4]]/K[[1]];  (* \:8ba1\:7b97 \[Chi]1+s \
\:8d28\:5fc3\:7cfb\:76f8\:5bf9\:5b9e\:9a8c\:5ba4\:7cfb\:7684\:901f\:5ea6 *)

  ps=boost[pin,-bK];  (* \:5c06\:5165\:5c04\:52a8\:91cf\:53d8\:6362\:5230 \
\[Chi]1+s \:8d28\:5fc3\:7cfb *)
e3=Normalize[ps[[2;;4]]];  (* \
\:4ee5\:8d28\:5fc3\:7cfb\:5165\:5c04\:65b9\:5411\:5b9a\:4e49\:6781\:8f74 *)
ref=If[Abs[e3[[1]]]>.9,{0.,1.,0.},{1.,0.,0.}];  (* \:9009\:62e9\:4e0d\:4e0e\
\:6781\:8f74\:8fd1\:4e4e\:5e73\:884c\:7684\:53c2\:8003\:65b9\:5411 *)

  e1=Normalize[Cross[ref,e3]];  (* \:8ba1\:7b97\:5782\:76f4\:4e8e\:6781\:8f74\
\:7684\:7b2c\:4e00\:4e2a\:5355\:4f4d\:77e2\:91cf *)
e2=Cross[e3,e1];  (* \:8ba1\:7b97\:7b2c\:4e8c\:4e2a\:6a2a\:5411\:5355\:4f4d\
\:77e2\:91cf *)

  lam=Max[0.,(w2-(m+ms)^2)(w2-(m-ms)^2)];  (* \:8ba1\:7b97 K\[ADoubleDot]ll\
\[EAcute]n \:51fd\:6570\:ff0c\:5e76\:9650\:5236\:9608\:503c\:5904\:820d\:5165\
\:8bef\:5dee *)
 W=Sqrt[w2];  (* \:4ece\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:5f97\:5230\:8d28\
\:5fc3\:7cfb\:603b\:80fd\:91cf *)

  kabs=Sqrt[lam]/(2 W);  (* \:8ba1\:7b97\:8d28\:5fc3\:7cfb\:4e2d\:7684\:672b\
\:6001\:52a8\:91cf\:5927\:5c0f *)
Ek=(w2-m^2+ms^2)/(2 W);  (* \:8ba1\:7b97\:6807\:91cf\:5728\:8d28\:5fc3\:7cfb\
\:7684\:80fd\:91cf *)
Ep=(w2+m^2-ms^2)/(2 W);  (* \:8ba1\:7b97\:672b\:6001 \[Chi]1 \:5728\:8d28\
\:5fc3\:7cfb\:7684\:80fd\:91cf *)

  ang=0.;  (* \:521d\:59cb\:5316\:6781\:89d2\:79ef\:5206\:7684\:7d2f\:52a0\
\:503c *)
Do[z=zn[[1]];  (* \:904d\:5386 Gauss \:6781\:89d2\:4f59\:5f26\:8282\:70b9 *)
pa=0.;  (* \:521d\:59cb\:5316\:8be5\:6781\:89d2\:4e0b\:65b9\:4f4d\:89d2\:5e73\
\:5747\:7684\:7d2f\:52a0\:503c *)
Do[phi=Pi(pn[[1]]+1);  (* \:5c06\:65b9\:4f4d\:89d2\:8282\:70b9\:6620\:5c04\
\:5230 0 \:5230 2\[Pi] *)

   n=z e3+Sqrt[Max[0.,1-z^2]](Cos[phi] e1+Sin[phi] e2);  (* \
\:7531\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:6784\:9020\:6807\:91cf\:7684\:5355\
\:4f4d\:65b9\:5411 *)

   k=boost[Join[{Ek},kabs n],bK];  (* \:5c06\:6807\:91cf\:56db\:52a8\:91cf\
\:53d8\:6362\:5230\:5b9e\:9a8c\:5ba4\:7cfb *)
pp=boost[Join[{Ep},-kabs n],bK];  (* \:5c06\:672b\:6001 \[Chi]1 \:56db\:52a8\
\:91cf\:53d8\:6362\:5230\:5b9e\:9a8c\:5ba4\:7cfb *)

   pa+=pn[[2]]/2 trace[pin,pp,k,m,m2,w2,width],{pn,quadrP}];  (* \:8bbe\:7f6e\
\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

   ang+=zn[[2]] pa,{zn,quadrZ}];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\
\:5206\:8282\:70b9 *)

  sum+=weight Sqrt[lam]/w2 ang,{node,quadrW}];  (* \:8bbe\:7f6e\:76f8\:7a7a\
\:95f4\:79ef\:5206\:8282\:70b9 *)
sum];  (* \:8fd4\:56de\:5404\:79ef\:5206\:8282\:70b9\:7684\:52a0\:6743\:548c *)


Print[\"Gauss \:5bf9\:7167\:51fd\:6570\:5df2\:5b9a\:4e49\:ff1b\:4e3b\:8ba1\
\:7b97\:4ecd\:4f7f\:7528 FeynCalc \:548c NIntegrate\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1164]:=",ExpressionUUID->"d3b54fd9-599b-0a48-b59b-022bc1968b9b"],

