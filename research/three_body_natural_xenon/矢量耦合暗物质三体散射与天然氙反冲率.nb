Cell["\<\
FCClearScalarProducts[];  (* \:6e05\:9664\:6b64\:524d\:8bbe\:7f6e\:7684 \
FeynCalc \:6807\:91cf\:79ef *)
fcChain1 = GA[0].(GS[fcP]-GS[fcK]+fcM2);  (* \:6784\:9020\:7b2c\:4e00\:5f20\
\:8f90\:5c04\:56fe\:7684 Dirac \:77e9\:9635\:94fe *)
fcChain2 = (GS[fcR]+GS[fcK]+fcM2).GA[0];  (* \:6784\:9020\:7b2c\:4e8c\:5f20\
\:8f90\:5c04\:56fe\:7684 Dirac \:77e9\:9635\:94fe *)
fcChains = {fcChain1, fcChain2};  (* \:6536\:96c6\:4e24\:5f20\:56fe\:7684\
\:77e9\:9635\:94fe *)
(* FeynCalc \:7684 ComplexConjugate \:751f\:6210 Dirac \:5171\:8f6d\:ff0c\
\:4ea4\:6362\:94fe\:7684\:987a\:5e8f\:3002 *)
fcTraceMatrix = Table[  (* \:9010\:5bf9\:8ba1\:7b97\:632f\:5e45\:7684\:81ea\
\:65cb\:8ff9\:ff0c\:5305\:62ec\:5e72\:6d89\:9879 *)
 DiracSimplify[DiracTrace[(GS[fcR]+fcM).fcChains[[i]].(GS[fcP]+fcM).  (* \
\:5316\:7b80 FeynCalc \:7684 Dirac \:8ff9 *)
   ComplexConjugate[fcChains[[j]]]], DiracTraceEvaluate->True]/2,  (* \:6784\
\:9020\:632f\:5e45\:7684 Dirac \:5171\:8f6d *)
 {i,2},{j,2}];  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\
\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
Print[\"FeynCalc \:5df2\:8ba1\:7b97\:4e24\:5f20\:56fe\:7684 2\[Times]2 \:81ea\
\:65cb\:8ff9\:77e9\:9635\:ff1b\:975e\:5bf9\:89d2\:9879\:662f\:5e72\:6d89\:9879\
\:3002\:5b8c\:6574\:7b26\:53f7\:7ed3\:679c\:4fdd\:5b58\:5728 fcTraceMatrix\
\:3002\"];
Print[\"\:77e9\:9635\:7ef4\:6570\:ff1a\", Dimensions[fcTraceMatrix], \"\:ff1b\
\:672a\:5316\:7b80 DiracTrace \:6570\:ff1a\", \
Length[Cases[fcTraceMatrix,_DiracTrace,Infinity]]];
(* \:8fd9\:4e24\:9879\:662f\:53bb\:6389\:516c\:5171\:8026\:5408\:3001\:5a92\
\:4ecb\:4f20\:64ad\:5b50\:548c\:5916\:90e8\:65cb\:91cf\:540e\:7684\:6697\:7269\
\:8d28\:7535\:6d41\:77e9\:9635\:94fe\:3002 *)
fcDenBefore = SP[fcP-fcK,fcP-fcK]-fcM2^2; (* \:7b2c\:4e00\:6761\:4e2d\:95f4\
\:6001\:4f20\:64ad\:5b50\:5206\:6bcd *)
fcDenAfter = SP[fcR+fcK,fcR+fcK]-fcM2^2+I fcM2 fcWidth; (* \:7b2c\:4e8c\:6761\
\:4f20\:64ad\:5b50\:542b\:6781\:70b9\:5bbd\:5ea6 *)
Print[\"\:7b2c\:4e00\:5f20\:56fe\:7684\:6697\:7269\:8d28\:7535\:6d41\:77e9\
\:9635\:94fe\:ff1a\", TraditionalForm[fcChain1/fcDenBefore]]; (* \:663e\:793a\
\:56fe\:4e00\:632f\:5e45\:7ed3\:6784 *)
Print[\"\:7b2c\:4e8c\:5f20\:56fe\:7684\:6697\:7269\:8d28\:7535\:6d41\:77e9\
\:9635\:94fe\:ff1a\", TraditionalForm[fcChain2/fcDenAfter]]; (* \:663e\:793a\
\:56fe\:4e8c\:632f\:5e45\:7ed3\:6784 *)
Print[\"\:5b8c\:6574\:7b26\:53f7\:81ea\:65cb\:8ff9\:77e9\:9635\:ff08\:5bf9\
\:89d2\:9879\:4e3a\:5355\:56fe\:5e73\:65b9\:ff0c\:975e\:5bf9\:89d2\:9879\:4e3a\
\:5e72\:6d89\:9879\:ff09\:ff1a\"]; (* \:89e3\:91ca\:77e9\:9635\:5143\:7d20 *)
Print[MatrixForm[fcTraceMatrix]]; (* \:663e\:793a FeynCalc \:8ba1\:7b97\:7684\
\:5b8c\:6574\:7b26\:53f7\:7ed3\:679c\:ff0c\:4e0d\:542b\:4f20\:64ad\:5b50\:7cfb\
\:6570 *)\
\>", "Input",
 CellLabel->
