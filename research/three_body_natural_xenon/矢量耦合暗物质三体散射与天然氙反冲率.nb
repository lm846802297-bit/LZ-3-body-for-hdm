Cell["\<\
root=DirectoryName[$InputFileName];
base=FileNameJoin[{root,\"feynrules-current\"}];
$FeynRulesPath=base;FR$Parallel=False;FeynRules`MatrixSymbol;
Get[FileNameJoin[{base,\"FeynRules.m\"}]];
SetDirectory[root];
LoadModel[FileNameJoin[{root,\"ThreeBodyVV.fr\"}]];
Print[\"LAGRANGIAN: \",ToString[InputForm[LInteraction],PageWidth->Infinity]];
rules=FeynmanRules[LInteraction];
Print[\"RULE COUNT: \",Length[rules]];
Print[\"RULES: \",ToString[InputForm[rules],PageWidth->Infinity]];
scalar=Select[rules,!FreeQ[#[[2]],gS]&];vector=Select[rules,!FreeQ[#[[2]],gX]&\
];nuclear=Select[rules,!FreeQ[#[[2]],gN]&];
Print[\"SCALAR, VECTOR, NUCLEON COUNTS: \
\",{Length[scalar],Length[vector],Length[nuclear]}];
Print[\"SCALAR STRUCTURE OK: \
\",And@@(FreeQ[#[[2]],Ga]&&!FreeQ[#[[2]],IndexDelta]& /@ scalar)];
Print[\"VECTOR STRUCTURE OK: \",And@@(!FreeQ[#[[2]],Ga]& /@ \
Join[vector,nuclear])];
Print[\"SCALAR COEFFICIENTS: \",ToString[InputForm[Simplify[#[[2]]/(I*gS)]& \
/@ scalar]]];
Print[\"VECTOR COEFFICIENTS: \",ToString[InputForm[Simplify[#[[2]]/(I*gX)]& \
/@ vector]]];
hermiticity=CheckHermiticity[LInteraction];
Print[\"HERMITICITY RESULT: \",ToString[InputForm[hermiticity]]];
Export[FileNameJoin[{root,\"feynrules_derived_rules.txt\"}],ToString[\
InputForm[rules],PageWidth->Infinity],\"Text\"];
scalarOK=And@@(FreeQ[#[[2]],Ga]&&!FreeQ[#[[2]],IndexDelta]& /@ scalar);
vectorOK=And@@(!FreeQ[#[[2]],Ga]& /@ Join[vector,nuclear]);
If[Length[rules]!=5||Length[scalar]!=2||Length[vector]!=2||Length[nuclear]!=1|\
|!TrueQ[scalarOK]||!TrueQ[vectorOK]||hermiticity=!={},Exit[2]];
Print[\"CHECK: PASS\"];Exit[0];
\
\>", "Program",
 CellTags->
  "embeddedRules",ExpressionUUID->"e2a08997-f72a-b84b-b60c-af74549cb68c"],

