  {\"\:76f4\:63a5\:8ba1\:7b97\:5929\:7136\:6c19\:603b\:7387\", \
haloRateTotal},  (* \:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\
\:884c\:53ca\:5176\:5bf9\:5e94\:7269\:7406\:91cf *)
  {\"\:4e24\:8005\:76f8\:5bf9\:5dee\", sumRelativeDifference}  (* \
