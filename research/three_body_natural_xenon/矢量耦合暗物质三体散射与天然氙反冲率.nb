1]*FeynAmpDenominator[PropagatorDenominator[Momentum[P - R], \
MMed]]*FeynAmpDenominator[PropagatorDenominator[Momentum[P - r - R], \
MChiTwo]]*Pair[LorentzIndex[Lor1], LorentzIndex[Lor2]]) - \
(Spinor[Momentum[R], MNuc, 1] . (I*gc5*DiracGamma[LorentzIndex[Lor2]] . \
DiracGamma[6] + I*gc5*DiracGamma[LorentzIndex[Lor2]] . DiracGamma[7]) . \
Spinor[Momentum[P], MNuc, 1]*Spinor[Momentum[r], MChiOne, 1] . \
(I*gc1*DiracGamma[6] + I*gc1*DiracGamma[7]) . (MChiTwo + \
DiracGamma[Momentum[k + r]]) . (I*gc4*DiracGamma[LorentzIndex[Lor1]] . \
DiracGamma[6] + I*gc4*DiracGamma[LorentzIndex[Lor1]] . DiracGamma[7]) . \
Spinor[Momentum[p], MChiOne, \
1]*FeynAmpDenominator[PropagatorDenominator[Momentum[-P + R], \
MMed]]*Pair[LorentzIndex[Lor1], LorentzIndex[Lor2]])/(I*gammaWidth*MChiTwo - \
