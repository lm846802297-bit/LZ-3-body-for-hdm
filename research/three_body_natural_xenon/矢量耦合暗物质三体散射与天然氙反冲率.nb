Cell[CellGroupData[{

Cell["\<\
(* \:4ece\:7b2c\:4e00\:8282\:9009\:62e9\:540c\:4f4d\:7d20\:3001\:8d28\:91cf\
\:7ec4\:5408\:3001\:53cd\:51b2\:80fd\:91cf\:548c\:901f\:5ea6\:3002 *)
If[!MemberQ[isotopes, diagnosticIsotope],  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
  Print[\"\:9519\:8bef\:ff1a\:8bf7\:5728 1.3 \:8282\:7684\:540c\:4f4d\:7d20\
\:8868\:4e2d\:52a0\:5165\:6240\:9009\:540c\:4f4d\:7d20\:3002\"]; Abort[]];  \
(* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
If[!IntegerQ[diagnosticBenchmarkIndex] ||  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
   !Between[diagnosticBenchmarkIndex, {1, Length[benchmarks]}],  (* \:7ee7\
\:7eed\:68c0\:67e5\:8f93\:5165\:6761\:4ef6\:6216\:6570\:503c\:6709\:6548\:6027\
 *)
  Print[\"\:9519\:8bef\:ff1a\:8d28\:91cf\:7ec4\:5408\:5e8f\:53f7\:8d85\:51fa \
benchmarks \:8303\:56f4\:3002\"]; Abort[]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
If[!TrueQ[0 < diagnosticSpeedKmPerS < 299792.458] ||  (* \:5224\:65ad\:6761\
\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
   !TrueQ[diagnosticRecoilKeV >= 0],  (* \:7ee7\:7eed\:68c0\:67e5\:8f93\:5165\
\:6761\:4ef6\:6216\:6570\:503c\:6709\:6548\:6027 *)
  Print[\"\:9519\:8bef\:ff1a\:8981\:6c42 0 < v < c \:4e14 ER >= 0\:3002\"]; \
Abort[]];  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\
\:679c *)

diagnosticParameters = pPole;  (* \:56fa\:5b9a\:4f7f\:7528\:6781\:70b9\:5bbd\
\:5ea6\:53c2\:6570\:7ec4 *)

selectedScalarMassGeV = benchmarks[[diagnosticBenchmarkIndex, 1]] * keVToGeV; \
 (* \:9009\:62e9\:5e76\:6362\:7b97\:6807\:91cf\:8d28\:91cf\:4e3a GeV *)
selectedSplittingGeV = benchmarks[[diagnosticBenchmarkIndex, 2]] * \
megaElectronVoltToGeV;  (* \:9009\:62e9\:5e76\:6362\:7b97\:8d28\:91cf\:5288\
\:88c2\:4e3a GeV *)
selectedNuclearMassGeV = diagnosticIsotope * 0.93149410242;  (* \:7528 A \
\:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\:6838\:8d28\:91cf *)
selectedRecoilGeV = diagnosticRecoilKeV * keVToGeV;  (* \:5c06\:53cd\:51b2\
\:80fd\:91cf\:6362\:7b97\:4e3a GeV *)
selectedBeta = diagnosticSpeedKmPerS / 299792.458;  (* \:8ba1\:7b97\:65e0\
\:91cf\:7eb2\:901f\:5ea6 v/c *)
selectedChiEnergyGeV = darkMatterMassGeV / Sqrt[1 - selectedBeta^2];  (* \
\:8ba1\:7b97\:5165\:5c04\:6697\:7269\:8d28\:76f8\:5bf9\:8bba\:80fd\:91cf *)
selectedChiMomentumGeV = selectedChiEnergyGeV * selectedBeta;  (* \
\:8ba1\:7b97\:5165\:5c04\:6697\:7269\:8d28\:52a8\:91cf\:5927\:5c0f *)
selectedQGeV = Sqrt[2 * selectedNuclearMassGeV * selectedRecoilGeV + \
selectedRecoilGeV^2];  (* \:7531\:53cd\:51b2\:80fd\:91cf\:8ba1\:7b97\:8f6c\
\:79fb\:4e09\:52a8\:91cf\:5927\:5c0f *)

(* \:539f\:7a3f\:4e2d\:7684\:4e0d\:53d8\:8d28\:91cf\:79ef\:5206\:4e0a\:4e0b\
\:9650\:ff0c\:5355\:4f4d GeV\.b2\:3002 *)
selectedW2Min = (darkMatterMassGeV + selectedScalarMassGeV)^2;  (* \:8ba1\
\:7b97 chi1 \
\:4e0e\:6807\:91cf\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:4e0b\:9650 *)
selectedW2Max = darkMatterMassGeV^2 + 2 * selectedChiMomentumGeV * \
selectedQGeV -  (* \:8ba1\:7b97\:5f53\:524d\:8fd0\:52a8\:5b66\:4e0b\:7684\
\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:4e0a\:9650 *)
  2 * (selectedChiEnergyGeV + selectedNuclearMassGeV) * selectedRecoilGeV;  \
(* \:8ba1\:7b97\:5f53\:524d\:516c\:5f0f\:7684\:8fd9\:4e00\:9879\:5e76\:63a5\
\:7eed\:4e0a\:4e0b\:6587 *)

Grid[{  (* \:5c06\:6570\:636e\:6574\:7406\:4e3a\:8868\:683c *)
  {\"\:7269\:7406\:91cf\", \"\:6570\:503c\", \"\:5355\:4f4d\"},  (* \:5b9a\
\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\
\:7269\:7406\:91cf *)
  {\"A\", diagnosticIsotope, \"\:65e0\:91cf\:7eb2\"},  (* \:5b9a\:4e49\:6216\
\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\:7269\:7406\
\:91cf *)
  {\"mA\", selectedNuclearMassGeV, \"GeV\"},  (* \:5b9a\:4e49\:6216\:8f93\
\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\:7269\:7406\:91cf\
 *)
  {\"p chi1\", selectedChiMomentumGeV, \"GeV\"},  (* \:5b9a\:4e49\:6216\:8f93\
\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\:7269\:7406\:91cf\
 *)
  {\"Wmin\.b2\", NumberForm[selectedW2Min, {16, 6}, ExponentFunction -> (Null \
&)], \"GeV\.b2\"},  (* \:63a7\:5236\:6570\:5b57\:7684\:663e\:793a\:683c\:5f0f \
*)
  {\"Wmax\.b2\", NumberForm[selectedW2Max, {16, 6}, ExponentFunction -> (Null \
&)], \"GeV\.b2\"},  (* \:63a7\:5236\:6570\:5b57\:7684\:663e\:793a\:683c\:5f0f \
*)
  {\"Wmax\.b2 - Wmin\.b2\", selectedW2Max - selectedW2Min, \"GeV\.b2\"},  (* \
\:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\
\:5e94\:7269\:7406\:91cf *)
  {\"\:4e09\:4f53\:76f8\:7a7a\:95f4\", If[selectedW2Max > selectedW2Min, \"\
\:6253\:5f00\", \"\:5173\:95ed\"], \"\"}  (* \:6839\:636e\:6761\:4ef6\:9009\
\:62e9\:5bf9\:5e94\:5206\:652f *)
}, Frame -> All]  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)\
\>", "Input",
 CellLabel->
