Cell[CellGroupData[{

Cell["\:4e94\:3001\:901f\:5ea6\:5206\:5e03\:4e0e\:5929\:7136\:6c19\:7684\:5fae\
\:5206\:622a\:9762", "Section",ExpressionUUID->"c1e88784-0fd4-5341-b39a-\
26f3478ccbd2"],

Cell["\<\
\:524d\:4e00\:8282\:5f97\:5230\:56fa\:5b9a\:901f\:5ea6\:3001\:5355\:4e00\:540c\
\:4f4d\:7d20 A \:7684 \
d\[Sigma]A/dER\:3002\:8fd9\:91cc\:7528\:5b9e\:9a8c\:5ba4\:901f\:7387\:6982\
\:7387\:5bc6\:5ea6 F(v) \
\:8ba1\:7b97\:666e\:901a\:901f\:5ea6\:5e73\:5747\:ff0c\:518d\:7528\:540c\:4f4d\
\:7d20\:6570\:76ee\:4e30\:5ea6 \[Eta]A \:52a0\:6743\:3002\:5404\:540c\:4f4d\
\:7d20\:6709\:5404\:81ea\:7684\:6838\:54cd\:5e94\:3001\:6838\:8d28\:91cf\:548c\
\:901f\:5ea6\:9608\:503c\:3002\:5df2\:5217\:540c\:4f4d\:7d20\:4e30\:5ea6\:76f4\
\:63a5\:76f8\:52a0\:ff0c\:4e0d\:91cd\:65b0\:5f52\:4e00\:5316\:ff1b\:7ed3\:679c\
\:5355\:4f4d\:4e3a GeV^-3\:ff0c\:4e58 0.3893793721\[Times]10^-33 \:53ef\:6362\
\:7b97\:4e3a cm\.b2/keV\:3002\
\>", "Text",ExpressionUUID->"719f4e53-46dd-1149-9411-86ee31b98c5b"],

Cell["\:27e8d\[Sigma]/dER\:27e9 = \[Sum]A \[Eta]A \[Integral]vmin,A^vmax F(v) \
[d\[Sigma]A(v)/dER] dv", "Text",ExpressionUUID->"ac7701b0-c9d1-c54f-81ea-\
859c6ff1c24c"],

Cell["\<\
Clear[SpeedAveragedCrossSection, NaturalAveragedCrossSection];
SpeedAveragedCrossSection[a_Integer, er_?NumericQ, ms_?NumericQ, \
dm_?NumericQ, p_Association] := Module[
  {vmin, vmax, opt, integrand}, (* \:8bbe\:7f6e\:901f\:5ea6\:4e0a\:4e0b\:9650\
\:548c\:79ef\:5206\:9009\:9879 *)
  vmin = VMin[p[\"mchi\"], ms, Global`xenonNuclearMassGeV[a], er*10^-6]; (* \
\:8be5\:540c\:4f4d\:7d20\:7684\:9608\:503c\:ff0ckm/s *)
  vmax = p[\"vEarth\"] + p[\"vEsc\"]; (* \:5730\:7403\:7cfb\:6700\:5927\:901f\
\:5ea6\:ff0ckm/s *)
  If[vmin >= vmax, Return[0.]]; (* \:65e0\:53ef\:7528\:901f\:5ea6\:65f6\:622a\
\:9762\:4e3a\:96f6 *)
  opt = p[\"nv\"]; (* \:4f7f\:7528\:4e3b\:8ba1\:7b97\:4e2d\:7684\:901f\:5ea6\
\:79ef\:5206\:8bbe\:7f6e *)
  integrand[v_?NumericQ] := SpeedPDF[v,p[\"v0\"],p[\"vEarth\"],p[\"vEsc\"]] \
DifferentialCrossSection[a,er,v,ms,dm,p]; (* \:6982\:7387\:5bc6\:5ea6\:4e58\
\:5fae\:5206\:622a\:9762 *)
  NIntegrate[integrand[v],{v,vmin,vmax},Method->{\"GlobalAdaptive\",\"\
SymbolicProcessing\"->0}, \
AccuracyGoal->opt[\"AccuracyGoal\"],PrecisionGoal->opt[\"PrecisionGoal\"],\
MaxRecursion->opt[\"MaxRecursion\"]] (* \:666e\:901a\:901f\:5ea6\:5e73\:5747 *)
];
NaturalAveragedCrossSection[er_?NumericQ,ms_?NumericQ,dm_?NumericQ,p_\
Association] := Total[Table[p[\"abundance\"][a] \
SpeedAveragedCrossSection[a,er,ms,dm,p],{a,p[\"isotopes\"]}]]; (* \
\:5404\:540c\:4f4d\:7d20\:6570\:76ee\:4e30\:5ea6\:52a0\:6743 *)
Print[\"\:5df2\:5b9a\:4e49\:5355\:540c\:4f4d\:7d20\:53ca\:5929\:7136\:6c19\
\:7684\:666e\:901a\:901f\:5ea6\:5e73\:5747\:5fae\:5206\:622a\:9762\:ff1b\:5b9e\
\:9645\:6570\:503c\:7531\:4e0b\:4e00\:8282\:7684\:6269\:5c55\:8ba1\:7b97\:5f00\
\:5173\:63a7\:5236\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1125]:=",ExpressionUUID->"869babae-a5aa-4c49-8481-0e8fd57d9427"],

Cell["\<\
\"\\:5df2\\:5b9a\\:4e49\\:5355\\:540c\\:4f4d\\:7d20\\:53ca\\:5929\\:7136\\:\
