6b42-8d94-8de7d3040ea3"],

Cell["\:4e0b\:9762\:7684\:4ee3\:7801\:76f4\:63a5\:4fdd\:5b58\:5728\:672c\:7b14\
\:8bb0\:672c\:ff0c\:53ef\:5c55\:5f00\:9605\:8bfb\:6216\:7f16\:8f91\:ff1b\:6267\
\:884c\:5176\:540e\:7684\:8fd0\:884c\:5355\:5143\:65f6\:ff0c\:5c06\:5728\:72ec\
\:7acb\:5185\:6838\:4e2d\:4f7f\:7528\:8fd9\:91cc\:7684\:4ee3\:7801\:3002", \
"Text",ExpressionUUID->"fbeac760-bc74-454f-a78b-e3959395df30"],

Cell["\<\
(* Run in a separate kernel: original FeynArts and FeynCalc export \
overlapping names. *)
base = DirectoryName[$InputFileName];
faDir = FileNameJoin[{base,\"..\",\"three_body_calculation_and_validation\",\"\
mathematica_halo_notebook\",\"FeynRules_check\",\"FeynArts-3.12\"}];
If[!FileExistsQ[FileNameJoin[{faDir,\"FeynArts.m\"}]],Print[\"FeynArts \
missing: \",faDir];Exit[1]];
PrependTo[$Path,faDir];
Get[\"FeynArts`\"];
topologies=CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];
diagrams=InsertFields[topologies,{F[1],V[1]}->{F[1],S[1]},
 Model->\"ChiRadiation\",InsertionLevel->{Classes}];
amplitudes=CreateFeynAmp[diagrams,Truncated->True];
Print[\"Number of inserted diagrams: \",Length[diagrams]];
Print[\"Number of amplitudes: \",Length[amplitudes]];
Print[\"Amplitudes (FeynArts notation):\"];
Print[ToString[InputForm[amplitudes],PageWidth->Infinity]];
If[Length[diagrams]!=2||Length[amplitudes]!=2,Exit[2]];
Exit[0];
\
\>", "Program",
 CellTags->
  "embeddedFA",ExpressionUUID->"4a3b0600-4c2f-ac4f-ae72-99325b6ffe92"],

Cell["\<\
(* \:5355\:72ec\:542f\:52a8 Mathematica \:5185\:6838\:ff0c\:907f\:514d \
FeynArts \:4e0e FeynCalc \:540c\:540d\:7b26\:53f7\:51b2\:7a81\:3002 *)
feynArtsScript = writeEmbeddedScript[\"embeddedFA\", False];  (* \:5b9a\:4f4d \
FeynArts \:81ea\:52a8\:751f\:6210\:56fe\:7684\:811a\:672c *)
feynArtsKernel = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \
\"Windows\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed];  (* \:67e5\:627e Wolfram \:547d\:4ee4\
\:884c\:7a0b\:5e8f *)
If[!FileExistsQ[feynArtsScript] || feynArtsKernel === $Failed,  (* \:5224\
\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\
\:652f *)
  Print[\"\:627e\:4e0d\:5230 FeynArts \:5bf9\:7167\:811a\:672c\:6216 \
wolframscript\:ff0c\:8bf7\:68c0\:67e5\:5b8c\:6574\:6587\:4ef6\:5305\:3002\"], \
 (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
  feynArtsRun = RunProcess[{feynArtsKernel, \"-file\", feynArtsScript}];  (* \
\:5728\:72ec\:7acb\:5185\:6838\:4e2d\:8fd0\:884c FeynArts \:5e76\:4fdd\:5b58\
\:8f93\:51fa *)
  Print[feynArtsRun[\"StandardOutput\"]];  (* \:663e\:793a\:5f53\:524d\:8bf4\
\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
  If[feynArtsRun[\"StandardError\"] =!= \"\", \
Print[feynArtsRun[\"StandardError\"]]];  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
  Print[\"\:6267\:884c\:9000\:51fa\:7801\:ff1a\", feynArtsRun[\"ExitCode\"]]  \
(* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
]  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
