\:3002 *)
fcFullScript = writeEmbeddedScript[\"embeddedFull\", True]; (* \:5b8c\:6574\
\:632f\:5e45\:811a\:672c *)
fcFullExecutable = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \
\"Windows\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed]; (* \:67e5\:627e Mathematica \:547d\
\:4ee4\:884c\:7a0b\:5e8f *)
fcFullInputs = {darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV, selectedNuclearMassGeV, selectedRecoilGeV, \
diagnosticSpeedKmPerS, mediatorMassGeV, g1val, g2val, gVNval}; (* \
\:8d28\:91cf\:3001\:901f\:5ea6\:548c\:70b9\:72b6\:9776\:8026\:5408 *)
If[fcFullExecutable === $Failed || !FileExistsQ[fcFullScript] || !And @@ \
(NumericQ /@ fcFullInputs), (* \:68c0\:67e5\:811a\:672c\:548c\:53c2\:6570 *)
 Print[\"\:8bf7\:5148\:8fd0\:884c\:7b2c\:4e00\:81f3\:7b2c\:4e09\:8282\:ff0c\
\:5e76\:786e\:8ba4 FeynRules_check \:6587\:4ef6\:5939\:4e0e wolframscript \
\:53ef\:7528\:3002\"], (* \:63d0\:793a\:5982\:4f55\:51c6\:5907 *)
 fcFullRun = RunProcess[Join[{fcFullExecutable, \"-file\", fcFullScript}, \
ToString[#, InputForm] & /@ fcFullInputs]]; (* \:5728\:72ec\:7acb\:5185\:6838\
\:751f\:6210\:4e24\:56fe\:3001\:81ea\:65cb\:8ff9\:5e76\:6570\:503c\:79ef\:5206\
 *)
 Print[fcFullRun[\"StandardOutput\"]]; (* \
\:663e\:793a\:632f\:5e45\:3001\:622a\:9762\:4e0e\:5bf9\:7167 *)
 If[fcFullRun[\"StandardError\"] =!= \"\", \
Print[fcFullRun[\"StandardError\"]]]; (* \:663e\:793a\:53ef\:80fd\:7684\:8ba1\
\:7b97\:63d0\:793a *)
 Print[\"\:6267\:884c\:9000\:51fa\:7801\:ff1a\", fcFullRun[\"ExitCode\"]] (* \
0 \:8868\:793a\:8ba1\:7b97\:5b8c\:6210\:ff1b\:6b64\:8ba1\:7b97\:4f7f\:7528\
\:6781\:70b9\:5bbd\:5ea6 *)
]\
\>", "Input",
 CellLabel->
