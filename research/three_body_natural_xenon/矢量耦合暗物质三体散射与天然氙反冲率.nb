]]]];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:5bf9\:6bcf\:7ec4\:8d28\:91cf\:9010\:70b9\:8ba1\:7b97\:672c\:8282\:516c\
\:5f0f\:ff0c\:7ed3\:679c\:4fdd\:5b58\:4e3a {ER, d sigma/d ER}\:3002 *)
fixedSpeedCrossSections = Table[  (* \:9010\:8d28\:91cf\:7ec4\:5408\:548c\
\:80fd\:91cf\:8ba1\:7b97\:56fa\:5b9a\:901f\:5ea6\:622a\:9762 *)
