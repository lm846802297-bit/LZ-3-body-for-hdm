Cell["\<\
expectedModelCanonicalHash = Hash[StringTrim[\"M$ModelName = \
\\\"InelasticScalarRadiation\\\";\\nM$Information = {Authors -> \
{\\\"Independent verification\\\"}, Version -> \\\"1.0\\\"};\\nM$Parameters = \
{\\n gX == {ParameterType -> External, ComplexParameter -> False, Value -> \
1.0, InteractionOrder -> {NP,1}, Description -> \\\"Off-diagonal vector \
coupling\\\"},\\n gS == {ParameterType -> External, ComplexParameter -> \
False, Value -> 1.0, InteractionOrder -> {NP,1}, Description -> \
\\\"Off-diagonal scalar coupling\\\"},\\n gN == {ParameterType -> External, \
ComplexParameter -> False, Value -> 1.0, InteractionOrder -> {NP,1}, \
Description -> \\\"Pointlike nucleon vector \
coupling\\\"}\\n};\\nM$ClassesDescription = {\\n F[1] == {ClassName -> \
chiOne, AntiClassName -> chiOnebar, SelfConjugate -> False, Mass -> \
{MChiOne,1000.}, Width -> 0, PDG -> {9000001}},\\n F[2] == {ClassName -> \
chiTwo, AntiClassName -> chiTwobar, SelfConjugate -> False, Mass -> \
{MChiTwo,1000.001}, Width -> {WChiTwo,0.0001518239116}, PDG -> {9000002}},\\n \
F[3] == {ClassName -> nuc, AntiClassName -> nucbar, SelfConjugate -> False, \
Mass -> {MNuc,0.938272}, Width -> 0, PDG -> {9000003}},\\n V[1] == {ClassName \
-> med, SelfConjugate -> True, Mass -> {MMed,10.}, Width -> 0, PDG -> \
{9000004}},\\n S[1] == {ClassName -> scal, SelfConjugate -> True, Mass -> \
{MScal,0.0003}, Width -> 0, PDG -> {9000005}}\\n};\\nLX := gX med[mu] \
chiTwobar.Ga[mu].chiOne;\\nLS := gS scal chiTwobar.chiOne;\\nLN := gN med[mu] \
nucbar.Ga[mu].nuc;\\nLInteraction := LX + HC[LX] + LS + HC[LS] + LN;\\n\\n\\n\
\"], \"SHA256\"];
(* \:4ece\:672c\:7b14\:8bb0\:672c\:5185\:7684\:7a0b\:5e8f\:5355\:5143\:8bfb\
\:53d6\:6e90\:4ee3\:7801\:ff1b\:6bcf\:6b21\:8fd0\:884c\:90fd\:4f1a\:8bfb\:53d6\
\:5f53\:524d\:5185\:5bb9\:3002 *)
notebookSource[tag_String] := Module[{cells},
 cells = Cells[EvaluationNotebook[], CellTags -> tag];
 If[Length[cells] == 0, Print[\"Notebook source cell missing: \", tag]; \
Abort[]];
 StringRiffle[(First[NotebookRead[#]] &) /@ cells, \"\\n\"]
];
(* \:4e3a\:907f\:514d FeynCalc\:3001FeynArts \:548c FeynRules \:7684\:7b26\
\:53f7\:51b2\:7a81\:ff0c\:5728\:4e34\:65f6\:72ec\:7acb\:5185\:6838\:8fd0\:884c\
\:ff1b
   \:4e34\:65f6\:811a\:672c\:7684\:5185\:5bb9\:6765\:81ea\:672c\:7b14\:8bb0\
\:672c\:ff0c\:4e0d\:8bfb\:53d6\:6211\:4eec\:539f\:6709\:7684\:5916\:90e8\:8ba1\
\:7b97\:811a\:672c\:3002 *)
writeEmbeddedScript[tag_String, inRulesFolder_:False] := Module[
 {src, base, root, engineSource, niSource, modelSource, modelTemp, modelDir, \
hashTemp, temp},
 base = NotebookDirectory[];
 root = If[inRulesFolder, FileNameJoin[{base, \"FeynRules_check\"}], base];
 src = notebookSource[tag];
 engineSource = notebookSource[\"inlineEngine\"];
 niSource = notebookSource[\"embeddedNI\"];
 modelSource = notebookSource[\"embeddedModel\"];
 modelTemp = CreateTemporary[] <> \".fr\";
 Export[modelTemp, modelSource, \"Text\"];
 (* \:81ea\:52a8\:5bfc\:51fa\:7684 FeynArts \:6a21\:578b\:4e5f\:4ece\:672c\
\:7b14\:8bb0\:672c\:590d\:5236\:5230\:4e34\:65f6\:76ee\:5f55\:3002 *)
 modelDir = CreateDirectory[CreateTemporary[] <> \"_models\"];
 Export[FileNameJoin[{modelDir, \"ThreeBodyVV_FA.gen\"}], \
notebookSource[\"embeddedFAgen\"], \"Text\"];
 Export[FileNameJoin[{modelDir, \"ThreeBodyVV_FA.mod\"}], \
notebookSource[\"embeddedFAmod\"], \"Text\"];
 Export[FileNameJoin[{modelDir, \"ChiRadiation.mod\"}], \
notebookSource[\"embeddedChiFA\"], \"Text\"];
 hashTemp = CreateTemporary[] <> \".txt\";
 Export[hashTemp, \
\"ca06a6866fc7eb34bdb8ab985f6dc2b35553dbe031e929355c84586b62b5afd6\", \
\"Text\"];
 src = StringReplace[src, {
   \"DirectoryName[$InputFileName]\" -> ToString[InputForm[root]],
   \"FileNameJoin[{workDir,\\\"ThreeBodyVV.fr\\\"}]\" -> \
ToString[InputForm[modelTemp]],
   \"FileNameJoin[{root,\\\"ThreeBodyVV.fr\\\"}]\" -> \
ToString[InputForm[modelTemp]],
   \"FileNameJoin[{workDir,\\\"generated_model_source_sha256.txt\\\"}]\" -> \
ToString[InputForm[hashTemp]],
   \"\\\"ThreeBodyVV_FA\\\"\" -> ToString[InputForm[FileNameJoin[{modelDir, \
\"ThreeBodyVV_FA\"}]]],
   \"\\\"ChiRadiation\\\"\" -> ToString[InputForm[FileNameJoin[{modelDir, \
\"ChiRadiation\"}]]],
   \"(* INSERT_NOTEBOOK_ENGINE *)\" -> engineSource,
   \"(* INSERT_NOTEBOOK_NINTEGRATE *)\" -> StringReplace[niSource, \
\"299792.458\" -> \"(299792458/1000)\"]
 }];
 (* \:4e0d\:540c\:7cfb\:7edf\:7684\:6362\:884c\:7b26\:4e0d\:5f71\:54cd\:6a21\
\:578b\:7684\:7269\:7406\:5185\:5bb9\:ff1b\:4ee5\:89c4\:8303\:5316\:6a21\:578b\
\:5185\:5bb9\:68c0\:67e5\:6765\:6e90\:ff0c
    \:540c\:65f6\:4fdd\:7559\:5bfc\:51fa\:6a21\:578b\:65f6\:7684\:539f\:59cb \
SHA256 \:8bb0\:5f55\:68c0\:67e5\:3002 *)
 src = StringReplace[src,
  \"ToLowerCase[FileHash[sourceModel,\\\"SHA256\\\",\\\"HexString\\\"]]=!=\
StringTrim[Import[hashFile,\\\"Text\\\"]]\" ->
   \"(Hash[StringTrim[StringReplace[Import[sourceModel,\\\"Text\\\"],\
FromCharacterCode[{13,10}]->FromCharacterCode[10]]],\\\"SHA256\\\"] =!= \" <>
   ToString[expectedModelCanonicalHash, InputForm] <> \" || \
StringTrim[Import[hashFile,\\\"Text\\\"]] =!= \
\\\"ca06a6866fc7eb34bdb8ab985f6dc2b35553dbe031e929355c84586b62b5afd6\\\")\"
 ];
 temp = CreateTemporary[] <> \".wls\";
 Export[temp, src, \"Text\"];
 temp
];\
\>", "Input",
 CellLabel->
  "In[1241]:=",ExpressionUUID->"2bca3392-ed14-9349-8a95-28c9863349b7"]
}, Open  ]]
