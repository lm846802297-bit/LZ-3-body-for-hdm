\:8868\:683c *)
    recoilKeV,  (* \:4f20\:5165\:53c2\:6570 recoilKeV\:ff0c\:4f9b\:5f53\:524d\
\:51fd\:6570\:4f7f\:7528 *)
    DifferentialCrossSection[  (* \:8ba1\:7b97\:5355\:6838\:56fa\:5b9a\:901f\
\:5ea6\:5fae\:5206\:622a\:9762 *)
      diagnosticIsotope, recoilKeV, diagnosticSpeedKmPerS,  (* \:672c\:884c\
\:6d89\:53ca\:ff1a\:9009\:62e9\:5355\:6838\:622a\:9762\:7684\:540c\:4f4d\:7d20\
\:8d28\:91cf\:6570\:ff1b\:8bbe\:7f6e\:68c0\:67e5\:7528\:5165\:5c04\:901f\:5ea6\
 km/s *)
      benchmark[[1]] * keVToGeV, benchmark[[2]] * megaElectronVoltToGeV,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:5b9a\:4e49 keV \:5230 GeV \:7684\:6362\:7b97\
\:56e0\:5b50\:ff1b\:5b9a\:4e49 MeV \:5230 GeV \:7684\:6362\:7b97\:56e0\:5b50 *)
      diagnosticParameters  (* \:4f20\:5165\:53c2\:6570 diagnosticParameters\
\:ff0c\:4f9b\:5f53\:524d\:51fd\:6570\:4f7f\:7528 *)
    ] * gevMinus2ToCm2 * 10^-6  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\
\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
  }, {recoilKeV, fixedSpeedEnergyGridKeV}],  (* \
\:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\
\:7b97\:5757 *)
  {benchmark, benchmarks}  (* \
\:8bbe\:7f6e\:8be5\:5faa\:73af\:7684\:53d8\:91cf\:548c\:904d\:5386\:8303\:56f4\
\:ff0c\:6216\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:5bf9\:6570\:5750\:6807\:53ea\:7ed8\:5236\:622a\:9762\:4e3a\:6b63\:7684\
\:70b9\:3002 *)
positiveCrossSections = (Select[#, Last[#] > 0 &] &) /@ \
fixedSpeedCrossSections;  (* \:7b5b\:9009\:6b63\:503c\:4ee5\:4fbf\:4f7f\:7528\
\:5bf9\:6570\:5750\:6807 *)
activeCrossSectionIndices = Select[Range[Length[benchmarks]],  (* \
\:627e\:51fa\:6709\:6b63\:503c\:6570\:636e\:7684\:8d28\:91cf\:7ec4\:5408 *)
  Length[positiveCrossSections[[#]]] > 0 &];  (* \:672c\:884c\:6d89\:53ca\
\:ff1a\:7b5b\:9009\:6b63\:503c\:4ee5\:4fbf\:4f7f\:7528\:5bf9\:6570\:5750\:6807\
 *)

If[Length[activeCrossSectionIndices] == 0,  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
  Print[\"\:6240\:9009\:901f\:5ea6\:548c\:80fd\:91cf\:8303\:56f4\:5185\:7684\
\:622a\:9762\:5747\:4e3a\:96f6\:3002\"],  (* \:663e\:793a\:5f53\:524d\:8bf4\
\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
  fixedSpeedLabels = (\"ms=\" <> ToString[#[[1]]] <> \" keV, Delta m=\" <>  \
(* \:7531\:8d28\:91cf\:7ec4\:5408\:81ea\:52a8\:751f\:6210\:56fe\:4f8b *)
      ToString[#[[2]]] <> \" MeV\" &) /@ benchmarks;  (* \:5c06\:6570\:503c\
\:6216\:8868\:8fbe\:5f0f\:8f6c\:6362\:4e3a\:6587\:5b57 *)
  fixedSpeedPlot = ListLogPlot[  (* \
\:7ed8\:5236\:56fa\:5b9a\:901f\:5ea6\:5fae\:5206\:622a\:9762\:66f2\:7ebf *)
    positiveCrossSections[[activeCrossSectionIndices]],  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:7b5b\:9009\:6b63\:503c\:4ee5\:4fbf\:4f7f\:7528\
\:5bf9\:6570\:5750\:6807\:ff1b\:627e\:51fa\:6709\:6b63\:503c\:6570\:636e\:7684\
\:8d28\:91cf\:7ec4\:5408 *)
    Joined -> True,  (* \
\:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\:5219\
\:6216\:663e\:793a\:9009\:9879 *)
    PlotRange -> All,  (* \:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\
\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\:793a\:9009\:9879 *)
    Frame -> True,  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)
    (* \:548c\:540e\:9762\:7684\:4e8b\:4ef6\:7387\:56fe\:4f7f\:7528\:76f8\
\:540c\:7684\:57fa\:51c6\:989c\:8272\:3002 *)
    PlotStyle -> Table[  (* \:6309\:7ed9\:5b9a\:53d8\:91cf\:904d\:5386\:5e76\
\:751f\:6210\:8868\:683c *)
      {Red, RGBColor[0, .5, 0], Black, Blue}[[1 + Mod[index - 1, 4]]],  (* \
\:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\
\:7b97\:5757 *)
      {index, activeCrossSectionIndices}  (* \:7ec4\:7ec7\:5f53\:524d\:5217\
\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
    ],  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
    FrameLabel -> {\"Recoil energy ER (keV)\", \"d sigma / d ER \
(cm^2/keV)\"},  (* \:8bbe\:7f6e\:7ed8\:56fe\:5750\:6807\:8f74\:540d\:79f0\
\:548c\:5355\:4f4d *)
    PlotLegends -> Placed[fixedSpeedLabels[[activeCrossSectionIndices]], \
Below],  (* \
\:8bbe\:7f6e\:66f2\:7ebf\:56fe\:4f8b\:548c\:663e\:793a\:4f4d\:7f6e *)
    PlotLabel -> \"Fixed-speed cross section, Xe-\" <> \
ToString[diagnosticIsotope] <>  (* \:5c06\:6570\:503c\:6216\:8868\:8fbe\:5f0f\
\:8f6c\:6362\:4e3a\:6587\:5b57 *)
      \", v=\" <> ToString[diagnosticSpeedKmPerS] <> \" km/s\",  (* \:5c06\
\:6570\:503c\:6216\:8868\:8fbe\:5f0f\:8f6c\:6362\:4e3a\:6587\:5b57 *)
