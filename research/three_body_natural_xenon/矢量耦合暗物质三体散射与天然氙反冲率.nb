Cell[CellGroupData[{

Cell["FeynCalc\:ff1a\:4e24\:5f20\:8d39\:66fc\:56fe\:4e0e\:81ea\:65cb\:8ff9", \
"Subsection",ExpressionUUID->"884da098-185b-084d-b412-e5e312605bdb"],

Cell["\<\
\:4e0b\:9762\:663e\:793a\:4e24\:5f20\:8f90\:5c04\:56fe\:5404\:81ea\:7684\:6697\
\:7269\:8d28\:7535\:6d41\:77e9\:9635\:94fe\:53ca\:4f20\:64ad\:5b50\:5206\:6bcd\
\:3002\:8f93\:51fa\:7701\:7565\:516c\:5171\:8026\:5408\:3001\:77e2\:91cf\:5a92\
\:4ecb\:4f20\:64ad\:5b50\:3001\:6838\:6d41\:548c\:5916\:90e8\:65cb\:91cf\:ff1b\
fcWidth \:662f\:7b26\:53f7\:5bbd\:5ea6\:ff0c\:6570\:503c\:8ba1\:7b97\:4f1a\
\:4ee3\:5165 Chi2Width\:3002\:968f\:540e\:663e\:793a FeynCalc \:7684 \
2\[Times]2 \:81ea\:65cb\:8ff9\:77e9\:9635\:ff0c\:5bf9\:89d2\:5143\:7d20\:662f\
\:5355\:56fe\:5e73\:65b9\:ff0c\:975e\:5bf9\:89d2\:5143\:7d20\:662f\:5e72\:6d89\
\:9879\:ff1b\:77e9\:9635\:8f93\:51fa\:672a\:4e58\:4f20\:64ad\:5b50\:5206\:6bcd\
\:3002\
\>", "Text",ExpressionUUID->"df6e5089-683b-a140-8113-c6229e9c98f6"],

Cell["\<\
\:5728\:672c\:6a21\:578b\:4e2d\:624b\:52a8\:5199\:51fa\:4e24\:6761\:8d39\:7c73\
\:5b50\:94fe\:ff1bFeynCalc \:8ba1\:7b97\:81ea\:65cb\:8ff9\:548c\:5e72\:6d89\
\:9879\:ff0c\:968f\:540e\:628a\:7ed3\:679c\:7528\:4e8e I6\:3001\:5fae\:5206\
\:622a\:9762\:548c\:4e8b\:4ef6\:7387\:3002\:8fd9\:91cc\:4e0d\:4f9d\:8d56 \
FeynArts \:81ea\:52a8\:751f\:6210\:8d39\:66fc\:56fe\:3002\
\>", "Text",ExpressionUUID->"effe9e67-022c-7844-b455-7fe311426d43"],

Cell[CellGroupData[{

Cell["\<\
FCClearScalarProducts[];  (* \:6e05\:9664\:6b64\:524d\:8bbe\:7f6e\:7684 \
FeynCalc \:6807\:91cf\:79ef *)
fcChain1 = GA[0].(GS[fcP]-GS[fcK]+fcM2);  (* \:6784\:9020\:7b2c\:4e00\:5f20\
\:8f90\:5c04\:56fe\:7684 Dirac \:77e9\:9635\:94fe *)
fcChain2 = (GS[fcR]+GS[fcK]+fcM2).GA[0];  (* \:6784\:9020\:7b2c\:4e8c\:5f20\
\:8f90\:5c04\:56fe\:7684 Dirac \:77e9\:9635\:94fe *)
fcChains = {fcChain1, fcChain2};  (* \:6536\:96c6\:4e24\:5f20\:56fe\:7684\
\:77e9\:9635\:94fe *)
(* FeynCalc \:7684 ComplexConjugate \:751f\:6210 Dirac \:5171\:8f6d\:ff0c\
\:4ea4\:6362\:94fe\:7684\:987a\:5e8f\:3002 *)
fcTraceMatrix = Table[  (* \:9010\:5bf9\:8ba1\:7b97\:632f\:5e45\:7684\:81ea\
\:65cb\:8ff9\:ff0c\:5305\:62ec\:5e72\:6d89\:9879 *)
 DiracSimplify[DiracTrace[(GS[fcR]+fcM).fcChains[[i]].(GS[fcP]+fcM).  (* \
\:5316\:7b80 FeynCalc \:7684 Dirac \:8ff9 *)
   ComplexConjugate[fcChains[[j]]]], DiracTraceEvaluate->True]/2,  (* \:6784\
\:9020\:632f\:5e45\:7684 Dirac \:5171\:8f6d *)
 {i,2},{j,2}];  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\
\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
Print[\"FeynCalc \:5df2\:8ba1\:7b97\:4e24\:5f20\:56fe\:7684 2\[Times]2 \:81ea\
\:65cb\:8ff9\:77e9\:9635\:ff1b\:975e\:5bf9\:89d2\:9879\:662f\:5e72\:6d89\:9879\
\:3002\:5b8c\:6574\:7b26\:53f7\:7ed3\:679c\:4fdd\:5b58\:5728 fcTraceMatrix\
\:3002\"];
Print[\"\:77e9\:9635\:7ef4\:6570\:ff1a\", Dimensions[fcTraceMatrix], \"\:ff1b\
