Cell["FeynCalc + AFH\:ff1a\:8ba1\:7b97\:6211\:4eec\:7684\:4e09\:4f53\:6838\
\:622a\:9762", "Subsubsection",ExpressionUUID->"c21b02ea-454a-d541-8221-\
3de4a29a215e"],

Cell["\<\
\:672c\:8282\:4f7f\:7528 FeynRules \:5bfc\:51fa\:7684\:76f8\:4e92\:4f5c\:7528\
\:ff0c\:7ecf FeynArts \:751f\:6210\:4e24\:5f20\:5b8c\:6574 2\[RightArrow]3 \
\:6811\:56fe\:ff0c\:518d\:7531 FeynCalc \:505a\:521d\:6001\:6697\:7269\:8d28\
\:81ea\:65cb\:5e73\:5747\:53ca\:672b\:6001\:81ea\:65cb\:6c42\:548c\:3002\:4e3a\
\:5339\:914d\:7b2c 3.5 \:8282\:91c7\:7528\:7684\:524d\:5bfc\:6838\:6d41\:ff0c\
\:5c06\:6838\:6d41\:6295\:5f71\:5230\:9776\:6838\:9759\:6b62\:7cfb\:7684\:65f6\
