 *)
Print[\"\:793a\:4f8b\:79ef\:5206\:53d8\:91cf\:ff1au=0.4\:ff0cz=0.25\:ff0cphi=\
1.2\:ff1b\:4f20\:64ad\:5b50\:7684\:5b9e\:90e8\:968f W\.b2 \:6539\:53d8\:ff0c\
\:5bbd\:5ea6\:6309\:8be5 benchmark \:56fa\:5b9a\:3002\"]; (* \:89e3\:91ca\
\:793a\:4f8b\:70b9\:4e0e\:5b9e\:9645\:79ef\:5206\:7684\:5173\:7cfb *)
Grid[Prepend[widthPropagationRows,{\"ms (keV)\",\"\[CapitalDelta]m \
(MeV)\",\"m\[Chi]2 (GeV)\",\"\[CapitalGamma] (keV)\",\"Im(D2) (GeV\.b2)\",\"\
