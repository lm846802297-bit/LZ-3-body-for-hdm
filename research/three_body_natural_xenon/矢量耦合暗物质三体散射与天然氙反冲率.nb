ab44-bda7-a0ec72d472d6"],

Cell[CellGroupData[{

Cell["\<\
(* \:9009\:62e9\:5f85\:6bd4\:8f83\:7684\:8d28\:91cf\:7ec4\:5408\:548c\:53cd\
\:51b2\:80fd\:91cf\:3002 *)
haloBenchmarkIndex = diagnosticBenchmarkIndex;  (* \:9009\:62e9\:5929\:7136\
\:6c19\:53cd\:51b2\:7387\:7684\:8d28\:91cf\:7ec4\:5408 *)
haloRecoilKeV = diagnosticRecoilKeV;  (* \:8bbe\:7f6e\:5929\:7136\:6c19\:540c\
\:4f4d\:7d20\:8d21\:732e\:7684\:68c0\:67e5\:80fd\:91cf *)
haloScalarMassGeV = benchmarks[[haloBenchmarkIndex, 1]] * keVToGeV;  (* \
\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\:6362\:7b97\:4e3a GeV *)
haloSplittingGeV = benchmarks[[haloBenchmarkIndex, 2]] * \
megaElectronVoltToGeV;  (* \:5c06\:6240\:9009\:8d28\:91cf\:5288\:88c2\:6362\
\:7b97\:4e3a GeV *)

(* \:5bf9\:5b9e\:9a8c\:5ba4\:901f\:7387\:5206\:5e03\:79ef\:5206\:3002\:5206\
\:754c\:70b9\:6765\:81ea\:9003\:9038\:901f\:5ea6\:622a\:65ad\:3002 *)
haloBoundary = parameters[\"vEsc\"] - parameters[\"vEarth\"];  (* \
\:8ba1\:7b97\:901f\:5ea6\:5206\:5e03\:7684\:5206\:6bb5\:8fb9\:754c *)
haloMaximum = parameters[\"vEsc\"] + parameters[\"vEarth\"];  (* \:8ba1\:7b97\
\:5b9e\:9a8c\:5ba4\:7cfb\:901f\:7387\:7684\:6700\:5927\:503c *)
haloNormalization = NIntegrate[  (* \
\:6570\:503c\:68c0\:67e5\:5b9e\:9a8c\:5ba4\:901f\:7387\:6982\:7387\:5bc6\:5ea6\
\:7684\:5f52\:4e00\:5316 *)
  SpeedPDF[v, parameters[\"v0\"], parameters[\"vEarth\"], \
parameters[\"vEsc\"]],  (* \:8ba1\:7b97\:5b9e\:9a8c\:5ba4\:7cfb\:901f\:7387\
\:6982\:7387\:5bc6\:5ea6 *)
  {v, 0, haloBoundary, haloMaximum}  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\
\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:6bcf\:6b21\:53ea\:4fdd\:7559\:4e00\:4e2a\:540c\:4f4d\:7d20\:ff0c\:4fdd\
\:7559\:5176\:5929\:7136\:4e30\:5ea6\:548c\:5929\:7136\:6c19\:5e73\:5747\:6469\
\:5c14\:8d28\:91cf\:3002 *)
isotopeContributions = Table[  (* \:9010\:79cd\:540c\:4f4d\:7d20\:8ba1\:7b97\
\:5176\:5929\:7136\:4e30\:5ea6\:52a0\:6743\:8d21\:732e *)
  Module[{oneIsotopeParameters, threshold, contribution},  (* \:5b9a\:4e49\
\:5c40\:90e8\:53d8\:91cf\:548c\:5c40\:90e8\:8ba1\:7b97 *)
    oneIsotopeParameters = Join[pPole, <|\"isotopes\" -> {isotope}|>];  (* \
\:4fdd\:7559\:5f53\:524d\:540c\:4f4d\:7d20\:53ca\:5929\:7136\:6c19\:6469\:5c14\
\:8d28\:91cf\:7684\:53c2\:6570 *)
    threshold = VMin[  (* \:8ba1\:7b97\:8be5\:540c\:4f4d\:7d20\:4e09\:4f53\
\:6563\:5c04\:7684\:901f\:5ea6\:9608\:503c *)
      darkMatterMassGeV, haloScalarMassGeV,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:8f93\:5165\:6697\:7269\:8d28 chi1 \
\:8d28\:91cf\:ff0c\:5355\:4f4d GeV\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\
\:91cf\:6362\:7b97\:4e3a GeV *)
      isotope * 0.93149410242, haloRecoilKeV * keVToGeV  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:5b9a\:4e49 keV \:5230 GeV \:7684\:6362\:7b97\
\:56e0\:5b50\:ff1b\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\
\:7684\:68c0\:67e5\:80fd\:91cf *)
    ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
    contribution = Rate[  (* \:8ba1\:7b97\:8be5\:540c\:4f4d\:7d20\:5bf9\:5929\
\:7136\:6c19\:7387\:7684\:8d21\:732e *)
      haloRecoilKeV, haloScalarMassGeV, haloSplittingGeV,  (* \:672c\:884c\
\:6d89\:53ca\:ff1a\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\
\:7684\:68c0\:67e5\:80fd\:91cf\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\
\:6362\:7b97\:4e3a GeV\:ff1b\:5c06\:6240\:9009\:8d28\:91cf\:5288\:88c2\:6362\
\:7b97\:4e3a GeV *)
      oneIsotopeParameters  (* \:4f20\:5165\:53c2\:6570\:ff1a\:4fdd\:7559\
\:5f53\:524d\:540c\:4f4d\:7d20\:53ca\:5929\:7136\:6c19\:6469\:5c14\:8d28\:91cf\
\:7684\:53c2\:6570 *)
    ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
    {isotope, abundances[isotope], threshold, contribution}  (* \:8bbe\:7f6e\
\:8be5\:5faa\:73af\:7684\:53d8\:91cf\:548c\:904d\:5386\:8303\:56f4\:ff0c\:6216\
\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c *)
  ],  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
  {isotope, isotopes}  (* \:8bbe\:7f6e\:8be5\:5faa\:73af\:7684\:53d8\:91cf\
\:548c\:904d\:5386\:8303\:56f4\:ff0c\:6216\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c\
 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:76f4\:63a5\:6c42\:5929\:7136\:6c19\:4e8b\:4ef6\:7387\:ff0c\:5e76\:4e0e\
\:9010\:540c\:4f4d\:7d20\:7ed3\:679c\:4e4b\:548c\:5bf9\:7167\:3002 *)
haloRateTotal = Rate[  (* \:4f7f\:7528\:5b8c\:6574\:540c\:4f4d\:7d20\:5217\
\:8868\:76f4\:63a5\:8ba1\:7b97\:603b\:7387 *)
  haloRecoilKeV, haloScalarMassGeV, haloSplittingGeV, pPole  (* \:672c\:884c\
\:6d89\:53ca\:ff1a\:521b\:5efa\:6781\:70b9\:5bbd\:5ea6\:53c2\:6570\:7ec4\:ff1b\
\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\:7684\:68c0\:67e5\
\:80fd\:91cf\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\:6362\:7b97\:4e3a\
 GeV *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
isotopeRateSum = Total[isotopeContributions[[All, 4]]];  (* \
\:628a\:5404\:540c\:4f4d\:7d20\:8d21\:732e\:76f8\:52a0 *)
sumRelativeDifference = If[haloRateTotal != 0,  (* \:8ba1\:7b97\:9010\:9879\
\:76f8\:52a0\:4e0e\:76f4\:63a5\:603b\:7387\:7684\:76f8\:5bf9\:5dee *)
  isotopeRateSum / haloRateTotal - 1,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:4f7f\:7528\:5b8c\:6574\:540c\:4f4d\:7d20\:5217\
\:8868\:76f4\:63a5\:8ba1\:7b97\:603b\:7387\:ff1b\:628a\:5404\:540c\:4f4d\:7d20\
\:8d21\:732e\:76f8\:52a0 *)
  If[isotopeRateSum == 0, 0, Indeterminate]  (* \
\:5224\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\
\:5206\:652f *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

Print[\"\:901f\:7387\:5206\:5e03\:5f52\:4e00\:5316 = \", haloNormalization];  \
(* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[\"\:7eb3\:5165\:540c\:4f4d\:7d20\:7684\:5929\:7136\:4e30\:5ea6\:4e4b\
\:548c = \", Total[Values[abundances]]];  (* \:663e\:793a\:5f53\:524d\:8bf4\
\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[Grid[  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\
\:679c *)
  Prepend[isotopeContributions,  (* \
\:5728\:8868\:683c\:524d\:52a0\:5165\:6807\:9898\:884c *)
    {\"A\", \"\:6570\:76ee\:4e30\:5ea6\", \"\:4e09\:4f53\:9608\:503c\:901f\
\:5ea6 [km/s]\", \"\:8d21\:732e [events/(tonne year keV)]\"}],  (* \:5b9a\
