\:5b9a\:8303\:56f4\:7684\:6570\:503c\:70b9 *)
  extraRecoilEnergiesKeV,  (* \
\:4f20\:5165\:53c2\:6570\:ff1a\:628a\:989d\:5916\:68c0\:67e5\:80fd\:91cf\:52a0\
\:5165\:7f51\:683c *)
