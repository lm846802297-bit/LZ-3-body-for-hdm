Cell["\<\
\:672c\:68c0\:67e5\:4f7f\:7528\:56fa\:5b9a\:5386\:53f2\:57fa\:51c6 \
m\[Chi]1=1000 GeV\:3001ms=300 keV\:3001\[CapitalDelta]m=1 MeV\:3001mA=122 GeV\
\:3001ER=200 keV\:3001v=776 km/s\:3001g2=1\:3002\:8fd9\:91cc\:7684 mA \:6070\
