Cell["\<\
(* \:5355\:72ec\:542f\:52a8 Mathematica \:5185\:6838\:ff0c\:907f\:514d \
FeynArts \:4e0e FeynCalc \:540c\:540d\:7b26\:53f7\:51b2\:7a81\:3002 *)
feynArtsScript = writeEmbeddedScript[\"embeddedFA\", False];  (* \:5b9a\:4f4d \
FeynArts \:81ea\:52a8\:751f\:6210\:56fe\:7684\:811a\:672c *)
feynArtsKernel = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \
\"Windows\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed];  (* \:67e5\:627e Wolfram \:547d\:4ee4\
\:884c\:7a0b\:5e8f *)
If[!FileExistsQ[feynArtsScript] || feynArtsKernel === $Failed,  (* \:5224\
\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\
\:652f *)
