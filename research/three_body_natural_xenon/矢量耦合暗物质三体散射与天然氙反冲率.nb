\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\:793a\:9009\:9879 *)
  ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
  fixedSpeedPlot  (* \:4f20\:5165\:53c2\:6570\:ff1a\:7ed8\:5236\:56fa\:5b9a\
\:901f\:5ea6\:5fae\:5206\:622a\:9762\:66f2\:7ebf *)
]  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)\
