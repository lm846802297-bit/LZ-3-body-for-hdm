Cell[CellGroupData[{

Cell["\<\
(* \:8ba1\:7b97\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd\:548c\:622a\:9762\
\:524d\:56e0\:5b50\:3002 *)
selectedMediatorDenominator = (mediatorMassGeV^2 + 2 selectedNuclearMassGeV \
selectedRecoilGeV)^2;
If[!TrueQ[selectedMediatorDenominator > 0], Print[\"\:9519\:8bef\:ff1a\:77e2\
\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd\:4e3a\:96f6\:3002\"]; Abort[]];
selectedPrefactorGeVMinus5 = selectedNuclearMassGeV couplingProductSquared \
selectedNuclearResponse/
 (256 Pi^3 selectedChiMomentumGeV^2 selectedMediatorDenominator);
(* \:5c06 FeynCalc \:81ea\:65cb\:8ff9\:6240\:5f97\:7684\:4e09\:4f53\:79ef\
\:5206 I6 \:4e58\:4ee5\:524d\:56e0\:5b50\:ff0c\:5f97\:5230\:5fae\:5206\:622a\
\:9762\:3002 *)
selectedDSigmaGeVMinus3 = selectedPrefactorGeVMinus5 selectedI6GeV2;
gevMinus2ToCm2 = 0.3893793721 * 10^-27;
selectedDSigmaCm2PerKeV = selectedDSigmaGeVMinus3 gevMinus2ToCm2 * 10^-6;
Grid[{{\"\:7269\:7406\:91cf\", \"\:6570\:503c\", \"\:5355\:4f4d\"}, {\"\:622a\
\:9762\:524d\:56e0\:5b50\", selectedPrefactorGeVMinus5, \"GeV^-5\"},
 {\"d sigma / d ER\", selectedDSigmaGeVMinus3, \"GeV^-3\"},
 {\"d sigma / d ER\", selectedDSigmaCm2PerKeV, \"cm\.b2/keV\"}}, Frame -> All]\
\>", "Input",
 CellLabel->
