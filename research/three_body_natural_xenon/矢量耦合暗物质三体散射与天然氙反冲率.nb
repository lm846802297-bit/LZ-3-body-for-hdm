Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{"d", 
        SubscriptBox["\[Sigma]", "A"]}], 
       RowBox[{"d", 
        SubscriptBox["E", "R"]}]], "=", 
      FractionBox[
       RowBox[{
        SubscriptBox["m", "A"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["g", "1"], " ", 
          SubscriptBox["g", "2"], " ", 
          SubscriptBox["g", "VN"], ")"}], "2"], 
        SubscriptBox["\[ScriptCapitalR]", "A"], "(", 
        SubscriptBox["E", "R"], ")"}], 
       RowBox[{"256", 
        SuperscriptBox["\[Pi]", "3"], 
        SubsuperscriptBox["p", 
         SubscriptBox["\[Chi]", "1"], "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["m", "V", "2"], "+", "2", 
          SubscriptBox["m", "A"], 
          SubscriptBox["E", "R"], ")"}], "2"]}]]}]},
    {
     RowBox[{"\[Times]", 
      SubsuperscriptBox["\[Integral]", 
       SubsuperscriptBox["W", "min", "2"], 
       SubsuperscriptBox["W", "max", "2"]], 
      RowBox[{"d", 
       SuperscriptBox["W", "2"]}], "\[ThinSpace]", 
      SqrtBox[
       RowBox[{"\[Lambda]", "(", 
        SuperscriptBox["W", "2"], ",", 
        SubsuperscriptBox["m", 
         SubscriptBox["\[Chi]", "1"], "2"], ",", 
        SubsuperscriptBox["m", "s", "2"], ")"}]], "\[ThinSpace]", 
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "1"}], "1"], 
      RowBox[{"d", "z"}], "\[ThinSpace]", 
      SubscriptBox[
       RowBox[{"\[LeftAngleBracket]", 
        SubscriptBox["\[ScriptCapitalL]", "00"], "\[RightAngleBracket]"}], 
       SubscriptBox["\[CurlyPhi]", "*"]]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1.}}}], TraditionalForm]], "DisplayFormula",E\
xpressionUUID->"26ee5d2a-2197-5f47-a6a4-53d530ab438b"],

