Cell["\:6bd4\:8f83\:4e24\:7ec4 NIntegrate \
\:7cbe\:5ea6\:53c2\:6570\:5bf9\:56fa\:5b9a\:901f\:5ea6\:622a\:9762\:7684\:5f71\
\:54cd\:3002", "Text",ExpressionUUID->"919f2f77-0657-9f49-a96d-0c7bbb8463fa"],

Cell["\<\
(* \:589e\:5927 \
W\.b2\:3001\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:7684NIntegrate \:7cbe\:5ea6\
\:8bbe\:7f6e\:540e\:91cd\:65b0\:8ba1\:7b97\:3002 *)
selectedI6FineGeV2 = I6[  (* \:4f7f\:7528\:66f4\:9ad8NIntegrate \:7cbe\:5ea6\
\:8bbe\:7f6e\:91cd\:65b0\:8ba1\:7b97 I6 *)
  darkMatterMassGeV, selectedScalarMassGeV, selectedSplittingGeV,  (* \:672c\
\:884c\:6d89\:53ca\:ff1a\:8f93\:5165\:6697\:7269\:8d28 chi1 \
\:8d28\:91cf\:ff0c\:5355\:4f4d GeV\:ff1b\:9009\:62e9\:5e76\:6362\:7b97\:6807\
\:91cf\:8d28\:91cf\:4e3a GeV\:ff1b\:9009\:62e9\:5e76\:6362\:7b97\:8d28\:91cf\
\:5288\:88c2\:4e3a GeV *)
  selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:8bbe\:7f6e\:68c0\:67e5\:7528\:5165\:5c04\:901f\
\:5ea6 km/s\:ff1b\:7528 A \:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\
\:4f3c\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\:51b2\:80fd\:91cf\:6362\:7b97\:4e3a\
 GeV *)
  finePhaseSpaceOrders, selectedWidthGeV  (* \:672c\:884c\:6d89\:53ca\:ff1a\
\:8bbe\:7f6e\:66f4\:9ad8\:7684\:4e09\:4f53\:76f8\:7a7a\:95f4NIntegrate \:7cbe\
\:5ea6\:8bbe\:7f6e\:ff1b\:6839\:636e\:5bbd\:5ea6\:5904\:65b9\:786e\:5b9a\:4e2d\
\:95f4\:6001\:5bbd\:5ea6 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
selectedDSigmaFine = selectedPrefactorGeVMinus5 * selectedI6FineGeV2;  (* \
\:7531\:8f83\:9ad8\:7cbe\:5ea6 I6 \:8ba1\:7b97\:5bf9\:7167\:622a\:9762 *)
selectedFineDifference = If[selectedDSigmaFine != 0,  (* \:8ba1\:7b97\:4f4e\
\:9636\:4e0e\:8f83\:9ad8\:7cbe\:5ea6\:7ed3\:679c\:7684\:76f8\:5bf9\:5dee *)
  selectedDSigmaGeVMinus3 / selectedDSigmaFine - 1,  (* \:672c\:884c\:6d89\
\:53ca\:ff1a\:5c06\:622a\:9762\:524d\:56e0\:5b50\:4e58\:4ee5 I6\:ff1b\:7531\
\:8f83\:9ad8\:7cbe\:5ea6 I6 \:8ba1\:7b97\:5bf9\:7167\:622a\:9762 *)
  If[selectedDSigmaGeVMinus3 == 0, 0, Indeterminate]  (* \:5224\:65ad\:6761\
\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Grid[{  (* \:5c06\:6570\:636e\:6574\:7406\:4e3a\:8868\:683c *)
  {\"NIntegrate \:7cbe\:5ea6\:8bbe\:7f6e\", \"I6 [GeV\.b2]\", \"d sigma/d ER \
[GeV^-3]\"},  (* \:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\
\:53ca\:5176\:5bf9\:5e94\:7269\:7406\:91cf *)
  {phaseSpaceOrders, selectedI6GeV2, selectedDSigmaGeVMinus3},  (* \:7ec4\
\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\
\:5757 *)
  {finePhaseSpaceOrders, selectedI6FineGeV2, selectedDSigmaFine},  (* \:7ec4\
\:7ec7\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\
\:5757 *)
  {\"\:7c97/\:7ec6 - 1\", \"\", selectedFineDifference}  (* \
\:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\
\:5e94\:7269\:7406\:91cf *)
}, Frame -> All]  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)\
\>", "Input",
 CellLabel->
  "In[1183]:=",ExpressionUUID->"3ffaaa4d-b47b-9144-9c4d-1bd9c2ed2f2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:5929\:7136\:6c19\:4e8b\:4ef6\:7387 NIntegrate \
\:6536\:655b\:68c0\:67e5", "Subsubsection",ExpressionUUID->"247e27f9-75c4-\
9f47-99b5-aea628995306"],

Cell["\:540c\:4e00\:6781\:70b9\:5bbd\:5ea6\:5904\:65b9\:4e0b\:6bd4\:8f83\:4e0d\
\:540c NIntegrate \
\:7cbe\:5ea6\:8bbe\:7f6e\:ff1b\:9700\:5728\:80fd\:91cf\:9608\:503c\:548c\:6838\
\:54cd\:5e94\:8c37\:5e95\:9644\:8fd1\:8fdb\:884c\:6536\:655b\:68c0\:67e5\:3002\
", "Text",ExpressionUUID->"9973d706-9574-864e-bf59-5a88efa84e02"],

Cell["\<\
(* \:5728\:540c\:4e00\:4e2a\:6781\:70b9\:5bbd\:5ea6\:5904\:65b9\:4e0b\:ff0c\
\:6bd4\:8f83\:4e0d\:540c NIntegrate \:7cbe\:5ea6\:8bbe\:7f6e\:3002 *)
{convergenceMsKeV,convergenceDeltaMMeV}=benchmarks[[convergenceBenchmarkIndex]\
];
convergenceMsGeV=convergenceMsKeV*keVToGeV;
convergenceDeltaMGeV=convergenceDeltaMMeV*megaElectronVoltToGeV;
fineOrders=<|\"quad\"->finePhaseSpaceOrders,\"nv\"->fineSpeedOrder|>;
pPoleFine=Join[pPole,fineOrders];
coarse1=Rate[convergenceRecoilKeV,convergenceMsGeV,convergenceDeltaMGeV,pPole];
fine1=Rate[convergenceRecoilKeV,convergenceMsGeV,convergenceDeltaMGeV,\
pPoleFine];
relativeDifference[coarse_,fine_]:=If[fine>0,coarse/fine-1,\"NA\"];
Print[\"\:6536\:655b\:70b9\:ff1a\",benchmarkLabel[benchmarks[[\
convergenceBenchmarkIndex]]],\", ER=\",convergenceRecoilKeV,\" keV\"];
Grid[{{\"\:5bbd\:5ea6\:5904\:65b9\",\"\:57fa\:7840\:7cbe\:5ea6\",\"\:8f83\
\:9ad8\:7cbe\:5ea6\",\"\:7c97/\:7ec6 - 1\"},
 {\"\:6781\:70b9\:5bbd\:5ea6\",coarse1,fine1,relativeDifference[coarse1,fine1]\
}},Frame->All]\
\>", "Input",
 CellLabel->
  "In[1188]:=",ExpressionUUID->"bc7dec9f-a76e-8443-b1cd-7dd889fe79b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:5929\:7136\:6c19\:901f\:5ea6\:5206\:5e03\:3001\:540c\:4f4d\:7d20\:548c\
\:5f62\:72b6\:68c0\:67e5", "Subsubsection",ExpressionUUID->"5b00a944-ac8c-\
9244-a101-93cace93474f"],

Cell["\<\
\:8fd9\:90e8\:5206\:6709\:4e24\:4e2a\:4e92\:8865\:7684\:52a0\:548c\:68c0\:67e5\
\:ff1a\:9010\:4e2a isotope \:8fd0\:884c\:540c\:4e00 halo-rate \:51fd\:6570\
\:540e\:76f8\:52a0\:ff1b\:518d\:4ee5\:5b8c\:6574 isotope \:5217\:8868\:76f4\
\:63a5\:8fd0\:884c\:4e00\:6b21\:3002\:4e24\:79cd\:65b9\:5f0f\:91c7\:7528\:76f8\
\:540c\:7684\:5929\:7136\:6c19\:5e73\:5747\:6469\:5c14\:8d28\:91cf\:3001halo \
\:53c2\:6570\:548c\:8026\:5408\:ff0c\:4e8c\:8005\:76f8\:5bf9\:5dee\:5e94\:63a5\
\:8fd1\:6d6e\:70b9\:820d\:5165\:8bef\:5dee\:3002\:82e5\:4e0d\:4e00\:81f4\:ff0c\
\:4f18\:5148\:68c0\:67e5\:8f93\:5165\:5217\:8868\:3001\:4e30\:5ea6\:5b57\:5178\
\:3001\:5bbd\:5ea6\:6a21\:5f0f\:548c\:53c2\:6570\:662f\:5426\:4ece\:7b2c\:4e00\
\:8282\:5b8c\:6574\:91cd\:7b97\:3002\
\>", "Text",ExpressionUUID->"5388c8cb-8bbf-ef49-a432-26360d20b9da"],

Cell[CellGroupData[{

Cell["\:68c0\:9a8c\:901f\:5ea6\:5206\:5e03\:3001\:8d28\:91cf\:7ec4\:5408\:548c\
\:540c\:4f4d\:7d20\:8d21\:732e", "Subsection",ExpressionUUID->"d0fbc64f-24a7-\
ab44-bda7-a0ec72d472d6"],

Cell["\<\
(* \:9009\:62e9\:5f85\:6bd4\:8f83\:7684\:8d28\:91cf\:7ec4\:5408\:548c\:53cd\
\:51b2\:80fd\:91cf\:3002 *)
haloBenchmarkIndex = diagnosticBenchmarkIndex;  (* \:9009\:62e9\:5929\:7136\
\:6c19\:53cd\:51b2\:7387\:7684\:8d28\:91cf\:7ec4\:5408 *)
haloRecoilKeV = diagnosticRecoilKeV;  (* \:8bbe\:7f6e\:5929\:7136\:6c19\:540c\
\:4f4d\:7d20\:8d21\:732e\:7684\:68c0\:67e5\:80fd\:91cf *)
haloScalarMassGeV = benchmarks[[haloBenchmarkIndex, 1]] * keVToGeV;  (* \
\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\:6362\:7b97\:4e3a GeV *)
haloSplittingGeV = benchmarks[[haloBenchmarkIndex, 2]] * \
megaElectronVoltToGeV;  (* \:5c06\:6240\:9009\:8d28\:91cf\:5288\:88c2\:6362\
\:7b97\:4e3a GeV *)

(* \:5bf9\:5b9e\:9a8c\:5ba4\:901f\:7387\:5206\:5e03\:79ef\:5206\:3002\:5206\
\:754c\:70b9\:6765\:81ea\:9003\:9038\:901f\:5ea6\:622a\:65ad\:3002 *)
haloBoundary = parameters[\"vEsc\"] - parameters[\"vEarth\"];  (* \
\:8ba1\:7b97\:901f\:5ea6\:5206\:5e03\:7684\:5206\:6bb5\:8fb9\:754c *)
haloMaximum = parameters[\"vEsc\"] + parameters[\"vEarth\"];  (* \:8ba1\:7b97\
\:5b9e\:9a8c\:5ba4\:7cfb\:901f\:7387\:7684\:6700\:5927\:503c *)
haloNormalization = NIntegrate[  (* \
\:6570\:503c\:68c0\:67e5\:5b9e\:9a8c\:5ba4\:901f\:7387\:6982\:7387\:5bc6\:5ea6\
\:7684\:5f52\:4e00\:5316 *)
  SpeedPDF[v, parameters[\"v0\"], parameters[\"vEarth\"], \
parameters[\"vEsc\"]],  (* \:8ba1\:7b97\:5b9e\:9a8c\:5ba4\:7cfb\:901f\:7387\
\:6982\:7387\:5bc6\:5ea6 *)
  {v, 0, haloBoundary, haloMaximum}  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\
\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:6bcf\:6b21\:53ea\:4fdd\:7559\:4e00\:4e2a\:540c\:4f4d\:7d20\:ff0c\:4fdd\
\:7559\:5176\:5929\:7136\:4e30\:5ea6\:548c\:5929\:7136\:6c19\:5e73\:5747\:6469\
\:5c14\:8d28\:91cf\:3002 *)
isotopeContributions = Table[  (* \:9010\:79cd\:540c\:4f4d\:7d20\:8ba1\:7b97\
\:5176\:5929\:7136\:4e30\:5ea6\:52a0\:6743\:8d21\:732e *)
  Module[{oneIsotopeParameters, threshold, contribution},  (* \:5b9a\:4e49\
\:5c40\:90e8\:53d8\:91cf\:548c\:5c40\:90e8\:8ba1\:7b97 *)
    oneIsotopeParameters = Join[pPole, <|\"isotopes\" -> {isotope}|>];  (* \
\:4fdd\:7559\:5f53\:524d\:540c\:4f4d\:7d20\:53ca\:5929\:7136\:6c19\:6469\:5c14\
\:8d28\:91cf\:7684\:53c2\:6570 *)
    threshold = VMin[  (* \:8ba1\:7b97\:8be5\:540c\:4f4d\:7d20\:4e09\:4f53\
\:6563\:5c04\:7684\:901f\:5ea6\:9608\:503c *)
      darkMatterMassGeV, haloScalarMassGeV,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:8f93\:5165\:6697\:7269\:8d28 chi1 \
\:8d28\:91cf\:ff0c\:5355\:4f4d GeV\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\
\:91cf\:6362\:7b97\:4e3a GeV *)
      Global`xenonNuclearMassGeV[isotope], haloRecoilKeV * keVToGeV  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:5b9a\:4e49 keV \:5230 GeV \:7684\:6362\:7b97\
\:56e0\:5b50\:ff1b\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\
\:7684\:68c0\:67e5\:80fd\:91cf *)
    ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
    contribution = Rate[  (* \:8ba1\:7b97\:8be5\:540c\:4f4d\:7d20\:5bf9\:5929\
\:7136\:6c19\:7387\:7684\:8d21\:732e *)
      haloRecoilKeV, haloScalarMassGeV, haloSplittingGeV,  (* \:672c\:884c\
\:6d89\:53ca\:ff1a\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\
\:7684\:68c0\:67e5\:80fd\:91cf\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\
\:6362\:7b97\:4e3a GeV\:ff1b\:5c06\:6240\:9009\:8d28\:91cf\:5288\:88c2\:6362\
\:7b97\:4e3a GeV *)
      oneIsotopeParameters  (* \:4f20\:5165\:53c2\:6570\:ff1a\:4fdd\:7559\
\:5f53\:524d\:540c\:4f4d\:7d20\:53ca\:5929\:7136\:6c19\:6469\:5c14\:8d28\:91cf\
\:7684\:53c2\:6570 *)
    ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
    {isotope, abundances[isotope], threshold, contribution}  (* \:8bbe\:7f6e\
\:8be5\:5faa\:73af\:7684\:53d8\:91cf\:548c\:904d\:5386\:8303\:56f4\:ff0c\:6216\
\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c *)
  ],  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
  {isotope, isotopes}  (* \:8bbe\:7f6e\:8be5\:5faa\:73af\:7684\:53d8\:91cf\
\:548c\:904d\:5386\:8303\:56f4\:ff0c\:6216\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c\
 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:76f4\:63a5\:6c42\:5929\:7136\:6c19\:4e8b\:4ef6\:7387\:ff0c\:5e76\:4e0e\
\:9010\:540c\:4f4d\:7d20\:7ed3\:679c\:4e4b\:548c\:5bf9\:7167\:3002 *)
haloRateTotal = Rate[  (* \:4f7f\:7528\:5b8c\:6574\:540c\:4f4d\:7d20\:5217\
\:8868\:76f4\:63a5\:8ba1\:7b97\:603b\:7387 *)
  haloRecoilKeV, haloScalarMassGeV, haloSplittingGeV, pPole  (* \:672c\:884c\
\:6d89\:53ca\:ff1a\:521b\:5efa\:6781\:70b9\:5bbd\:5ea6\:53c2\:6570\:7ec4\:ff1b\
\:8bbe\:7f6e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\:8d21\:732e\:7684\:68c0\:67e5\
\:80fd\:91cf\:ff1b\:5c06\:6240\:9009\:6807\:91cf\:8d28\:91cf\:6362\:7b97\:4e3a\
 GeV *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
isotopeRateSum = Total[isotopeContributions[[All, 4]]];  (* \
\:628a\:5404\:540c\:4f4d\:7d20\:8d21\:732e\:76f8\:52a0 *)
sumRelativeDifference = If[haloRateTotal != 0,  (* \:8ba1\:7b97\:9010\:9879\
\:76f8\:52a0\:4e0e\:76f4\:63a5\:603b\:7387\:7684\:76f8\:5bf9\:5dee *)
  isotopeRateSum / haloRateTotal - 1,  (* \
\:672c\:884c\:6d89\:53ca\:ff1a\:4f7f\:7528\:5b8c\:6574\:540c\:4f4d\:7d20\:5217\
\:8868\:76f4\:63a5\:8ba1\:7b97\:603b\:7387\:ff1b\:628a\:5404\:540c\:4f4d\:7d20\
\:8d21\:732e\:76f8\:52a0 *)
  If[isotopeRateSum == 0, 0, Indeterminate]  (* \
\:5224\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\
\:5206\:652f *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

Print[\"\:901f\:7387\:5206\:5e03\:5f52\:4e00\:5316 = \", haloNormalization];  \
(* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[\"\:7eb3\:5165\:540c\:4f4d\:7d20\:7684\:5929\:7136\:4e30\:5ea6\:4e4b\
\:548c = \", Total[Values[abundances]]];  (* \:663e\:793a\:5f53\:524d\:8bf4\
\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[Grid[  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\
\:679c *)
  Prepend[isotopeContributions,  (* \
\:5728\:8868\:683c\:524d\:52a0\:5165\:6807\:9898\:884c *)
    {\"A\", \"\:6570\:76ee\:4e30\:5ea6\", \"\:4e09\:4f53\:9608\:503c\:901f\
\:5ea6 [km/s]\", \"\:8d21\:732e [events/(tonne year keV)]\"}],  (* \:5b9a\
\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\
\:7269\:7406\:91cf *)
  Frame -> All  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)
]];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Grid[{  (* \:5c06\:6570\:636e\:6574\:7406\:4e3a\:8868\:683c *)
  {\"\:9010\:540c\:4f4d\:7d20\:4e4b\:548c\", isotopeRateSum},  (* \
\:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\
\:5e94\:7269\:7406\:91cf *)
  {\"\:76f4\:63a5\:8ba1\:7b97\:5929\:7136\:6c19\:603b\:7387\", \
haloRateTotal},  (* \:5b9a\:4e49\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\
\:884c\:53ca\:5176\:5bf9\:5e94\:7269\:7406\:91cf *)
  {\"\:4e24\:8005\:76f8\:5bf9\:5dee\", sumRelativeDifference}  (* \
