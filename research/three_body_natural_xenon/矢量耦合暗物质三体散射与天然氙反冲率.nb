Print[\"\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6\:4e8b\:4ef6\:7387\:ff0cg2 = \", \
g2val];
poleSeconds = AbsoluteTiming[curvesPole = \
MakeCurves[energies,benchmarks,pPole];][[1]];
Print[\"\:80fd\:91cf\:70b9\:6570\:ff1a\",Length[energies],\"\:ff1b\:8017\:65f6\
\:ff08\:79d2\:ff09\:ff1a\",poleSeconds];\
\>", "Input",
