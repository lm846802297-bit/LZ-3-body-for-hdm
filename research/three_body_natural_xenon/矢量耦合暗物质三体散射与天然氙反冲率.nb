Cell["FeynRules \:6a21\:578b\:4e0e\:62c9\:6c0f\:91cf", "Subsection",ExpressionUUID->"1a63408f-f6e8-5c4d-aa1e-cc3c6da50daf"],

Cell["\<\
M$ModelName = \"InelasticScalarRadiation\";
M$Information = {Authors -> {\"Independent verification\"}, Version -> \
\"1.0\"};
M$Parameters = {
 gX == {ParameterType -> External, ComplexParameter -> False, Value -> 1.0, \
InteractionOrder -> {NP,1}, Description -> \"Off-diagonal vector coupling\"},
 gS == {ParameterType -> External, ComplexParameter -> False, Value -> 1.0, \
InteractionOrder -> {NP,1}, Description -> \"Off-diagonal scalar coupling\"},
 gN == {ParameterType -> External, ComplexParameter -> False, Value -> 1.0, \
InteractionOrder -> {NP,1}, Description -> \"Pointlike nucleon vector \
coupling\"}
};
M$ClassesDescription = {
 F[1] == {ClassName -> chiOne, AntiClassName -> chiOnebar, SelfConjugate -> \
False, Mass -> {MChiOne,1000.}, Width -> 0, PDG -> {9000001}},
 F[2] == {ClassName -> chiTwo, AntiClassName -> chiTwobar, SelfConjugate -> \
False, Mass -> {MChiTwo,1000.001}, Width -> {WChiTwo,0.0001518239116}, PDG -> \
{9000002}},
 F[3] == {ClassName -> nuc, AntiClassName -> nucbar, SelfConjugate -> False, \
Mass -> {MNuc,0.938272}, Width -> 0, PDG -> {9000003}},
 V[1] == {ClassName -> med, SelfConjugate -> True, Mass -> {MMed,10.}, Width \
-> 0, PDG -> {9000004}},
 S[1] == {ClassName -> scal, SelfConjugate -> True, Mass -> {MScal,0.0003}, \
Width -> 0, PDG -> {9000005}}
};
LX := gX med[mu] chiTwobar.Ga[mu].chiOne;
LS := gS scal chiTwobar.chiOne;
LN := gN med[mu] nucbar.Ga[mu].nuc;
LInteraction := LX + HC[LX] + LS + HC[LS] + LN;


\
\>", "Program",
 CellTags->
  "embeddedModel",ExpressionUUID->"054a3789-84f5-114d-834d-7fe7758ce0ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:72ec\:7acb\:76f8\:7a7a\:95f4\:4e0e NIntegrate \:6e90\:7801", \
"Subsection",ExpressionUUID->"c32799b2-2c88-6548-a5ac-c174a10551bc"],

Cell["\<\
(* Independent construction: axes aligned with the chi1+s system momentum.
   Uses the existing trace only; no private momentum or quadrature functions. \
*)
ClearAll[niDot,niKinematics,niIntegrand,niI6];
niDot[a_,b_]:=a[[1]] b[[1]]-a[[2;;4]].b[[2;;4]];
niKinematics[m_?NumericQ,ms_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,u_\
?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[
 {beta,e,p,q,wmin,wmax,w2,angle,qvec,pin,Q,W,Qvec,Qmag,ez,ex,ey,rad,est,kstar,\
ks,ks4,pp,threshold,delta},
 beta=v/299792.458;e=m/Sqrt[1-beta^2];p=e beta;q=Sqrt[er (2 mA+er)];
 wmin=(m+ms)^2;wmax=m^2+2 p q-2(e+mA)er;delta=wmax-wmin;
 If[delta<=0,Return[$Failed]];
 w2=wmin+delta u^2;
 angle=(w2-m^2+2(e+mA)er)/(2 p q);
 If[Abs[angle]>1+10^-8,Return[$Failed]];
 qvec=q {Sqrt[Max[0,1-angle^2]],0,angle};
 pin={e,0,0,p};Q=Join[{e-er},{0,0,p}-qvec];
 W=Sqrt[w2];Qvec=Q[[2;;4]];Qmag=Norm[Qvec];
 ez=If[Qmag>0,Qvec/Qmag,{0,0,1}];
 ex=Normalize[Cross[If[Abs[ez[[3]]]<0.9,{0,0,1},{0,1,0}],ez]];ey=Cross[ez,ex];\

 rad=Sqrt[Max[0,(w2-(m+ms)^2)(w2-(m-ms)^2)]];
 est=(w2-m^2+ms^2)/(2 W);kstar=rad/(2 W);
 ks=kstar (z ez+Sqrt[Max[0,1-z^2]](Cos[phi] ex+Sin[phi] ey));
 ks4=Join[{(Q[[1]] est+Qvec.ks)/W},ks+Qvec (est/W+(Qvec.ks)/(W (Q[[1]]+W)))];
 pp=Q-ks4;
 <|\"pin\"->pin,\"pout\"->pp,\"k\"->ks4,\"Q\"->Q,\"w2\"->w2,\"qvec\"->qvec,
   \"jac\"->2 delta u,\"phase\"->rad/w2,\"delta\"->delta|>
];
niIntegrand[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_\
?NumericQ,width_?NumericQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[{kin},
 kin=niKinematics[m,ms,mA,er,v,u,z,phi];
 If[kin===$Failed,Return[0.]];
 kin[\"jac\"] kin[\"phase\"] \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],width]/(2 Pi)
];
Options[niI6]={AccuracyGoal->3,PrecisionGoal->3,MaxRecursion->6};
niI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?\
NumericQ,width_?NumericQ,OptionsPattern[]]:=Module[{b,e,p,q,wmax},
 If[!TrueQ[m>0&&ms>=0&&dm>=0&&mA>0&&er>0&&0<v<299792.458&&width>=0],Print[\"\
Invalid inputs\"];Return[$Failed]];
 b=v/299792.458;e=m/Sqrt[1-b^2];p=e b;q=Sqrt[er(2mA+er)];wmax=m^2+2p \
q-2(e+mA)er;
 If[wmax<=(m+ms)^2,Return[0.]];
 If[wmax>=(m+dm)^2,Print[\"On-shell chi2 accessible; off-shell calculation \
aborted.\"];Return[$Failed]];
 NIntegrate[niIntegrand[m,ms,dm,mA,er,v,width,u,z,phi],{u,0,1},{z,-1,1},{phi,\
0,2Pi},
   Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0},AccuracyGoal->\
OptionValue[AccuracyGoal],
   PrecisionGoal->OptionValue[PrecisionGoal],MaxRecursion->OptionValue[\
MaxRecursion]]
];
\
\>", "Program",
 CellTags->
  "embeddedNI",ExpressionUUID->"ed0f9f7e-65b7-7447-a407-171cc9a47ba4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FeynArts \:81ea\:52a8\:5bfc\:51fa\:7684\:901a\:7528\:6a21\:578b", \
"Subsection",ExpressionUUID->"3b0a4e8c-1b8b-fc45-89fe-146d222c1fae"],

Cell["\<\
(* Patched for use with FeynCalc *)
(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * *)
(*                                                                            \
   *)
(*         This file has been automatically generated by FeynRules.           \
   *)
(*                                                                            \
   *)
(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * *)



(*     Kinematic indices    *)

KinematicIndices[ F ] = {};
KinematicIndices[ V ] = {Lorentz};
KinematicIndices[ S ] = {};
KinematicIndices[ SV ] = {Lorentz};
KinematicIndices[ U ] = {};

$FermionLines = True;

(*     Simplification rules    *)

Attributes[ FAMetricTensor ] = Attributes[ FAScalarProduct ] = {Orderless}

FAFourVector/: -FAFourVector[ mom_, mu_ ] := FAFourVector[Expand[-mom], mu]

FAFourVector[ 0, _ ] = 0

SpinorType[j_Integer, ___] := MajoranaSpinor /; SelfConjugate[F[j]]

SpinorType[_Integer, __] = FADiracSpinor

(*     Generic propagators    *)

M$GenericPropagators={

(*general fermion propagator:*)

AnalyticalPropagator[External][s1 F[j1,mom]]==
FANonCommutative[SpinorType[j1][-mom,Mass[F[j1]]]],

AnalyticalPropagator[Internal][s1 F[j1,mom]]==
FANonCommutative[FADiracSlash[-mom]+Mass[F[j1]]]*
I FAPropagatorDenominator[mom,Mass[F[j1]]],

(*general vector boson propagator:*)

AnalyticalPropagator[External][s1 V[j1,mom,{li2}]]==
FAPolarizationVector[V[j1],mom,li2],

AnalyticalPropagator[Internal][s1 V[j1,mom,{li1}->{li2}]]==
-I FAPropagatorDenominator[mom,Mass[V[j1]]]*
(FAMetricTensor[li1,li2]-(1-FAGaugeXi[V[j1]])*
FAFourVector[mom,li1] FAFourVector[mom,li2]*
FAPropagatorDenominator[mom,Sqrt[FAGaugeXi[V[j1]]] Mass[V[j1]]]),

(*general mixing scalar-vector propagator:*)

AnalyticalPropagator[Internal][s1 SV[j1,mom,{li1}->{li2}]]==
I Mass[SV[j1]] FAPropagatorDenominator[mom,Mass[SV[j1]]]*
FAFourVector[mom,If[s1==1||s1==-2,li1,li2]],

(*general scalar propagator:*)

AnalyticalPropagator[External][s1 S[j1,mom]]==1,

AnalyticalPropagator[Internal][s1 S[j1,mom]]==
I FAPropagatorDenominator[mom,Sqrt[FAGaugeXi[S[j1]]] Mass[S[j1]]],

(*general Fadeev-Popov ghost propagator:*)

AnalyticalPropagator[External][s1 U[j1,mom]]==1,

AnalyticalPropagator[Internal][s1 U[j1,mom]]==
I*FAPropagatorDenominator[mom,Sqrt[FAGaugeXi[U[j1]]] Mass[U[j1]]]
}

(*     Generic couplings    *)

M$GenericCouplings = {

\t (* FFS *)

AnalyticalCoupling[s1 F[j1, mom1], s2 F[j2, mom2], s3 S[j3, mom3] ] ==
G[-1][s1 F[j1], s2 F[j2], s3 \
S[j3]].{FANonCommutative[FAChiralityProjector[-1]], \
FANonCommutative[FAChiralityProjector[+1]]},

\t (* FFV *)

AnalyticalCoupling[s1 F[j1, mom1], s2 F[j2, mom2], s3 V[j3, mom3, {li3}] ] ==
G[-1][s1 F[j1], s2 F[j2], s3 V[j3]].{FANonCommutative[FADiracMatrix[li3], \
FAChiralityProjector[-1] ], FANonCommutative[FADiracMatrix[li3], \
FAChiralityProjector[+1] ]}
}

(* FlippingRules: the flipping rules determines how Dirac
   objects change when the order of fermion fields in the
   coupling is reversed. In other words, it defines how the 
   coupling C[F, -F, ...] is derived from C[-F, F, ...].*)

M$FlippingRules = {
FANonCommutative[dm1:_FADiracMatrix | _FADiracSlash,dm2:_FADiracMatrix | \
_FADiracSlash, FAChiralityProjector[+1]] ->
 FANonCommutative[dm2,dm1, FAChiralityProjector[+1]],
FANonCommutative[dm1:_FADiracMatrix | _FADiracSlash,dm2:_FADiracMatrix | \
_FADiracSlash, FAChiralityProjector[-1]] ->
 FANonCommutative[dm2,dm1, FAChiralityProjector[-1]],
FANonCommutative[dm:_FADiracMatrix | _FADiracSlash, FAChiralityProjector[+1]] \
->
-FANonCommutative[dm, FAChiralityProjector[-1]],
FANonCommutative[dm:_FADiracMatrix | _FADiracSlash, FAChiralityProjector[-1]] \
->
-FANonCommutative[dm, FAChiralityProjector[+1]]}

\t(* TruncationRules: rule for omitting the wave functions of
\t   external Propagators defined in this file. *)

M$TruncationRules = {
  _FAPolarizationVector -> 1,
  _FADiracSpinor -> 1,
  _MajoranaSpinor -> 1 
}
\t(* LastGenericRules: the very last rules that are applied to an
\t   amplitude before it is returned by CreateFeynAmp. *)

M$LastGenericRules = {
  FAPolarizationVector[p_, _. mom:FourMomentum[Outgoing, _], li_] :>
    Conjugate[FAPolarizationVector][p, mom, li]
}
\t(* cosmetics: *)

\t(*  left spinor in chain + mom incoming -> \\bar v
\t    left spinor in chain + mom outgoing -> \\bar u
\t   right spinor in chain + mom incoming -> u
\t   right spinor in chain + mom outgoing -> v *)
Format[
  FermionChain[
    FANonCommutative[_[s1_. mom1_, mass1_]],
    r___,
    FANonCommutative[_[s2_. mom2_, mass2_]]] ] :=
  Overscript[If[FreeQ[mom1, Incoming], \"u\", \"v\"], \"_\"][mom1, mass1] .
    r . If[FreeQ[mom2, Outgoing], \"u\", \"v\"][mom2, mass2]

Format[ FADiracSlash ] = \"gs\"

Format[ FADiracMatrix ] = \"ga\"

Format[ FAChiralityProjector[1] ] = SequenceForm[\"om\", Subscript[\"+\"]]

Format[ FAChiralityProjector[-1] ] = SequenceForm[\"om\", Subscript[\"-\"]]

Format[ FAGaugeXi[a_] ] := SequenceForm[\"xi\", Subscript[a]]

Format[ FAPolarizationVector ] = \"ep\"

Unprotect[Conjugate];
Format[ Conjugate[a_] ] = SequenceForm[a, Superscript[\"*\"]];
Protect[Conjugate]

Format[ FAMetricTensor ] = \"g\"

Format[ FAScalarProduct[a__] ] := Dot[a]

Format[ FAFourVector[a_, b_] ] := a[b]

\
\>", "Program",
 CellTags->
  "embeddedFAgen",ExpressionUUID->"48273421-2269-a246-bd86-f24a7bcf35d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FeynArts \:81ea\:52a8\:5bfc\:51fa\:7684\:573a\:548c\:9876\:89d2", \
"Subsection",ExpressionUUID->"21dea8ed-46e1-7745-813d-335f2c873c17"],

Cell["\<\
(* Patched for use with FeynCalc *)
(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * *)
(*                                                                            \
 *)
(*         This file has been automatically generated by FeynRules.           \
 *)
(*                                                                            \
 *)
(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * \
* * *)


FR$ModelInformation={
  ModelName->\"InelasticScalarRadiation\",
  Authors -> {\"Independent verification\"},
  Version -> \"1.0\"};

FR$ClassesTranslation={};

FR$InteractionOrderPerturbativeExpansion={{NP, 0}};

FR$GoldstoneList={};

(*     Declared indices    *)

(*     Declared particles    *)

M$ClassesDescription = {
F[1] == {
    SelfConjugate -> False,
    PropagatorLabel -> chiOne,
    PropagatorType -> Straight,
    PropagatorArrow -> Forward,
    Mass -> MChiOne,
    Indices -> {} },

F[2] == {
    SelfConjugate -> False,
    PropagatorLabel -> chiTwo,
    PropagatorType -> Straight,
    PropagatorArrow -> Forward,
    Mass -> MChiTwo,
    Indices -> {} },

F[3] == {
    SelfConjugate -> False,
    PropagatorLabel -> nuc,
    PropagatorType -> Straight,
    PropagatorArrow -> Forward,
    Mass -> MNuc,
    Indices -> {} },

V[1] == {
    SelfConjugate -> True,
    PropagatorLabel -> med,
    PropagatorType -> Sine,
    PropagatorArrow -> None,
    Mass -> MMed,
    Indices -> {} },

S[1] == {
    SelfConjugate -> True,
    PropagatorLabel -> scal,
    PropagatorType -> ScalarDash,
    PropagatorArrow -> None,
    Mass -> MScal,
    Indices -> {} }
}


(*        Definitions       *)


MChiOne[ ___ ] := MChiOne;
MChiTwo[ ___ ] := MChiTwo;
MNuc[ ___ ] := MNuc;
MMed[ ___ ] := MMed;
MScal[ ___ ] := MScal;




(*      Couplings (calculated by FeynRules)      *)

M$CouplingMatrices = {

C[ -F[1] , F[2] , S[1] ] == {{I*gc1, 0}, {I*gc1, 0}},

C[ -F[2] , F[1] , S[1] ] == {{I*gc2, 0}, {I*gc2, 0}},

C[ -F[1] , F[2] , V[1] ] == {{I*gc3, 0}, {I*gc3, 0}},

C[ -F[2] , F[1] , V[1] ] == {{I*gc4, 0}, {I*gc4, 0}},

C[ -F[3] , F[3] , V[1] ] == {{I*gc5, 0}, {I*gc5, 0}}

}

(* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *)

(* Parameter replacement lists (These lists were created by FeynRules) *)

(* FA Couplings *)

M$FACouplings = {
     gc1 -> gS,
     gc2 -> gS,
     gc3 -> gX,
     gc4 -> gX,
     gc5 -> gN};

\
\>", "Program",
 CellTags->
  "embeddedFAmod",ExpressionUUID->"0db41152-7da7-764d-99e0-ed76f702809c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FeynArts \:6697\:7269\:8d28\:8f90\:5c04\:6a21\:578b", "Subsection",ExpressionUUID->"a6b1c2ef-94cf-3549-aac7-8a533245935b"],

Cell["\<\
M$ClassesDescription = {
 F[1] == {SelfConjugate->False, Mass->Mchi1, PropagatorLabel->\"chi1\", \
PropagatorType->Straight, PropagatorArrow->Forward},
 F[2] == {SelfConjugate->False, Mass->Mchi2, PropagatorLabel->\"chi2\", \
PropagatorType->Straight, PropagatorArrow->Forward},
 V[1] == {SelfConjugate->True, Mass->MV, PropagatorLabel->\"V\", \
PropagatorType->Sine, PropagatorArrow->None},
 S[1] == {SelfConjugate->True, Mass->MS, PropagatorLabel->\"s\", \
PropagatorType->Dashes, PropagatorArrow->None}
};
M$CouplingMatrices = {
 C[-F[2],F[1],V[1]] == I gv {{1},{1}},
 C[-F[1],F[2],V[1]] == I gv {{1},{1}},
 C[-F[2],F[1],S[1]] == I gs {{1},{1}},
 C[-F[1],F[2],S[1]] == I gs {{1},{1}}
};
M$LastModelRules = {};
\
\>", "Program",
 CellTags->
  "embeddedChiFA",ExpressionUUID->"305404f1-cc68-464f-8a95-67fab60aad63"]
}, Open  ]]
}, Open  ]],

