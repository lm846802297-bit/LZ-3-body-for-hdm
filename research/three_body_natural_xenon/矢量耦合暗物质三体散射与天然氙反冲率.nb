Cell["Mathematica NIntegrate\:ff1a\:4e09\:4f53\:76f8\:7a7a\:95f4\:548c\:6655\
\:901f\:5ea6\:79ef\:5206", "Subsection",ExpressionUUID->"f4a8b35d-6e91-af4e-\
927f-f0583a70996b"],

Cell["\<\
\:516c\:5f0f\:7ea6\:5b9a\:ff1a\[Lambda]K(W\.b2,m\.b2,ms\.b2)=[W\.b2\[Minus](m+\
ms)\.b2][W\.b2\[Minus](m\[Minus]ms)\.b2] \:6709 GeV\:2074 \:91cf\:7eb2\:ff1b\
\:4ee3\:7801\:7684 phase=Sqrt[\[Lambda]K]/W\.b2 \
\:662f\:65e0\:91cf\:7eb2\:56e0\:5b50\:3002\:82e5\:539f\:7a3f\:4f7f\:7528\:65e0\
\:91cf\:7eb2 \[Lambda]\:0302=\[Lambda]K/W\:2074\:ff0c\:90a3\:4e48 Sqrt[\
\[Lambda]\:0302]=Sqrt[\[Lambda]K]/W\.b2\:ff0c\:4e24\:79cd\:8bb0\:53f7\:5bf9\
\:5e94\:540c\:4e00\:6743\:91cd\:3002\:65b9\:4f4d\:89d2\:5e73\:5747\:5305\:542b\
 1/(2\[Pi])\:ff0c\:4e0d\:53ef\:91cd\:590d\:76f8\:4e58\:3002I6 \:542b\:81ea\
\:65cb\:8ff9\:ff0c\:4e0d\:53ea\:662f\:7eaf\:51e0\:4f55\:76f8\:7a7a\:95f4\:4f53\
\:79ef\:3002\
\>", "Text",ExpressionUUID->"9db6db62-40f2-4941-a8cc-60277fe4fd8a"],

Cell["\<\
I6 \:662f\:8fd9\:4efd\:7a0b\:5e8f\:7ed9\:79ef\:5206\:7ed3\:679c\:8d77\:7684\
\:5386\:53f2\:53d8\:91cf\:540d\:ff0c\:5e76\:975e Mathematica \:7684\:4e13\
\:7528\:51fd\:6570\:ff1b\:6570\:5b57 6 \:5728\:6b64\:6ca1\:6709\:989d\:5916\
\:7269\:7406\:542b\:4e49\:3002\:4e0b\:65b9 niIntegrand \:660e\:786e\:7ed9\
\:51fa\:88ab\:79ef\:51fd\:6570\:ff0cniI6 \:76f4\:63a5\:8c03\:7528 NIntegrate \
