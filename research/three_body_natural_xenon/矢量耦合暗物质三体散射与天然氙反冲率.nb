Cell[CellGroupData[{

Cell["\<\
(* \:6bcf\:4e2a benchmark \:7684\:6807\:91cf\:8d28\:91cf\:4ee5 \
keV\:3001\:8d28\:91cf\:5288\:88c2\:4ee5 MeV \:8f93\:5165\:3002 *)
benchmarkSummaryRows = Table[ (* \:4f9d\:6b21\:5904\:7406\:5168\:90e8 \
benchmark *)
  Module[{msGeV, dmGeV, widthGeV, integralI6, dsigmaGeV}, (* \:8be5\:884c\
\:7684\:5c40\:90e8\:7269\:7406\:91cf *)
    msGeV = benchmark[[1]] * keVToGeV; (* \
\:6807\:91cf\:8d28\:91cf\:8f6c\:6362\:6210 GeV *)
    dmGeV = benchmark[[2]] * megaElectronVoltToGeV; (* \:8d28\:91cf\:5288\
\:88c2\:8f6c\:6362\:6210 GeV *)
    widthGeV = Chi2Width[darkMatterMassGeV, msGeV, dmGeV, g2val]; (* \:8ba1\
\:7b97\:8be5\:7ec4\:7684\:6781\:70b9\:5bbd\:5ea6 *)
    integralI6 = I6[darkMatterMassGeV, msGeV, dmGeV, selectedNuclearMassGeV, \
selectedRecoilGeV, diagnosticSpeedKmPerS, phaseSpaceOrders, widthGeV]; (* \
FeynCalc \:81ea\:65cb\:8ff9\:4e0e NIntegrate \:76f8\:7a7a\:95f4\:79ef\:5206 \
*)
    dsigmaGeV = selectedPrefactorGeVMinus5 * integralI6; (* \
\:622a\:9762\:524d\:56e0\:5b50\:4e0e I6 \:76f8\:4e58\:ff0c\:5355\:4f4d GeV^-3 \
*)
    {benchmark[[1]], benchmark[[2]], widthGeV * gevToKeV, \
selectedNuclearResponse, integralI6, dsigmaGeV, dsigmaGeV * gevMinus2ToCm2 * \
10^-6} (* \:4fdd\:5b58\:8d28\:91cf\:3001\:5bbd\:5ea6\:3001AFH \:6838\:54cd\
\:5e94\:3001\:79ef\:5206\:548c\:4e24\:79cd\:622a\:9762\:5355\:4f4d\:ff1b\:6838\
\:54cd\:5e94\:5df2\:5305\:542b\:76f8\:5e72\:589e\:5f3a\:53ca\:6838 form \
factor *)
  ],
  {benchmark, benchmarks} (* \:904d\:5386\:7b2c\:4e00\:8282\:5b9a\:4e49\:7684\
\:8d28\:91cf\:7ec4\:5408 *)
];
Print[\"\:5171\:540c\:8f93\:5165\:ff1aXe-\", diagnosticIsotope, \"\:ff0cER = \
\", diagnosticRecoilKeV, \" keV\:ff0cv = \", diagnosticSpeedKmPerS, \" \
km/s\"]; (* \:663e\:793a\:6838\:7d20\:548c\:8fd0\:52a8\:5b66\:8f93\:5165 *)
Print[\"m\[Chi]1 = \", darkMatterMassGeV, \" GeV\:ff0cmV = \", \
mediatorMassGeV, \" GeV\:ff1bg1 = \", g1val, \"\:ff0cg2 = \", g2val, \
\"\:ff0cgVN = \", gVNval]; (* \
\:663e\:793a\:8d28\:91cf\:548c\:6240\:6709\:8026\:5408 *)
benchmarkSummaryTable = Grid[Prepend[benchmarkSummaryRows, {\"ms (keV)\", \"\
\[CapitalDelta]m (MeV)\", \"\[CapitalGamma]\[Chi]2 (keV)\", \"\:6838\:54cd\
\:5e94 RA (\:65e0\:91cf\:7eb2)\", \"I6 (GeV\.b2)\", \"d\[Sigma]/dER \
(GeV^-3)\", \"d\[Sigma]/dER (cm\.b2/keV)\"}], Frame -> All]; (* \:6dfb\:52a0\
\:8868\:5934\:4e0e\:8fb9\:6846 *)
benchmarkSummaryTable (* \:663e\:793a\:7ed3\:679c\:ff1bbenchmarkSummaryRows \
\:4fdd\:5b58\:539f\:59cb\:6570\:503c *)\
\>", "Input",
 CellLabel->
