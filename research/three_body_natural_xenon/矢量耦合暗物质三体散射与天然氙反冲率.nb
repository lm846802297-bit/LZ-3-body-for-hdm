Cell[CellGroupData[{

Cell["\:56fa\:5b9a\:901f\:5ea6\:4e09\:4f53\:5fae\:5206\:622a\:9762", \
"Subsubsection",ExpressionUUID->"24622ca2-2ee9-c04b-97e5-b48815867453"],

Cell["\:5c06\:81ea\:65cb\:8ff9\:3001\:76f8\:7a7a\:95f4\:79ef\:5206\:3001\:4f20\
\:64ad\:5b50\:548c AFH \:6838\:54cd\:5e94\:5408\:6210\:4e3a\:56fa\:5b9a\:901f\
\:5ea6\:622a\:9762\:3002", "Text",ExpressionUUID->"088af27f-1d33-ba41-a074-\
abadfb77b1f5"],

Cell["\<\
(* Eq. (radiative-recoil): I6 includes dW^2, dz and the phi average.
   Inputs are GeV except speedKms. The result is in GeV^-3. *)
fixedSpeedCrossSection[nuclearMass_, recoilGeV_, speedKms_, mass_, scalarMass_,
   splitting_, mediatorMass_, couplingSquared_, orders_, width_, \
nuclearResponse_] :=
 Module[{beta, incomingMomentum, mediatorDenominator, integral},
  If[!TrueQ[0 < speedKms < cKm], Throw[\"Fixed-speed cross section requires 0 \
< v < c\"]];  (* \:68c0\:67e5\:8f93\:5165\:901f\:5ea6\:5728 0 \:4e0e\:5149\
\:901f\:4e4b\:95f4 *)

  beta = speedKms/cKm;  (* \:5c06\:8f93\:5165\:901f\:5ea6 km/s \:8f6c\:6362\
\:4e3a\:65e0\:91cf\:7eb2 v/c *)

  incomingMomentum = mass*beta/Sqrt[1-beta^2];  (* \:8ba1\:7b97\:5165\:5c04\
\:6697\:7269\:8d28\:7684\:76f8\:5bf9\:8bba\:4e09\:52a8\:91cf\:5927\:5c0f *)

  mediatorDenominator = (mediatorMass^2+2*nuclearMass*recoilGeV)^2;  (* \
\:8ba1\:7b97\:77e2\:91cf\:4f20\:64ad\:5b50\:5206\:6bcd (mV\.b2+2 mA ER)\.b2 *)

  If[!TrueQ[mediatorDenominator > 0], Throw[\"Vector mediator denominator is \
zero\"]];  (* \:9632\:6b62\:4f20\:64ad\:5b50\:5206\:6bcd\:4e3a\:96f6 *)

  integral = I6[mass, scalarMass, splitting, nuclearMass, recoilGeV, \
speedKms, orders, width];  (* \
\:8fdb\:884c\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 *)

  nuclearMass*couplingSquared*nuclearResponse*integral/
   (256*Pi^3*incomingMomentum^2*mediatorDenominator)
 ];  (* \:7ed3\:675f\:5f53\:524d\:622a\:9762\:51fd\:6570\:5b9a\:4e49 *)


DifferentialCrossSection[a_Integer, recoilKeV_?NumericQ, speedKms_?NumericQ,
   scalarMassGeV_?NumericQ, splittingGeV_?NumericQ, params_Association] :=
 Module[{nuclearMass, nuclearResponse, width},
  nuclearResponse = NuclearResponse[a, recoilKeV];  (* \:8ba1\:7b97\:8be5\
\:53cd\:51b2\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\:5e94 *)

  nuclearMass = Global`xenonNuclearMassGeV[a];  (* \:7528\:8d28\:91cf\:6570\
\:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\:6838\:8d28\:91cf\:ff0c\
\:5355\:4f4d GeV *)

  width = widthForParameters[params[\"mchi\"], scalarMassGeV, splittingGeV, \
params];  (* \:6309\:5bbd\:5ea6\:9009\:9879\:51b3\:5b9a\:4f20\:64ad\:5b50\
\:5bbd\:5ea6 *)

  fixedSpeedCrossSection[nuclearMass, recoilKeV*10^-6, speedKms,
   params[\"mchi\"], scalarMassGeV, splittingGeV, params[\"mV\"],
   params[\"couplingSq\"], params[\"quad\"], width, nuclearResponse]
 ];  (* \:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)


\
\>", "Input",
 CellTags->"inlineEngine",
 CellLabel->
  "In[983]:=",ExpressionUUID->"eb37d1c3-6abc-9343-9cca-b9abd42aa862"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\
\:56fe\:6570\:636e", "Subsubsection",ExpressionUUID->"e3a88b99-9acf-464e-9f58-\
41eca2152c5a"],

Cell["\:5bf9\:901f\:5ea6\:5206\:5e03\:4e0e\:5929\:7136\:6c19\:540c\:4f4d\:7d20\
\:4e30\:5ea6\:6c42\:548c\:ff0c\:8f6c\:6362\:5355\:4f4d\:5e76\:8ba1\:7b97\:66f2\
\:7ebf\:3002", "Text",ExpressionUUID->"cdd68582-20a6-ec48-ab04-17105206b776"],

Cell["\<\
Rate[erKeV_?NumericQ,ms_?NumericQ,dm_?NumericQ,p_Association]:=Module[
 {er=erKeV \
10^-6,m=p[\"mchi\"],v0=p[\"v0\"],ve=p[\"vEarth\"],vesc=p[\"vEsc\"],coupling=p[\
\"couplingSq\"],mv=p[\"mV\"],order=p[\"quad\"],isotopes=p[\"isotopes\"],\
weights=p[\"abundance\"],nv=p[\"nv\"],rho=p[\"rho\"],sum=0.,mA,vmin,vmax,acc,\
v,w,conv,width,nuclearResponse},
 width=widthForParameters[m,ms,dm,p];  (* \
\:8bbe\:7f6e\:76f8\:7a7a\:95f4\:79ef\:5206\:8282\:70b9 *)

 vmax=ve+vesc;  (* \
\:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\
\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\
\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 Do[mA=a 0.93149410242;  (* \:8bbe\:7f6e\:9776\:6838\:8d28\:91cf *)
vmin=VMin[m,ms,mA,er];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\
\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 If[vmin<vmax,
  acc=0.;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
nuclearResponse=NuclearResponse[a,erKeV];  (* \:8ba1\:7b97\:8be5\:53cd\:51b2\
\:80fd\:91cf\:5bf9\:5e94\:7684\:6838\:54cd\:5e94 *)

  Do[v=(vmax+vmin)/2+(vmax-vmin)node[[1]]/2;  (* \:5b8c\:6210\
\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\
\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\
\:524d\:8ba1\:7b97\:6b65\:9aa4 *)
w=node[[2]](vmax-vmin)/2;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\
\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

   acc+=w SpeedPDF[v,v0,ve,vesc] (v/cKm)*
    fixedSpeedCrossSection[mA,er,v,m,ms,dm,mv,coupling,order,width,\
nuclearResponse],
   {node,gl[nv]}];  (* \:751f\:6210 Gauss \
\:79ef\:5206\:8282\:70b9\:548c\:6743\:91cd *)

  sum+=weights[a] acc],{a,isotopes}];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\
\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\
\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\
\:9aa4 *)

 (* isotope weights are number fractions; average target molar mass is \
explicit *)
 conv=(rho/m) cCm (6.02214076 10^23 1000/p[\"molarMass\"]) GeV2cm2 10^-6 \
86400 365250;  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 conv sum];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\:52a0\
\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

MakeCurves[energies_List,bench_List,p_Association]:=Table[
 Print[\"Computing benchmark \",i,\" / \",Length[bench],\"; ms,dm = \
\",bench[[i]]];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\:540c\:4f4d\:7d20\
\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\:6570\:636e\
\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\:9aa4 *)

 Table[{er,Rate[er,bench[[i,1]] 10^-6,bench[[i,2]] 10^-3,p]}, \
{er,energies}],{i,Length[bench]}];  (* \:5b8c\:6210\[OpenCurlyDoubleQuote]\
\:540c\:4f4d\:7d20\:52a0\:6743\:3001\:901f\:5ea6\:79ef\:5206\:4e0e\:4f5c\:56fe\
\:6570\:636e\[CloseCurlyDoubleQuote]\:4e2d\:7684\:5f53\:524d\:8ba1\:7b97\:6b65\
\:9aa4 *)

\
\>", "Program",
 CellOpen->False,
 CellTags->
  "inlineEngine",ExpressionUUID->"064c13a3-a7f1-7d46-9f74-b8149557f3cc"],

Cell["\<\
\:65e7 Gauss \:901f\:5ea6\:79ef\:5206\:4fdd\:5b58\:5728\:72ec\:7acb\:9a8c\
\:8bc1\:6e90\:7801\:4e2d\:ff1b\:8fd9\:91cc\:5148\:5b9a\:4e49 MakeCurves\:ff0c\
\:4e3b Rate \:5728 NIntegrate \:90e8\:5206\:76f4\:63a5\:5b9a\:4e49\:3002\
\>", "Text",ExpressionUUID->"a0541150-855b-9947-88d5-59b7e8e03d21"],

Cell[CellGroupData[{

Cell["\<\
MakeCurves[energies_List,bench_List,p_Association]:=Table[
 Print[\"Computing benchmark \",i,\" / \",Length[bench],\"; ms,dm = \
\",bench[[i]]];  (* \:8f93\:51fa\:5f53\:524d\:6b63\:5728\:8ba1\:7b97\:7684 \
benchmark \:5e8f\:53f7\:4e0e\:8d28\:91cf *)

 Table[{er,Rate[er,bench[[i,1]] 10^-6,bench[[i,2]] 10^-3,p]}, \
{er,energies}],{i,Length[bench]}];  (* \:5bf9\:6240\:6709\:80fd\:91cf\:70b9\
\:8ba1\:7b97\:8be5 benchmark \:7684\:5fae\:5206\:4e8b\:4ef6\:7387 *)


Print[\"\:4e8b\:4ef6\:7387\:66f2\:7ebf\:6570\:636e\:51fd\:6570 MakeCurves \
\:5df2\:5b9a\:4e49\:3002\"];\
\>", "Input",
 CellLabel->
  "In[991]:=",ExpressionUUID->"6c9b1a0f-77e4-0043-972b-2516c55cb027"],

Cell["\<\
\"\\:4e8b\\:4ef6\\:7387\\:66f2\\:7ebf\\:6570\\:636e\\:51fd\\:6570 MakeCurves \
\\:5df2\\:5b9a\\:4e49\\:3002\"\
\>", "Print",ExpressionUUID->"eb7e6467-b171-0041-9cf6-5a36543710cb"]
}, Open  ]]
}, Open  ]],

