6269\\:5c55\\:8ba1\\:7b97\\:5f00\\:5173\\:63a7\\:5236\\:3002\"\
\>", "Print",ExpressionUUID->"fd258a42-8a60-ee45-b78d-c9aa810eb1e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\:516d\:3001\:603b\:622a\:9762\:ff1a\:5bf9\:5141\:8bb8\:7684\:6838\:53cd\
\:51b2\:80fd\:91cf\:79ef\:5206", "Section",ExpressionUUID->"8539c9ee-8822-\
754e-a077-e44751ad7ce5"],

Cell["\<\
\:603b\:622a\:9762\:662f d\[Sigma]A/dER \:5728\:8fd0\:52a8\:5b66\:5141\:8bb8\
\:7684\:5b8c\:6574 ER \:8303\:56f4\:4e0a\:7684\:79ef\:5206\:3002\:4e0a\:4e0b\
\:9650\:7531 \[Chi]1+A\[RightArrow](\[Chi]1+s)+A \:7684\:4e24\:4f53\:8fd0\
\:52a8\:5b66\:6c42\:5f97\:ff0c\:5176\:4e2d\:7ec4\:5408\:672b\:6001\:7684\:6700\
\:5c0f\:4e0d\:53d8\:8d28\:91cf\:4e3a \
m\[Chi]1+ms\:3002\:8fd9\:91cc\:4f7f\:7528\:4e0e\:4e3b\:8ba1\:7b97\:76f8\:540c\
\:7684\:6838\:8d28\:91cf\:8fd1\:4f3c mA=A\[Times]0.93149410242 GeV\:3002\
\>", "Text",ExpressionUUID->"e0a67b20-2136-1948-8dd8-ef0ba5c02b32"],

Cell["\<\
\[Sigma]A(v) = \[Integral]ER,min^ER,max (d\[Sigma]A/dER) dER\:ff1b  \:27e8\
\[Sigma]\:27e9Xe = \[Sum]A \[Eta]A \[Integral] F(v) \[Sigma]A(v) dv\:3002\
\>", "Text",ExpressionUUID->"a9806afe-43fe-7845-a88f-d7f54c4a60f8"],

Cell["\<\
Clear[RecoilEnergyBoundsKeV, TotalCrossSection];
RecoilEnergyBoundsKeV[a_Integer,v_?NumericQ,ms_?NumericQ,p_Association] := \
Module[
 {m,ma,beta,e,s,root,ein,eout,pii,pf,lo,hi}, (* \
\:8d28\:5fc3\:7cfb\:8fd0\:52a8\:5b66\:53d8\:91cf *)
 {m,ma,beta}=N[Rationalize[{p[\"mchi\"],Global`xenonNuclearMassGeV[a],v/\
299792.458},0],40]; (* \:63d0\:9ad8\:8ba1\:7b97\:7cbe\:5ea6\:4ee5\:51cf\:5c11\
\:5927\:8d28\:91cf\:76f8\:51cf\:8bef\:5dee *)
 e=m/Sqrt[1-beta^2]; s=m^2+ma^2+2 ma e; root=Sqrt[s]; (* \:5165\:5c04\:80fd\
\:91cf\:4e0e\:603b\:4e0d\:53d8\:91cf *)
 If[root <= ma+m+ms,Return[{0.,0.}]]; (* \:4e09\:4f53\:672b\:6001\:9608\:503c\
\:672a\:6253\:5f00 *)
 ein=(s+ma^2-m^2)/(2 root); (* \:521d\:6001\:6838\:5728\:8d28\:5fc3\:7cfb\
\:4e2d\:7684\:80fd\:91cf *)
 eout=(s+ma^2-(m+ms)^2)/(2 root); (* \:6700\:5c0f\:7ec4\:5408\:8d28\:91cf\
\:5bf9\:5e94\:7684\:672b\:6001\:6838\:80fd\:91cf *)
 pii=Sqrt[Max[0,ein^2-ma^2]]; pf=Sqrt[Max[0,eout^2-ma^2]]; (* \:521d\:672b\
\:6001\:8d28\:5fc3\:52a8\:91cf *)
 lo=(ein eout-pii pf-ma^2)/ma; hi=(ein eout+pii pf-ma^2)/ma; (* t=-2 mA ER *)
 N[10^6 {Max[0,lo],Max[0,hi]},16] (* GeV \:8f6c keV *)
];
TotalCrossSection[a_Integer,v_?NumericQ,ms_?NumericQ,dm_?NumericQ,p_\
Association] := Module[{bounds,integrand},
 bounds=RecoilEnergyBoundsKeV[a,v,ms,p]; (* \:5168\:90e8\:8fd0\:52a8\:5b66\
\:5141\:8bb8\:53cd\:51b2\:80fd\:91cf\:ff0ckeV *)
 If[bounds[[2]]<=bounds[[1]],Return[0.]]; (* \:9608\:503c\:4ee5\:4e0b\:603b\
\:622a\:9762\:4e3a\:96f6 *)
 integrand[er_?NumericQ]:=10^-6 DifferentialCrossSection[a,er,v,ms,dm,p]; (* \
dER \:4ece keV \:6362\:4e3a GeV *)
 NIntegrate[integrand[er],{er,bounds[[1]],bounds[[2]]},Method->{\"\
GlobalAdaptive\",\"SymbolicProcessing\"->0},AccuracyGoal->Infinity,\
PrecisionGoal->2,MaxRecursion->5] (* \:7ed3\:679c GeV^-2 *)
];
Clear[NaturalAveragedTotalCrossSection];
NaturalAveragedTotalCrossSection[ms_?NumericQ,dm_?NumericQ,p_Association] := \
Module[{vmax,opt,integrand},
 vmax=p[\"vEarth\"]+p[\"vEsc\"]; opt=p[\"nv\"]; (* \:6700\:5927\:901f\:5ea6\
\:53ca\:901f\:5ea6\:79ef\:5206\:8bbe\:7f6e *)
 Total[Table[
  integrand[v_?NumericQ]:=SpeedPDF[v,p[\"v0\"],p[\"vEarth\"],p[\"vEsc\"]] \
TotalCrossSection[a,v,ms,dm,p]; (* \:6bcf\:4e2a\:901f\:5ea6\:7684\:603b\:622a\
\:9762\:4e58\:6982\:7387\:5bc6\:5ea6 *)
  p[\"abundance\"][a] \
NIntegrate[integrand[v],{v,0,vmax},Method->{\"GlobalAdaptive\",\"\
SymbolicProcessing\"->0},AccuracyGoal->Infinity,PrecisionGoal->2,MaxRecursion-\
>opt[\"MaxRecursion\"]], (* \:6bcf\:79cd\:540c\:4f4d\:7d20\:72ec\:7acb\:79ef\
\:5206\:518d\:52a0\:6743 *)
  {a,p[\"isotopes\"]}]] (* \:5929\:7136\:6c19\:5e73\:5747\:603b\:622a\:9762\
\:ff0cGeV^-2 *)
];
Print[\"\:5df2\:5b9a\:4e49\:53cd\:51b2\:80fd\:91cf\:8fb9\:754c\:548c\:603b\
\:622a\:9762\:ff1b\:5b8c\:6574\:6570\:503c\:79ef\:5206\:5728\:4e0b\:4e00\:5355\
\:5143\:9009\:62e9\:8fd0\:884c\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1129]:=",ExpressionUUID->"d09a2335-fb47-1b47-a529-ac245873a2f4"],

Cell["\<\
\"\\:5df2\\:5b9a\\:4e49\\:53cd\\:51b2\\:80fd\\:91cf\\:8fb9\\:754c\\:548c\\:\
603b\\:622a\\:9762\\:ff1b\\:5b8c\\:6574\\:6570\\:503c\\:79ef\\:5206\\:5728\\:\
4e0b\\:4e00\\:5355\\:5143\\:9009\\:62e9\\:8fd0\\:884c\\:3002\"\
\>", "Print",ExpressionUUID->"c9a742e8-17a9-3546-b36e-9afe46ffbd22"],

Cell["\<\
\:4e0b\:9762\:7684\:5b8c\:6574\:5d4c\:5957\:79ef\:5206\:8ba1\:7b97\:91cf\:8f83\
\:5927\:3002\:9996\:6b21\:8fd0\:884c\:65f6\:4ec5\:5b9a\:4e49\:51fd\:6570\:ff1b\
\:628a runExtendedCrossSections \:6539\:4e3a True \:540e\:91cd\:65b0\:8fd0\
\:884c\:672c\:5355\:5143\:ff0c\:5373\:53ef\:8ba1\:7b97\:5f53\:524d\:68c0\:67e5\
\:70b9\:7684\:901f\:5ea6\:5e73\:5747\:5fae\:5206\:622a\:9762\:548c\:56fa\:5b9a\
\:901f\:5ea6\:603b\:622a\:9762\:3002\:603b\:622a\:9762\:5355\:4f4d\:6362\:7b97\
\:4e3a cm\.b2 \:4f7f\:7528 1 GeV^-2 = 0.3893793721\[Times]10^-27 cm\.b2\:3002\
\
\>", "Text",ExpressionUUID->"75b63ddc-99c3-c94c-8b84-404efe1b31b3"],

Cell["\<\
runExtendedCrossSections = False; (* \:6539\:4e3a True \:540e\:8fd0\:884c\
\:8017\:65f6\:8f83\:957f\:7684\:79ef\:5206 *)
If[TrueQ[runExtendedCrossSections],
 averagedXeDSigma = \
NaturalAveragedCrossSection[diagnosticRecoilKeV,selectedScalarMassGeV,\
selectedSplittingGeV,diagnosticParameters]; (* \:5929\:7136\:6c19\:4e0e\:901f\
\:5ea6\:5e73\:5747\:5fae\:5206\:622a\:9762 *)
 totalXe131 = \
TotalCrossSection[diagnosticIsotope,diagnosticSpeedKmPerS,\
selectedScalarMassGeV,selectedSplittingGeV,diagnosticParameters]; (* \:5355\
\:6838\:7d20\:3001\:56fa\:5b9a\:901f\:5ea6\:603b\:622a\:9762 *)
 Print[\"\:5929\:7136\:6c19\:901f\:5ea6\:5e73\:5747\:5fae\:5206\:622a\:9762 \
GeV^-3: \",averagedXeDSigma]; (* \:663e\:793a\:5e73\:5747\:5fae\:5206\:622a\
\:9762 *)
 Print[\"\:56fa\:5b9a\:901f\:5ea6\:603b\:622a\:9762 GeV^-2: \",totalXe131]; \
(* \:663e\:793a\:603b\:622a\:9762 *)
 Print[\"\:56fa\:5b9a\:901f\:5ea6\:603b\:622a\:9762 cm^2: \
\",totalXe131*0.3893793721*10^-27]; (* \:663e\:793a\:5398\:7c73\:5355\:4f4d\
\:7ed3\:679c *)
];
