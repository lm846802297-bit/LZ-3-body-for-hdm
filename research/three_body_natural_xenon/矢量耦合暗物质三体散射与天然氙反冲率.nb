Cell["4.5 \:8ba1\:7b97\:5404\:7ec4\:6781\:70b9\:5bbd\:5ea6", "Subsection",ExpressionUUID->"84c18b14-dbff-ce45-892b-01ab008c2cb3"],
Cell[CellGroupData[{

Cell["\<\
(* \:8f93\:5165\:7684\:8d28\:91cf\:5148\:6362\:7b97\:4e3a GeV\:ff0c\:5bbd\
\:5ea6\:7ed3\:679c\:518d\:6362\:56de keV\:3002 *)
keVToGeV = 10^-6;  (* \:5b9a\:4e49 keV \:5230 GeV \:7684\:6362\:7b97\:56e0\
\:5b50 *)
megaElectronVoltToGeV = 10^-3;  (* \:5b9a\:4e49 MeV \:5230 GeV \:7684\:6362\
\:7b97\:56e0\:5b50 *)
gevToKeV = 10^6;  (* \:5b9a\:4e49 GeV \:5230 keV \:7684\:6362\:7b97\:56e0\
\:5b50 *)

poleWidthRow[{scalarMassKeV_, massSplittingMeV_}] := Module[  (* \:5b9a\:4e49\
\:5355\:7ec4\:8d28\:91cf\:7684\:6781\:70b9\:5bbd\:5ea6\:8ba1\:7b97\:51fd\:6570\
 *)
  {scalarMassGeV, massSplittingGeV, widthGeV},  (* \:7ec4\:7ec7\:5f53\:524d\
\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
  scalarMassGeV = scalarMassKeV * keVToGeV;  (* \
\:5c06\:6807\:91cf\:8d28\:91cf\:4ece keV \:6362\:7b97\:4e3a GeV *)
  massSplittingGeV = massSplittingMeV * megaElectronVoltToGeV;  (* \:5c06\
\:8d28\:91cf\:5288\:88c2\:4ece MeV \:6362\:7b97\:4e3a GeV *)

  widthGeV = Chi2Width[  (* \:6309\:5f53\:524d\:8026\:5408\:548c\:8d28\:91cf\
\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6 *)
    darkMatterMassGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:8f93\:5165\:6697\
\:7269\:8d28 chi1 \:8d28\:91cf\:ff0c\:5355\:4f4d GeV *)
    scalarMassGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:5c06\:6807\:91cf\:8d28\
\:91cf\:4ece keV \:6362\:7b97\:4e3a GeV *)
    massSplittingGeV,  (* \:4f20\:5165\:53c2\:6570\:ff1a\:5c06\:8d28\:91cf\
\:5288\:88c2\:4ece MeV \:6362\:7b97\:4e3a GeV *)
    g2val  (* \:4f20\:5165\:53c2\:6570\:ff1a\:8bbe\:7f6e\:6697\:7269\:8d28\
\:4e0e\:6807\:91cf\:7684\:8026\:5408 g2\:ff0c\:540c\:65f6\:5f71\:54cd\:6781\
\:70b9\:5bbd\:5ea6 *)
  ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

  {scalarMassKeV, massSplittingMeV, widthGeV * gevToKeV}  (* \:7ec4\:7ec7\
\:5f53\:524d\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757\
 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

widthTable = poleWidthRow /@ benchmarks;  (* \:5bf9\:5168\:90e8\:8d28\:91cf\
\:7ec4\:5408\:9010\:4e00\:8ba1\:7b97\:6781\:70b9\:5bbd\:5ea6 *)
Print[\"Included isotope abundance: \", Total[Values[abundances]]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)
Print[\"g2 = \", g2val];  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\
\:7b97\:7ed3\:679c *)

Print[\"\:5404 benchmark \:7684\:5bbd\:5ea6\:5df2\:8ba1\:7b97\:ff1b\:4e0b\
\:65b9\:5c06\:4e0e\:4f20\:64ad\:5b50\:5206\:6bcd\:4e00\:8d77\:663e\:793a\:3002\
\"];\
\>", "Input",
 CellLabel->
  "In[1050]:=",ExpressionUUID->"442dcb22-ff33-6047-bd17-bdd45e152c57"],

