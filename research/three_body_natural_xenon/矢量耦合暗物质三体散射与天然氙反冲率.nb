  If[faCheckResult[\"StandardError\"] =!= \"\", \
Print[faCheckResult[\"StandardError\"]]];  (* \:5224\:65ad\:6761\:4ef6\:ff0c\
\:6839\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
