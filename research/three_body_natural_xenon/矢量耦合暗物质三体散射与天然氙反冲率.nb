\:5e94\:7269\:7406\:91cf *)
}, Frame -> All]  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)\
\>", "Input",
