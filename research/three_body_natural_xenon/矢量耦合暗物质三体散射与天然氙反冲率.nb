\>", "Text",ExpressionUUID->"e3eb4764-b427-6d46-989c-a400e80a4b06"],

Cell[BoxData[
 TagBox[
  RowBox[{"I6", "\[Equal]", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "1"}], "1"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", 
       RowBox[{"2", " ", "\[Pi]"}]], 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "delta", " ", "u"}], ")"}], " ", 
         SqrtBox["lambda"], " ", "L00"}], 
        RowBox[{"W2", " ", 
         RowBox[{"(", 
          RowBox[{"2", " ", "\[Pi]"}], ")"}]}]], 
       RowBox[{"\[DifferentialD]", "phi"}], 
       RowBox[{"\[DifferentialD]", "z"}], 
       RowBox[{"\[DifferentialD]", "u"}]}]}]}]}]}],
  HoldForm]], "DisplayFormula",ExpressionUUID->"04abfbf2-061a-514c-b3b9-\
b7a6d0cff03f"],

Cell["\<\
\:5148\:6784\:9020\:56db\:52a8\:91cf\:4e0e\:76f8\:7a7a\:95f4 Jacobian\:ff0c\
\:518d\:7528 NIntegrate \
\:5bf9\:4e0d\:53d8\:8d28\:91cf\:548c\:4e24\:4e2a\:89d2\:79ef\:5206\:ff1b\:5bf9\
\:6bcf\:79cd\:6c19\:540c\:4f4d\:7d20\:ff0c\:518d\:7528 NIntegrate \
\:5bf9\:5b9e\:9a8c\:5ba4\:901f\:7387\:5206\:5e03\:79ef\:5206\:3002\:79ef\:5206\
