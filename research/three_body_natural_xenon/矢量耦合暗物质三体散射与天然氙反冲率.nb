\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\:7269\
\:7406\:91cf *)
 {\"\:539f\:8fd0\:52a8\:5b66 + Gauss {24,24,12}\", gauss24},  (* \:5b9a\:4e49\
\:6216\:8f93\:51fa\:8868\:683c\:7684\:4e00\:884c\:53ca\:5176\:5bf9\:5e94\:7269\
\:7406\:91cf *)
 {\"NIntegrate / Gauss24 - 1\", If[NumericQ[niResult] && gauss24 != 0, \
niResult/gauss24 - 1, Indeterminate]}  (* \
\:6839\:636e\:6761\:4ef6\:9009\:62e9\:5bf9\:5e94\:5206\:652f *)
}, Frame -> All]  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)\
\>", "Input",
