\:7269\:7406\:91cf *)
  Frame -> All  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)
]];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Grid[{  (* \:5c06\:6570\:636e\:6574\:7406\:4e3a\:8868\:683c *)
  {\"\:9010\:540c\:4f4d\:7d20\:4e4b\:548c\", isotopeRateSum},  (* \
