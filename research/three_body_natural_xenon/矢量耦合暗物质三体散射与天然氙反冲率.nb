Cell["\<\
baseDir = NotebookDirectory[];
afhPath = FileNameJoin[{baseDir, \"dmformfactor-V6.m\"}];
If[!FileExistsQ[afhPath], Print[\"AFH package missing: \", afhPath]; \
Abort[]];
LoadResponses[afhPath, isotopes];
Print[\"AFH \
\:6838\:54cd\:5e94\:521d\:59cb\:5316\:5b8c\:6210\:ff1b\:4e0b\:8868\:4f7f\:7528\
\:5f53\:524d\:68c0\:67e5\:53cd\:51b2\:80fd\:91cf ER = \", \
diagnosticRecoilKeV, \" keV\:3002\"]; (* \:8bf4\:660e\:8868\:683c\:4f7f\:7528\
\:7684\:8f93\:5165 *)
Print[Grid[Prepend[Table[{a,NuclearResponse[a,diagnosticRecoilKeV]}, \
{a,isotopes}],{\"\:6c19\:540c\:4f4d\:7d20\:8d28\:91cf\:6570 \
A\",\"\:6838\:54cd\:5e94 RA\:ff08\:65e0\:91cf\:7eb2\:ff09\"}],Frame->All]]; \
(* \:663e\:793a\:5404\:540c\:4f4d\:7d20\:7684 AFH \:6838\:54cd\:5e94 *)\
\>", "Input",
 CellLabel->
  "In[996]:=",ExpressionUUID->"1389bf94-8723-fb49-b602-b35e9df6c157"],

