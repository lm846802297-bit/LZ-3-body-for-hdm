", "Text",ExpressionUUID->"8a40f4a9-c545-384f-8b15-bf2c19cdce30"],

Cell[CellGroupData[{

Cell["\<\
(* \:540c\:4e00\:4e2a\:8fd0\:52a8\:5b66\:70b9\:548c\:79ef\:5206\:8282\:70b9\
\:ff0c\:5206\:522b\:4f7f\:7528\:624b\:5199\:8ff9\:548c FeynCalc \:8ff9\:3002 *)
fcOriginalI6 = Block[{trace = manualTrace},
 I6[darkMatterMassGeV, selectedScalarMassGeV, selectedSplittingGeV,
  selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS,
  phaseSpaceOrders, selectedWidthGeV]];
fcFeynCalcI6 = I6[darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV,
 selectedNuclearMassGeV, selectedRecoilGeV, diagnosticSpeedKmPerS,
 phaseSpaceOrders, selectedWidthGeV];
fcRelativeDifference = If[fcOriginalI6 != 0, fcFeynCalcI6/fcOriginalI6 - 1, \
Indeterminate];
