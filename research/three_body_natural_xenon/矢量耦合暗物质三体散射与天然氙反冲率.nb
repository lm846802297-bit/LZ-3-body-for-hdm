\>", "Text",ExpressionUUID->"4e93b28c-d367-1d49-9d99-412c99075fe2"],

Cell[CellGroupData[{

Cell["\<\
(* \:6784\:9020\:672b\:6001\:56db\:52a8\:91cf\:ff1b\:76f8\:7a7a\:95f4\:6620\
\:5c04\:4e0d\:8c03\:7528\:539f\:7a0b\:5e8f\:7684 boost \:6216 Gauss \:6c42\
\:79ef\:51fd\:6570\:3002 *)
ClearAll[niDot,niKinematics,niIntegrand,niI6];  (* \:6e05\:9664\:7b26\:53f7\
\:7684\:65e7\:5b9a\:4e49\:53ca\:5c5e\:6027 *)
niDot[a_,b_]:=a[[1]] b[[1]]-a[[2;;4]].b[[2;;4]];  (* \:5b9a\:4e49\:95f5\:53ef\
\:592b\:65af\:57fa\:56db\:5411\:91cf\:70b9\:79ef *)
niKinematics[m_?NumericQ,ms_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?NumericQ,u_\
?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[  (* \:72ec\:7acb\:5b9a\:4e49\
\:76f8\:7a7a\:95f4\:70b9\:548c\:672b\:6001\:56db\:52a8\:91cf\:7684\:6784\:9020\
 *)
 {beta,e,p,q,wmin,wmax,w2,angle,qvec,pin,Q,W,Qvec,Qmag,ez,ex,ey,rad,est,kstar,\
ks,ks4,pp,threshold,delta},  (* \:7ec4\:7ec7\:5f53\:524d\:5217\:8868\:3001\
\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
 beta=v/(299792458/1000);e=m/Sqrt[1-beta^2];p=e beta;q=Sqrt[er (2 mA+er)];  \
(* \:8ba1\:7b97\:5165\:5c04\:7c92\:5b50\:7684\:65e0\:91cf\:7eb2\:901f\:5ea6 *)
 wmin=(m+ms)^2;wmax=m^2+2 p q-2(e+mA)er;delta=wmax-wmin;  (* \:8ba1\:7b97\
\:4e0d\:53d8\:8d28\:91cf\:5e73\:65b9\:7684\:4e0a\:4e0b\:9650\:53ca\:533a\:95f4\
\:5bbd\:5ea6 *)
 If[delta<=0,Return[$Failed]];  (* \:82e5\:4e0d\:53d8\:8d28\:91cf\:4e0a\:4e0b\
\:9650\:5012\:7f6e\:ff0c\:8fd4\:56de\:5931\:8d25 *)
 w2=wmin+delta u^2;  (* \:7528 u \:7684\:5e73\:65b9\:6620\:5c04\:5230\:4e0d\
\:53d8\:8d28\:91cf\:79ef\:5206\:533a\:95f4 *)
 angle=(w2-m^2+2(e+mA)er)/(2 p q);  (* \:7531\:80fd\:91cf\:52a8\:91cf\:5b88\
\:6052\:8ba1\:7b97\:6838\:53cd\:51b2\:65b9\:5411\:4f59\:5f26 *)
 If[Abs[angle]>1+10^-8,Return[$Failed]];  (* \:68c0\:67e5\:53cd\:51b2\:89d2\
\:4f59\:5f26\:662f\:5426\:8d85\:51fa\:5141\:8bb8\:8303\:56f4 *)
 qvec=q {Sqrt[Max[0,1-angle^2]],0,angle};  (* \:6784\:9020\:5b9e\:9a8c\:5ba4\
\:7cfb\:6838\:53cd\:51b2\:4e09\:52a8\:91cf *)
 pin={e,0,0,p};Q=Join[{e-er},{0,0,p}-qvec];  (* \
\:6784\:9020\:5165\:5c04\:6697\:7269\:8d28\:56db\:52a8\:91cf *)
 W=Sqrt[w2];Qvec=Q[[2;;4]];Qmag=Norm[Qvec];  (* \
\:8ba1\:7b97\:672b\:6001\:4e0d\:53d8\:8d28\:91cf\:4e0e\:603b\:4e09\:52a8\:91cf\
\:7684\:5927\:5c0f *)
 ez=If[Qmag>0,Qvec/Qmag,{0,0,1}];  (* \:4ee5\:672b\:6001\:603b\:52a8\:91cf\
\:65b9\:5411\:5b9a\:4e49\:6781\:8f74 *)
 ex=Normalize[Cross[If[Abs[ez[[3]]]<0.9,{0,0,1},{0,1,0}],ez]];ey=Cross[ez,ex];\
  (* \:5efa\:7acb\:4e0e\:672b\:6001\:603b\:52a8\:91cf\:5782\:76f4\:7684\:4e24\
\:4e2a\:6b63\:4ea4\:57fa\:65b9\:5411 *)
 rad=Sqrt[Max[0,(w2-(m+ms)^2)(w2-(m-ms)^2)]];  (* \:8ba1\:7b97\:6709\:91cf\
\:7eb2 K\[ADoubleDot]ll\[EAcute]n \:51fd\:6570\:7684\:5e73\:65b9\:6839 *)
 est=(w2-m^2+ms^2)/(2 W);kstar=rad/(2 W);  (* \:8ba1\:7b97\:6807\:91cf\:5728\
\:672b\:6001\:8d28\:5fc3\:7cfb\:7684\:80fd\:91cf *)
 ks=kstar (z ez+Sqrt[Max[0,1-z^2]](Cos[phi] ex+Sin[phi] ey));  (* \
\:6309\:8d28\:5fc3\:7cfb\:6781\:89d2\:548c\:65b9\:4f4d\:89d2\:6784\:9020\:6807\
\:91cf\:4e09\:52a8\:91cf *)
 ks4=Join[{(Q[[1]] est+Qvec.ks)/W},ks+Qvec (est/W+(Qvec.ks)/(W (Q[[1]]+W)))]; \
 (* \:5c06\:6807\:91cf\:56db\:52a8\:91cf\:4ece\:8d28\:5fc3\:7cfb\:53d8\:6362\
\:81f3\:5b9e\:9a8c\:5ba4\:7cfb *)
 pp=Q-ks4;  (* \:7531\:56db\:52a8\:91cf\:5b88\:6052\:5f97\:5230\:672b\:6001\
\:6697\:7269\:8d28\:56db\:52a8\:91cf *)
 <|\"pin\"->pin,\"pout\"->pp,\"k\"->ks4,\"Q\"->Q,\"w2\"->w2,\"qvec\"->qvec,  \
(* \:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\
\:5219\:6216\:663e\:793a\:9009\:9879 *)
   \"jac\"->2 delta u,\"phase\"->rad/w2,\"delta\"->delta|>  (* \:6307\:5b9a\
\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\
\:793a\:9009\:9879 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Print[\"\:5df2\:5b9a\:4e49\:76f8\:7a7a\:95f4\:8fd0\:52a8\:5b66\:ff1au\
\[RightArrow]W\.b2\:ff0cz=cos\[Theta]*\:ff0cphi \
\:4e3a\:65b9\:4f4d\:89d2\:3002\:5177\:4f53\:56db\:52a8\:91cf\:5c06\:5728\:4e0b\
\:9762\:7684\:56fa\:5b9a\:70b9\:68c0\:67e5\:663e\:793a\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1030]:=",ExpressionUUID->"0a064cf6-97a1-f646-83a5-262ecff19783"],

Cell[BoxData["\<\"\:5df2\:5b9a\:4e49\:76f8\:7a7a\:95f4\:8fd0\:52a8\:5b66\:ff1a\
u\[RightArrow]W\.b2\:ff0cz=cos\[Theta]*\:ff0cphi \:4e3a\:65b9\:4f4d\:89d2\
\:3002\:5177\:4f53\:56db\:52a8\:91cf\:5c06\:5728\:4e0b\:9762\:7684\:56fa\:5b9a\
\:70b9\:68c0\:67e5\:663e\:793a\:3002\"\>"], "Print",
 CellChangeTimes->{4.0038872839542217`*^9},
 CellLabel->
  "\:6b63\:5728\:8ba1\:7b97In[1030]:=",ExpressionUUID->"d84ded73-3d7d-a84a-\
a172-cada661387aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
niIntegrand[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_\
?NumericQ,width_?NumericQ,u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[{kin}\
,  (* \:5b9a\:4e49\:542b Jacobian\:3001\:76f8\:7a7a\:95f4\:6743\:91cd\:548c\
\:81ea\:65cb\:8ff9\:7684\:88ab\:79ef\:51fd\:6570 *)
 kin=niKinematics[m,ms,mA,er,v,u,z,phi];  (* \:5728\:5f53\:524d\:79ef\:5206\
\:70b9\:6784\:9020\:8fd0\:52a8\:5b66\:56db\:52a8\:91cf *)
 If[kin===$Failed,Return[0.]];  (* \:8fd0\:52a8\:5b66\:70b9\:65e0\:6548\:65f6\
\:4ee4\:8be5\:79ef\:5206\:70b9\:8d21\:732e\:4e3a\:96f6 *)
 kin[\"jac\"] kin[\"phase\"] \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],width]/(2 Pi)  \
(* \:76f8\:7a7a\:95f4 Jacobian \:4e58\:76f8\:7a7a\:95f4\:56e0\:5b50\:3001\
\:81ea\:65cb\:8ff9\:53ca\:65b9\:4f4d\:5e73\:5747\:7cfb\:6570 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Options[niI6]={AccuracyGoal->3,PrecisionGoal->3,MaxRecursion->6,\
WorkingPrecision->30};  (* \:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\
\:5ea6\:76ee\:6807\:6216\:6700\:5927\:9012\:5f52\:6b21\:6570 *)
niI6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,v_?\
NumericQ,width_?NumericQ,OptionsPattern[]]:=Module[{b,e,p,q,wmax},  (* \:5b9a\
\:4e49\:5c40\:90e8\:53d8\:91cf\:548c\:5c40\:90e8\:8ba1\:7b97 *)
 If[!TrueQ[m>0&&ms>=0&&dm>=0&&mA>0&&er>0&&0<v<(299792458/1000)&&width>=0],\
Print[\"Invalid inputs\"];Return[$Failed]];  (* \
\:68c0\:67e5\:8d28\:91cf\:3001\:53cd\:51b2\:80fd\:91cf\:3001\:901f\:5ea6\:548c\
\:5bbd\:5ea6\:662f\:5426\:4f4d\:4e8e\:5141\:8bb8\:8303\:56f4 *)
 b=v/(299792458/1000);e=m/Sqrt[1-b^2];p=e b;q=Sqrt[er(2mA+er)];wmax=m^2+2p \
q-2(e+mA)er;  (* \:8ba1\:7b97\:5165\:5c04\:901f\:5ea6\:3001\:80fd\:91cf\:3001\
\:52a8\:91cf\:4e0e\:4e0d\:53d8\:8d28\:91cf\:4e0a\:9650 *)
 If[wmax<=(m+ms)^2,Return[0.]];  (* \
\:82e5\:672b\:6001\:76f8\:7a7a\:95f4\:5173\:95ed\:ff0c\:8fd4\:56de\:96f6 *)
 If[wmax>=(m+dm)^2,Print[\"On-shell chi2 accessible; off-shell calculation \
aborted.\"];Return[$Failed]];  (* \:82e5\:4e2d\:95f4\:6001\:53ef\:5728\:58f3\
\:ff0c\:505c\:6b62\:5f53\:524d\:79bb\:58f3\:8fd1\:4f3c\:8ba1\:7b97 *)
 NIntegrate[niIntegrand[m,ms,dm,mA,er,v,width,u,z,phi],{u,0,1},{z,-1,1},{phi,\
0,2Pi},  (* \:8fdb\:884c\:6570\:503c\:79ef\:5206 *)
   WorkingPrecision->OptionValue[WorkingPrecision], Method->{\"GlobalAdaptive\
\",\"SymbolicProcessing\"->0},AccuracyGoal->OptionValue[AccuracyGoal],  (* \
\:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\:5ea6\:76ee\:6807\:6216\:6700\
\:5927\:9012\:5f52\:6b21\:6570 *)
   PrecisionGoal->OptionValue[PrecisionGoal],MaxRecursion->OptionValue[\
MaxRecursion]]  (* \:6307\:5b9a\:6570\:503c\:79ef\:5206\:7684\:7cbe\:5ea6\
\:76ee\:6807\:6216\:6700\:5927\:9012\:5f52\:6b21\:6570 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
Print[\"\:5df2\:5b9a\:4e49 NIntegrate \:88ab\:79ef\:51fd\:6570\:4e0e\:4e09\
\:7ef4\:76f8\:7a7a\:95f4\:79ef\:5206\:ff1b\:8ba1\:7b97\:7ed3\:679c\:5728\:56fa\
\:5b9a\:70b9\:53ca benchmark \:8868\:663e\:793a\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1035]:=",ExpressionUUID->"e3fbca77-f4d2-b645-bf2a-d63303459cb0"],

Cell[BoxData["\<\"\:5df2\:5b9a\:4e49 NIntegrate \
\:88ab\:79ef\:51fd\:6570\:4e0e\:4e09\:7ef4\:76f8\:7a7a\:95f4\:79ef\:5206\:ff1b\
\:8ba1\:7b97\:7ed3\:679c\:5728\:56fa\:5b9a\:70b9\:53ca benchmark \:8868\:663e\
\:793a\:3002\"\>"], "Print",
 CellChangeTimes->{4.003887283958235*^9},
 CellLabel->
  "\:6b63\:5728\:8ba1\:7b97In[1035]:=",ExpressionUUID->"5775edeb-4b9c-0646-\
bd07-84dcfc9d723b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* \:4e3b\:8ba1\:7b97\:76f4\:63a5\:91c7\:7528 NIntegrate\:ff1bGauss \:6bd4\
\:8f83\:51fd\:6570\:5728\:9a8c\:8bc1\:90e8\:5206\:5b9a\:4e49\:3002 *)
(* \:4e3b\:8ba1\:7b97\:ff1a\:4f7f\:7528 Mathematica NIntegrate \:79ef\:5206\
\:4e09\:4f53\:76f8\:7a7a\:95f4\:3002 *)
Clear[I6];
I6[m_?NumericQ,ms_?NumericQ,dm_?NumericQ,mA_?NumericQ,er_?NumericQ,
 v_?NumericQ,opts_Association,width_?NumericQ]:=Module[{wp,vals,result},
 If[er<=0,Return[0.]];
 wp=opts[\"WorkingPrecision\"];
 (* \:4ee5\:6307\:5b9a\:5de5\:4f5c\:7cbe\:5ea6\:8ba1\:7b97\:ff1b\:8fd9\:4e0d\
\:4f1a\:6062\:590d\:7528\:6237\:8f93\:5165\:672c\:8eab\:672a\:63d0\:4f9b\:7684\
\:6709\:6548\:6570\:5b57\:3002 *)
 vals=N[Rationalize[{m,ms,dm,mA,er,v,width},0],wp];
 result=niI6[Sequence@@vals,AccuracyGoal->opts[\"AccuracyGoal\"],
  PrecisionGoal->opts[\"PrecisionGoal\"],MaxRecursion->opts[\"MaxRecursion\"],\
WorkingPrecision->wp];
 If[!NumericQ[result],Throw[\"NIntegrate phase-space calculation \
failed\"]];result
];
(* \:4e3b\:8ba1\:7b97\:ff1a\:6bcf\:4e2a\:6c19\:540c\:4f4d\:7d20\:7684\:5b9e\
\:9a8c\:5ba4\:901f\:5ea6\:5206\:5e03\:4e5f\:7528 NIntegrate \
\:79ef\:5206\:3002 *)
Clear[Rate];
Rate[erKeV_?NumericQ,ms_?NumericQ,dm_?NumericQ,pars_Association]:=Module[
 {m=pars[\"mchi\"],v0=pars[\"v0\"],ve=pars[\"vEarth\"],vesc=pars[\"vEsc\"],
  rho=pars[\"rho\"],weights=pars[\"abundance\"],speedOpts=pars[\"nv\"],vmax,\
vmin,mA,acc,sum=0.,conv,integrand},
 vmax=ve+vesc;
 Do[mA=a*0.93149410242;vmin=VMin[m,ms,mA,erKeV*10^-6];
  If[vmin<vmax,
   integrand[v_?NumericQ]:=SpeedPDF[v,v0,ve,vesc]*(v/299792.458)*
    DifferentialCrossSection[a,erKeV,v,ms,dm,pars];
   acc=NIntegrate[integrand[v],{v,vmin,vmax},
    Method->{\"GlobalAdaptive\",\"SymbolicProcessing\"->0},
    AccuracyGoal->speedOpts[\"AccuracyGoal\"],PrecisionGoal->speedOpts[\"\
PrecisionGoal\"],
    MaxRecursion->speedOpts[\"MaxRecursion\"]];
   If[!NumericQ[acc],Throw[\"NIntegrate velocity calculation \
failed\"]];sum+=weights[a]*acc],
  {a,pars[\"isotopes\"]}];
 (* \:6570\:5bc6\:5ea6\:3001\:5355\:4f4d\:9776\:6838\:6570\:3001\:622a\:9762\
\:3001\:80fd\:91cf\:4e0e\:65f6\:95f4\:5355\:4f4d\:8f6c\:6362\:3002 *)
 conv=(rho/m)*2.99792458*10^10*(6.02214076*10^23*1000/pars[\"molarMass\"])*
  0.3893793721*10^-27*10^-6*86400*365250;
 conv*sum
];
Print[\"\:4e3b\:8ba1\:7b97\:5df2\:542f\:7528 FeynCalc + \
NIntegrate\:ff08\:4e09\:4f53\:76f8\:7a7a\:95f4\:53ca\:901f\:5ea6\:5206\:5e03\
\:ff09\:3002\"];\
\>", "Input",
 CellLabel->
  "In[1039]:=",ExpressionUUID->"a70205bb-46bf-224a-9882-858da3ba37a9"],

Cell[BoxData["\<\"\:4e3b\:8ba1\:7b97\:5df2\:542f\:7528 FeynCalc + NIntegrate\
\:ff08\:4e09\:4f53\:76f8\:7a7a\:95f4\:53ca\:901f\:5ea6\:5206\:5e03\:ff09\:3002\
\"\>"], "Print",
 CellChangeTimes->{4.003876746321617*^9, 4.0038778897771015`*^9, 
  4.003887283961973*^9},
 CellLabel->
  "\:6b63\:5728\:8ba1\:7b97In[1039]:=",ExpressionUUID->"b32bfcdd-9110-e24f-\
9f63-95bd56074efc"]
}, Open  ]]
