Cell["\:672c\:8282\:8ba1\:7b97\:6e90\:4ee3\:7801\:ff1aFeynCalc \:4e0e AFH\
\:ff1a\:6c19\:6838\:4e09\:4f53\:622a\:9762", "Subsubsection",ExpressionUUID->\
"28785887-4e3e-f947-a661-7ebd5d98b661"],

Cell["\:4e0b\:9762\:7684\:4ee3\:7801\:76f4\:63a5\:4fdd\:5b58\:5728\:672c\:7b14\
\:8bb0\:672c\:ff0c\:53ef\:5c55\:5f00\:9605\:8bfb\:6216\:7f16\:8f91\:ff1b\:6267\
\:884c\:5176\:540e\:7684\:8fd0\:884c\:5355\:5143\:65f6\:ff0c\:5c06\:5728\:72ec\
\:7acb\:5185\:6838\:4e2d\:4f7f\:7528\:8fd9\:91cc\:7684\:4ee3\:7801\:3002", \
"Text",ExpressionUUID->"2b17683e-2b52-5c49-9f1f-3dd527deeb15"],

Cell["\<\
(* Independent kernel: patched FeynArts is kept inside this project. *)
workDir=DirectoryName[$InputFileName];projectDir=DirectoryName[workDir];
FeynCalc`$FeynArtsDirectory=FileNameJoin[{workDir,\"FeynArtsPatched\"}];
sourceModel=FileNameJoin[{workDir,\"ThreeBodyVV.fr\"}];
hashFile=FileNameJoin[{workDir,\"generated_model_source_sha256.txt\"}];
If[!FileExistsQ[sourceModel]||!FileExistsQ[hashFile]||ToLowerCase[FileHash[\
sourceModel,\"SHA256\",\"HexString\"]]=!=StringTrim[Import[hashFile,\"Text\"]],
 Print[\"FeynRules source changed since FeynArts model generation; regenerate \
and patch the model first.\"];Exit[2]];
$LoadAddOns={\"FeynArts\"};$FeynCalcStartupMessages=False;Get[\"FeynCalc`\"];
$PrePrint=.;$FAVerbose=0;
top=CreateTopologies[0,2->3,ExcludeTopologies->{Tadpoles,SelfEnergies}];
ins=InsertFields[top,{F[1],F[3]}->{F[1],F[3],S[1]},Model->\"ThreeBodyVV_FA\",\
GenericModel->\"ThreeBodyVV_FA\",InsertionLevel->{Classes}];
Print[\"graphs=\",Length[ins]];
faamp=CreateFeynAmp[ins,PreFactor->1];
fcamp=FCFAConvert[faamp,IncomingMomenta->{p,P},OutgoingMomenta->{r,R,k},\
ChangeDimension->4,List->False,DropSumOver->True];
Print[\"FCAMP=\",ToString[InputForm[fcamp],PageWidth->Infinity]];

(* Static nucleus charge current: project nuclear line to 2 m_A delta^mu_0. *)
projected=fcamp /. \
HoldPattern[Dot[Spinor[Momentum[R],___],middle__,Spinor[Momentum[P],___]]] :> \
2 MNuc;
If[!FreeQ[projected,Spinor[Momentum[P|R],___]],Print[\"Nuclear projection \
failed.\"];Exit[3]];
projected=projected /. \
{HoldPattern[Pair[LorentzIndex[_],LorentzIndex[_]]]->1,HoldPattern[DiracGamma[\
LorentzIndex[_]]]:>FeynCalc`GA[0]};
(* Add the pole width only to the p-prime + k internal line, as in the paper. \
*)
projected=projected /. \
HoldPattern[FeynAmpDenominator[PropagatorDenominator[Momentum[-k-r],MChiTwo]]]\
 :>
 1/(Pair[Momentum[k+r],Momentum[k+r]]-MChiTwo^2+I MChiTwo gammaWidth);
Print[\"Width inserted in radiating propagator: \
\",!FreeQ[projected,gammaWidth]];
If[FreeQ[projected,gammaWidth],Print[\"Width insertion failed.\"];Exit[3]];
conj=ComplexConjugate[projected] /. Conjugate[gammaWidth]->gammaWidth;
squared=FermionSpinSum[projected conj]/2;
expr=FeynAmpDenominatorExplicit[Contract[DiracSimplify[squared,\
DiracTraceEvaluate->True]]];
Print[\"static projected spin trace bytes=\",ByteCount[expr],\" remaining \
propagators=\",Length[Cases[expr,_FeynAmpDenominator,Infinity]]];
(* INSERT_NOTEBOOK_ENGINE *)
(* INSERT_NOTEBOOK_NINTEGRATE *)
prec=50;args=Rest[$ScriptCommandLine];
If[!MemberQ[{0,12},Length[args]],Print[\"Expected no arguments or exactly 12: \
m,ms,dm,mA,ER,v,mV,g1,g2,gN,A,widthMode.\"];Exit[2]];
If[Length[args]==12,
 {m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[Rationalize[ToExpression[#],0],prec]& /@ \
Take[args,10];iso=ToExpression[args[[11]]];widthMode=Last[args],
 {m,ms,dm,ma,er,v,mv,cX,cS,cN}=N[#,prec]& /@ \
{1000,3/10000,1/1000,131*93149410242/10^11,1/5000,776,10,1,1,1};iso=131;\
widthMode=\"pole\"
];
If[!MemberQ[{128,129,130,131,132,134,136},iso]||!TrueQ[Abs[ma-iso*93149410242/\
10^11]<10^-8]||!MemberQ[{\"pole\"},widthMode]||!TrueQ[m>0&&ms>=0&&dm>=0&&ma>0&\
&er>0&&0<v<299792458/1000&&mv>0&&cX!=0&&cS!=0&&cN!=0],Print[\"Invalid \
physical inputs.\"];Exit[2]];
widthGeV=Chi2Width[m,ms,dm,cS];
kin=niKinematics[m,ms,ma,er,v,N[2/5,prec],N[1/4,prec],N[6/5,prec]];
If[kin===$Failed,Print[\"Phase space closed.\"];Exit[2]];
If[!TrueQ[(m+ms)^2+kin[\"delta\"]<(m+dm)^2],Print[\"On-shell pole accessible; \
off-shell assumption invalid.\"];Exit[2]];
muDot[a_,b_]:=a[[1]]b[[1]]-a[[2;;4]].b[[2;;4]];
Clear[fcStaticME2,fcStaticWeight];
fcStaticME2[u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[{x,pIn,pOut,kOut,\
pT,rT,vs,momf},
 x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];
 pIn=x[\"pin\"];pOut=x[\"pout\"];kOut=x[\"k\"];pT={ma,0,0,0};rT=pT+Join[{er},\
x[\"qvec\"]];
 vs={p->pIn,r->pOut,k->kOut,P->pT,R->rT};momf[a_]:=a/.vs;
 expr/.{HoldPattern[Pair[Momentum[a_],Momentum[b_]]]:>muDot[momf[a],momf[b]],\
HoldPattern[TemporalPair[ExplicitLorentzIndex[0],TemporalMomentum[a_]]]:>momf[\
a][[1]],MChiOne->m,MChiTwo->m+dm,MNuc->ma,MMed->mv,gammaWidth->widthGeV,gc1->\
cS,gc2->cS,gc3->cX,gc4->cX,gc5->cN}
];
fcStaticWeight[u_?NumericQ,z_?NumericQ,phi_?NumericQ]:=Module[{x},
 x=niKinematics[m,ms,ma,er,v,u,z,phi];If[x===$Failed,Return[0]];
 x[\"jac\"] x[\"phase\"] Re[fcStaticME2[u,z,phi]]/(2 Pi)
];
point=fcStaticME2[N[2/5,prec],N[1/4,prec],N[6/5,prec]];
pointReference=4ma^2*(cX*cS*cN)^2 \
trace[kin[\"pin\"],kin[\"pout\"],kin[\"k\"],m,m+dm,kin[\"w2\"],widthGeV]/(mv^\
2+2ma er)^2;
Print[\"Static projected amplitude squared=\",N[Re[point],15],\" \
reference=\",N[pointReference,15],\" relative=\",N[point/pointReference-1,8]];
If[!NumericQ[point]||Abs[N[Im[point]/pointReference]]>10^-8||Abs[N[point/\
pointReference-1]]>10^-8,Print[\"Point check failed.\"];Exit[4]];
incomingMomentum=m*(v/(299792458/1000))/Sqrt[1-(v/(299792458/1000))^2];
Print[\"Integrating FeynCalc static-current amplitude; width \
mode=\",widthMode];
sigmaPoint=NIntegrate[fcStaticWeight[u,z,phi],{u,0,1},{z,-1,1},{phi,0,2Pi},\
WorkingPrecision->35,AccuracyGoal->5,PrecisionGoal->5,MaxRecursion->7,Method->\
{\"GlobalAdaptive\",\"SymbolicProcessing\"->0}]/(1024 Pi^3 ma \
incomingMomentum^2);
LoadResponses[FileNameJoin[{projectDir,\"dmformfactor-V6.m\"}],{iso}];
(* Use the same AFH isotope and A*u nuclear mass as the notebook. *)
response=NuclearResponse[iso,N[er*10^6]];
sigmaXe=sigmaPoint*response;
Print[\"AFH isotope and response=\",iso,\" \",response];
Print[\"Three-body dsigma GeV^-3=\",N[sigmaXe,15]];
Print[\"Three-body dsigma cm2/keV=\",N[sigmaXe*3893793721/10^43,15]];
Print[\"Pointlike R=1 dsigma GeV^-3=\",N[sigmaPoint,15]];
Print[\"Width GeV=\",N[widthGeV,12]];
originalParams=<|\"mchi\"->N[m],\"mV\"->N[mv],\"g2\"->N[cS],\"couplingSq\"->N[\
(cX*cS*cN)^2],\"quad\"->{24,24,12},\"widthMode\"->widthMode|>;
originalSigma=DifferentialCrossSection[iso,N[er*10^6],N[v],N[ms],N[dm],\
originalParams];
Print[\"Original Gauss (24,24,12) dsigma GeV^-3=\",originalSigma];
Print[\"FeynCalc/original - 1=\",N[sigmaXe/originalSigma-1,8]];
If[!NumericQ[sigmaXe]||!TrueQ[sigmaXe>0],Exit[5]];
Exit[0];


\
\>", "Program",
 CellTags->
  "embeddedNuclear",ExpressionUUID->"816153c9-672f-ad4c-a0b6-3f82a03b88a6"],

Cell[CellGroupData[{

Cell["\<\
(* \:5148\:8fd0\:884c\:7b2c\:4e00\:81f3\:7b2c\:4e09\:8282\:ff0c\:9009\:5b9a\
\:540c\:4f4d\:7d20\:3001\:8d28\:91cf\:3001\:901f\:5ea6\:3001\:8026\:5408\:53ca\
\:5bbd\:5ea6\:5904\:65b9\:3002 *)
fcNuclearScript = writeEmbeddedScript[\"embeddedNuclear\", True]; (* \:4e09\
\:4f53\:6838\:622a\:9762\:811a\:672c *)
fcNuclearExecutable = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \
\"Windows\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ \
StringSplit[Environment[\"PATH\"], If[$OperatingSystem === \"Windows\", \
\";\", \":\"]], FileExistsQ, $Failed]; (* \
\:67e5\:627e\:547d\:4ee4\:884c\:5185\:6838 *)
fcNuclearInputs = {darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV, selectedNuclearMassGeV, selectedRecoilGeV, \
diagnosticSpeedKmPerS, mediatorMassGeV, g1val, g2val, gVNval, \
diagnosticIsotope}; (* \:7a0b\:5e8f\:9700\:8981\:7684\:8d28\:91cf\:3001\:8026\
\:5408\:548c\:540c\:4f4d\:7d20 *)
If[fcNuclearExecutable === $Failed || !FileExistsQ[fcNuclearScript] || !And \
@@ (NumericQ /@ fcNuclearInputs) || diagnosticWidthMode =!= \"pole\", (* \
\:68c0\:67e5\:6587\:4ef6\:3001\:53c2\:6570\:548c\:5bbd\:5ea6 *)
 Print[\"\:8bf7\:5148\:8fd0\:884c\:7b2c\:4e00\:81f3\:7b2c\:4e09\:8282\:ff0c\
\:68c0\:67e5\:53c2\:6570\:3001\:5bbd\:5ea6\:5904\:65b9\:548c FeynRules_check \
\:6587\:4ef6\:5939\:3002\"], (* \:8f93\:5165\:65e0\:6548\:65f6\:7ed9\:51fa\
\:8bf4\:660e *)
 fcNuclearRun = RunProcess[Join[{fcNuclearExecutable, \"-file\", \
fcNuclearScript}, ToString[#, InputForm] & /@ fcNuclearInputs, \
{diagnosticWidthMode}]]; (* \:72ec\:7acb\:5185\:6838\:751f\:6210\:632f\:5e45\
\:5e76\:79ef\:5206 *)
 Print[fcNuclearRun[\"StandardOutput\"]]; (* \:663e\:793a\:632f\:5e45\:3001\
\:81ea\:65cb\:8ff9\:4e0e\:622a\:9762\:5bf9\:7167 *)
 If[fcNuclearRun[\"StandardError\"] =!= \"\", \
Print[fcNuclearRun[\"StandardError\"]]]; (* \:663e\:793a\:7a0b\:5e8f\:8b66\
\:544a *)
 Print[\"\:6267\:884c\:9000\:51fa\:7801\:ff1a\", fcNuclearRun[\"ExitCode\"]] \
(* \:9000\:51fa\:7801 0 \:8868\:793a\:8ba1\:7b97\:5b8c\:6210 *)
]\
\>", "Input",
 CellLabel->
  "In[1259]:=",ExpressionUUID->"d48332ca-27f0-af4a-8c44-d0ab28ce2b24"],

Cell[CellGroupData[{

Cell[BoxData["\<\"graphs=2\\r\\nFCAMP=-(Spinor[Momentum[R], MNuc, 1] . \
(I*gc5*DiracGamma[LorentzIndex[Lor1]] . DiracGamma[6] + \
I*gc5*DiracGamma[LorentzIndex[Lor1]] . DiracGamma[7]) . Spinor[Momentum[P], \
MNuc, 1]*Spinor[Momentum[r], MChiOne, 1] . \
(I*gc3*DiracGamma[LorentzIndex[Lor2]] . DiracGamma[6] + \
I*gc3*DiracGamma[LorentzIndex[Lor2]] . DiracGamma[7]) . (MChiTwo + \
DiracGamma[Momentum[-P + r + R]]) . (I*gc2*DiracGamma[6] + \
I*gc2*DiracGamma[7]) . Spinor[Momentum[p], MChiOne, \
1]*FeynAmpDenominator[PropagatorDenominator[Momentum[P - R], \
MMed]]*FeynAmpDenominator[PropagatorDenominator[Momentum[P - r - R], \
MChiTwo]]*Pair[LorentzIndex[Lor1], LorentzIndex[Lor2]]) - Spinor[Momentum[R], \
MNuc, 1] . (I*gc5*DiracGamma[LorentzIndex[Lor2]] . DiracGamma[6] + \
I*gc5*DiracGamma[LorentzIndex[Lor2]] . DiracGamma[7]) . Spinor[Momentum[P], \
MNuc, 1]*Spinor[Momentum[r], MChiOne, 1] . (I*gc1*DiracGamma[6] + \
I*gc1*DiracGamma[7]) . (MChiTwo + DiracGamma[Momentum[k + r]]) . \
(I*gc4*DiracGamma[LorentzIndex[Lor1]] . DiracGamma[6] + \
