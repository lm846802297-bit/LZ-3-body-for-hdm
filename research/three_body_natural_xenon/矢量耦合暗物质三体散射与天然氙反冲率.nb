Cell["\<\
base=DirectoryName[$InputFileName]; \
AppendTo[$Path,FileNameJoin[{base,\"feynarts\",\"FeynArts-3.12\"}]];
Get[\"FeynArts`\"]

top=CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];
ins=InsertFields[top,{F[1],V[1]}->{F[1],S[1]},Model->\"ChiRadiation\",\
InsertionLevel->{Classes}];
amp=CreateFeynAmp[ins,Truncated->True];
(* INSERT_NOTEBOOK_ENGINE *)
terms=List@@amp;
Print[\"amp terms \",Length[terms]];
chains=Cases[terms,FermionChain[a_,b_,c_]:>{a,b,c},Infinity];
dens=Cases[terms,PropagatorDenominator[a_,Mchi2]:>a,Infinity];
Print[\"chains \",Length[chains],\" dens \",Length[dens]];
Print[\"chain1 \",ToString[InputForm[chains[[1]]]]];
Print[\"den1 \",ToString[InputForm[dens[[1]]]]];
If[Length[chains]!=2||Length[dens]!=2,Exit[1]];
Clear[faNumericTrace,faPieces];
faPieces[pin_,pp_,k_,m2_,width_]:=Module[{qv,vectors,mom,vert,parts,den,vals},
 qv=pp+k-pin;
 vectors={FourMomentum[Incoming,1]->pin,FourMomentum[Incoming,2]->qv,
          FourMomentum[Outgoing,1]->pp,FourMomentum[Outgoing,2]->k};
 mom[x_]:=x/.vectors;
 vert[x_]:=x/.{
   HoldPattern[NonCommutative[ChiralityProjector[_]]] :> id/2,
   HoldPattern[NonCommutative[DiracMatrix[Index[Lorentz,1]],\
ChiralityProjector[_]]] :> g0/2,
   HoldPattern[NonCommutative[Mchi2+DiracSlash[t_]]] :> (m2 id+slash[mom[t]]),
   gs->1,gv->1};
 parts=Map[vert,chains,{2}];
 den=Table[mdot[mom[dens[[i]]],mom[dens[[i]]]]-m2^2+If[i==1,I m2 \
width,0],{i,2}];
 vals=Table[Dot@@parts[[i]]/den[[i]],{i,2}];
 (* Each FeynArts vertex contributes i; remove their common -1 phase. *)
 -vals
];
faNumericTrace[pin_,pp_,k_,m_,m2_,w2_,width_]:=Module[{g,bar},
 g=Total[faPieces[pin,pp,k,m2,width]];bar=g0.ConjugateTranspose[g].g0;
 Re[Tr[(slash[pp]+m id).g.(slash[pin]+m id).bar]]/2];
args=Rest[$ScriptCommandLine];
If[Length[args]==10,
 {m,ms,dm,mA,er,v,nw,nz,np,g2input}=ToExpression /@ args;ord={nw,nz,np},
 m=1000.;ms=.0003;dm=.001;mA=131*.93149410242;er=.0002;v=776.;ord={6,6,4};\
g2input=1.];
pole=Chi2Width[m,ms,dm,g2input];
samples=Reap[Block[{trace=Function[{p,r,k,m1,m2,w,g},Sow[{p,r,k,m1,m2,w,g}];0.\
]},I6[m,ms,dm,mA,er,v,{2,2,2},pole]]][[2,1]];
sample=First[samples];{pin,pp,k,m1,m2,w2,width}=sample;
fa=faPieces[pin,pp,k,m2,width];
ref={ (slash[pp+k]+m2 id).g0/(w2-m2^2+I m2 width),
 g0.(slash[pin-k]+m2 id)/(mdot[pin-k,pin-k]-m2^2)};
Print[\"amplitude relative matrix norms: \
\",Table[Norm[Flatten[fa[[i]]-ref[[i]]]]/Norm[Flatten[ref[[i]]]],{i,2}]];
t0=trace@@sample;t1=faNumericTrace@@sample;
Print[\"trace original=\",t0,\" FA=\",t1,\" relative=\",t1/t0-1];
Do[
 original=I6[m,ms,dm,mA,er,v,ord,width];
 generated=Block[{trace=faNumericTrace},I6[m,ms,dm,mA,er,v,ord,width]];
 Print[\"width=\",width,\" original I6=\",original,\" FA I6=\",generated,\" \
relative=\",generated/original-1],
 {width,{pole}}];
Print[\"FA_DATA:\",ExportString[N[{t0,t1,original,generated},16],\"RawJSON\",\
\"Compact\"->True]];
\
\>", "Program",
 CellTags->
  "embeddedFANumeric",ExpressionUUID->"89d1371a-201e-0d44-a4ea-bdbc99d529fa"],

