Cell["\:5c06 FeynCalc \:7b26\:53f7\:81ea\:65cb\:8ff9\:4ee3\:5165\:56db\:52a8\
\:91cf\:548c\:4f20\:64ad\:5b50\:ff1b\:540e\:7eed\:7528 NIntegrate \
\:79ef\:5206\:3002", "Text",ExpressionUUID->"b2c2c74f-e3fa-c146-ab58-\
734d294e5cbd"],

Cell[CellGroupData[{

Cell["\<\
Clear[fcTraceNumeric];  (* \:6e05\:9664\:65e7\:5b9a\:4e49 *)
fcTraceNumeric[pin_, pp_, k_, m_, m2_, w2_, width_] := Module[  (* \:5b9a\
\:4e49\:5c06 FeynCalc \:8ff9\:4ee3\:5165\:6570\:503c\:56db\:52a8\:91cf\:7684\
\:51fd\:6570 *)
 {vectors, dot, rules, d1, d2, coeff, matrix},  (* \:7ec4\:7ec7\:5f53\:524d\
\:5217\:8868\:3001\:51fd\:6570\:53c2\:6570\:6216\:8ba1\:7b97\:5757 *)
 vectors = <|fcP->pin, fcR->pp, fcK->k|>;  (* \:5173\:8054\:7b26\:53f7\:56db\
\:52a8\:91cf\:4e0e\:6570\:503c\:56db\:52a8\:91cf *)
 dot[a_,b_] := a[[1]] b[[1]] - a[[2;;4]].b[[2;;4]];  (* \:5b9a\:4e49\:95f5\
\:53ef\:592b\:65af\:57fa\:6807\:91cf\:79ef\:ff0c\:5ea6\:89c4\:4e3a\:6b63\:8d1f\
\:8d1f\:8d1f *)
 rules = {HoldPattern[Pair[Momentum[a_],Momentum[b_]]] :> \
dot[vectors[a],vectors[b]],  (* \:5efa\:7acb FeynCalc \
\:7b26\:53f7\:4e0e\:6570\:503c\:6807\:91cf\:79ef\:7684\:66ff\:6362\:89c4\:5219\
 *)
   HoldPattern[TemporalPair[ExplicitLorentzIndex[0],TemporalMomentum[a_]]] :> \
vectors[a][[1]],  (* \:672c\:884c\:6d89\:53ca\:ff1a\:5173\:8054\:7b26\:53f7\
\:56db\:52a8\:91cf\:4e0e\:6570\:503c\:56db\:52a8\:91cf *)
   fcM->m,fcM2->m2};  (* \:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\
\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\:793a\:9009\:9879 *)
 d1=dot[pin-k,pin-k]-m2^2; d2=w2-m2^2+I m2 width;  (* \
\:8ba1\:7b97\:8f90\:5c04\:524d\:4e2d\:95f4\:6001\:7684\:4f20\:64ad\:5b50\:5206\
\:6bcd *)
 coeff={1/d1,1/d2};  (* \
\:4fdd\:5b58\:4e24\:5f20\:56fe\:7684\:4f20\:64ad\:5b50\:7cfb\:6570 *)
 matrix=fcTraceMatrix /. rules;  (* \
\:628a\:6570\:503c\:56db\:52a8\:91cf\:4ee3\:5165 FeynCalc \:81ea\:65cb\:8ff9\
\:77e9\:9635 *)
 Re[Sum[coeff[[i]] Conjugate[coeff[[j]]] matrix[[i,j]],{i,2},{j,2}]]  (* \
\:5bf9\:6307\:5b9a\:6307\:6807\:6c42\:548c *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
(* \:590d\:7528\:539f\:4e09\:4f53\:8fd0\:52a8\:5b66\:548c Gauss \:79ef\:5206\
\:8282\:70b9\:ff0c\:5c06\:81ea\:65cb\:8ff9\:66ff\:6362\:4e3a FeynCalc \:7ed3\
\:679c\:3002 *)
Clear[fcI6];  (* \:6e05\:9664\:65e7\:5b9a\:4e49 *)
fcI6[m_,ms_,dm_,mA_,er_,v_,orders_,width_] :=  (* \:4ee5 FeynCalc \
\:81ea\:65cb\:8ff9\:4ee3\:66ff\:539f\:77e9\:9635\:8ff9\:5e76\:6267\:884c\:79ef\
\:5206 *)
 Block[{trace=fcTraceNumeric},  (* \:4e34\:65f6\:66ff\:6362\:5c40\:90e8\:51fd\
\:6570\:6216\:53d8\:91cf *)
  I6[m,ms,dm,mA,er,v,orders,width]];  (* \:8ba1\:7b97\:56fa\:5b9a\:8fd0\:52a8\
\:5b66\:7684\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206 *)
Print[\"FeynCalc trace prepared. \",FreeQ[fcTraceMatrix,DiracTrace]];  (* \
\:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\:679c *)\
\>", "Input",
 CellLabel->
  "In[1017]:=",ExpressionUUID->"3d85d611-bf98-d045-b1a2-ee308bea2ec6"],

Cell["\"FeynCalc trace prepared. \"True", "Print",ExpressionUUID->"f1787e2f-ab80-c746-a092-66ace68e6b5c"]
}, Open  ]],

