(* \:5408\:5e76\:7528\:6237\:8bbe\:7f6e\:7684\:53cd\:51b2\:80fd\:91cf\:7f51\
\:683c\:548c\:4ee3\:8868\:80fd\:91cf\:3002 *)
energies = \
Sort[DeleteDuplicates[N[Join[Range[recoilMinKeV,recoilMaxKeV,recoilStepKeV],
 extraRecoilEnergiesKeV, comparisonEnergiesKeV]]]];
(* \:6bcf\:4e2a\:80fd\:91cf\:70b9\:4f7f\:7528\:5f53\:524d\:6a21\:578b\:7b97\
\:51fa\:7684\:6781\:70b9\:5bbd\:5ea6\:ff0c\:8ba1\:7b97\:56db\:7ec4\:8d28\:91cf\
