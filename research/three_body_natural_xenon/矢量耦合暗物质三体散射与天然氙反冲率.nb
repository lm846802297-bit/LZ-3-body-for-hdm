\>", "Text",ExpressionUUID->"7f4b2f84-fabb-3647-824a-1a03e9526228"],

Cell[CellGroupData[{

Cell["\<\
(* \:72ec\:7acb\:57fa\:51c6\:ff1a\:901f\:5ea6\:5206\:5e03\:3001\:8870\:53d8\
\:5bbd\:5ea6\:548c\:542b\:6781\:70b9\:5bbd\:5ea6\:7684 I6\:3002 *)
haloNorm=NIntegrate[SpeedPDF[v,220.,232.,544.],{v,0,312,776}];
testWidth=Chi2Width[1000.,0.0003,0.001,1.];
testPole=I6[1000.,0.0003,0.001,122.,0.0002,776.,finePhaseSpaceOrders,\
testWidth];
Grid[{{\"check\",\"Mathematica\",\"reference\"},{\"halo \
integral\",haloNorm,1.},
 {\"pole width [keV]\",10^6 testWidth,151.8239115788},
 {\"I6 pole [GeV^2]\",testPole,868246.7879206}},Frame->All]\
\>", "Input",
