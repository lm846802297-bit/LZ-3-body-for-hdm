\:68c0\:67e5\:8fd0\:884c\:4f9d\:8d56 *)
 Print[\"\:672a\:627e\:5230 wolframscript \:6216 FeynRules \:811a\:672c\:ff0c\
\:8bf7\:68c0\:67e5\:5b8c\:6574\:6587\:4ef6\:5305\:3002\"], (* \:7f3a\:5c11\
\:6587\:4ef6\:65f6\:7ed9\:51fa\:63d0\:793a *)
