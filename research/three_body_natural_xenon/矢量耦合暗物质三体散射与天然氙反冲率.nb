\:7528\:540c\:4e00\:516c\:5f0f\:ff0c\:662f\:5185\:90e8\:4e00\:81f4\:6027\:68c0\
\:67e5\:3002 *)
selectedDSigmaCheck = DifferentialCrossSection[diagnosticIsotope, \
diagnosticRecoilKeV,
 diagnosticSpeedKmPerS, selectedScalarMassGeV, selectedSplittingGeV, \
diagnosticParameters];
selectedRelativeDifference = If[selectedDSigmaGeVMinus3 != 0,
 selectedDSigmaCheck/selectedDSigmaGeVMinus3 - 1, If[selectedDSigmaCheck == \
0, 0, Indeterminate]];
Grid[{{\"\:8ba1\:7b97\:65b9\:5f0f\", \"d sigma/d ER [GeV^-3]\"}, {\"\:5206\
\:9879\:8ba1\:7b97\", selectedDSigmaGeVMinus3},
 {\"\:516c\:5171\:622a\:9762\:63a5\:53e3\", selectedDSigmaCheck}, {\"\:63a5\
