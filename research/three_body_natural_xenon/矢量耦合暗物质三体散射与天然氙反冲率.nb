\:6bd4\:8f83\:5f62\:72b6\:3002\
\>", "Text",ExpressionUUID->"295d294a-2c3c-a844-9b01-86f83bcf2d8b"],

Cell["\<\
(* \:7b2c\:4e00\:6761\:ff1a\:5355\:540c\:4f4d\:7d20\:7684\:6838\:54cd\:5e94 \
R_A/A\.b2\:3002 *)
nuclearShape = Table[  (* \:8ba1\:7b97\:5355\:540c\:4f4d\:7d20\:6838\:54cd\
\:5e94\:5f62\:72b6 *)
  {energy, NuclearResponse[diagnosticIsotope, energy] / diagnosticIsotope^2}, \
 (* \:8bfb\:53d6\:6838\:54cd\:5e94 *)
  {energy, energies}  (* \:8bbe\:7f6e\:8be5\:5faa\:73af\:7684\:53d8\:91cf\
\:548c\:904d\:5386\:8303\:56f4\:ff0c\:6216\:7ec4\:7ec7\:5f53\:524d\:7ed3\:679c\
 *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)

(* \:7b2c\:4e8c\:6761\:ff1a\:540c\:4e00\:540c\:4f4d\:7d20\:3001\:540c\:4e00\
\:5165\:5c04\:901f\:5ea6\:7684\:5fae\:5206\:622a\:9762\:3002 *)
fixedSpeedShape = fixedSpeedCrossSections[[haloBenchmarkIndex]];  (* \:9009\
\:53d6\:76f8\:540c\:8d28\:91cf\:7ec4\:5408\:7684\:56fa\:5b9a\:901f\:5ea6\:622a\
\:9762 *)

(* \:7b2c\:4e09\:6761\:ff1a\:540c\:4e00\:8d28\:91cf\:7ec4\:5408\:7684\:5929\
\:7136\:6c19 halo \:5e73\:5747\:53cd\:51b2\:7387\:3002 *)
naturalHaloShape = curvesPole[[haloBenchmarkIndex]];  (* \:9009\:53d6\:76f8\
\:540c\:8d28\:91cf\:7ec4\:5408\:7684\:5929\:7136\:6c19 halo \:7387 *)

(* \:4e09\:6761\:66f2\:7ebf\:5355\:4f4d\:4e0d\:540c\:ff0c\:5206\:522b\:6309\
\:5404\:81ea\:6700\:5927\:503c\:5f52\:4e00\:5316\:3002 *)
normalizeShape[data_] := Module[{peak},  (* \:5b9a\:4e49\:6309\:5404\:81ea\
\:6700\:5927\:503c\:5f52\:4e00\:5316\:7684\:51fd\:6570 *)
  peak = Max[data[[All, 2]]];  (* \:627e\:51fa\:5f53\:524d\:66f2\:7ebf\:7684\
\:6700\:5927\:503c *)
  If[peak > 0,  (* \:5224\:65ad\:6761\:4ef6\:ff0c\:6839\:636e\:7ed3\:679c\
\:6267\:884c\:76f8\:5e94\:5206\:652f *)
    Select[({#[[1]], #[[2]] / peak} & /@ data), Last[#] > 0 &],  (* \:7b5b\
\:9009\:6ee1\:8db3\:6761\:4ef6\:7684\:6570\:636e *)
    {}  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
  ]  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
shapeCurves = normalizeShape /@ {nuclearShape, fixedSpeedShape, \
naturalHaloShape};  (* \:5206\:522b\:5f52\:4e00\:5316\:4e09\:6761\:7269\:7406\
\:91cf\:66f2\:7ebf *)
activeShapeIndices = Select[Range[3], Length[shapeCurves[[#]]] > 0 &];  (* \
\:7b5b\:9009\:5b58\:5728\:6b63\:503c\:6570\:636e\:7684\:66f2\:7ebf *)
shapeLabels = {  (* \:8bbe\:7f6e\:4e09\:6761\:66f2\:7ebf\:7684\:56fe\:4f8b *)
  \"Xe-131 nuclear response\",  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\
\:8868\:3001\:8ba1\:7b97\:5757\:6216\:8868\:8fbe\:5f0f *)
  \"Xe-131 fixed-speed cross section\",  (* \:7ed3\:675f\:5f53\:524d\:53c2\
\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\:6216\:8868\:8fbe\:5f0f *)
  \"natural-xenon halo-folded rate\"
};  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
(* \:5982\:4fee\:6539\:540c\:4f4d\:7d20\:ff0c\:56fe\:4f8b\:81ea\:52a8\:540c\
\:6b65\:3002 *)
shapeLabels[[1]] = \"Xe-\" <> ToString[diagnosticIsotope] <> \" nuclear \
response\";  (* \:5c06\:6570\:503c\:6216\:8868\:8fbe\:5f0f\:8f6c\:6362\:4e3a\
\:6587\:5b57 *)
shapeLabels[[2]] = \"Xe-\" <> ToString[diagnosticIsotope] <> \" fixed-speed \
cross section\";  (* \:5c06\:6570\:503c\:6216\:8868\:8fbe\:5f0f\:8f6c\:6362\
\:4e3a\:6587\:5b57 *)

If[Length[activeShapeIndices] == 0,  (* \:5224\:65ad\:6761\:4ef6\:ff0c\:6839\
\:636e\:7ed3\:679c\:6267\:884c\:76f8\:5e94\:5206\:652f *)
  Print[\"\:5f53\:524d\:53c2\:6570\:4e0b\:6ca1\:6709\:6b63\:503c\:66f2\:7ebf\
\:3002\"],  (* \:663e\:793a\:5f53\:524d\:8bf4\:660e\:6216\:8ba1\:7b97\:7ed3\
\:679c *)
  shapeComparisonPlot = ListLogPlot[  (* \:7ed8\:5236\:4e09\:79cd\:7269\:7406\
\:91cf\:7684\:5f52\:4e00\:5316\:5f62\:72b6\:5bf9\:7167 *)
    shapeCurves[[activeShapeIndices]],  (* \:672c\:884c\:6d89\:53ca\:ff1a\
\:5206\:522b\:5f52\:4e00\:5316\:4e09\:6761\:7269\:7406\:91cf\:66f2\:7ebf\:ff1b\
\:7b5b\:9009\:5b58\:5728\:6b63\:503c\:6570\:636e\:7684\:66f2\:7ebf *)
    Joined -> True,  (* \
\:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\:3001\:66ff\:6362\:89c4\:5219\
\:6216\:663e\:793a\:9009\:9879 *)
    Frame -> True,  (* \:8bbe\:7f6e\:8868\:683c\:8fb9\:6846\:6216\:7ed8\:56fe\
\:8fb9\:6846 *)
    PlotRange -> All,  (* \:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\
\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\:793a\:9009\:9879 *)
    FrameLabel -> {\"Recoil energy ER (keV)\", \"Each curve / its own maximum\
\"},  (* \:8bbe\:7f6e\:7ed8\:56fe\:5750\:6807\:8f74\:540d\:79f0\:548c\:5355\
\:4f4d *)
    PlotLegends -> Placed[shapeLabels[[activeShapeIndices]], Below],  (* \
\:8bbe\:7f6e\:66f2\:7ebf\:56fe\:4f8b\:548c\:663e\:793a\:4f4d\:7f6e *)
    ImageSize -> Large  (* \:6307\:5b9a\:8be5\:51fd\:6570\:7684\:53c2\:6570\
\:3001\:66ff\:6362\:89c4\:5219\:6216\:663e\:793a\:9009\:9879 *)
  ];  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\
\:5757\:6216\:8868\:8fbe\:5f0f *)
  shapeComparisonPlot  (* \:4f20\:5165\:53c2\:6570\:ff1a\:7ed8\:5236\:4e09\
\:79cd\:7269\:7406\:91cf\:7684\:5f52\:4e00\:5316\:5f62\:72b6\:5bf9\:7167 *)
]  (* \:7ed3\:675f\:5f53\:524d\:53c2\:6570\:5217\:8868\:3001\:8ba1\:7b97\:5757\
\:6216\:8868\:8fbe\:5f0f *)\
\>", "Input",
 CellLabel->
  "In[1222]:=",ExpressionUUID->"a8a01080-736c-d847-96a3-74b64631cfc4"],

