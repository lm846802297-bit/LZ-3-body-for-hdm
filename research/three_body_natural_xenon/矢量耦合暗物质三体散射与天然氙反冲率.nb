\:66f2\:7ebf\:53ca\:5bf9\:5e94\:7684\:5bbd\:5ea6\:8868\:3002 *)
outDir=FileNameJoin[{baseDir,\"g2_output\"}];If[!DirectoryQ[outDir],\
CreateDirectory[outDir]];
Do[Export[FileNameJoin[{outDir,\"benchmark_\"<>ToString[i]<>\"_pole.csv\"}],
 Prepend[curvesPole[[i]],{\"ER_keV\",\"pole_rate_events_per_tonne_year_keV\"}]\
,\"CSV\"],{i,Length[benchmarks]}];
Export[FileNameJoin[{outDir,\"pole_widths.csv\"}],Prepend[widthTable,{\"ms_\
keV\",\"delta_m_MeV\",\"gamma_keV\"}],\"CSV\"];
Export[FileNameJoin[{outDir,\"selected_pole_energies.csv\"}],Prepend[\
compareRows,{\"benchmark\",\"ER_keV\",\"pole_rate\"}],\"CSV\"];
Export[FileNameJoin[{outDir,\"rate_pole.png\"}],ratePlot,\"PNG\",\
ImageResolution->180];
Print[\"\:7ed3\:679c\:5df2\:5bfc\:51fa\:81f3\:ff1a\",outDir];\
\>", "Input",
