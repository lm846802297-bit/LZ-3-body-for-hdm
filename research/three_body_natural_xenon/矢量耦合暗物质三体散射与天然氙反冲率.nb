mediatorMassGeV, \" GeV\:ff1bg1 = \", g1val, \"\:ff0cg2 = \", g2val, \
\"\:ff0cgVN = \", gVNval]; (* \
\:663e\:793a\:8d28\:91cf\:548c\:6240\:6709\:8026\:5408 *)
benchmarkSummaryTable = Grid[Prepend[benchmarkSummaryRows, {\"ms (keV)\", \"\
\[CapitalDelta]m (MeV)\", \"\[CapitalGamma]\[Chi]2 (keV)\", \"\:6838\:54cd\
\:5e94 RA (\:65e0\:91cf\:7eb2)\", \"I6 (GeV\.b2)\", \"d\[Sigma]/dER \
(GeV^-3)\", \"d\[Sigma]/dER (cm\.b2/keV)\"}], Frame -> All]; (* \:6dfb\:52a0\
\:8868\:5934\:4e0e\:8fb9\:6846 *)
