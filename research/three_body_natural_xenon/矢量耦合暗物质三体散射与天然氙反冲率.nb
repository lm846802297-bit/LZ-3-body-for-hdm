\>", "Text",ExpressionUUID->"fecad642-7871-e64a-9111-7013121830e9"],

Cell["\<\
\:672c\:8282\:4ece FeynRules \:81ea\:52a8\:5bfc\:51fa\:7684\:6a21\:578b\:751f\
\:6210 chi1 + N -> chi1 + N + s \:7684\:4e24\:5f20\:5b8c\:6574\:6811\:56fe\
\:ff0c\:7ecf FCFAConvert \:8f6c\:5165 FeynCalc\:ff0c\:8fdb\:884c\:5168\:90e8\
\:521d\:672b\:6001\:81ea\:65cb\:6c42\:548c\:53ca Dirac \:8ff9\:8ba1\:7b97\
