\:5ea6 km/s\:ff1b\:7528 A \:4e58\:539f\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\
\:4f3c\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\:51b2\:80fd\:91cf\:6362\:7b97\:4e3a\
 GeV *)
  finePhaseSpaceOrders, selectedWidthGeV];  (* \:6307\:5b9a\:6570\:503c\:79ef\
\:5206\:7684\:7cbe\:5ea6\:76ee\:6807\:6216\:6700\:5927\:9012\:5f52\:6b21\:6570\
 *)

(* \:63d0\:9ad8\:539f Gauss \:6c42\:79ef\:9636\:6570\:4ee5\:4fbf\:68c0\:9a8c\
\:5176\:6536\:655b\:3002 *)
gauss16 = gaussI6[darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV,  (* \:7528\:539f Gauss \:6c42\:79ef\:548c 16 \:9636\
\:8bbe\:7f6e\:8ba1\:7b97\:5bf9\:7167\:503c *)
