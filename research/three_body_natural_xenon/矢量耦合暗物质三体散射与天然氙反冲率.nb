{16,16,8}, selectedWidthGeV];  (* \:672c\:884c\:6d89\:53ca\:ff1a\:8bbe\:7f6e\
\:68c0\:67e5\:7528\:5165\:5c04\:901f\:5ea6 km/s\:ff1b\:7528 A \:4e58\:539f\
\:5b50\:8d28\:91cf\:5355\:4f4d\:8fd1\:4f3c\:6838\:8d28\:91cf\:ff1b\:5c06\:53cd\
\:51b2\:80fd\:91cf\:6362\:7b97\:4e3a GeV *)
gauss24 = gaussI6[darkMatterMassGeV, selectedScalarMassGeV, \
selectedSplittingGeV,  (* \:7528\:66f4\:9ad8 Gauss \:9636\:6570\:8ba1\:7b97\
\:6536\:655b\:5bf9\:7167\:503c *)
