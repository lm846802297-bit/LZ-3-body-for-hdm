Cell[CellGroupData[{

Cell["\:4e5d\:3001\:7ed8\:5236\:5929\:7136\:6c19\:4e8b\:4ef6\:7387\:66f2\:7ebf", \
"Section",ExpressionUUID->"8a2a2079-2854-174f-80e6-3280249ea3ba"],

Cell["\:6bcf\:4e2a\:989c\:8272\:5bf9\:5e94\:4e00\:7ec4\:8d28\:91cf\:53c2\:6570\
\:ff1b\:6240\:6709\:66f2\:7ebf\:90fd\:4f7f\:7528\:76f8\:5e94\:53c2\:6570\:4e0b\
\:7684\:6781\:70b9\:5bbd\:5ea6\:3002", "Text",ExpressionUUID->"db8a30d8-f98a-\
9646-8a53-560b85879776"],

Cell[CellGroupData[{

Cell["\<\
(* \:6bcf\:7ec4\:8d28\:91cf\:4f7f\:7528\:4e00\:79cd\:989c\:8272\:ff1b\:53ea\
\:7ed8\:5236\:5305\:542b\:6781\:70b9\:5bbd\:5ea6\:7684\:4e8b\:4ef6\:7387\:3002\
 *)
baseColors={Red,RGBColor[0,.5,0],Black,Blue};
colors=Table[baseColors[[1+Mod[i-1,Length[baseColors]]]],{i,Length[benchmarks]\
}];
benchmarkLabel[{msKeV_,dmMeV_}]:=\"ms=\"<>ToString[msKeV]<>\" keV, \
dm=\"<>ToString[dmMeV]<>\" MeV\";
labels=benchmarkLabel/@benchmarks;
positivePole=(Select[#,Last[#]>0&]&)/@curvesPole;  (* \
\:5bf9\:6570\:56fe\:53ea\:4fdd\:7559\:6b63\:503c *)
activeRateIndices=Select[Range[Length[positivePole]],Length[positivePole[[#]]]\
>0&];
ratePlot=If[activeRateIndices==={},
 Print[\"\:5f53\:524d\:7f51\:683c\:6ca1\:6709\:6b63\:7684\:4e8b\:4ef6\:7387\
\:3002\"];Graphics[{}],
 ListLogPlot[positivePole[[activeRateIndices]],Joined->True,
 PlotStyle->(Directive[#,Thick]&/@colors[[activeRateIndices]]),PlotRange->All,\
Frame->True,
 FrameLabel->{\"Recoil energy E_R (keV)\",\"Rate [events/(tonne year keV)]\"},
 PlotLegends->Placed[labels[[activeRateIndices]],Below],ImageSize->Large,
 PlotLabel->\"Vector-vector model: pole width\"]];
ratePlot\
\>", "Input",
 CellLabel->
  "In[1144]:=",ExpressionUUID->"e9005ada-a540-2e49-b45b-670cd3e8c1f0"],

