367595d203b2"],

Cell["\<\
parameters = <|  (* \:6c47\:603b\:540e\:7eed\:4e8b\:4ef6\:7387\:51fd\:6570\
\:4f7f\:7528\:7684\:8f93\:5165\:53c2\:6570 *)
  \"mchi\"       -> darkMatterMassGeV,  (* \:53c2\:6570 \
mchi\:ff1a\:6697\:7269\:8d28 chi1 \:8d28\:91cf GeV *)
  \"mV\"         -> mediatorMassGeV,  (* \:53c2\:6570 mV\:ff1a\:77e2\:91cf\
\:5a92\:4ecb\:8d28\:91cf GeV *)
  \"g2\"         -> g2val,  (* \:53c2\:6570 g2\:ff1a\:6697\:7269\:8d28\:4e0e\
\:6807\:91cf\:8026\:5408 *)
  \"couplingSq\" -> couplingProductSquared,  (* \:53c2\:6570 couplingSq\:ff1a\
\:8026\:5408\:4e58\:79ef\:7684\:6a21\:5e73\:65b9 *)
  \"rho\"        -> localDensityGeVPerCm3,  (* \:53c2\:6570 rho\:ff1a\:6697\
\:7269\:8d28\:5c40\:57df\:5bc6\:5ea6 *)
  \"v0\"         -> haloSpeedScaleKmPerS,  (* \:53c2\:6570 v0\:ff1a\:6655\
\:901f\:5ea6\:5c3a\:5ea6 km/s *)
  \"vEarth\"     -> earthSpeedKmPerS,  (* \:53c2\:6570 vEarth\:ff1a\:5730\
\:7403\:901f\:5ea6 km/s *)
  \"vEsc\"       -> escapeSpeedKmPerS,  (* \:53c2\:6570 \
vEsc\:ff1a\:9003\:9038\:901f\:5ea6 km/s *)
  \"molarMass\"  -> xenonMolarMassGPerMol,  (* \:53c2\:6570 molarMass\:ff1a\
\:5929\:7136\:6c19\:6469\:5c14\:8d28\:91cf g/mol *)
  \"isotopes\"   -> isotopes,  (* \:53c2\:6570 isotopes\:ff1a\:53c2\:4e0e\
\:8ba1\:7b97\:7684\:6c19\:540c\:4f4d\:7d20 *)
  \"abundance\"  -> abundances,  (* \:53c2\:6570 abundance\:ff1a\:540c\:4f4d\
\:7d20\:6570\:76ee\:4e30\:5ea6 *)
  \"quad\"       -> phaseSpaceOrders,  (* \:53c2\:6570 quad\:ff1a\:4e09\:4f53\
\:76f8\:7a7a\:95f4 NIntegrate \:53c2\:6570 *)
  \"nv\"         -> speedOrder  (* \:53c2\:6570 nv\:ff1a\:901f\:5ea6 \
NIntegrate \:53c2\:6570 *)
|>;  (* \:63a5\:7eed\:4e0a\:4e00\:884c\:7684\:53c2\:6570\:6216\:8868\:8fbe\
\:5f0f *)

pPole = Append[parameters, \"widthMode\" -> \"pole\"];  (* \:521b\:5efa\:6781\
\:70b9\:5bbd\:5ea6\:53c2\:6570\:7ec4 *)\
\>", "Input",
