Cell["\<\
base=DirectoryName[$InputFileName];
faDir=FileNameJoin[{base,\"..\",\"three_body_calculation_and_validation\",\"\
mathematica_halo_notebook\",\"FeynRules_check\",\"FeynArts-3.12\"}];
If[!FileExistsQ[FileNameJoin[{faDir,\"FeynArts.m\"}]],Print[\"ERROR: FeynArts \
missing: \",faDir];Exit[1]];
PrependTo[$Path,faDir];Get[\"FeynArts`\"];
$FAVerbose=0;
top=CreateTopologies[0,2->3,ExcludeTopologies->{Tadpoles,SelfEnergies}];
ins=InsertFields[top,{F[1],F[3]}->{F[1],F[3],S[1]},Model->\"ThreeBodyVV_FA\",\
GenericModel->\"ThreeBodyVV_FA\",InsertionLevel->{Classes}];
Print[\"Number of 2->3 diagrams: \",Length[ins]];
If[Length[ins]!=2,Print[\"ERROR: expected 2 diagrams\"];Exit[2]];
Paint[ins,ColumnsXRows->{2,1},SheetHeader->None];
FeynArts`Graphics`LabelFontSize=0.7;
result=Paint[ins,ColumnsXRows->{2,1},Numbering->Simple,SheetHeader->None,\
ImageSize->{900,450}];
outputPath=Last[$ScriptCommandLine];
Export[outputPath,result,\"PNG\"];
If[!FileExistsQ[outputPath],Print[\"ERROR: diagram export failed\"];Exit[3]];
Print[\"DIAGRAM_EXPORT_OK\"];Exit[0];\
\>", "Program",
 CellOpen->False,
 CellTags->
  "embeddedFAFullPaint",ExpressionUUID->"506c60d7-ea08-d54c-92f4-\
606e8f74d4b4"],

Cell["\<\
Clear[faDiagramRun]; (* \
\:6e05\:9664\:4e0a\:6b21\:8d39\:66fc\:56fe\:68c0\:67e5\:72b6\:6001 *)
(* \:8fd0\:884c\:524d\:9700\:8981\:5b8c\:6210\:524d\:9762\:7684\:72ec\:7acb\
\:5185\:6838\:5de5\:5177\:5b9a\:4e49\:ff0c\:4ee5\:53ca\:672c\:673a FeynArts \
\:5b89\:88c5\:68c0\:67e5\:3002 *)
faDiagramScript = writeEmbeddedScript[\"embeddedFAFullPaint\", False]; (* \
\:5c06\:7b14\:8bb0\:672c\:5185\:7684\:7ed8\:56fe\:811a\:672c\:548c\:6a21\:578b\
\:5199\:5230\:4e34\:65f6\:76ee\:5f55 *)
faExecutable = SelectFirst[FileNameJoin[{#, If[$OperatingSystem === \"Windows\
\", \"wolframscript.exe\", \"wolframscript\"]}] & /@ StringSplit[Environment[\
\"PATH\"], If[$OperatingSystem === \"Windows\", \";\", \":\"]], FileExistsQ, \
$Failed]; (* \:5bfb\:627e Mathematica \:547d\:4ee4\:884c\:5185\:6838 *)
If[faExecutable === $Failed, Print[\"\:672a\:627e\:5230 wolframscript\:ff0c\
\:65e0\:6cd5\:8fd0\:884c FeynArts \:56fe\:5f62\:8ba1\:7b97\:3002\"], (* \
\:627e\:4e0d\:5230\:65f6\:663e\:793a\:539f\:56e0 *)
 faDiagramFile = CreateTemporary[] <> \".png\"; (* \:56fe\:50cf\:5199\:5165\
\:4e34\:65f6\:6587\:4ef6\:ff0c\:907f\:514d\:8986\:76d6\:5df2\:6709\:6587\:4ef6\
 *)
 faDiagramRun = RunProcess[{faExecutable, \"-file\", faDiagramScript, \
faDiagramFile}]; (* \:72ec\:7acb\:5185\:6838\:751f\:6210\:5b8c\:6574 2\
\[RightArrow]3 \:56fe *)
 Print[\"FeynArts \:9000\:51fa\:7801\:ff1a\", faDiagramRun[\"ExitCode\"]]; (* \
\:663e\:793a\:8fd0\:884c\:72b6\:6001 *)
 Print[faDiagramRun[\"StandardOutput\"]]; (* \:663e\:793a\:62d3\:6251\:6570\
\:548c\:7a0b\:5e8f\:4fe1\:606f *)
 If[faDiagramRun[\"StandardError\"] =!= \"\", \
Print[faDiagramRun[\"StandardError\"]]]; (* \:663e\:793a\:9519\:8bef\:8f93\
\:51fa *)
 If[faDiagramRun[\"ExitCode\"] === 0 && FileExistsQ[faDiagramFile], \
Print[Import[faDiagramFile]], Print[\"\:672a\:80fd\:751f\:6210\:8d39\:66fc\
\:56fe\:ff1b\:8bf7\:68c0\:67e5\:4e0a\:9762\:7684\:9519\:8bef\:4fe1\:606f\:3002\
\"]]; (* \:663e\:793a\:771f\:5b9e\:751f\:6210\:7684\:56fe\:50cf *)
];\
\>", "Input",
 CellLabel->
  "In[1264]:=",ExpressionUUID->"8f160b49-1a9b-7248-805c-f3f4047c78f3"],

