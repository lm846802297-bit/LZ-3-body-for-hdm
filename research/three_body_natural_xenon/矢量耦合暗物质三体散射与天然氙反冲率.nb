Cell["\<\
(* Run in a separate kernel: original FeynArts and FeynCalc export \
overlapping names. *)
base = DirectoryName[$InputFileName];
faDir = FileNameJoin[{base,\"feynarts\",\"FeynArts-3.12\"}];
If[!FileExistsQ[FileNameJoin[{faDir,\"FeynArts.m\"}]],Print[\"FeynArts \
missing: \",faDir];Exit[1]];
AppendTo[$Path,faDir];
Get[\"FeynArts`\"];
topologies=CreateTopologies[0,2->2,ExcludeTopologies->{Tadpoles,SelfEnergies}];
diagrams=InsertFields[topologies,{F[1],V[1]}->{F[1],S[1]},
 Model->\"ChiRadiation\",InsertionLevel->{Classes}];
amplitudes=CreateFeynAmp[diagrams,Truncated->True];
Print[\"Number of inserted diagrams: \",Length[diagrams]];
Print[\"Number of amplitudes: \",Length[amplitudes]];
Print[\"Amplitudes (FeynArts notation):\"];
Print[ToString[InputForm[amplitudes],PageWidth->Infinity]];
If[Length[diagrams]!=2||Length[amplitudes]!=2,Exit[2]];
Exit[0];
\
\>", "Program",
 CellTags->
  "embeddedFA",ExpressionUUID->"4a3b0600-4c2f-ac4f-ae72-99325b6ffe92"],

