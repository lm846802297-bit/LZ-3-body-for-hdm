feynRulesScript}]; (* \:63a8\:5bfc\:8d39\:66fc\:89c4\:5219\:5e76\:68c0\:67e5\
\:5384\:7c73\:6027 *)
 Print[feynRulesRun[\"StandardOutput\"]]; (* \:663e\:793a\:4e94\:4e2a\:9876\
\:89d2\:53ca\:68c0\:67e5\:7ed3\:679c *)
 If[feynRulesRun[\"StandardError\"] =!= \"\", \
Print[feynRulesRun[\"StandardError\"]]]; (* \:663e\:793a\:53ef\:80fd\:7684\
\:8b66\:544a *)
 Print[\"\:6267\:884c\:9000\:51fa\:7801\:ff1a\", feynRulesRun[\"ExitCode\"]] \
