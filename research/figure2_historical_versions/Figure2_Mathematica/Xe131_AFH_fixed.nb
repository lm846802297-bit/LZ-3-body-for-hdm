Cell["\:4f7f\:7528\:65b9\:6cd5\:ff1a\:7528 Mathematica \:684c\:9762\:7248\:6253\:5f00\:672c\:6587\:4ef6\:ff0c\:4ece\:5934\:5230\:5c3e\:4f9d\:6b21\:9009\:4e2d\:6bcf\:4e2a Input \:5355\:5143\:683c\:ff0c\:6309 Shift+Enter\:ff1b\:4e5f\:53ef\:4ee5\:4f7f\:7528 Evaluation \:2192 Evaluate Notebook\:3002\:8bf7\:4fdd\:7559\:672c\:7b14\:8bb0\:672c\:3001dmformfactor-V6.m \:548c python_reference.csv \:5728\:540c\:4e00\:6587\:4ef6\:5939\:3002\:9996\:6b21\:8fd0\:7b97\:53ef\:80fd\:9700\:8981\:4e00\:4e9b\:65f6\:95f4\:3002\:82e5\:67d0\:4e00\:6b65\:51fa\:73b0\:7ea2\:8272\:62a5\:9519\:ff0c\:8bf7\:5148\:89e3\:51b3\:8be5\:6b65\:518d\:7ee7\:7eed\:ff1b\:4fee\:6539\:53c2\:6570\:540e\:5e94\:4ece\:5934\:91cd\:65b0\:8fd0\:884c\:3002", "Text"],
Cell["\:8303\:56f4\:ff1a\:8fd9\:91cc\:8ba1\:7b97 Xe-131 \:7684\:6838\:54cd\:5e94\:ff0c\:4e0d\:5305\:542b\:4e09\:4f53\:76f8\:7a7a\:95f4\:79ef\:5206\:3001\:7edd\:5bf9\:5fae\:5206\:622a\:9762\:3001\:5929\:7136\:6c19\:52a0\:6743\:6216\:6697\:7269\:8d28\:901f\:5ea6\:5206\:5e03\:3002Python CSV \:4ec5\:7528\:4e8e\:5916\:90e8\:5bf9\:7167\:ff1bAFH \:6838\:54cd\:5e94\:3001\:96f6\:70b9\:53ca\:6781\:5c0f\:503c\:7531 Mathematica \:76f4\:63a5\:8c03\:7528\:5b98\:65b9\:5305\:91cd\:65b0\:8ba1\:7b97\:3002", "Text"],
Cell["1. \:73af\:5883\:4e0e\:8f93\:5165\:6587\:4ef6", "Section"],
Cell["\:6838\:54cd\:5e94\:6765\:81ea AFH \:5b98\:65b9 DMFormFactor v6.0\:3002\:6e90\:6587\:4ef6\:7684 SHA-256 \:7528\:6765\:786e\:8ba4\:6587\:4ef6\:7248\:672c\:ff1b\:5982\:8def\:5f84\:6216\:54c8\:5e0c\:4e0d\:7b26\:ff0c\:8ba1\:7b97\:4f1a\:4e2d\:6b62\:3002ClearAll \:53ea\:6e05\:9664 Global` \:73af\:5883\:4e2d\:7684\:53d8\:91cf\:ff0c\:5efa\:8bae\:5728\:72ec\:7acb\:5185\:6838\:8fd0\:884c\:3002", "Text"],
Cell["ClearAll[\"Global`*\"];\n(* \:7b14\:8bb0\:672c\:548c\:4e24\:4e2a\:8f93\:5165\:6587\:4ef6\:653e\:5728\:540c\:4e00\:4e2a\:6587\:4ef6\:5939\:3002 *)\nbaseDir = NotebookDirectory[];\npackagePath = FileNameJoin[{baseDir, \"dmformfactor-V6.m\"}];\npythonPath = FileNameJoin[{baseDir, \"python_reference.csv\"}];\nexpectedHash = \"dc0742f1c50b0a478adab62f2ddef6c82978ee034c1f177e0ed917deab5dd372\";\nIf[! FileExistsQ[packagePath], Print[\"\:9519\:8bef\:ff1a\:627e\:4e0d\:5230 AFH \:6e90\:6587\:4ef6\:ff1a\", packagePath]; Abort[]];\nsourceHash = ToLowerCase[FileHash[packagePath, \"SHA256\", \"HexString\"]];\nPrint[\"Mathematica \:7248\:672c\:ff1a\", $Version];\nPrint[\"AFH \:6e90\:6587\:4ef6\:ff1a\", packagePath];\nPrint[\"SHA-256\:ff1a\", sourceHash];\nIf[sourceHash =!= expectedHash, Print[\"\:9519\:8bef\:ff1aAFH \:6e90\:6587\:4ef6\:54c8\:5e0c\:4e0e\:8bb0\:5f55\:4e0d\:7b26\:ff0c\:8bf7\:6838\:67e5\:6765\:6e90\:3002\"]; Abort[]];\nPrint[\"\:6e90\:6587\:4ef6\:54c8\:5e0c\:68c0\:67e5\:901a\:8fc7\:3002\"]", "Input"],
Cell["2. \:8f7d\:5165 AFH \:5e76\:8bbe\:7f6e Xe-131", "Section"],
Cell["AFH \:5305\:5185\:7f6e 67 \:9879 Xe-131 \:9ed8\:8ba4\:5bc6\:5ea6\:77e9\:9635\:3002\:8c03\:7528 SetIsotope \:65f6\:ff0c\:4e24\:4e2a default \:5206\:522b\:9009\:62e9\:9ed8\:8ba4\:5bc6\:5ea6\:77e9\:9635\:548c\:9ed8\:8ba4\:632f\:5b50\:957f\:5ea6\:ff1b\:6ca1\:6709\:901a\:8fc7\:8c03\:6574\:632f\:5b50\:957f\:5ea6\:62df\:5408\:8c37\:503c\:3002", "Text"],
Cell["Get[packagePath];\nSetIsotope[54, 131, \"default\", \"default\"];\n(* ResponseNuclear \:8fd4\:56de\:5305\:4e2d\:539f\:59cb\:7684 W_M^(00)(y)\:3002 *)\nwmExpression = ResponseNuclear[y, 1, 0, 0];\nIf[! NumericQ[N[wmExpression /. y -> 0]], Print[\"\:9519\:8bef\:ff1aAFH \:54cd\:5e94\:5728 y=0 \:4e0d\:662f\:6570\:503c\:3002\"]; Abort[]];\nA = 131; JA = 3/2;\n(* \:9ed8\:8ba4\:632f\:5b50\:957f\:5ea6\:ff0c\:5355\:4f4d fm\:ff1b5.0677 \:662f AFH v6 \:4f7f\:7528\:7684\:6362\:7b97\:3002 *)\nbFM = Sqrt[41.467/(45. A^(-1./3.) - 25. A^(-2./3.))];\nbGeVInverse = 5.0677 bFM;\n(* \:4ec5\:7528\:4e8e q \:5230\:53cd\:51b2\:80fd\:91cf\:7684\:6620\:5c04\:ff0c\:4e0d\:53c2\:4e0e\:786e\:5b9a\:6838\:54cd\:5e94\:3002 *)\nmassGeV = A 0.93149410242;\nPrint[\"b_A = \", bFM, \" fm\:ff0c\:9884\:671f\:7ea6 2.2923417985 fm\"];\nPrint[\"W_M^00(0) = \", N[wmExpression /. y -> 0]]", "Input"],
Cell["3. AFH \:7ea6\:5b9a\:4e0e\:96f6\:52a8\:91cf\:5f52\:4e00\:5316", "Section"],
Cell["\:4ee4 q \:4ee5 GeV \:4e3a\:5355\:4f4d\:ff0cy=(q b_A/2)^2\:ff0cb_A \:5148\:6362\:7b97\:4e3a GeV^-1\:3002AFH \:539f\:59cb\:7684 (4\:03c0/(2J+1)) W_M^00(0) \:63a5\:8fd1 A\:00b2/4\:3002\:7b49\:8d28\:5b50\:548c\:4e2d\:5b50\:7269\:7406\:8026\:5408\:65f6\:ff0c\:6b64\:54cd\:5e94\:518d\:4e58 4\:ff0c\:5373 16\:03c0 W/(2J+1)\:3002\:7531\:4e8e\:5bc6\:5ea6\:77e9\:9635\:7ed9\:51fa\:7684\:6570\:5b57\:6709\:9650\:7cbe\:5ea6\:ff0c\:539f\:59cb\:96f6\:70b9\:63a5\:8fd1\:4f46\:4e0d\:4e25\:683c\:7b49\:4e8e A\:00b2\:3002\:4e0b\:9762\:518d\:7528 A\:00b2/Rraw(0) \:7edf\:4e00\:7f29\:653e\:6574\:6761\:66f2\:7ebf\:ff1b\:539f\:59cb\:4e0e\:7f29\:653e\:540e\:7684\:91cf\:90fd\:4f1a\:4fdd\:7559\:3002", "Text"],
Cell["wm[q_?NumericQ] := N[wmExpression /. y -> (q bGeVInverse/2)^2];\nrAFH[q_?NumericQ] := 4 Pi/(2 JA + 1) wm[q];\nrRaw[q_?NumericQ] := 4 rAFH[q];\nr0 = rRaw[0.];\nIf[! NumericQ[r0] || r0 <= 0, Print[\"\:9519\:8bef\:ff1a\:96f6\:52a8\:91cf\:539f\:59cb\:54cd\:5e94\:65e0\:6548\:3002\"]; Abort[]];\nscale = A^2/r0;\nrNormalized[q_?NumericQ] := scale rRaw[q];\nzeroRelativeOffset = r0/A^2 - 1;\nGrid[{\n {\"\:68c0\:67e5\:91cf\", \"Mathematica \:8ba1\:7b97\:503c\", \"\:7406\:8bba\:6216\:9884\:671f\"},\n {\"AFH \:539f\:59cb 4\:03c0W/(2J+1)\", rAFH[0.], N[A^2/4]},\n {\"\:7b49\:6838\:5b50\:539f\:59cb\:54cd\:5e94\", r0, A^2},\n {\"\:539f\:59cb\:96f6\:70b9\:76f8\:5bf9\:504f\:5dee\", zeroRelativeOffset, \"\:7ea6 -8.2523\:00d710^-5\"},\n {\"\:6574\:4f53\:5f52\:4e00\:5316\:56e0\:5b50\", scale, \"\:7ea6 1.0000825298\"},\n {\"\:5f52\:4e00\:5316\:540e\:96f6\:70b9\", rNormalized[0.], A^2}}, Frame -> All]", "Input"],
Cell["\:4e0b\:9762\:7684\:68c0\:67e5\:5141\:8bb8\:5bc6\:5ea6\:77e9\:9635\:6709\:9650\:7cbe\:5ea6\:5f15\:8d77\:7684\:5c0f\:504f\:5dee\:ff1b\:8fd9\:4e0d\:662f\:901a\:8fc7\:66f4\:6539\:632f\:5b50\:957f\:5ea6\:6216\:6539\:53d8\:6570\:636e\:6765\:62df\:5408\:3002\:8bba\:6587\:4e2d\:5b8c\:6574\:622a\:9762\:516c\:5f0f\:7684\:8026\:5408\:4e0e\:603b\:524d\:56e0\:5b50\:4ecd\:9700\:5355\:72ec\:5ba1\:8ba1\:3002", "Text"],
Cell["If[Abs[zeroRelativeOffset] > 2 10^-4,\n Print[\"\:672a\:901a\:8fc7\:ff1a\:96f6\:52a8\:91cf\:54cd\:5e94\:8d85\:51fa\:9884\:8bbe\:5bb9\:5dee\:ff0c\:8bf7\:68c0\:67e5\:5305\:4e0e\:7ea6\:5b9a\:3002\"]; Abort[],\n Print[\"\:901a\:8fc7\:ff1a\:539f\:59cb\:96f6\:70b9\:7b26\:5408 A\:00b2 \:7684\:6709\:9650\:7cbe\:5ea6\:5bb9\:5dee\:ff1b\:5f52\:4e00\:5316\:540e\:96f6\:70b9 = \", rNormalized[0.]]];", "Input"],
Cell["4. \:751f\:6210 2401 \:70b9\:52a8\:91cf\:626b\:63cf", "Section"],
Cell["q \:4ece 0 \:5230 0.600 GeV\:ff0c\:6b65\:957f 0.00025 GeV\:ff080.25 MeV\:ff09\:3002\:53cd\:51b2\:80fd\:91cf\:4f7f\:7528 E_R=q\:00b2/(sqrt(m_A\:00b2+q\:00b2)+m_A)\:ff0c\:4e0e sqrt(m_A\:00b2+q\:00b2)-m_A \:7b49\:4ef7\:ff0c\:4f46\:66f4\:80fd\:907f\:514d\:5c0f q \:65f6\:7684\:6570\:503c\:6d88\:51cf\:3002", "Text"],
Cell["qGrid = N[Range[0, 2400]/4000];\nrecoilKeV[q_?NumericQ] := 10^6 q^2/(Sqrt[massGeV^2 + q^2] + massGeV);\n(* \:5217\:ff1aq\:3001\:53cd\:51b2\:80fd\:91cf\:3001AFH \:539f\:59cb W\:3001\:7b49\:6838\:5b50\:539f\:59cb\:54cd\:5e94\:3001\:5f52\:4e00\:5316\:54cd\:5e94\:3001\:5f52\:4e00\:5316\:54cd\:5e94/A\:00b2\:3002 *)\nnativeGrid = Table[{q, recoilKeV[q], wm[q], rRaw[q], rNormalized[q], rNormalized[q]/A^2}, {q, qGrid}];\nPrint[\"\:626b\:63cf\:70b9\:6570\:ff1a\", Length[nativeGrid], \"\:ff1bq \:8303\:56f4 [GeV]\:ff1a\", {First[qGrid], Last[qGrid]}];\nGrid[Prepend[nativeGrid[[{1, 401, 1001, 1601, 2401}]],\n {\"q [GeV]\", \"E_R [keV]\", \"W_M^00\", \"R \:539f\:59cb\", \"R \:5f52\:4e00\:5316\", \"R/A\:00b2\"}], Frame -> All]", "Input"],
Cell["5. \:72ec\:7acb\:6c42\:89e3\:4e09\:4e2a\:6781\:5c0f\:503c", "Section"],
Cell["\:5206\:522b\:5728 0.14\:20130.18\:30010.24\:20130.28\:30010.34\:20130.39 GeV \:533a\:95f4\:4f7f\:7528 NMinimize\:ff1b\:8fd9\:4e9b\:662f\:641c\:7d22\:533a\:95f4\:ff0c\:5e76\:975e\:5c06\:8c37\:503c\:4f4d\:7f6e\:56fa\:5b9a\:4e3a\:9884\:671f\:7b54\:6848\:3002\:6df1\:5ea6\:663e\:793a\:5f52\:4e00\:5316\:54cd\:5e94\:9664\:4ee5 A\:00b2\:3002", "Text"],
Cell["intervals = {{0.14, 0.18}, {0.24, 0.28}, {0.34, 0.39}};\nminima = Table[\n Module[{lo = interval[[1]], hi = interval[[2]], solution, qmin},\n  solution = NMinimize[{rNormalized[x]/A^2, lo <= x <= hi}, x];\n  If[! MatchQ[solution, {_?NumericQ, {x -> _?NumericQ}}], Print[\"\:6781\:5c0f\:503c\:6c42\:89e3\:5931\:8d25\:ff1a\", interval]; Abort[]];\n  qmin = x /. solution[[2]];\n  {1000 qmin, recoilKeV[qmin], solution[[1]]}], {interval, intervals}];\nGrid[Prepend[minima, {\"q_min [MeV]\", \"E_R,min [keV]\", \"R/A\:00b2\"}], Frame -> All]", "Input"],
Cell["\:53c2\:8003\:7ed3\:679c\:ff08\:56db\:820d\:4e94\:5165\:ff09\:ff1a(157.935779 MeV, 102.206725 keV, 1.23638\:00d710^-5)\:3001(256.271871 MeV, 269.103904 keV, 6.34070\:00d710^-8)\:3001(365.066573 MeV, 546.086910 keV, 1.56194\:00d710^-7)\:3002\:673a\:5668\:7cbe\:5ea6\:6216\:4f18\:5316\:5668\:53ef\:80fd\:5bfc\:81f4\:672b\:4f4d\:5c0f\:5dee\:5f02\:3002", "Text"],
Cell["6. \:7ed8\:5236\:6838\:54cd\:5e94\:66f2\:7ebf", "Section"],
Cell["\:7eb5\:8f74\:4e3a R/A\:00b2\:3002\:5bf9\:6570\:5750\:6807\:4fbf\:4e8e\:89c2\:5bdf\:591a\:4e2a\:8c37\:503c\:ff1b\:672c\:56fe\:4ec5\:4e3a\:6838\:54cd\:5e94\:ff0c\:4e0d\:662f\:4e09\:4f53\:622a\:9762\:6216\:4e8b\:4ef6\:7387\:3002", "Text"],
Cell["ListLogPlot[nativeGrid[[All, {2, 6}]], Joined -> True, PlotRange -> All,\n Frame -> True, FrameLabel -> {\"Recoil energy E_R (keV)\", \"Normalized response R/A^2\"},\n PlotLabel -> \"Xe-131 AFH default nuclear response\", ImageSize -> Large]", "Input"],
Cell["7. \:4e0e\:6b64\:524d Python \:7ed3\:679c\:9010\:70b9\:6bd4\:8f83", "Section"],
Cell["\:672c\:8282\:9700\:8981\:540c\:76ee\:5f55\:7684 python_reference.csv\:3002\:5b83\:6765\:81ea\:4ed3\:5e93\:5f52\:6863 CSV\:ff1b\:539f\:6587\:4ef6\:6709\:4e24\:5904\:7f3a\:5931\:6362\:884c\:548c\:4e00\:4e2a\:7a7a\:884c\:ff0c\:6b64\:526f\:672c\:53ea\:4fee\:590d\:4e86\:683c\:5f0f\:ff0c\:5e76\:68c0\:67e5\:4e86 2401 \:70b9\:7f51\:683c\:3002\:5bf9\:539f\:59cb W\:3001\:539f\:59cb\:7269\:7406\:54cd\:5e94\:548c\:5f52\:4e00\:5316\:54cd\:5e94\:5206\:522b\:6bd4\:8f83\:3002\:901a\:8fc7\:6761\:4ef6\:ff1a|Mathematica\:2212Python| \:2264 2\:00d710^-10 + 2\:00d710^-8 |Python|\:3002\:63a5\:8fd1\:96f6\:7684\:8c37\:5e95\:4f7f\:7528\:7edd\:5bf9\:5bb9\:5dee\:ff0c\:907f\:514d\:53ea\:770b\:76f8\:5bf9\:8bef\:5dee\:7684\:8bef\:5bfc\:3002", "Text"],
Cell["If[! FileExistsQ[pythonPath], Print[\"\:9519\:8bef\:ff1a\:627e\:4e0d\:5230 Python \:5bf9\:7167\:6587\:4ef6\:ff1a\", pythonPath]; Abort[]];\nreference = Import[pythonPath, \"CSV\"];\nIf[! ListQ[reference] || Length[reference] != 2402, Print[\"\:9519\:8bef\:ff1a\:5bf9\:7167\:6587\:4ef6\:884c\:6570\:4e0d\:4e3a 2402\:ff08\:542b\:8868\:5934\:ff09\:3002\"]; Abort[]];\nheader = First[reference]; referenceData = Rest[reference];\nnames = {\"q_GeV\", \"W_M00_AFH_package\", \"R_equal_pn_raw\", \"R_equal_pn_normalized\"};\npositions = (FirstPosition[header, #, Missing[\"NotFound\"]] &) /@ names;\nIf[! FreeQ[positions, _Missing], Print[\"\:9519\:8bef\:ff1a\:5bf9\:7167 CSV \:7f3a\:5c11\:5fc5\:8981\:5217\:3002 \", positions]; Abort[]];\nindices = First /@ positions;\nIf[! MatrixQ[referenceData[[All, indices]], NumericQ], Print[\"\:9519\:8bef\:ff1a\:5bf9\:7167\:5217\:4e2d\:5b58\:5728\:975e\:6570\:503c\:6216\:683c\:5f0f\:9519\:8bef\:3002\"]; Abort[]];\npythonGrid = referenceData[[All, indices]];\nIf[Max[Abs[pythonGrid[[All, 1]] - qGrid]] > 10^-12, Print[\"\:9519\:8bef\:ff1a\:52a8\:91cf\:7f51\:683c\:4e0d\:4e00\:81f4\:ff0c\:4e0d\:8fdb\:884c\:63d2\:503c\:6bd4\:8f83\:3002\"]; Abort[]];\n(* nativeGrid \:7684\:7b2c 3\:30014\:30015 \:5217\:5206\:522b\:5bf9\:5e94 Python \:7684\:7b2c 2\:30013\:30014 \:5217\:3002 *)\nrtol = 2 10^-8; atol = 2 10^-10;\ncomparison = Table[\n Module[{py = pythonGrid[[All, k]], mma = nativeGrid[[All, k + 1]], delta, limit, worst},\n  delta = Abs[mma - py]; limit = atol + rtol Abs[py];\n  worst = First[Ordering[delta/limit, -1]];\n  {names[[k]], Max[delta], Max[delta/limit], qGrid[[worst]], Count[MapThread[Greater, {delta, limit}], True]}], {k, 2, 4}];\nGrid[Prepend[comparison, {\"\:6bd4\:8f83\:91cf\", \"\:6700\:5927\:7edd\:5bf9\:5dee\", \"\:6700\:5927\:8bef\:5dee/\:5bb9\:5dee\", \"\:6700\:5dee\:70b9 q [GeV]\", \"\:672a\:901a\:8fc7\:70b9\:6570\"}], Frame -> All]", "Input"],
Cell["If[Total[comparison[[All, 5]]] == 0,\n Print[\"\:901a\:8fc7\:ff1a\:4e09\:4e2a\:54cd\:5e94\:91cf\:5728\:5168\:90e8 2401 \:4e2a\:7f51\:683c\:70b9\:6ee1\:8db3\:5bb9\:5dee\:3002\"],\n Print[\"\:672a\:901a\:8fc7\:ff1a\:8bf7\:68c0\:67e5\:4e0a\:8868\:672a\:901a\:8fc7\:70b9\:6570\:548c\:8f93\:5165\:6587\:4ef6\:3002\"]]", "Input"],
Cell["8. \:53ef\:9009\:ff1a\:5bfc\:51fa\:672c\:6b21 Mathematica \:7ed3\:679c", "Section"],
Cell["\:53ea\:6709\:8fd0\:884c\:4e0b\:9762\:5355\:5143\:683c\:624d\:4f1a\:5199\:51fa\:7ed3\:679c\:3002\:6587\:4ef6\:5199\:5165\:672c\:7b14\:8bb0\:672c\:540c\:76ee\:5f55\:7684 mma_output \:6587\:4ef6\:5939\:ff0c\:91cd\:590d\:8fd0\:884c\:4f1a\:8986\:76d6\:540c\:540d CSV\:3002", "Text"],
Cell["outDir = FileNameJoin[{baseDir, \"mma_output\"}];\nIf[! DirectoryQ[outDir], CreateDirectory[outDir]];\nExport[FileNameJoin[{outDir, \"xe131_native_grid.csv\"}],\n Prepend[nativeGrid, {\"q_GeV\", \"ER_keV\", \"W_M00_AFH\", \"R_equal_raw\", \"R_equal_normalized\", \"R_over_A2\"}], \"CSV\"];\nExport[FileNameJoin[{outDir, \"xe131_minima.csv\"}],\n Prepend[minima, {\"q_MeV\", \"ER_keV\", \"R_over_A2\"}], \"CSV\"];\nExport[FileNameJoin[{outDir, \"xe131_python_comparison.csv\"}],\n Prepend[comparison, {\"quantity\", \"max_abs_difference\", \"max_tolerance_ratio\", \"worst_q_GeV\", \"failed_points\"}], \"CSV\"];\nPrint[\"\:5df2\:5bfc\:51fa\:81f3\:ff1a\", outDir]", "Input"],
Cell["9. \:5982\:4f55\:89e3\:91ca\:7ed3\:679c", "Section"],
Cell["\:5982\:679c\:96f6\:70b9\:68c0\:67e5\:548c\:9010\:70b9\:6bd4\:8f83\:5747\:901a\:8fc7\:ff0c\:8bf4\:660e\:5728\:6240\:91c7\:7528\:7684 AFH \:9ed8\:8ba4\:8f93\:5165\:3001\:6570\:503c\:7f51\:683c\:53ca\:5bb9\:5dee\:4e0b\:ff0cMathematica \:4e0e\:5f52\:6863 Python \:7684\:6838\:54cd\:5e94\:4e00\:81f4\:3002\:5b83\:4e0d\:8bc1\:660e\:5176\:4ed6\:6838\:7ed3\:6784\:6a21\:578b\:6216\:4e09\:4f53\:79ef\:5206\:6b63\:786e\:ff0c\:4e5f\:4e0d\:80fd\:5355\:72ec\:786e\:5b9a\:8bba\:6587\:7684\:5b8c\:6574\:7edd\:5bf9\:622a\:9762\:5f52\:4e00\:5316\:3002\:4f7f\:7528\:4e0d\:540c\:7684\:6838\:8d28\:91cf\:7ea6\:5b9a\:4f1a\:5f71\:54cd q \:5230 E_R \:7684\:6362\:7b97\:3002", "Text"]
