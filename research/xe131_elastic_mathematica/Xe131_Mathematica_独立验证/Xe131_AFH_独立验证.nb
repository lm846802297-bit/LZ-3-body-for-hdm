\:3002\:53cd\:51b2\:80fd\:91cf\:4f7f\:7528 \
E_R=q\.b2/(sqrt(m_A\.b2+q\.b2)+m_A)\:ff0c\:4e0e sqrt(m_A\.b2+q\.b2)-m_A \
\:7b49\:4ef7\:ff0c\:4f46\:66f4\:80fd\:907f\:514d\:5c0f q \:65f6\:7684\:6570\
