Cell["\<\
wm[q_?NumericQ] := N[wmExpression /. y -> (q bGeVInverse/2)^2];
rAFH[q_?NumericQ] := 4 Pi/(2 JA + 1) wm[q];
rRaw[q_?NumericQ] := 4 rAFH[q];
r0 = rRaw[0.];
If[! NumericQ[r0] || r0 <= 0, Print[\"\:9519\:8bef\:ff1a\:96f6\:52a8\:91cf\
\:539f\:59cb\:54cd\:5e94\:65e0\:6548\:3002\"]; Abort[]];
scale = A^2/r0;
rNormalized[q_?NumericQ] := scale rRaw[q];
zeroRelativeOffset = r0/A^2 - 1;
Grid[{
 {\"\:68c0\:67e5\:91cf\", \"Mathematica \:8ba1\:7b97\:503c\", \"\:7406\:8bba\
\:6216\:9884\:671f\"},
