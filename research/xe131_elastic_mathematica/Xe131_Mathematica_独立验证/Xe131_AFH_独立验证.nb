Cell["7. \:4e0e\:6b64\:524d Python \:7ed3\:679c\:9010\:70b9\:6bd4\:8f83", \
"Section",ExpressionUUID->"cb319b87-6b28-954f-b311-74e3f36ade48"],

Cell["\<\
\:672c\:8282\:9700\:8981\:540c\:76ee\:5f55\:7684 python_reference.csv\:3002\
\:5b83\:6765\:81ea\:4ed3\:5e93\:5f52\:6863 CSV\:ff1b\:539f\:6587\:4ef6\:6709\
\:4e24\:5904\:7f3a\:5931\:6362\:884c\:548c\:4e00\:4e2a\:7a7a\:884c\:ff0c\:6b64\
\:526f\:672c\:53ea\:4fee\:590d\:4e86\:683c\:5f0f\:ff0c\:5e76\:68c0\:67e5\:4e86\
 2401 \:70b9\:7f51\:683c\:3002\:5bf9\:539f\:59cb W\:3001\:539f\:59cb\:7269\
\:7406\:54cd\:5e94\:548c\:5f52\:4e00\:5316\:54cd\:5e94\:5206\:522b\:6bd4\:8f83\
\:3002\:901a\:8fc7\:6761\:4ef6\:ff1a|Mathematica\[Minus]Python| \[LessEqual] \
2\[Times]10^-10 + 2\[Times]10^-8 |Python|\:3002\:63a5\:8fd1\:96f6\:7684\:8c37\
\:5e95\:4f7f\:7528\:7edd\:5bf9\:5bb9\:5dee\:ff0c\:907f\:514d\:53ea\:770b\:76f8\
\:5bf9\:8bef\:5dee\:7684\:8bef\:5bfc\:3002\
\>", "Text",ExpressionUUID->"bf99aebc-3732-f74b-afa8-3c9b757a2411"],

Cell["\<\
If[! FileExistsQ[pythonPath], Print[\"\:9519\:8bef\:ff1a\:627e\:4e0d\:5230 \
Python \:5bf9\:7167\:6587\:4ef6\:ff1a\", pythonPath]; Abort[]];
reference = Import[pythonPath, \"CSV\"];
If[! ListQ[reference] || Length[reference] != 2402, \
Print[\"\:9519\:8bef\:ff1a\:5bf9\:7167\:6587\:4ef6\:884c\:6570\:4e0d\:4e3a \
2402\:ff08\:542b\:8868\:5934\:ff09\:3002\"]; Abort[]];
header = First[reference]; referenceData = Rest[reference];
names = {\"q_GeV\", \"W_M00_AFH_package\", \"R_equal_pn_raw\", \
\"R_equal_pn_normalized\"};
positions = (FirstPosition[header, #, Missing[\"NotFound\"]] &) /@ names;
If[! FreeQ[positions, _Missing], Print[\"\:9519\:8bef\:ff1a\:5bf9\:7167 CSV \
\:7f3a\:5c11\:5fc5\:8981\:5217\:3002 \", positions]; Abort[]];
indices = First /@ positions;
If[! MatrixQ[referenceData[[All, indices]], NumericQ], Print[\"\:9519\:8bef\
\:ff1a\:5bf9\:7167\:5217\:4e2d\:5b58\:5728\:975e\:6570\:503c\:6216\:683c\:5f0f\
\:9519\:8bef\:3002\"]; Abort[]];
pythonGrid = referenceData[[All, indices]];
If[Max[Abs[pythonGrid[[All, 1]] - qGrid]] > 10^-12, \
Print[\"\:9519\:8bef\:ff1a\:52a8\:91cf\:7f51\:683c\:4e0d\:4e00\:81f4\:ff0c\
\:4e0d\:8fdb\:884c\:63d2\:503c\:6bd4\:8f83\:3002\"]; Abort[]];
(* nativeGrid \:7684\:7b2c 3\:30014\:30015 \:5217\:5206\:522b\:5bf9\:5e94 \
Python \:7684\:7b2c 2\:30013\:30014 \:5217\:3002 *)
rtol = 2 10^-8; atol = 2 10^-10;
comparison = Table[
 Module[{py = pythonGrid[[All, k]], mma = nativeGrid[[All, k + 1]], delta, \
limit, worst},
  delta = Abs[mma - py]; limit = atol + rtol Abs[py];
  worst = First[Ordering[delta/limit, -1]];
  {names[[k]], Max[delta], Max[delta/limit], qGrid[[worst]], \
Count[MapThread[Greater, {delta, limit}], True]}], {k, 2, 4}];
Grid[Prepend[comparison, {\"\:6bd4\:8f83\:91cf\", \"\:6700\:5927\:7edd\:5bf9\
\:5dee\", \"\:6700\:5927\:8bef\:5dee/\:5bb9\:5dee\", \"\:6700\:5dee\:70b9 q \
[GeV]\", \"\:672a\:901a\:8fc7\:70b9\:6570\"}], Frame -> All]\
\>", "Input",ExpressionUUID->"33f0714a-f4f1-034d-a44e-67516fcd44e6"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"\:6bd4\:8f83\:91cf\"\>", "\<\"\:6700\:5927\:7edd\:5bf9\:5dee\"\>", \
"\<\"\:6700\:5927\:8bef\:5dee/\:5bb9\:5dee\"\>", "\<\"\:6700\:5dee\:70b9 q \
[GeV]\"\>", "\<\"\:672a\:901a\:8fc7\:70b9\:6570\"\>"},
    {"\<\"W_M00_AFH_package\"\>", "1.5916157281026244`*^-12", 
     "0.00196332439875869`", "0.2565`", "0"},
    {"\<\"R_equal_pn_raw\"\>", "2.000888343900442`*^-11", 
     "0.02203562074824121`", "0.2565`", "0"},
    {"\<\"R_equal_pn_normalized\"\>", "2.3646862246096134`*^-11", 
     "0.022037226618105317`", "0.2565`", "0"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"cc959487-7742-e542-9243-048d59edbced"],

