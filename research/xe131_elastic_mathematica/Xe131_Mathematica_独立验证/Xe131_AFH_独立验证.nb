Cell["5. \:72ec\:7acb\:6c42\:89e3\:4e09\:4e2a\:6781\:5c0f\:503c", "Section",ExpressionUUID->"5cd6752d-6b0e-f641-84c2-3a671a96d13d"],

Cell["\<\
\:5206\:522b\:5728 0.14\[Dash]0.18\:30010.24\[Dash]0.28\:30010.34\[Dash]0.39 \
GeV \:533a\:95f4\:4f7f\:7528 NMinimize\:ff1b\:8fd9\:4e9b\:662f\:641c\:7d22\
\:533a\:95f4\:ff0c\:5e76\:975e\:5c06\:8c37\:503c\:4f4d\:7f6e\:56fa\:5b9a\:4e3a\
\:9884\:671f\:7b54\:6848\:3002\:6df1\:5ea6\:663e\:793a\:5f52\:4e00\:5316\:54cd\
\:5e94\:9664\:4ee5 A\.b2\:3002\
\>", "Text",ExpressionUUID->"61e7c646-3954-b04b-a2b9-a1b87a727491"],

Cell["\<\
intervals = {{0.14, 0.18}, {0.24, 0.28}, {0.34, 0.39}};
minima = Table[
 Module[{lo = interval[[1]], hi = interval[[2]], solution, qmin},
  solution = NMinimize[{rNormalized[x]/A^2, lo <= x <= hi}, x];
  If[! MatchQ[solution, {_?NumericQ, {x -> _?NumericQ}}], \
Print[\"\:6781\:5c0f\:503c\:6c42\:89e3\:5931\:8d25\:ff1a\", interval]; \
Abort[]];
  qmin = x /. solution[[2]];
  {1000 qmin, recoilKeV[qmin], solution[[1]]}], {interval, intervals}];
Grid[Prepend[minima, {\"q_min [MeV]\", \"E_R,min [keV]\", \"R/A\.b2\"}], \
Frame -> All]\
\>", "Input",ExpressionUUID->"2641b5ac-8e16-1f4d-afb7-91b7da84635e"],

