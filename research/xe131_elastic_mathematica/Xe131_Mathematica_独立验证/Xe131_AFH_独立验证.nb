Cell["\<\
qGrid = N[Range[0, 2400]/4000];
recoilKeV[q_?NumericQ] := 10^6 q^2/(Sqrt[massGeV^2 + q^2] + massGeV);
(* \:5217\:ff1aq\:3001\:53cd\:51b2\:80fd\:91cf\:3001AFH \:539f\:59cb W\:3001\
\:7b49\:6838\:5b50\:539f\:59cb\:54cd\:5e94\:3001\:5f52\:4e00\:5316\:54cd\:5e94\
\:3001\:5f52\:4e00\:5316\:54cd\:5e94/A\.b2\:3002 *)
nativeGrid = Table[{q, recoilKeV[q], wm[q], rRaw[q], rNormalized[q], \
rNormalized[q]/A^2}, {q, qGrid}];
Print[\"\:626b\:63cf\:70b9\:6570\:ff1a\", Length[nativeGrid], \"\:ff1bq \
\:8303\:56f4 [GeV]\:ff1a\", {First[qGrid], Last[qGrid]}];
Grid[Prepend[nativeGrid[[{1, 401, 1001, 1601, 2401}]],
 {\"q [GeV]\", \"E_R [keV]\", \"W_M^00\", \"R \:539f\:59cb\", \"R \
\:5f52\:4e00\:5316\", \"R/A\.b2\"}], Frame -> All]\
\>", "Input",ExpressionUUID->"b8dc058a-b413-2640-998d-6fe96bf8c6f6"],

Cell["\<\
